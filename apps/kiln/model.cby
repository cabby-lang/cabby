// model.cby — Kiln's model: the shapes to begin with, colours, and .glb
// files written and read (model.hby says what each is for).

use math
use bytes
use json
use files
use local model

// ---- shapes to begin with

// a box, Size each way: six faces of four corners
part cube_part double Size {
	part P = {.Name = "cube", .Color = "#c8c8c8"}
	double H = Size / 2
	for I in 8 {
		double X = H
		double Y = H
		double Z = H
		if I % 2 == 0 {
			X = -H
		}
		if (I / 2) % 2 == 0 {
			Y = -H
		}
		if I / 4 == 0 {
			Z = -H
		}
		P.add_point X, Y, Z
	}
	// (corner I: x is + for odd I, y for I / 2 odd, z for I / 4 odd)
	P.add_face {4, 5, 7, 6}         // front (+z)
	P.add_face {1, 0, 2, 3}         // back
	P.add_face {5, 1, 3, 7}         // right
	P.add_face {0, 4, 6, 2}         // left
	P.add_face {6, 7, 3, 2}         // top
	P.add_face {0, 1, 5, 4}         // bottom
	return P
}

// flat, facing up, Size across
part plane_part double Size {
	part P = grid_part 1, Size
	P.Name = "plane"
	return P
}

// flat, facing up, Size across, in Across by Across squares
part grid_part int Across, double Size {
	part P = {.Name = "grid", .Color = "#c8c8c8"}
	for R in Across + 1 {
		for C in Across + 1 {
			P.add_point -Size / 2 + Size * C / Across, 0, -Size / 2 + Size * R / Across
		}
	}
	for R in Across {
		for C in Across {
			int A = (int)(R * (Across + 1) + C)
			P.add_face {A, A + Across + 1, A + Across + 2, A + 1}
		}
	}
	return P
}

// standing up, Height high, its round edge Sides corners
part cylinder_part int Sides, double Radius, double Height {
	part P = {.Name = "cylinder", .Color = "#c8c8c8"}
	for I in Sides {
		double A = 2 * HALF_TURN * I / Sides
		P.add_point Radius * sin(A), -Height / 2, Radius * cos(A)
		P.add_point Radius * sin(A), Height / 2, Radius * cos(A)
	}
	list int Top
	list int Bottom
	for I in Sides {
		int A = (int)(2 * I)
		int B = (int)(2 * ((I + 1) % Sides))
		P.add_face {A, B, B + 1, A + 1}
		Top.add A + 1
		Bottom.insert 0, A
	}
	P.add_face Top
	P.add_face Bottom
	return P
}

// standing up, its point Height above the middle of its round bottom
part cone_part int Sides, double Radius, double Height {
	part P = {.Name = "cone", .Color = "#c8c8c8"}
	for I in Sides {
		double A = 2 * HALF_TURN * I / Sides
		P.add_point Radius * sin(A), -Height / 2, Radius * cos(A)
	}
	int Tip = P.add_point 0, Height / 2, 0
	list int Bottom
	for I in Sides {
		int B = (int)((I + 1) % Sides)
		P.add_face {(int)I, B, Tip}
		Bottom.insert 0, (int)I
	}
	P.add_face Bottom
	return P
}

// a ball: Rings bands from top to bottom, Sides round
part sphere_part int Rings, int Sides, double Radius {
	part P = {.Name = "sphere", .Color = "#c8c8c8"}
	int Top = P.add_point 0, Radius, 0
	for R in 1 to Rings - 1 {
		double A = HALF_TURN * R / Rings
		for S in Sides {
			double B = 2 * HALF_TURN * S / Sides
			P.add_point Radius * sin(A) * sin(B), Radius * cos(A), Radius * sin(A) * cos(B)
		}
	}
	int Bottom = P.add_point 0, -Radius, 0
	for S in Sides {
		int Next = (int)((S + 1) % Sides)
		P.add_face {Top, 1 + (int)S, 1 + Next}
		int Last = 1 + (Rings - 2) * Sides
		P.add_face {Last + Next, Last + (int)S, Bottom}
	}
	for R in Rings - 2 {
		for S in Sides {
			int A = 1 + (int)(R * Sides + S)
			int B = 1 + (int)(R * Sides + (S + 1) % Sides)
			P.add_face {A, A + Sides, B + Sides, B}
		}
	}
	return P
}

// ---- colours

// a hex digit's value (0 to 15)
static int hex_digit char C {
	if C >= '0' && C <= '9' {
		return (int)C - (int)'0'
	} else if C >= 'a' && C <= 'f' {
		return (int)C - (int)'a' + 10
	} else if C >= 'A' && C <= 'F' {
		return (int)C - (int)'A' + 10
	}
	return 0
}

// a screen's colour as light: each of red, green and blue from 0 to 1,
// darker in the middle than it looks (sRGB to linear)
list double light_of const str &Color {
	list double Light
	for K in 3 {
		double V = (hex_digit(Color[1 + 2 * K]) * 16 + hex_digit(Color[2 + 2 * K])) / 255.0
		if V <= 0.04045 {
			Light.add V / 12.92
		} else {
			Light.add pow((V + 0.055) / 1.055, 2.4)
		}
	}
	return Light
}

static str two_hex int N {
	str Digits = "0123456789abcdef"
	str Out = ""
	Out += Digits[N / 16]
	Out += Digits[N % 16]
	return Out
}

// and back: light (0 to 1 each) as a screen's "#rrggbb"
str color_of double R, double G, double B {
	list double Light = {R, G, B}
	str Out = "#"
	for V in Light {
		double S = V * 12.92
		if V > 0.0031308 {
			S = 1.055 * pow(V, 1 / 2.4) - 0.055
		}
		int N = (int)(S * 255 + 0.5)
		if N < 0 {
			N = 0
		} else if N > 255 {
			N = 255
		}
		Out += two_hex N
	}
	return Out
}

// ---- .glb files: JSON saying what's where, then the numbers, in binary
//
// FRONT: a .glb's front is +z (Blender's, and glTF's), and the world
// library turns a model round as it's added, to face -z as its shapes do.
// Kiln works as the world does, -z forward, so a model is turned round as
// it's written (x and z the other way), and back as it's read: what's in
// front in Kiln is in front in a game, and in Blender.

// bytes, padded to a multiple of 4 with Pad (as a .glb's chunks must be)
static void pad_to_four bytes &B, int Pad {
	while B.length % 4 != 0 {
		B.add Pad
	}
}

// a part's faces, each corner its own (so each face is flat, its own
// way), as a glTF mesh: its places, its normals and its triangles, added
// to Bin, and their accessors to Gltf
static void write_part const part &P, int Index, bytes &Bin, json &Gltf {
	list double Places
	list double Normals
	list int Tris
	for F in P.Faces.length {
		point3 N = P.normal_of((int)F)
		int First = (int)(Places.length / 3)
		for C in P.Faces[F] {
			Places.add -P.Points[C].X       // (turned round: see FRONT)
			Places.add P.Points[C].Y
			Places.add -P.Points[C].Z
			Normals.add -N.X
			Normals.add N.Y
			Normals.add -N.Z
		}
		for I in 1 to P.Faces[F].length - 2 {
			Tris.add First
			Tris.add First + (int)I
			Tris.add First + (int)I + 1
		}
	}
	int Count = (int)(Places.length / 3)
	list double Low = {0, 0, 0}
	list double High = {0, 0, 0}
	for I in Count {
		for K in 3 {
			double V = Places[3 * I + K]
			if I == 0 || V < Low[K] {
				Low[K] = V
			}
			if I == 0 || V > High[K] {
				High[K] = V
			}
		}
	}
	add_view Gltf, Bin, Places, Count, "VEC3", Low, High
	add_view Gltf, Bin, Normals, Count, "VEC3", Low, High
	long At = Bin.length
	for T in Tris {
		Bin.add_int T
	}
	json View = json.lookup
	View["buffer"] = 0
	View["byteOffset"] = At
	View["byteLength"] = Bin.length - At
	View["target"] = 34963
	Gltf["bufferViews"].add View
	json Indices = json.lookup
	Indices["bufferView"] = Gltf["bufferViews"].length - 1
	Indices["componentType"] = 5125
	Indices["count"] = Tris.length
	Indices["type"] = "SCALAR"
	Gltf["accessors"].add Indices
	int Base = (int)Gltf["accessors"].length - 3
	json Attributes = json.lookup
	Attributes["POSITION"] = Base
	Attributes["NORMAL"] = Base + 1
	json Primitive = json.lookup
	Primitive["attributes"] = Attributes
	Primitive["indices"] = Base + 2
	Primitive["material"] = Index
	json Primitives = json.list
	Primitives.add Primitive
	json Mesh = json.lookup
	Mesh["name"] = P.Name.copy
	Mesh["primitives"] = Primitives
	Gltf["meshes"].add Mesh
	json Light = json.list
	for V in light_of P.Color {
		Light.add V
	}
	Light.add 1
	json Pbr = json.lookup
	Pbr["baseColorFactor"] = Light
	Pbr["metallicFactor"] = 0
	Pbr["roughnessFactor"] = 1
	json Material = json.lookup
	Material["name"] = P.Name.copy
	Material["pbrMetallicRoughness"] = Pbr
	Gltf["materials"].add Material
	json At3 = json.list
	At3.add -P.AtX
	At3.add P.AtY
	At3.add -P.AtZ
	json Node = json.lookup
	Node["name"] = P.Name.copy
	Node["mesh"] = Index
	Node["translation"] = At3
	Gltf["nodes"].add Node
	Gltf["scenes"][0]["nodes"].add Index
}

// Numbers as floats in Bin, a buffer view of them and an accessor
// (Count of Kind: "VEC3"), Low and High each way (for a place, as glTF
// asks)
static void add_view json &Gltf, bytes &Bin, const list double &Numbers, int Count, const str &Kind, const list double &Low, const list double &High {
	long At = Bin.length
	for V in Numbers {
		Bin.add_float V
	}
	json View = json.lookup
	View["buffer"] = 0
	View["byteOffset"] = At
	View["byteLength"] = Bin.length - At
	View["target"] = 34962
	Gltf["bufferViews"].add View
	json Accessor = json.lookup
	Accessor["bufferView"] = Gltf["bufferViews"].length - 1
	Accessor["componentType"] = 5126
	Accessor["count"] = Count
	Accessor["type"] = Kind
	if Gltf["accessors"].length % 3 == 0 {   // (a place's: its bounds)
		json Min = json.list
		json Max = json.list
		for K in 3 {
			Min.add Low[K]
			Max.add High[K]
		}
		Accessor["min"] = Min
		Accessor["max"] = Max
	}
	Gltf["accessors"].add Accessor
}

void save_parts_glb const list part &Parts, const str &Path {
	json Gltf = json.lookup
	json Asset = json.lookup
	Asset["version"] = "2.0"
	Asset["generator"] = "Kiln (Cabby)"
	Gltf["asset"] = Asset
	Gltf["scene"] = 0
	json Scene = json.lookup
	Scene["nodes"] = json.list
	Gltf["scenes"] = json.list
	Gltf["scenes"].add Scene
	Gltf["nodes"] = json.list
	Gltf["meshes"] = json.list
	Gltf["materials"] = json.list
	Gltf["accessors"] = json.list
	Gltf["bufferViews"] = json.list
	bytes Bin
	for I in Parts.length {
		write_part Parts[I], (int)I, Bin, Gltf
	}
	pad_to_four Bin, 0
	json Buffer = json.lookup
	Buffer["byteLength"] = Bin.length
	Gltf["buffers"] = json.list
	Gltf["buffers"].add Buffer
	bytes Text = Gltf.text
	pad_to_four Text, 32
	bytes File
	File.add_bytes "glTF"
	File.add_int 2
	File.add_int 12 + 8 + Text.length + 8 + Bin.length
	File.add_int Text.length
	File.add_bytes "JSON"
	File.add_bytes Text
	File.add_int Bin.length
	File.add_int 0x004e4942        // "BIN\0"
	File.add_bytes Bin
	files.write_bytes Path, File
}

// ---- reading one

// an accessor's numbers: Count items of Size each (floats), or (indices)
// whole numbers of whatever size the file keeps them
static list double numbers_of const json &Gltf, const bytes &Bin, int Which {
	json Accessor = Gltf["accessors"][Which]
	json View = Gltf["bufferViews"][Accessor["bufferView"].long]
	long At = View["byteOffset"].long_or(0) + Accessor["byteOffset"].long_or(0)
	long Count = Accessor["count"].long
	int Kind = (int)Accessor["componentType"].long
	str Type = Accessor["type"].str
	int Size = 1
	if Type == "VEC2" {
		Size = 2
	} else if Type == "VEC3" {
		Size = 3
	} else if Type == "VEC4" {
		Size = 4
	}
	int Each = 4
	if Kind == 5121 {
		Each = 1
	} else if Kind == 5123 {
		Each = 2
	}
	long Stride = View["byteStride"].long_or Size * Each
	list double Out
	for I in Count {
		for K in Size {
			long Here = At + I * Stride + K * Each
			if Kind == 5126 {
				Out.add Bin.float_at(Here)
			} else if Kind == 5121 {
				Out.add Bin[Here]
			} else if Kind == 5123 {
				Out.add Bin.short_at(Here) & 0xffff
			} else {
				Out.add Bin.unsigned_int_at(Here)
			}
		}
	}
	return Out
}

// a mesh's primitives as one part: corners in the same place made one
// again, and triangles that were one flat face (as Kiln writes a face of
// four corners, or more: a fan from its first) joined back into it
static part read_mesh const json &Gltf, const bytes &Bin, const json &Mesh {
	part P = {.Name = Mesh["name"].str_or("mesh"), .Color = "#c8c8c8"}
	lookup str int Where
	for Primitive in Mesh["primitives"] {
		if Primitive["mode"].long_or(4) != 4 {
			continue
		}
		list double Places = numbers_of Gltf, Bin, (int)Primitive["attributes"]["POSITION"].long
		list int Mine
		for I in Places.length / 3 {
			double X = -Places[3 * I]       // (turned round: see FRONT)
			double Y = Places[3 * I + 1]
			double Z = -Places[3 * I + 2]
			str Key = ((long)(X * 100000)).text + " " + ((long)(Y * 100000)).text + " " + ((long)(Z * 100000)).text
			if !Where.contains(Key) {
				Where[Key] = P.add_point X, Y, Z
			}
			Mine.add Where[Key]
		}
		list int Order
		if Primitive.has "indices" {
			for V in numbers_of Gltf, Bin, (int)Primitive["indices"].long {
				Order.add (int)V
			}
		} else {
			for I in Mine.length {
				Order.add (int)I
			}
		}
		list int Fan
		for I in Order.length / 3 {
			int A = Mine[Order[3 * I]]
			int B = Mine[Order[3 * I + 1]]
			int C = Mine[Order[3 * I + 2]]
			if Fan.length > 0 && A == Fan[0] && B == Fan[Fan.length - 1] && flat_with(P, Fan, C) {
				Fan.add C                   // (the next triangle of the same fan)
			} else {
				if Fan.length >= 3 {
					P.add_face Fan
				}
				Fan = {A, B, C}
			}
		}
		if Fan.length >= 3 {
			P.add_face Fan
		}
		if Primitive.has("material") && P.Color == "#c8c8c8" {
			json Material = Gltf["materials"][Primitive["material"].long]
			if Material["pbrMetallicRoughness"].has "baseColorFactor" {
				json Light = Material["pbrMetallicRoughness"]["baseColorFactor"]
				P.Color = color_of Light[0].double, Light[1].double, Light[2].double
			}
		}
	}
	return P
}

// whether C is in the same flat plane as the face so far
static bool flat_with const part &P, const list int &Fan, int C {
	point3 A = P.Points[Fan[0]]
	point3 B = P.Points[Fan[1]]
	point3 D = P.Points[Fan[2]]
	point3 E = P.Points[C]
	double Ux = B.X - A.X
	double Uy = B.Y - A.Y
	double Uz = B.Z - A.Z
	double Vx = D.X - A.X
	double Vy = D.Y - A.Y
	double Vz = D.Z - A.Z
	double Nx = Uy * Vz - Uz * Vy
	double Ny = Uz * Vx - Ux * Vz
	double Nz = Ux * Vy - Uy * Vx
	double Long = sqrt Nx * Nx + Ny * Ny + Nz * Nz
	if Long < 0.000000001 {
		return false
	}
	double Off = ((E.X - A.X) * Nx + (E.Y - A.Y) * Ny + (E.Z - A.Z) * Nz) / Long
	return Off < 0.0001 && Off > -0.0001
}

scene load_glb const str &Path {
	bytes File = files.read_bytes Path
	scene S
	long JsonLength = File.unsigned_int_at 12
	json Gltf = json.read File.part(20, JsonLength).str
	bytes Bin
	long BinAt = 20 + JsonLength
	if File.length > BinAt + 8 {
		Bin = File.part BinAt + 8, File.unsigned_int_at(BinAt)
	}
	for Node in Gltf["nodes"] {
		if !Node.has "mesh" {
			continue
		}
		part P = read_mesh Gltf, Bin, Gltf["meshes"][Node["mesh"].long]
		if Node.has "name" {
			P.Name = Node["name"].str
		}
		if Node.has "scale" {
			list int All = P.all_points
			point3 Zero = {0, 0, 0}
			P.scale_points All, Node["scale"][0].double, Node["scale"][1].double, Node["scale"][2].double, Zero
		}
		if Node.has "translation" {
			P.AtX = -Node["translation"][0].double
			P.AtY = Node["translation"][1].double
			P.AtZ = -Node["translation"][2].double
		}
		P.Name = S.free_name P.Name
		S.Parts.add P
	}
	return S
}
