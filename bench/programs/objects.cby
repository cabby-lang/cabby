object shape {
	int Size
	long area const {
		return 0
	}
}

object square : shape {
	long area const {
		return (long)Size * Size
	}
}

object triangle : shape {
	long area const {
		return (long)Size * Size / 2
	}
}

long measure const shape &s {
	return s.area
}

int main {
	int n = @N@
	long Total = 0
	for i in n {
		if i % 2 == 0 {
			square s = {.Size = i % 100}
			Total += measure s
		} else {
			triangle t = {.Size = i % 100}
			Total += measure t
		}
	}
	println Total
}
