extern int cby_game_key_hold long win, str name
extern int cby_game_key_release long win, str name
extern int cby_game_key_held_for long win, str name
extern long cby_game_sprite_picture long win, str path, double x, double y
extern long cby_game_sprite_rectangle long win, double width, double height, str color, double x, double y
extern long cby_game_sprite_circle long win, double radius, str color, double x, double y
extern double cby_game_sprite_x long sprite
extern double cby_game_sprite_y long sprite
extern double cby_game_sprite_angle long sprite
extern double cby_game_sprite_scale long sprite
extern int cby_game_sprite_visible long sprite
extern int cby_game_sprite_removed long sprite
extern double cby_game_sprite_width long sprite
extern double cby_game_sprite_height long sprite
