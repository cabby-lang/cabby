extern void cby_game_sprite_move long sprite, double dx, double dy
extern void cby_game_sprite_move_forward long sprite, double distance
extern void cby_game_sprite_set_angle long sprite, double degrees
extern void cby_game_sprite_turn long sprite, double degrees
extern void cby_game_sprite_set_scale long sprite, double scale
extern void cby_game_sprite_set_visible long sprite, int on
