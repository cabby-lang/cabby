// game.hby — games: a window with a stage, sprites on it, and frames.
//
//     use game
//
//     object catch_game : game.window {
//         game.sprite Basket
//
//         void build {
//             set_title "Catch"
//             set_size 480, 360
//             set_background "skyblue"
//             Basket = add_sprite "basket.png", 240, 330
//             on_frame step
//         }
//
//         void step {                          // 60 times a second
//             if key_hold "left" {
//                 Basket.move -5, 0
//             }
//         }
//     }
//
//     int main {
//         catch_game g
//         g.run
//     }
//
// A game.window is a window with a stage: the picture the game is played
// on, set_size big. Underneath is SDL 3, which draws with the graphics card;
// nothing here needs it. Its stage draws as a gui canvas does, with the
// same methods, and the window has gui's set_title, run, close, every,
// add_shortcut and show_message.
//
// Everything happens in frames, 60 a second: each frame, on_frame's handler
// runs, then any timers that are due, and the stage is drawn again. The
// keys are read in frames too: key_press is true in the frame a key went
// down, key_hold in every frame it's held, key_release in the frame it was
// let go.
//
// The full reference is game.md, next to this file.

use time

// ---- the C side (runtime/game.c); use the objects below instead

extern long cby_game_window_new void
extern void cby_game_set_title long win, str title
extern void cby_game_run long win
extern void cby_game_close long win
