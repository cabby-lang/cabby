extern void cby_game_stage_rectangle long win, double x, double y, double w, double h, int filled
extern void cby_game_stage_ellipse long win, double x, double y, double rx, double ry, int filled
extern void cby_game_stage_arc long win, double x, double y, double r, double start, double finish
extern void cby_game_stage_corner long win, double x, double y
extern void cby_game_stage_polygon long win, int filled, long numbers
extern void cby_game_stage_text long win, double x, double y, str text
extern double cby_game_stage_text_width long win, str text
extern double cby_game_stage_line_height long win
extern int cby_game_stage_lines_for long win, double width, str text
extern int cby_game_stage_write_wrapped long win, double x, double y, double width, str text
extern void cby_game_stage_image long win, double x, double y, str path
extern void cby_game_stage_save long win, str path
extern int cby_game_stage_mouse_x long win
extern int cby_game_stage_mouse_y long win
extern long cby_game_stage_key_length long win
extern void cby_game_stage_on_click long win, handler h
extern void cby_game_stage_on_mouse_move long win, handler h
extern void cby_game_stage_on_key long win, handler h

extern void cby_game_set_size long win, int width, int height
extern int cby_game_width long win
extern int cby_game_height long win
extern void cby_game_set_background long win, str spec
extern void cby_game_on_frame long win, handler h
extern long cby_game_frame long win
