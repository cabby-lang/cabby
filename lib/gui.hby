extern void cby_gui_canvas_line long canvas, double x1, double y1, double x2, double y2
extern void cby_gui_canvas_rectangle long canvas, double x, double y, double w, double h, int filled
extern void cby_gui_canvas_ellipse long canvas, double x, double y, double rx, double ry, int filled
extern void cby_gui_canvas_arc long canvas, double x, double y, double r, double start, double finish
extern void cby_gui_canvas_corner long canvas, double x, double y
