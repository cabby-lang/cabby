extern long cby_gui_table_cell_length long table, int row, int column
extern char cby_gui_table_cell_char long table, long i
extern void cby_gui_table_remove_row long table, int row
extern void cby_gui_table_clear long table
extern int cby_gui_table_rows long table
extern int cby_gui_table_columns long table
