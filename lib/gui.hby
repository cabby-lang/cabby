// gui.hby — windows and everything in them.
//
//     use gui
//
//     object greeter : gui.window {
//         gui.label Message
//         void build {
//             set_title "Hello"
//             Message = add_label "Nobody has clicked yet"
//             gui.button Button = add_button "Click me"
//             Button.on_click clicked
//         }
//         void clicked {
//             Message.set_text "Thank you!"
//         }
//     }
//
//     int main {
//         greeter g
//         g.run
//     }
//
// A window's things stack top to bottom in the order they are added; a
// row (add_row) puts things side by side, and a column (add_column) stacks
// them inside a row. `run` shows the window, calls handlers as things
// happen, and returns when the window is closed.
//
// The full reference is gui.md, next to this file.

use time
use images
//
// Underneath is GTK 4 (through libcabbygui), but nothing here needs it.

// ---- the C side (runtime/gui.c); use the objects below instead

extern long cby_gui_window_new void
extern long cby_gui_window_box long win
extern void cby_gui_window_set_title long win, str title
extern void cby_gui_window_set_size long win, int width, int height
extern void cby_gui_window_run long win
extern void cby_gui_window_close long win
