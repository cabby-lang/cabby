// screens.hby — the monitors: what each one shows, and changing it
// (resolution, refresh, rotation, scale, where it sits, on or off), the
// same way on Linux and macOS.
//
//     use screens
//
//     for S in screens.all {
//         println S.name, S.width, "x", S.height, "at", S.refresh, "Hz"
//     }
//     screens.screen Side = screens.named "HDMI-A-1"
//     Side.set_rotation 90
//
// Each desktop keeps these settings its own way, so each is asked its
// own way: Sway by swaymsg; GNOME by Mutter, over D-Bus (as its Settings
// app does); KDE Plasma by kscreen-doctor; any other desktop on X11 by
// xrandr; macOS by CoreGraphics. Another Wayland compositor has no way
// Cabby knows (screens.all is empty, and can_change false).
//
// The full reference is screens.md, next to this file.

use addresses
use dbus
use json

// ---- the C side (runtime/desktop.c)

extern long cby_desktop_kind void
extern long cby_desktop_capture str line, str input, int has_input
extern void cby_desktop_take_text address char dst
extern long cby_screens_mac_count void
extern long cby_screens_mac_number long i, long what
extern long cby_screens_mac_mode long i, long m, long what
extern int cby_screens_mac_set long i, long m, long x, long y

// What a program prints, run with its arguments (each after a "\x1f"):
// "\x1e" (which nothing prints) if it couldn't be run or didn't work.
static str screens_run const str &Line {
	long Length = cby_desktop_capture Line, "", 0
	if Length < 0 {
		return "\x1e"
	}
	str Text = " ".repeat Length
	address char Room = addresses.of_text Text
	cby_desktop_take_text Room
	return Text
}

// true if the program ran and worked
static bool screens_do const str &Line {
	return screens_run(Line) != "\x1e"
}

// a number in text, or Otherwise if it isn't one
static double screens_number const str &Text, double Otherwise {
	str T = Text.trim
	if T.is_number {
		return T.to_double
	}
	return Otherwise
}

// a refresh rate as a mode names it: 60, or 59.94
static str screens_hz double Hz {
	double Whole = (double)(long)(Hz + 0.5)
	if close_to Hz, Whole, 0.005 {
		return ((long)Whole).text
	}
	return Hz.text 2
}

// ---- Mutter's (GNOME's) monitors, over D-Bus

static const str screens_mutter = "org.gnome.Mutter.DisplayConfig"
static const str screens_mutter_path = "/org/gnome/Mutter/DisplayConfig"

// Mutter's GetCurrentState: [serial, monitors, logical monitors, its
// own settings] (an empty list if there's no Mutter)
static json screens_gnome_state {
	dbus.bus Bus = dbus.try_session
	if !Bus.is_open {
		return json.list
	}
	dbus.message M = dbus.method_call screens_mutter, screens_mutter_path, screens_mutter, "GetCurrentState"
	json Answer = Bus.try_call M
	return Answer
}

// the logical monitor (a place on the desktop) showing Connector, or -1
static long screens_gnome_logical const json &State, const str &Connector {
	json Logical = State[2]
	for long L = 0; L < Logical.length; L++ {
		json Shows = Logical.item_at(L).item_at 5
		for long K = 0; K < Shows.length; K++ {
			if Shows.item_at(K).item_at(0).str_or("") == Connector {
				return L
			}
		}
	}
	return -1
}

// the monitor named Connector in Mutter's list, or -1
static long screens_gnome_monitor const json &State, const str &Connector {
	json Monitors = State[1]
	for long I = 0; I < Monitors.length; I++ {
		if Monitors.item_at(I).item_at(0).item_at(0).str_or("") == Connector {
			return I
		}
	}
	return -1
}

// the id of Connector's current mode ("" if it's off), or of its
// preferred one when Preferred is true
static str screens_gnome_mode_id const json &State, const str &Connector, bool Preferred {
	long I = screens_gnome_monitor State, Connector
	if I < 0 {
		return ""
	}
	json Modes = State[1].item_at(I).item_at 1
	str Want = "is-current"
	if Preferred {
		Want = "is-preferred"
	}
	for long M = 0; M < Modes.length; M++ {
		json Mode = Modes.item_at M
		if Mode.item_at(6)[Want].bool_or false {
			return Mode.item_at(0).str_or ""
		}
	}
	if Preferred && Modes.length > 0 {
		return Modes.item_at(0).item_at(0).str_or ""
	}
	return ""
}

// One logical monitor, for ApplyMonitorsConfig: its place, scale, turn,
// whether it's the main one, and its monitors with their modes.
object screens_gnome_place {
	inner long X
	inner long Y
	inner double Scale
	inner long Turn
	inner bool Main
	inner list str Connectors
	inner list str Modes

	void fill long Px, long Py, double S, long T, bool M {
		X = Px
		Y = Py
		Scale = S
		Turn = T
		Main = M
	}

	void add_monitor const str &Connector, const str &Mode {
		Connectors.add Connector.copy
		Modes.add Mode.copy
	}

	bool shows const str &Connector const {
		return Connectors.contains Connector
	}

	// the first monitor it shows
	str first const {
		if Connectors.length == 0 {
			return ""
		}
		return Connectors[0].copy
	}

	void set_mode const str &Connector, const str &Mode {
		for long I = 0; I < Connectors.length; I++ {
			if Connectors[I] == Connector {
				Modes[I] = Mode.copy
			}
		}
	}

	void set_place long Px, long Py {
		X = Px
		Y = Py
	}

	void set_scale double S {
		Scale = S
	}

	void set_turn long T {
		Turn = T
	}

	long x const {
		return X
	}

	double scale const {
		return Scale
	}

	void add_to dbus.message &M const {
		M.begin_struct
		M.add_int X
		M.add_int Y
		M.add_double Scale
		M.add_uint Turn
		M.add_bool Main
		M.begin_list "(ssa{sv})"
		for long I = 0; I < Connectors.length; I++ {
			M.begin_struct
			M.add_str Connectors[I]
			M.add_str Modes[I]
			M.begin_lookup "s", "v"
			M.end_lookup
			M.end_struct
		}
		M.end_list
		M.end_struct
	}
}

// the logical monitors as they are now, to be changed and given back
static list screens_gnome_place screens_gnome_places const json &State {
	list screens_gnome_place Places
	json Logical = State[2]
	for long L = 0; L < Logical.length; L++ {
		json One = Logical.item_at L
		screens_gnome_place P
		P.fill(One.item_at(0).long_or(0), One.item_at(1).long_or(0), One.item_at(2).double_or(1.0),
			One.item_at(3).long_or(0), One.item_at(4).bool_or(false))
		json Shows = One.item_at 5
		for long K = 0; K < Shows.length; K++ {
			str Connector = Shows.item_at(K).item_at(0).str_or ""
			P.add_monitor Connector, screens_gnome_mode_id(State, Connector, false)
		}
		Places.add P
	}
	return Places
}

// asks Mutter to show Places, kept as Settings keeps them
static bool screens_gnome_apply const json &State, const list screens_gnome_place &Places {
	dbus.bus Bus = dbus.try_session
	if !Bus.is_open || Places.length == 0 {
		return false
	}
	dbus.message M = dbus.method_call screens_mutter, screens_mutter_path, screens_mutter, "ApplyMonitorsConfig"
	M.add_uint State[0].long_or(0)
	M.add_uint 2
	M.begin_list "(iiduba(ssa{sv}))"
	for P in Places {
		P.add_to M
	}
	M.end_list
	M.begin_lookup "s", "v"
	M.end_lookup
	json Answer = Bus.try_call M
	return Bus.error == ""
}

// Mutter's turns are 0 to 3, each a quarter turn clockwise
static long screens_gnome_turn long Degrees {
	return Degrees / 90 % 4
}

// the id of KDE's mode for Name nearest W by H at Hz ("" if none): its
// names round the refresh ("1920x1080@60" for 59.94 too), its ids don't
static str screens_kde_mode_id const str &Name, long W, long H, double Hz {
	str Said = screens_run "kscreen-doctor\x1f-j"
	if !json.can_read(Said) {
		return ""
	}
	json All = json.read(Said)["outputs"]
	str Best = ""
	double Gap = 1000.0
	for long I = 0; I < All.length; I++ {
		json O = All.item_at I
		if O["name"].str_or("") != Name {
			continue
		}
		json Modes = O["modes"]
		for long M = 0; M < Modes.length; M++ {
			json Mode = Modes.item_at M
			double Rate = Mode["refreshRate"].double_or 0
			if Mode["size"]["width"].long_or(0) == W && Mode["size"]["height"].long_or(0) == H && abs(Rate - Hz) < Gap {
				Gap = abs Rate - Hz
				Best = Mode["id"].str_or ""
			}
		}
	}
	return Best
}

// ---- one screen

// A monitor: what it shows now, and the modes (resolution and refresh)
// it can show. Made by screens.all, screens.named and screens.main.
object screens.screen {
	inner str Name
	inner str Description
	inner bool On
	inner bool Main
	inner long Width
	inner long Height
	inner double Refresh
	inner double Scale
	inner long X
	inner long Y
	inner int Rotation
	inner list long ModeWidths
	inner list long ModeHeights
	inner list double ModeRates
	inner long Index

	screens.screen {
		Scale = 1.0
		Index = -1
	}

	void fill_basics const str &N, const str &D, bool IsOn, bool IsMain {
		Name = N.copy
		Description = D.trim
		On = IsOn
		Main = IsMain
	}

	void fill_now long W, long H, double Hz, double S, long Px, long Py, int Turn {
		Width = W
		Height = H
		Refresh = Hz
		Scale = S
		X = Px
		Y = Py
		Rotation = Turn
	}

	void add_mode long W, long H, double Hz {
		for long I = 0; I < ModeWidths.length; I++ {
			if ModeWidths[I] == W && ModeHeights[I] == H && close_to(ModeRates[I], Hz, 0.005) {
				return
			}
		}
		ModeWidths.add W
		ModeHeights.add H
		ModeRates.add Hz
	}

	void set_index long I {
		Index = I
	}

	// false for a screens.named that found none
	bool found const {
		return Name != ""
	}

	// its name, as the system calls it: "DP-1", "HDMI-A-1", "eDP-1" (a
	// Mac's: "built-in", "display 2")
	str name const {
		return Name.copy
	}

	// what it is, where the system says: "Dell Inc. DELL U2720Q" ("" if
	// it doesn't)
	str description const {
		return Description.copy
	}

	// true if it's showing something (a monitor that's plugged in but
	// turned off is false)
	bool on const {
		return On
	}

	// true for the main one: the one with the menu bar (a Mac), the
	// primary one (GNOME, KDE, X11), or the one in use (Sway)
	bool main const {
		return Main
	}

	// its resolution, in pixels, as the monitor shows it (before it's
	// turned): 2560 and 1440; 0 when it's off
	long width const {
		return Width
	}

	long height const {
		return Height
	}

	// how many times a second it's drawn: 60.0, 143.97
	double refresh const {
		return Refresh
	}

	// how much bigger things are drawn: 1.0, 1.5, 2.0
	double scale const {
		return Scale
	}

	// where its top left corner is on the desktop
	long x const {
		return X
	}

	long y const {
		return Y
	}

	// how far it's turned, clockwise: 0, 90, 180 or 270
	int rotation const {
		return Rotation
	}

	// the modes it can show: "2560x1440@60", "1920x1080@59.94"
	list str modes const {
		list str Texts
		for long I = 0; I < ModeWidths.length; I++ {
			Texts.add ModeWidths[I].text + "x" + ModeHeights[I].text + "@" + screens_hz(ModeRates[I])
		}
		return Texts
	}

	// "DP-1: 2560x1440 at 60 Hz, at 0,0" (or "DP-1: off")
	str text const {
		if !On {
			return Name + ": off"
		}
		str T = Name + ": " + Width.text + "x" + Height.text + " at " + screens_hz(Refresh) + " Hz"
		if !close_to(Scale, 1.0, 0.001) {
			T += ", scale " + Scale.text
		}
		if Rotation != 0 {
			T += ", turned " + Rotation.text
		}
		return T + ", at " + X.text + "," + Y.text
	}

	// the best refresh it has for W by H, or 0 if it has no such mode
	double best_rate long W, long H const {
		double Best = 0.0
		for long I = 0; I < ModeWidths.length; I++ {
			if ModeWidths[I] == W && ModeHeights[I] == H && ModeRates[I] > Best {
				Best = ModeRates[I]
			}
		}
		return Best
	}

	// the refresh it has for W by H nearest Hz, or 0
	double nearest_rate long W, long H, double Hz const {
		double Best = 0.0
		for long I = 0; I < ModeWidths.length; I++ {
			if ModeWidths[I] == W && ModeHeights[I] == H && (Best == 0 || abs(ModeRates[I] - Hz) < abs(Best - Hz)) {
				Best = ModeRates[I]
			}
		}
		return Best
	}

	// reads it again, after a change
	void read_again {
		for S in screens.all {
			if S.name == Name {
				Description = S.description
				On = S.on
				Main = S.main
				fill_now S.width, S.height, S.refresh, S.scale, S.x, S.y, S.rotation
				Index = S.index
				return
			}
		}
	}

	long index const {
		return Index
	}

	// Changes: each gives true if it was done, and the screen is then read
	// again. What a desktop can't do gives false: X11 has no scale, and a
	// Mac can't be turned or turned off from outside its own settings.

	// shows W by H pixels, at the best refresh it has for them
	bool set_resolution long W, long H {
		double Hz = best_rate W, H
		if Hz == 0 {
			return false
		}
		return set_mode W, H, Hz
	}

	// draws it Hz times a second, at the resolution it has now (the
	// nearest it has to Hz)
	bool set_refresh double Hz {
		double Rate = nearest_rate Width, Height, Hz
		if Rate == 0 {
			return false
		}
		return set_mode Width, Height, Rate
	}

	bool set_mode long W, long H, double Hz {
		long Kind = cby_desktop_kind
		bool Done = false
		str Size = W.text + "x" + H.text
		if Kind == 1 {
			Done = screens_do "swaymsg\x1foutput\x1f" + Name + "\x1fmode\x1f" + Size + "@" + Hz.text(3) + "Hz"
		} else if Kind == 2 {
			Done = screens_gnome_change Name, "mode", Size + "@" + Hz.text(3)
		} else if Kind == 3 {
			str Id = screens_kde_mode_id Name, W, H, Hz
			Done = Id != "" && screens_do("kscreen-doctor\x1foutput." + Name + ".mode." + Id)
		} else if Kind == 4 {
			Done = screens_do "xrandr\x1f--output\x1f" + Name + "\x1f--mode\x1f" + Size + "\x1f--rate\x1f" + Hz.text(2)
		} else if Kind == 5 {
			for long M = 0; M < cby_screens_mac_number(Index, 10); M++ {
				if cby_screens_mac_mode(Index, M, 0) == W && cby_screens_mac_mode(Index, M, 1) == H &&
				close_to((double)cby_screens_mac_mode(Index, M, 2) / 1000, Hz, 0.01) {
					Done = cby_screens_mac_set(Index, M, 0, 0) != 0
					break
				}
			}
		}
		if Done {
			read_again
		}
		return Done
	}

	// turns it clockwise: 0, 90, 180 or 270 degrees (for a monitor on its
	// side, 90 or 270)
	bool set_rotation int Degrees {
		if Degrees % 90 != 0 || Degrees < 0 || Degrees > 270 {
			return false
		}
		long Kind = cby_desktop_kind
		list str Sway = {"normal", "90", "180", "270"}
		list str Words = {"normal", "right", "inverted", "left"}
		list str Kde = {"none", "right", "inverted", "left"}
		long Turn = Degrees / 90
		bool Done = false
		if Kind == 1 {
			Done = screens_do "swaymsg\x1foutput\x1f" + Name + "\x1ftransform\x1f" + Sway[Turn]
		} else if Kind == 2 {
			Done = screens_gnome_change Name, "rotation", Turn.text
		} else if Kind == 3 {
			Done = screens_do "kscreen-doctor\x1foutput." + Name + ".rotation." + Kde[Turn]
		} else if Kind == 4 {
			Done = screens_do "xrandr\x1f--output\x1f" + Name + "\x1f--rotate\x1f" + Words[Turn]
		}
		if Done {
			read_again
		}
		return Done
	}

	// draws things Times bigger: 1.0, 1.25, 1.5, 2.0 (GNOME allows only
	// the scales a mode lists; X11 has none)
	bool set_scale double Times {
		if Times <= 0 {
			return false
		}
		long Kind = cby_desktop_kind
		bool Done = false
		if Kind == 1 {
			Done = screens_do "swaymsg\x1foutput\x1f" + Name + "\x1fscale\x1f" + Times.text
		} else if Kind == 2 {
			Done = screens_gnome_change Name, "scale", Times.text
		} else if Kind == 3 {
			Done = screens_do "kscreen-doctor\x1foutput." + Name + ".scale." + Times.text
		}
		if Done {
			read_again
		}
		return Done
	}

	// puts its top left corner at Px, Py on the desktop
	bool set_position long Px, long Py {
		long Kind = cby_desktop_kind
		bool Done = false
		if Kind == 1 {
			Done = screens_do "swaymsg\x1foutput\x1f" + Name + "\x1fposition\x1f" + Px.text + "\x1f" + Py.text
		} else if Kind == 2 {
			Done = screens_gnome_change Name, "position", Px.text + "," + Py.text
		} else if Kind == 3 {
			Done = screens_do "kscreen-doctor\x1foutput." + Name + ".position." + Px.text + "," + Py.text
		} else if Kind == 4 {
			Done = screens_do "xrandr\x1f--output\x1f" + Name + "\x1f--pos\x1f" + Px.text + "x" + Py.text
		} else if Kind == 5 {
			Done = cby_screens_mac_set(Index, -1, Px, Py) != 0
		}
		if Done {
			read_again
		}
		return Done
	}

	// turns it on (at its preferred mode, on the right of the others) or
	// off (not the last one that's on)
	bool turn_on {
		return switch_to true
	}

	bool turn_off {
		long Others = 0
		for S in screens.all {
			if S.on && S.name != Name {
				Others++
			}
		}
		if Others == 0 {
			return false
		}
		return switch_to false
	}

	bool switch_to bool Yes {
		long Kind = cby_desktop_kind
		bool Done = false
		if Kind == 1 {
			str How = "disable"
			if Yes {
				How = "enable"
			}
			Done = screens_do "swaymsg\x1foutput\x1f" + Name + "\x1f" + How
		} else if Kind == 2 {
			str How = "off"
			if Yes {
				How = "on"
			}
			Done = screens_gnome_change Name, How, ""
		} else if Kind == 3 {
			str How = "disable"
			if Yes {
				How = "enable"
			}
			Done = screens_do "kscreen-doctor\x1foutput." + Name + "." + How
		} else if Kind == 4 {
			str How = "--off"
			if Yes {
				How = "--auto"
			}
			Done = screens_do "xrandr\x1f--output\x1f" + Name + "\x1f" + How
		}
		if Done {
			read_again
		}
		return Done
	}
}

// Changes Connector's logical monitor in Mutter's layout: What is "mode"
// (Value "2560x1440@59.951"), "rotation" (0 to 3), "scale", "position"
// ("x,y"), "on" or "off".
static bool screens_gnome_change const str &Connector, const str &What, const str &Value {
	json State = screens_gnome_state
	if State.length < 4 || screens_gnome_monitor(State, Connector) < 0 {
		return false
	}
	list screens_gnome_place Places = screens_gnome_places State
	long At = screens_gnome_logical State, Connector
	if What == "on" {
		if At >= 0 {
			return true
		}
		long Right = 0
		for long L = 0; L < Places.length; L++ {
			screens.screen S = screens.named Places[L].first
			if S.found {
				long Edge = S.x + (long)((double)S.width / S.scale)
				if S.rotation == 90 || S.rotation == 270 {
					Edge = S.x + (long)((double)S.height / S.scale)
				}
				if Edge > Right {
					Right = Edge
				}
			}
		}
		json Monitor = State[1].item_at screens_gnome_monitor(State, Connector)
		str Mode = screens_gnome_mode_id State, Connector, true
		double Scale = 1.0
		json Modes = Monitor.item_at 1
		for long M = 0; M < Modes.length; M++ {
			if Modes.item_at(M).item_at(0).str_or("") == Mode {
				Scale = Modes.item_at(M).item_at(4).double_or 1.0
			}
		}
		screens_gnome_place P
		P.fill Right, 0, Scale, 0, false
		P.add_monitor Connector, Mode
		Places.add P
		return screens_gnome_apply State, Places
	}
	if At < 0 {
		return false
	}
	if What == "off" {
		Places.remove_at At
		return screens_gnome_apply State, Places
	}
	if What == "mode" {
		// Mutter's ids are its own ("2560x1440@59.951"): the one nearest
		json Modes = State[1].item_at(screens_gnome_monitor(State, Connector)).item_at 1
		long X = Value.find "x"
		long Atsign = Value.find "@"
		long W = Value[to X - 1].to_long
		long H = Value[X + 1 to Atsign - 1].to_long
		double Hz = Value[Atsign + 1 to].to_double
		str Best = ""
		long BestAt = -1
		double Gap = 1000.0
		for long M = 0; M < Modes.length; M++ {
			json Mode = Modes.item_at M
			if Mode.item_at(1).long_or(0) == W && Mode.item_at(2).long_or(0) == H &&
			abs(Mode.item_at(3).double_or(0) - Hz) < Gap {
				Gap = abs Mode.item_at(3).double_or(0) - Hz
				Best = Mode.item_at(0).str_or ""
				BestAt = M
			}
		}
		if Best == "" {
			return false
		}
		Places[At].set_mode Connector, Best
		// a scale the new mode allows: the one now if it can, or else its own
		json Scales = Modes.item_at(BestAt).item_at 5
		bool Keeps = false
		for long K = 0; K < Scales.length; K++ {
			if close_to Scales.item_at(K).double_or(0), Places[At].scale, 0.01 {
				Keeps = true
			}
		}
		if !Keeps {
			Places[At].set_scale Modes.item_at(BestAt).item_at(4).double_or(1.0)
		}
	} else if What == "rotation" {
		Places[At].set_turn Value.to_long
	} else if What == "scale" {
		// only a scale the mode lists
		double Want = Value.to_double
		json Modes = State[1].item_at(screens_gnome_monitor(State, Connector)).item_at 1
		str Current = screens_gnome_mode_id State, Connector, false
		bool Allowed = false
		for long M = 0; M < Modes.length; M++ {
			json Mode = Modes.item_at M
			if Mode.item_at(0).str_or("") == Current {
				json Scales = Mode.item_at 5
				for long K = 0; K < Scales.length; K++ {
					if close_to Scales.item_at(K).double_or(0), Want, 0.01 {
						Want = Scales.item_at(K).double_or Want
						Allowed = true
					}
				}
			}
		}
		if !Allowed {
			return false
		}
		Places[At].set_scale Want
	} else if What == "position" {
		long Comma = Value.find ","
		Places[At].set_place Value[to Comma - 1].to_long, Value[Comma + 1 to].to_long
	}
	return screens_gnome_apply State, Places
}

// ---- reading them, each desktop's way

// Sway's: swaymsg's list of outputs, as json
static list screens.screen screens_sway {
	list screens.screen Found
	str Said = screens_run "swaymsg\x1f-t\x1fget_outputs\x1f-r"
	if !json.can_read(Said) {
		return Found
	}
	json All = json.read Said
	for long I = 0; I < All.length; I++ {
		json O = All.item_at I
		screens.screen S
		str Make = O["make"].str_or ""
		str Model = O["model"].str_or ""
		if Make == "Unknown" {
			Make = ""
		}
		if Model == "Unknown" {
			Model = ""
		}
		bool IsOn = O["active"].bool_or false
		S.fill_basics O["name"].str_or(""), Make + " " + Model, IsOn, O["focused"].bool_or(false)
		str Transform = O["transform"].str_or "normal"
		int Turn = 0
		if Transform.ends_with "90" {
			Turn = 90
		} else if Transform.ends_with "180" {
			Turn = 180
		} else if Transform.ends_with "270" {
			Turn = 270
		}
		if IsOn {
			json Mode = O["current_mode"]
			json Rect = O["rect"]
			S.fill_now(Mode["width"].long_or(0), Mode["height"].long_or(0), (double)Mode["refresh"].long_or(0) / 1000,
				O["scale"].double_or(1.0), Rect["x"].long_or(0), Rect["y"].long_or(0), Turn)
		}
		json Modes = O["modes"]
		for long M = 0; M < Modes.length; M++ {
			json Mode = Modes.item_at M
			S.add_mode Mode["width"].long_or(0), Mode["height"].long_or(0), (double)Mode["refresh"].long_or(0) / 1000
		}
		Found.add S
	}
	return Found
}

// GNOME's: Mutter's monitors, and the logical monitors they're shown in
static list screens.screen screens_gnome {
	list screens.screen Found
	json State = screens_gnome_state
	if State.length < 4 {
		return Found
	}
	json Monitors = State[1]
	json Logical = State[2]
	for long I = 0; I < Monitors.length; I++ {
		json Mon = Monitors.item_at I
		str Connector = Mon.item_at(0).item_at(0).str_or ""
		str Shown = Mon.item_at(2)["display-name"].str_or Mon.item_at(0).item_at(1).str_or("") + " " + Mon.item_at(0).item_at(2).str_or("")
		long L = screens_gnome_logical State, Connector
		screens.screen S
		bool IsMain = false
		if L >= 0 {
			IsMain = Logical.item_at(L).item_at(4).bool_or false
		}
		S.fill_basics Connector, Shown, L >= 0, IsMain
		json Modes = Mon.item_at 1
		for long M = 0; M < Modes.length; M++ {
			json Mode = Modes.item_at M
			long W = Mode.item_at(1).long_or 0
			long H = Mode.item_at(2).long_or 0
			double Hz = Mode.item_at(3).double_or 0
			S.add_mode W, H, Hz
			if L >= 0 && Mode.item_at(6)["is-current"].bool_or(false) {
				json Place = Logical.item_at L
				S.fill_now(W, H, Hz, Place.item_at(2).double_or(1.0), Place.item_at(0).long_or(0), Place.item_at(1).long_or(0),
					(int)(Place.item_at(3).long_or(0) % 4 * 90))
			}
		}
		Found.add S
	}
	return Found
}

// KDE's: kscreen-doctor's json
static list screens.screen screens_kde {
	list screens.screen Found
	str Said = screens_run "kscreen-doctor\x1f-j"
	if !json.can_read(Said) {
		return Found
	}
	json All = json.read(Said)["outputs"]
	for long I = 0; I < All.length; I++ {
		json O = All.item_at I
		if !O["connected"].bool_or(false) {
			continue
		}
		screens.screen S
		bool IsOn = O["enabled"].bool_or false
		S.fill_basics O["name"].str_or(""), "", IsOn, O["priority"].long_or(0) == 1
		// rotation: 1 none, 2 left, 4 inverted, 8 right
		long R = O["rotation"].long_or 1
		int Turn = 0
		if R == 8 {
			Turn = 90
		} else if R == 4 {
			Turn = 180
		} else if R == 2 {
			Turn = 270
		}
		str Current = O["currentModeId"].str_or ""
		json Modes = O["modes"]
		for long M = 0; M < Modes.length; M++ {
			json Mode = Modes.item_at M
			long W = Mode["size"]["width"].long_or 0
			long H = Mode["size"]["height"].long_or 0
			double Hz = Mode["refreshRate"].double_or 0
			S.add_mode W, H, Hz
			if IsOn && Mode["id"].str_or("") == Current {
				S.fill_now W, H, Hz, O["scale"].double_or(1.0), O["pos"]["x"].long_or(0), O["pos"]["y"].long_or(0), Turn
			}
		}
		Found.add S
	}
	return Found
}

// X11's: what xrandr says. A monitor's line, then its modes:
//   HDMI-1 connected primary 1920x1080+0+0 left (normal left ...) 527mm x 296mm
//      1920x1080     60.00*+  50.00    59.94
static list screens.screen screens_x11 {
	list screens.screen Found
	str Said = screens_run "xrandr\x1f--query"
	if Said == "\x1e" {
		return Found
	}
	// a block for each monitor: its line, then its modes'
	list str Blocks
	for Line in Said.split "\n" {
		if !Line.starts_with(" ") {
			Blocks.add Line.copy
		} else if Blocks.length > 0 {
			str Last = Blocks.take_last
			Blocks.add Last + "\n" + Line
		}
	}
	for Block in Blocks {
		screens.screen S = screens_x11_one Block
		if S.found {
			Found.add S
		}
	}
	return Found
}

// one monitor's block of what xrandr says (found is false if it isn't
// connected)
static screens.screen screens_x11_one const str &Block {
	screens.screen S
	list str Lines = Block.split "\n"
	list str Words = Lines[0].split " "
	if Words.length < 2 || Words[1] != "connected" {
		return S
	}
	bool IsMain = false
	bool IsOn = false
	long Px = 0
	long Py = 0
	int Turn = 0
	for long W = 2; W < Words.length; W++ {
		str Word = Words[W].copy
		if Word.starts_with "(" {
			break
		}
		if Word == "primary" {
			IsMain = true
		} else if Word.contains("+") && Word.contains("x") {
			IsOn = true
			list str Parts = Word.replace("x", "+").split "+"
			if Parts.length == 4 && Parts[2].is_long && Parts[3].is_long {
				Px = Parts[2].to_long
				Py = Parts[3].to_long
			}
		} else if Word == "right" {
			Turn = 90
		} else if Word == "inverted" {
			Turn = 180
		} else if Word == "left" {
			Turn = 270
		}
	}
	S.fill_basics Words[0], "", IsOn, IsMain
	for long L = 1; L < Lines.length; L++ {
		// a mode: its size, then its refresh rates (* the one now)
		list str Parts
		for Word in Lines[L].trim.split " " {
			if Word != "" {
				Parts.add Word.copy
			}
		}
		if Parts.length < 2 || !Parts[0].contains("x") {
			continue
		}
		long X = Parts[0].find "x"
		str Wide = Parts[0][to X - 1]
		str High = Parts[0][X + 1 to]
		if High.ends_with "i" {
			High = High[to High.length - 2]
		}
		if !Wide.is_long || !High.is_long {
			continue
		}
		for long R = 1; R < Parts.length; R++ {
			str Rate = Parts[R].replace("*", "").replace "+", ""
			if !Rate.is_number {
				continue
			}
			S.add_mode Wide.to_long, High.to_long, Rate.to_double
			if IsOn && Parts[R].contains("*") {
				S.fill_now Wide.to_long, High.to_long, Rate.to_double, 1.0, Px, Py, Turn
			}
		}
	}
	return S
}

// a Mac's: CoreGraphics's screens in use
static list screens.screen screens_mac {
	list screens.screen Found
	long Count = cby_screens_mac_count
	for long I = 0; I < Count; I++ {
		screens.screen S
		str Named = "display " + (I + 1).text
		if cby_screens_mac_number(I, 8) != 0 {
			Named = "built-in"
		}
		S.fill_basics Named, "", true, cby_screens_mac_number(I, 7) != 0
		S.set_index I
		long W = cby_screens_mac_number I, 1
		long Points = cby_screens_mac_number I, 9
		double Scale = 1.0
		if Points > 0 {
			Scale = (double)W / Points
		}
		S.fill_now(W, cby_screens_mac_number(I, 2), (double)cby_screens_mac_number(I, 3) / 1000, Scale,
			cby_screens_mac_number(I, 4), cby_screens_mac_number(I, 5), (int)cby_screens_mac_number(I, 6))
		for long M = 0; M < cby_screens_mac_number(I, 10); M++ {
			S.add_mode cby_screens_mac_mode(I, M, 0), cby_screens_mac_mode(I, M, 1), (double)cby_screens_mac_mode(I, M, 2) / 1000
		}
		Found.add S
	}
	return Found
}

// ---- the screens

// every monitor plugged in, on or off (an empty list where there's no
// way Cabby knows of asking)
list screens.screen screens.all {
	long Kind = cby_desktop_kind
	if Kind == 1 {
		return screens_sway
	}
	if Kind == 2 {
		return screens_gnome
	}
	if Kind == 3 {
		return screens_kde
	}
	if Kind == 4 {
		return screens_x11
	}
	if Kind == 5 {
		return screens_mac
	}
	list screens.screen None
	return None
}

// the one with that name ("DP-1"); found is false if there's none
screens.screen screens.named const str &Name {
	list screens.screen All = screens.all
	while All.length > 0 {
		screens.screen S = All.take_last
		if S.name == Name {
			return S
		}
	}
	screens.screen None
	return None
}

// the main one (or else the first one that's on); found is false if
// there are none
screens.screen screens.main {
	list screens.screen All = screens.all
	for S in All {
		if S.main {
			return screens.named S.name
		}
	}
	for S in All {
		if S.on {
			return screens.named S.name
		}
	}
	screens.screen None
	return None
}

// how many are plugged in
long screens.count {
	return screens.all.length
}

// which desktop's way they're asked and changed: "sway", "gnome", "kde",
// "x11", "macos", or "" for none
str screens.desktop {
	list str Names = {"", "sway", "gnome", "kde", "x11", "macos"}
	return Names[cby_desktop_kind].copy
}

// true if there are screens here Cabby can change
bool screens.can_change {
	return cby_desktop_kind > 0 && screens.all.length > 0
}
