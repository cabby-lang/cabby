// secrets.hby — keeping things secret: random numbers no one can guess,
// passwords kept safely, text and files locked with a password, and
// signatures that show a message hasn't been changed.
//
//     use secrets
//
//     str Kept = secrets.hash_password "correct horse battery"   // keep this, not the password
//     if secrets.check_password(Typed, Kept) {
//         println "welcome back"
//     }
//
//     str Locked = secrets.lock "the safe's code is 4812", Password
//     println secrets.unlock(Locked, Password)
//
// It's built on a well-tested library, not on cryptography of Cabby's
// own: OpenSSL on Linux, a Mac's CommonCrypto. The full reference is
// secrets.md, next to this file.

use bytes

// ---- the C side (runtime/secrets.c); use the functions below instead

extern char cby_secrets_char long i
extern long cby_secrets_random_bytes long n
extern long cby_secrets_random_number long low, long high
extern long cby_secrets_random_text long n
extern long cby_secrets_random_password long n, int symbols
extern long cby_secrets_hash_password str password
extern int cby_secrets_check_password str password, str kept
extern int cby_secrets_same str a, str b
extern long cby_secrets_signature str text, long length, str key
extern long cby_secrets_lock_text str text, long length, str password
extern long cby_secrets_unlock_text str locked, str password
extern long cby_secrets_lock_bytes long data, str password
extern long cby_secrets_unlock_bytes long data, str password
extern void cby_secrets_lock_file str from, str into, str password
extern int cby_secrets_unlock_file str from, str into, str password
extern void cby_secrets_cant_unlock void
extern int cby_secrets_can_use_keys void
extern long cby_secrets_make_private_key void
extern long cby_secrets_public_key str private
extern long cby_secrets_sign str text, long length, str private
extern int cby_secrets_check_signed str text, long length, str public, str signature
extern int cby_secrets_can_use_argon2 void
extern long cby_secrets_hash_password_argon2 str password

str secrets_handed long Length {
	str s
	for i in Length {
		s += cby_secrets_char i
	}
	return s
}

// ---- random, as no one can guess (the system's own: for passwords,
// codes, keys; a game's dice can use the faster random of its own)

// a whole number from From to To, both included
long secrets.random_number long From, long To {
	return cby_secrets_random_number From, To
}

// that many random bytes
bytes secrets.random_bytes long Count {
	bytes B
	B.adopt cby_secrets_random_bytes(Count)
	return B
}

// random letters, digits, - and _, safe in a web address or a file's
// name: a code to sign in with, a name no one can guess (22 is as hard to
// guess as anything needs)
str secrets.random_text long Length {
	return secrets_handed cby_secrets_random_text(Length)
}

// a password for a person: small and capital letters, digits and symbols,
// at least one of each, without those that look alike (0 and O, 1 and l)
str secrets.random_password long Length {
	return secrets_handed cby_secrets_random_password(Length, 1)
}

// the same, without symbols (for where they're not allowed)
str secrets.random_password_without_symbols long Length {
	return secrets_handed cby_secrets_random_password(Length, 0)
}

// ---- passwords: kept as hashes, which can't be turned back into them

// The password, hashed: what to keep (in a file or a database) instead of
// the password itself. The same password hashes differently each time;
// check_password knows it either way. It takes a moment, on purpose: so
// guessing millions of passwords against a stolen hash takes years.
str secrets.hash_password const str &Password {
	return secrets_handed cby_secrets_hash_password(Password)
}

// The same with Argon2id, which needs memory as well as time for each
// guess (so a graphics card can't guess by the million): OpenSSL 3.2's
// and later. check_password knows these too.
str secrets.hash_password_argon2 const str &Password {
	return secrets_handed cby_secrets_hash_password_argon2(Password)
}

// whether hash_password_argon2 can be used here
bool secrets.can_use_argon2 {
	return cby_secrets_can_use_argon2() != 0
}

// true if it's the password that was hashed (by either)
bool secrets.check_password const str &Password, const str &Kept {
	return cby_secrets_check_password(Password, Kept) != 0
}

// ---- locking: text, bytes and files, with a password (AES-256-GCM)

// The text, locked with the password: text again (base64), to keep or
// send. Only the password unlocks it, and if anything in it is changed,
// it won't unlock at all.
str secrets.lock const str &Text, const str &Password {
	return secrets_handed cby_secrets_lock_text(Text, Text.length, Password)
}

// The text again; a panic if the password's wrong (or it's been changed):
// can_unlock checks first.
str secrets.unlock const str &Locked, const str &Password {
	long Length = cby_secrets_unlock_text(Locked, Password)
	if Length < 0 {
		cby_secrets_cant_unlock
	}
	return secrets_handed Length
}

bool secrets.can_unlock const str &Locked, const str &Password {
	return cby_secrets_unlock_text(Locked, Password) >= 0
}

// bytes, locked (bytes again), and unlocked (a panic if they can't be)
bytes secrets.lock_bytes const bytes &Data, const str &Password {
	bytes B
	B.adopt cby_secrets_lock_bytes(Data.handle, Password)
	return B
}

bytes secrets.unlock_bytes const bytes &Locked, const str &Password {
	long Handle = cby_secrets_unlock_bytes(Locked.handle, Password)
	if Handle == 0 {
		cby_secrets_cant_unlock
	}
	bytes B
	B.adopt Handle
	return B
}

// a file, locked into another ("notes.txt" into "notes.txt.locked")
void secrets.lock_file const str &From, const str &Into, const str &Password {
	cby_secrets_lock_file From, Into, Password
}

// and unlocked into another: false if the password's wrong (or it's been
// changed), and nothing's written
bool secrets.unlock_file const str &From, const str &Into, const str &Password {
	return cby_secrets_unlock_file(From, Into, Password) != 0
}

// ---- signatures: proof a message came from someone with the key, unchanged

// the message's signature with a key both sides know (HMAC-SHA256, in
// hexadecimal): what a web service sends with its messages to say they're
// its own
str secrets.shared_signature const str &Message, const str &Key {
	return secrets_handed cby_secrets_signature(Message, Message.length, Key)
}

// true if it's the message's signature with the key
bool secrets.check_shared_signature const str &Message, const str &Key, const str &Signature {
	return cby_secrets_same(secrets.shared_signature(Message, Key), Signature.lower) != 0
}

// true if the two are the same, taking as long however much of them is:
// for comparing codes and signatures, so the time taken gives nothing away
bool secrets.same const str &A, const str &B {
	return cby_secrets_same(A, B) != 0
}

// ---- public keys: a private key signs, and anyone with the public key
// that goes with it can check (Ed25519, as SSH's newest keys are)

// a new private key (base64): keep it secret
str secrets.make_private_key {
	return secrets_handed cby_secrets_make_private_key()
}

// the public key that goes with a private key (base64): give it to
// anyone who needs to check what it signs
str secrets.public_key const str &PrivateKey {
	return secrets_handed cby_secrets_public_key(PrivateKey)
}

// the message's signature with a private key (base64)
str secrets.sign const str &Message, const str &PrivateKey {
	return secrets_handed cby_secrets_sign(Message, Message.length, PrivateKey)
}

// true if the message was signed with the private key that goes with
// this public key, and is unchanged
bool secrets.check_signed const str &Message, const str &PublicKey, const str &Signature {
	return cby_secrets_check_signed(Message, Message.length, PublicKey, Signature) != 0
}

// whether public keys can be used here (on a Mac, they need Homebrew's
// OpenSSL)
bool secrets.can_use_keys {
	return cby_secrets_can_use_keys() != 0
}
