// world.hby — 3D: a window looking into a world of shapes, lit by the sun
// and lamps, seen by a camera; frames, keys and timers as in a game.
//
//     use world
//
//     object spinner : world.window {
//         world.shape Cube
//
//         void build {
//             set_title "Spinner"
//             add_plane 20, 20, "forestgreen", 0, 0, 0     // the ground
//             Cube = add_box 1, 1, 1, "orange", 0, 1, 0
//             on_frame step
//         }
//
//         void step {                          // 60 times a second
//             Cube.turn 1                       // a degree a frame
//             if key_hold "up" {
//                 Cube.move_forward 0.05
//             }
//         }
//     }
//
//     int main {
//         spinner S
//         S.run
//     }
//
// Distances are in metres. y is up; a shape's position is its middle. The
// camera starts at 0, 1.6, 6 (standing, a few steps back), looking along
// -z, which is "forward" for a shape too: turn turns it round, and
// move_forward moves it the way it faces. Angles are in degrees.
//
// Underneath is OpenGL, through SDL 3; nothing here needs it. Under a test
// script, or where there's no OpenGL, Cabby draws the world itself.
//
// The full reference is world.md, next to this file.

use time

// ---- the C side (runtime/world.c); use the objects below instead

