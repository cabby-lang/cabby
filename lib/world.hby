// ---- shapes: what's in the world

// A box, ball, plane, cylinder or cone. Its position is its middle, in
// metres; its angle turns it round, as a person turns (counterclockwise
// seen from above), and at 0 it faces -z.
object world.shape {
	long Id

	double x const {
		return cby_world_shape_x Id
	}

	double y const {
		return cby_world_shape_y Id
	}

	double z const {
		return cby_world_shape_z Id
	}

	// puts its middle there
	void move_to double X, double Y, double Z const {
		cby_world_shape_move_to Id, X, Y, Z
	}

	// moves it by that much each way
	void move double Dx, double Dy, double Dz const {
		cby_world_shape_move Id, Dx, Dy, Dz
	}

	// moves it the way it faces (flat: up and down stay as they are)
	void move_forward double Distance const {
		cby_world_shape_move_forward Id, Distance
	}

	// moves it to its right (a negative distance: its left)
	void move_sideways double Distance const {
		cby_world_shape_move_sideways Id, Distance
	}

	// ---- turning, in degrees

	// which way it faces, round y: 0 to 360
	double angle const {
		return cby_world_shape_angle Id
	}

	void set_angle double Degrees const {
		cby_world_shape_set_angle Id, Degrees
	}

	// turns it round, to its left (a negative angle: to its right)
	void turn double Degrees const {
		cby_world_shape_turn Id, Degrees
	}

	// its nose up (or down, below 0), round its own x
	double tilt const {
		return cby_world_shape_tilt Id
	}

	void set_tilt double Degrees const {
		cby_world_shape_set_tilt Id, Degrees
	}

	void tilt_by double Degrees const {
		cby_world_shape_tilt_by Id, Degrees
	}

	// leaning over sideways, round the way it faces
	double roll const {
		return cby_world_shape_roll Id
	}

	void set_roll double Degrees const {
		cby_world_shape_set_roll Id, Degrees
	}

	void roll_by double Degrees const {
		cby_world_shape_roll_by Id, Degrees
	}

	// ---- how it looks

	// bigger or smaller: 2 is twice the size (1 to begin with)
	double scale const {
		return cby_world_shape_scale Id
	}

	void set_scale double Scale const {
		cby_world_shape_set_scale Id, Scale
	}

	// its width, height and depth, in metres (a ball's are its diameter)
	void set_size double Width, double Height, double Depth const {
		cby_world_shape_set_size Id, Width, Height, Depth
	}

	// a color: "orange", "#336699"
	void set_color const str &Color const {
		cby_world_shape_set_color Id, Color
	}

	// a picture on it (PNG, JPEG, BMP or GIF): on each side of a box, round
	// a ball or cylinder, over a plane. Its color tints it ("white": none).
	void set_picture const str &Picture const {
		cby_world_shape_set_picture Id, Picture
	}

	// the picture repeated, each copy this many metres across (grass on a
	// field, tiles on a floor); 0: once, stretched over it
	void set_picture_size double Metres const {
		cby_world_shape_set_picture_size Id, Metres
	}

	bool visible const {
		return cby_world_shape_visible(Id) != 0
	}

	void set_visible bool On const {
		cby_world_shape_set_visible Id, On
	}

	// a glowing shape is drawn in its own color, as bright at night as by
	// day, with no shading and no shadow: a lamp's bulb, a lit window, a
	// beam of light
	bool glow const {
		return cby_world_shape_glow(Id) != 0
	}

	void set_glow bool On const {
		cby_world_shape_set_glow Id, On
	}

	// takes it out of the world
	void remove const {
		cby_world_shape_remove Id
	}

	bool removed const {
		return cby_world_shape_removed(Id) != 0
	}

	// ---- groups and touching

	// a name for shapes of a kind ("coins", "walls"), for sprites_in
	void set_group const str &Group const {
		cby_world_shape_set_group Id, Group
	}

	str group const {
		str s
		for i in cby_world_shape_group_length Id {
			s += cby_world_text_char i
		}
		return s
	}

	// true when the two overlap (their boxes do: the box round each, as it
	// stands)
	bool touches const world.shape &Other const {
		return cby_world_shape_touches(Id, Other.Id) != 0
	}

	// how far its middle is from the other's, in metres
	double distance_to const world.shape &Other const {
		return cby_world_shape_distance_to Id, Other.Id
	}

	// the height of its top, and of its bottom: to stand something on it
	double top const {
		return cby_world_shape_top Id
	}

	double bottom const {
		return cby_world_shape_bottom Id
	}

	// ---- a model's animations (as Blender's actions are called)

	// plays one over and over: Hero.play "Walk" (playing it already, it
	// goes on, rather than from the start)
	void play const str &Name const {
		cby_world_shape_play Id, Name, 1
	}

	// plays one once, to its end, where it stays
	void play_once const str &Name const {
		cby_world_shape_play Id, Name, 0
	}

	// back to how it was made
	void stop_animation const {
		cby_world_shape_stop_animation Id
	}

	// 1 as made, 2 twice as fast, 0.5 slower, -1 backwards
	void set_animation_speed double Speed const {
		cby_world_shape_set_animation_speed Id, Speed
	}

	// what it's playing now ("" if nothing, or a play_once has ended)
	str playing const {
		str s
		for i in cby_world_shape_playing Id {
			s += cby_world_text_char i
		}
		return s
	}

	// how far through it, in seconds
	double animation_time const {
		return cby_world_shape_animation_time Id
	}

	// the animations it has, by name
	list str animations const {
		list str Names
		for i in cby_world_shape_animation_count Id {
			str s
			for k in cby_world_shape_animation_name Id, i {
				s += cby_world_text_char k
			}
			Names.add s
		}
		return Names
	}

	// ---- joined: moving and turning with another (a car's wheels)

	// joined to Other, staying where it is: from then on its place and
	// angles are counted from Other's, which carries it
	void join const world.shape &Other const {
		cby_world_shape_join Id, Other.Id
	}

	// back on its own, where it is
	void unjoin const {
		cby_world_shape_unjoin Id
	}

	bool joined const {
		return cby_world_shape_joined_to(Id) != 0
	}

	// where its middle is in the world, joined or not (x, y and z are
	// counted from what it's joined to, while it is)
	double world_x const {
		return cby_world_shape_world_x Id
	}

	double world_y const {
		return cby_world_shape_world_y Id
	}

	double world_z const {
		return cby_world_shape_world_z Id
	}

	// ---- physics

	// falling: pulled down by the world's gravity, landing on what's solid,
	// bouncing, and stopped by what it runs into
	void set_falls bool On const {
		cby_world_shape_set_falls Id, On
	}

	bool falls const {
		return cby_world_shape_falls(Id) != 0
	}

	// what falls lands on it, and is stopped by it (true to begin with);
	// false, things go through it: a coin, a ghost
	void set_solid bool On const {
		cby_world_shape_set_solid Id, On
	}

	bool solid const {
		return cby_world_shape_solid(Id) != 0
	}

	// standing on something (it fell, and landed)
	bool on_ground const {
		return cby_world_shape_on_ground(Id) != 0
	}

	// how fast it's going, in metres a second, each way: a falling shape
	// is moved by it, and so is one that doesn't fall (a platform, a door)
	void set_velocity double X, double Y, double Z const {
		cby_world_shape_set_velocity Id, X, Y, Z
	}

	// as much again, added: a jump is push 0, 5, 0
	void push double X, double Y, double Z const {
		cby_world_shape_push Id, X, Y, Z
	}

	double velocity_x const {
		return cby_world_shape_velocity_x Id
	}

	double velocity_y const {
		return cby_world_shape_velocity_y Id
	}

	double velocity_z const {
		return cby_world_shape_velocity_z Id
	}

	// how much of its speed it keeps, bouncing back: 0 none, 1 all (0.3)
	void set_bounce double Bounce const {
		cby_world_shape_set_bounce Id, Bounce
	}

	// how quickly it slows on the ground: 0 ice, 0.5 to begin with
	void set_friction double Friction const {
		cby_world_shape_set_friction Id, Friction
	}

	// the same shape: true for two names for one
	bool same_as const world.shape &Other const {
		return Id == Other.Id
	}

	// ---- a mesh shape's own triangles (add_mesh)

	// its points (x, y and z of each in turn, from its middle) and its
	// triangles (three points each, counted from 0, counterclockwise seen
	// from the side it faces), given again: what it is now
	void set_mesh const list double &Points, const list int &Triangles const {
		cby_world_mesh_clear Id
		for I in Points.length / 3 {
			cby_world_mesh_point Id, Points[3 * I], Points[3 * I + 1], Points[3 * I + 2]
		}
		for I in Triangles.length / 3 {
			cby_world_mesh_triangle Id, Triangles[3 * I], Triangles[3 * I + 1], Triangles[3 * I + 2]
		}
		cby_world_mesh_done Id
	}

	// laid from one place to the other, as long as it takes (a line made
	// by add_line, moved)
	void lay double X1, double Y1, double Z1, double X2, double Y2, double Z2 const {
		cby_world_shape_lay Id, X1, Y1, Z1, X2, Y2, Z2
	}
}

// ---- lamps: light from a place, falling off with distance

object world.lamp {
	long Id

	double x const {
		return cby_world_lamp_x Id
	}

	double y const {
		return cby_world_lamp_y Id
	}

	double z const {
		return cby_world_lamp_z Id
	}

	void move_to double X, double Y, double Z const {
		cby_world_lamp_move_to Id, X, Y, Z
	}

	void set_color const str &Color const {
		cby_world_lamp_set_color Id, Color
	}

	// how far its light goes, in metres
	void set_reach double Metres const {
		cby_world_lamp_set_reach Id, Metres
	}

	void remove const {
		cby_world_lamp_remove Id
	}
}

// ---- writing over the world: a score, a message

// Text in front of everything, X, Y pixels from the window's top left
// corner, staying there as the camera moves.
object world.text {
	long Id

	void set_text const str &Text const {
		cby_world_text_set Id, Text
	}

	str text const {
		str s
		for i in cby_world_text_length Id {
			s += cby_world_text_char i
		}
		return s
	}

	void move_to double X, double Y const {
		cby_world_text_move_to Id, X, Y
	}

	// "white" to begin with
	void set_color const str &Color const {
		cby_world_text_set_color Id, Color
	}

	// its height, in pixels (20 to begin with)
	void set_size double Size const {
		cby_world_text_set_size Id, Size
	}

	void set_visible bool On const {
		cby_world_text_set_visible Id, On
	}

	void remove const {
		cby_world_text_remove Id
	}
}

// ---- the window

object world.window {
	long Win
	bool Built

	// Override this to add the world's shapes and handlers.
	void build {
	}

	void set_title const str &Title {
		open
		cby_world_set_title Win, Title
	}

	// the window's size to begin with, in pixels (800 by 600); it can be
	// made bigger, and the world is seen wider
	void set_size int Width, int Height {
		open
		cby_world_set_size Win, Width, Height
	}

	int width const {
		return cby_world_width Win
	}

	int height const {
		return cby_world_height Win
	}

	// the sky: a color ("skyblue" to begin with)
	void set_background const str &Color {
		open
		cby_world_set_background Win, Color
	}

	// shows a message, with an OK button
	void show_message const str &Text {
		open
		cby_world_show_message Win, Text
	}

	// calls h when these keys are pressed: "P", "F5", "Ctrl+S"
	void add_shortcut const str &Keys, handler h {
		open
		cby_world_add_shortcut Win, Keys, h
	}

	// closes the window, ending run
	void close {
		if Win != 0 {
			cby_world_close Win
		}
	}

	// ---- shapes: each at X, Y, Z (its middle)

	// a box Width across (x), Height high (y) and Depth deep (z)
	world.shape add_box double Width, double Height, double Depth, const str &Color, double X, double Y, double Z {
		open
		return world.shape{.Id = cby_world_add_box(Win, Width, Height, Depth, Color, X, Y, Z)}
	}

	world.shape add_ball double Radius, const str &Color, double X, double Y, double Z {
		open
		return world.shape{.Id = cby_world_add_ball(Win, Radius, Color, X, Y, Z)}
	}

	// flat, facing up: the ground, a floor, a table top
	world.shape add_plane double Width, double Depth, const str &Color, double X, double Y, double Z {
		open
		return world.shape{.Id = cby_world_add_plane(Win, Width, Depth, Color, X, Y, Z)}
	}

	// standing up, Height high
	world.shape add_cylinder double Radius, double Height, const str &Color, double X, double Y, double Z {
		open
		return world.shape{.Id = cby_world_add_cylinder(Win, Radius, Height, Color, X, Y, Z)}
	}

	// its point up, Height high
	world.shape add_cone double Radius, double Height, const str &Color, double X, double Y, double Z {
		open
		return world.shape{.Id = cby_world_add_cone(Win, Radius, Height, Color, X, Y, Z)}
	}

	// a box cut corner to corner: its bottom whole, a sheer face at its
	// front (-z, the way shapes face), Height high, and a slope from the
	// back's bottom edge up to it: a ramp, a roof's side, a ledge
	world.shape add_wedge double Width, double Height, double Depth, const str &Color, double X, double Y, double Z {
		open
		return world.shape{.Id = cby_world_add_wedge(Win, Width, Height, Depth, Color, X, Y, Z)}
	}

	// a model made in Blender, exported as glTF (a .glb file, or .gltf with
	// its .bin and pictures beside it), with its colors, pictures and
	// animations. X, Y, Z is where its origin goes (where Blender's was:
	// for a character, usually its feet); it faces -z, as shapes do.
	world.shape add_model const str &Path, double X, double Y, double Z {
		open
		return world.shape{.Id = cby_world_add_model(Win, Path, X, Y, Z)}
	}

	// a shape of your own: Points (x, y and z of each in turn, from X, Y,
	// Z) joined by Triangles (three points each, counted from 0,
	// counterclockwise seen from the side it faces), each triangle flat,
	// seen from both sides. set_mesh changes them.
	world.shape add_mesh const list double &Points, const list int &Triangles, const str &Color, double X, double Y, double Z {
		open
		world.shape Mesh = world.shape{.Id = cby_world_add_mesh(Win, Color, X, Y, Z)}
		Mesh.set_mesh Points, Triangles
		return Mesh
	}

	// a line from one place to another: a box Thick across, as long as it
	// takes (lay moves it)
	world.shape add_line double X1, double Y1, double Z1, double X2, double Y2, double Z2, double Thick, const str &Color {
		world.shape Line = add_box Thick, Thick, 1, Color, X1, Y1, Z1
		Line.lay X1, Y1, Z1, X2, Y2, Z2
		return Line
	}

	// where a place in the world is in the window, in pixels from its
	// top left, as the mouse's are (-1, both, behind the camera)
	double screen_x double X, double Y, double Z const {
		return cby_world_screen_x(Win, X, Y, Z)
	}

	double screen_y double X, double Y, double Z const {
		return cby_world_screen_y(Win, X, Y, Z)
	}

	// every shape in a group, in the order they were added ("" for all)
	list world.shape shapes_in const str &Group const {
		list world.shape Found
		int Count = cby_world_find(Win, 0, Group)
		for i in Count {
			Found.add world.shape{.Id = cby_world_found(i)}
		}
		return Found
	}

	// the shapes in a group (or all, "") that this one touches
	list world.shape touching const world.shape &Shape, const str &Group const {
		list world.shape Found
		int Count = cby_world_find(Win, Shape.Id, Group)
		for i in Count {
			Found.add world.shape{.Id = cby_world_found(i)}
		}
		return Found
	}

	// text over the world, its top left corner X, Y pixels from the
	// window's: add_text "Score: 0", 10, 10
	world.text add_text const str &Text, double X, double Y {
		open
		return world.text{.Id = cby_world_text_new(Win, Text, X, Y)}
	}

	// ---- light

	// which way the sunlight goes: 0, -1, 0 is straight down (it starts
	// coming down from behind the camera's left)
	void set_sun double X, double Y, double Z {
		open
		cby_world_set_sun Win, X, Y, Z
	}

	// its color: "white" is bright, "black" no sun (night)
	void set_sun_color const str &Color {
		open
		cby_world_set_sun_color Win, Color
	}

	// the light everywhere, even in the shade: "#59596a" to begin with
	void set_ambient const str &Color {
		open
		cby_world_set_ambient Win, Color
	}

	// shadows cast by the sun (on to begin with): false, none
	void set_shadows bool On {
		open
		cby_world_set_shadows Win, On
	}

	bool shadows const {
		return Win == 0 || cby_world_shadows(Win)   // (on, until set_shadows says)
	}

	// how far round the camera they're cast: 30 metres to begin with
	// (further, a larger world shadowed, its shadows a little blurrier)
	void set_shadow_reach double Metres {
		open
		cby_world_set_shadow_reach Win, Metres
	}

	// a lamp at X, Y, Z, its light reaching that many metres
	world.lamp add_lamp double X, double Y, double Z, const str &Color, double Reach {
		open
		return world.lamp{.Id = cby_world_lamp_new(Win, X, Y, Z, Color, Reach)}
	}

	// ---- the camera

	void move_camera_to double X, double Y, double Z {
		open
		cby_world_move_camera_to Win, X, Y, Z
	}

	void move_camera double Dx, double Dy, double Dz {
		open
		cby_world_move_camera Win, Dx, Dy, Dz
	}

	// forward the way it looks, and to its right: walking (flat)
	void camera_forward double Distance {
		open
		cby_world_camera_forward Win, Distance
	}

	void camera_sideways double Distance {
		open
		cby_world_camera_sideways Win, Distance
	}

	// turns the camera to look at that place
	void point_camera_at double X, double Y, double Z {
		open
		cby_world_point_camera_at Win, X, Y, Z
	}

	// turns it: left (or right, below 0), and up (or down)
	void turn_camera double Left, double Up {
		open
		cby_world_turn_camera Win, Left, Up
	}

	// which way it looks: its angle round (as a shape's) and up or down
	void set_camera_angle double Angle, double Tilt {
		open
		cby_world_set_camera_angle Win, Angle, Tilt
	}

	double camera_x const {
		return cby_world_camera_x Win
	}

	double camera_y const {
		return cby_world_camera_y Win
	}

	double camera_z const {
		return cby_world_camera_z Win
	}

	double camera_angle const {
		return cby_world_camera_angle Win
	}

	double camera_tilt const {
		return cby_world_camera_tilt Win
	}

	// how wide it sees, in degrees from top to bottom (60 to begin with)
	// how fast things fall, in metres a second, each second: 9.8 (the
	// Earth's) to begin with; the Moon's is 1.6
	void set_gravity double G {
		open
		cby_world_set_gravity Win, G
	}

	double gravity const {
		if Win == 0 {
			return 9.8
		}
		return cby_world_gravity Win
	}

	void set_field_of_view double Degrees {
		open
		cby_world_set_field_of_view Win, Degrees
	}

	// keeps the camera Distance metres behind the shape and Height above
	// it, looking at it, as it moves and turns; moving the camera stops it
	void follow const world.shape &Shape, double Distance, double Height const {
		cby_world_follow cby_world_shape_world(Shape.Id), Shape.Id, Distance, Height
	}

	// ---- frames

	// calls h every frame, 60 times a second
	void on_frame handler h {
		open
		cby_world_on_frame Win, h
	}

	long frame const {
		return cby_world_frame Win
	}

	// stops the frames (and timers) until resume
	void pause {
		open
		cby_world_set_paused Win, 1
	}

	void resume {
		open
		cby_world_set_paused Win, 0
	}

	bool paused const {
		return cby_world_paused(Win) != 0
	}

	// ---- timers, counted in frames: they wait while the world is paused

	void every duration Wait, handler h {
		open
		int Ms = (int)Wait.whole_milliseconds
		cby_world_every Win, Ms, 1, h
	}

	void after duration Wait, handler h {
		open
		int Ms = (int)Wait.whole_milliseconds
		cby_world_every Win, Ms, 0, h
	}

	void stop_timers {
		open
		cby_world_stop_timers Win
	}

	// ---- keys: "left", "space", "w", "enter", "f1" ...

	bool key_press const str &Key const {
		return cby_world_key_press(Win, Key) != 0
	}

	bool key_hold const str &Key const {
		return cby_world_key_hold(Win, Key) != 0
	}

	bool key_release const str &Key const {
		return cby_world_key_release(Win, Key) != 0
	}

	int key_held_for const str &Key const {
		return cby_world_key_held_for Win, Key
	}

	// calls h for each key pressed; `key` says which ("a", " ", "left")
	void on_key handler h {
		open
		cby_world_on_key Win, h
	}

	str key const {
		str s
		for i in cby_world_key_length Win {
			s += cby_world_text_char i
		}
		return s
	}

	// ---- the mouse

	// calls h when the window is clicked (mouse_x and mouse_y say where)
	void on_click handler h {
		open
		cby_world_on_click Win, h
	}

	void on_mouse_move handler h {
		open
		cby_world_on_mouse_move Win, h
	}

	int mouse_x const {
		return cby_world_mouse_x Win
	}

	int mouse_y const {
		return cby_world_mouse_y Win
	}

	// true if there's a shape under the mouse; shape_at_mouse is it
	bool mouse_on_shape const {
		return cby_world_shape_at_mouse(Win) != 0
	}

	world.shape shape_at_mouse const {
		return world.shape{.Id = cby_world_shape_at_mouse(Win)}
	}

	// the mouse hidden and kept in the window, for looking round as in a
	// first-person game; mouse_moved_x and mouse_moved_y are how far it
	// moved this frame. Escape lets it go.
	void lock_mouse bool On {
		open
		cby_world_lock_mouse Win, On
	}

	bool mouse_locked const {
		return cby_world_mouse_locked(Win) != 0
	}

	double mouse_moved_x const {
		return cby_world_mouse_moved_x Win
	}

	double mouse_moved_y const {
		return cby_world_mouse_moved_y Win
	}

	// how far the mouse's wheel turned this frame: up (away), more than 0
	double mouse_wheel const {
		return cby_world_mouse_wheel Win
	}

	// ---- random numbers

	// a whole number from From to To, both included
	int random int From, int To const {
		return cby_world_random From, To
	}

	// ---- running

	// shows the window and runs the world, until the window is closed
	void run {
		open
		if !Built {
			Built = true
			build
		}
		cby_world_run Win
	}

	// (the window is made when it is first needed)
	void open {
		if Win == 0 {
			Win = cby_world_window_new
		}
	}
}
