// the linux library (run_linux_tests.sh): a pretend /sys, /proc and /dev
// (CABBY_SYSFS, CABBY_PROCFS, CABBY_DEVFS: tests/linux/), and stand-ins
// for systemctl and modprobe (tests/linux/tools)
use linux

int main {
	println "-- sensors"
	for S in linux.sensors {
		println S.chip, "|", S.label, "|", S.kind, S.value, S.unit, S.high, S.critical
	}
	println "temperatures:", linux.temperatures.length, "fans:", linux.fans.length

	println "-- disks"
	for B in linux.block_devices {
		println B.path, B.kind, B.size, "[" + B.model + "]", "[" + B.disk + "]", "[" + B.mounted_at + "]", "[" + B.label + "]", B.removable, B.ssd, B.read_only
	}
	println "disks:", linux.disks.length, "partitions of sda:", linux.partitions_of("sda").length

	println "-- USB"
	for U in linux.usb_devices {
		println U.vendor_id + ":" + U.product_id, U.maker, "|", U.name, "|", U.serial, U.bus, U.number, U.speed
	}

	println "-- modules"
	for M in linux.modules {
		println M.name, M.size, M.used, M.used_by
	}
	println "loaded:", linux.module_loaded("snd-hda-intel"), linux.module_loaded("i915")
	println "load:", linux.load_module("i915"), linux.load_module("nonexistent")
	println "unload:", linux.unload_module("bluetooth")

	println "-- settings"
	println linux.setting("net.ipv4.ip_forward"), linux.setting("kernel.hostname"), "[" + linux.setting("net.ipv4.ip_local_port_range") + "]"
	println "has:", linux.has_setting("net.ipv4.ip_forward"), linux.has_setting("net.ipv4.nonsense")

	println "-- services"
	for V in linux.services {
		println V.name, V.active, V.running, V.enabled, "|", V.description
	}
	linux.service Cups = linux.service_named "cups"
	println "cups:", Cups.active, Cups.enabled
	println "start:", Cups.start, Cups.active, Cups.running
	println "enable:", Cups.enable, Cups.enabled
	println "stop:", Cups.stop, Cups.active
	println "has:", linux.has_service("ssh"), linux.has_service("nothing")
	for V in linux.user_services {
		println "mine:", V.name, V.active, V.users_own
	}
	linux.service Missing = linux.service_named "nothing"
	println "not reached", Missing.active
	return 0
}

