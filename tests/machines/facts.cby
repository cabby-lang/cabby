// What the computer says about itself.
use system
use os
use networks
use printing
use users

int main {
	println "name:", system.name, "| version:", system.version
	println "memory:", os.memory_total / 1000000000, "GB | up for", system.uptime / 3600, "hours"
	println "processors busy:", os.cpu_use.text(0) + "%", "| memory used:", os.memory_used / 1000000, "MB of", os.memory_total / 1000000
	for D in os.disks {
		println "disk:", D.path, D.size / 1000000000, "GB,", D.free / 1000000000, "GB free"
	}
	str Wifi = networks.wifi_name else "(it couldn't say)"
	println "wifi:", Wifi
	println "printers:", printing.printers, "| default:", printing.default_printer
	println "you:", users.name, "(" + users.full_name + ")"
	return 0
}
