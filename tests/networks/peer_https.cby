// (not a test of its own: the encrypted servers tests/networks/https.cby
// talks to, started first by run_networks_tests.sh) A certificate of its
// own, made for localhost; a web server with it (HTTPS, and wss:// at
// /chat), and a line server with it (each line said back in capitals).
// "/stop", or "stop" by WebSocket, ends it all.
use networks
use events

object servers {
	networks.web_server Web
	networks.server Lines

	void begin {
		networks.make_certificate "localhost", "cert.pem", "key.pem"
		Web.set_certificate "cert.pem", "key.pem"
		Web.on_request answer
		Web.on_message heard
		Web.listen_here 0
		Lines.on_line said
		Lines.listen_here 0
		Lines.set_certificate "cert.pem", "key.pem"   // (after listen: as well)
		println Web.port, Lines.port      // (the ports, for the tests to find)
		events.run
	}

	void answer {
		if Web.path == "/chat" and Web.wants_socket {
			long Who = Web.accept_socket
			Web.send_message Who, "welcome, encrypted"
		} else if Web.path == "/stop" {
			Web.send_page "stopping"
			stop
		} else {
			Web.send_page "<p>a page, encrypted: " + Web.path + "</p>"
		}
	}

	void heard {
		if Web.message == "stop" {
			Web.reply "stopping"
			stop
		} else {
			Web.reply Web.message.upper
		}
	}

	void said {
		Lines.reply Lines.line.upper
	}

	void stop {
		Web.close
		Lines.close
	}
}

int main {
	servers S
	S.begin
}
