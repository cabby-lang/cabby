// two Cabby programs talking: this one connects to the server in
// peer_counter.cby, and waits for each answer with read_line
// peer: peer_counter.cby
//> ready
//> total 12
//> what's 'hello'?
//> goodbye
//> the server has gone: true
//> nothing listens there now: false
use networks
use shell

int main {
	long Port = shell.get("CABBY_TEST_PEER").to_long
	networks.connection C = networks.connect "localhost", Port
	C.read_line
	println C.line
	C.send_line "add 5"
	C.send_line "add 7"
	C.send_line "total"
	C.read_line
	println C.line
	C.send_line "hello"
	C.read_line
	println C.line
	C.send_line "quit"
	while C.read_line {
		println C.line
	}
	println "the server has gone:", not C.is_open
	println "nothing listens there now:", networks.can_connect("localhost", Port)
	return 0
}
