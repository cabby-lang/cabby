// blocks: continuation lines, if/else ended by a blank line, loops, switch
int n = 3
if n > 2 {
	println "big"
} else {
	println "small"
}

if n > 5 {
	println "huge"
}
else {
	println "not huge"
}

if n == 3 {
	println "three"
}
println "next input started without a blank line"
for int i = 0; i < n; i++ {
	print i
}
println
int total = 0
while n > 0 {
	total += n
	n--
}
total
do {
	n++
} while n < 4
n
switch n {
	case 4:
		println "four"
		break
	default:
		println "other"
}
