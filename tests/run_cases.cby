### threads_on_done
//> started
//> done: 499999500000
//> told again: 4950
//> after the loop
use threads
use events

object summer : threads.worker {
	long Upto
	long Total

	void work {
		Total = 0
		for long I = 0; I < Upto; I++ {
			Total += I
		}
	}
}

object app {
	summer Sum
	int Told

	void begin {
		Sum.Upto = 1000000
		Sum.on_done finished
		Sum.start
		println "started"
	}

	void finished {
		Told++
		if Told == 1 {
			println "done:", Sum.Total
			Sum.Upto = 100
			Sum.start
		} else {
			println "told again:", Sum.Total
		}
	}
}

int main {
	app A
	A.begin
	events.run
	println "after the loop"
	return 0
}

### threads_messages_and_stopping
//> heard: ready
//> heard: asked to stop
//> done
//> while waiting, heard 5000 the last: 4999
use threads
use events

object waiter : threads.worker {
	long Turns

	void work {
		tell "ready"
		until stopping {
			Turns++
		}
		tell "asked to stop"
	}
}

object chatty : threads.worker {
	void work {
		for I in 5000 {
			tell I.text
		}
	}
}

object app {
	waiter W
	chatty C
	int Heard
	str Last

	void begin {
		W.on_message heard
		W.on_done finished
		W.start
	}

	void heard {
		println "heard:", W.message
		if W.message == "ready" {
			W.ask_to_stop
		}
	}

	void finished {
		println "done"
	}

	void chat {
		C.on_message count_one
		C.start
		C.wait
		println "while waiting, heard", Heard, "the last:", Last
	}

	void count_one {
		Heard++
		Last = C.message
	}
}

int main {
	app A
	A.begin
	events.run
	A.chat
	return 0
}

