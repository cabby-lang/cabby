### time_durations
//> 5 minutes 30 seconds 330.0 5
//> 1.25 seconds 2 hours 5 minutes 350 milliseconds 3 days
//> 11 minutes 2 minutes 45 seconds 11.0
//> 1 hour
//> -3 seconds
//> 0 seconds 5 nanoseconds 1.5 microseconds
//> true
use time

int main {
	duration Break = time.minutes(5) + time.seconds(30)
	println Break, Break.seconds, Break.whole_minutes
	println time.seconds(1.25), time.hours(2) + time.minutes(5), time.milliseconds(350), time.days(3)
	println Break * 2, Break / 2, Break / time.seconds(30)
	moment Start = time.now
	moment Later = Start + time.hours(1)
	println Later - Start
	println -time.seconds(3)
	duration Zero
	println Zero, time.nanoseconds(5), time.nanoseconds(1500)
	time.sleep time.milliseconds(5)
	println time.since(Start) >= time.milliseconds(5)
	return 0
}

### dates_calendar
//> 2026-11-03 Tuesday November 2026 3 307
//> 3 November 2026 Tuesday, 3 Nov 26 03/11/2026
//> 52 days to go
//> 2026-11-17 2027-02-03 2026-02-28
//> true true
//> 07:30:00 7:30 am 13:30:00
//> 2026-11-03 07:30:00 Tue 3 Nov, 7:30 AM
//> 2026-12-25 false
//> 2026-11-03 16:05:00
//> 2026-11-03 07:30:00
//> 2024-02-29 true 29
use dates

int main {
	date D = dates.make 2026, 11, 3
	println D, D.weekday, D.month, D.year, D.day, D.day_of_year
	println D.format("d mmmm yyyy"), D.format("dddd, d mmm yy"), D.format("dd/mm/yyyy")
	date Christmas = dates.make D.year, 12, 25
	println Christmas - D, "days to go"
	println D + 14, D.add_months(3), (dates.make 2026, 1, 31).add_months(1)
	println D.weekday == TUESDAY, D.month == NOVEMBER
	time_of_day Alarm = dates.time 7, 30
	println Alarm, Alarm.format("h:mm am/pm"), Alarm + time.hours(6)
	date_time DT = D.at Alarm
	println DT, DT.format "ddd d mmm, h:mm AM/PM"
	date R = dates.read "25/12/2026", "dd/mm/yyyy"
	println R, dates.can_read("31/02/2026", "dd/mm/yyyy")
	println dates.read_date_time("3 Nov 2026 4:05 pm", "d mmm yyyy h:mm am/pm")
	moment M = DT.utc_moment
	println M.utc
	date Leap = dates.make 2024, 2, 29
	println Leap, Leap.is_leap_year, Leap.days_in_month
	return 0
}

