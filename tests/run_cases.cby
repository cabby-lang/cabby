### json_reading_and_writing
//> Sydney
//> 23.5 false
//> Tuesday 26
//> Wednesday 24
//> no warnings
//> 0 -1 2 true true
//> [city, now, days, warning]
//> {"name":"Ada","volume":7,"sounds":true,"recent":["notes.txt",2.5]}
//> {
//>   "name": "Ada",
//>   "recent": [
//>     "notes.txt"
//>   ]
//> }
//> 27 true
use json
use files

int main {
	str Text = "{\"city\": \"Sydney\", \"now\": {\"temperature\": 23.5, \"raining\": false}, "
	Text += "\"days\": [{\"day\": \"Tuesday\", \"high\": 26}, {\"day\": \"Wednesday\", \"high\": 24}], "
	Text += "\"warning\": null}"
	json Weather = json.read Text
	println Weather["city"].str
	println Weather["now"]["temperature"].double, Weather["now"]["raining"].bool
	for Day in Weather["days"] {
		println Day["day"].str, Day["high"].long
	}
	if Weather["warning"].is_null {
		println "no warnings"
	}
	println Weather["wind"].long_or(0), Weather["city"].long_or(-1), Weather["days"].length, Weather["nothing"].is_missing, Weather.has("city")
	println Weather.keys
	json Settings = json.lookup
	Settings["name"] = "Ada"
	Settings["volume"] = 7
	Settings["sounds"] = true
	json Recent = json.list
	Recent.add "notes.txt"
	Recent.add 2.5
	Settings["recent"] = Recent
	println Settings
	Settings.remove "volume"
	Settings.remove "sounds"
	json Short = json.list
	Short.add "notes.txt"
	Settings["recent"] = Short
	println Settings.pretty
	json Days = Weather["days"]
	Days[0]["high"] = 27                       // part of Weather: changes it too
	println Weather["days"][0]["high"].long, json.can_read(Weather.text)
	return 0
}

