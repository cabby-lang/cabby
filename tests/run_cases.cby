### borrow_disjoint_fields
//> [1, 2, 3] 6
//> Ada 3
object tally {
	list int Values
	list int Seen
	int Total
	str Name

	void add_all {
		for V in Values {
			Seen.add V              // another field: allowed
			Total += V
		}
	}

	void rename const str &New {
		Name = New.copy
	}
}

object person {
	str Name
	int Age
}

void set_age int &Age, const str &Name {
	Age = (int)Name.length
}

int main {
	tally T
	T.Values = {1, 2, 3}
	T.add_all
	println T.Seen, T.Total
	person P
	P.Name = "Ada"
	set_age P.Age, P.Name          // one field lent as mutable, another read
	println P.Name, P.Age
	return 0
}

