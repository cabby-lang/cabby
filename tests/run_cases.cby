### words_for_conditions
//> 3 2 1
//> yes 2
//> true false false true
//> both
//> true
int main {
	int Count = 3
	until Count == 0 {
		print Count
		if Count != 1 {
			print " "
		}
		Count--
	}
	println
	str Answer = "no"
	int Tries = 0
	do {
		Tries++
		if Tries == 2 {
			Answer = "yes"
		}
	} until Answer == "yes" || Tries > 5
	println Answer, Tries
	bool Done = false
	println !Done, Count != 0, Count != 0, !Done && Count == 0
	if Tries > 1 && Answer != "no" {
		println "both"
	}
	while !Done {
		Done = true
	}
	println Done
	return 0
}

### handlers_on_any_object
//> false
//> true
//> Big Ben tick 1
//> Big Ben tick 2
//> Big Ben tick 3
//> 1
//> chimes for Big Ben
//> false
object timer {
	handler Tick
	int Count

	void on_tick handler h {
		Tick = h
	}

	void step {
		Count++
		Tick.call
	}
}

object bell {
	timer T
	handler Ring

	// passed on to a part of it
	void on_tick handler h {
		T.on_tick h
	}

	void on_ring handler h {
		Ring = h
	}
}

object clock {
	timer T
	bell B
	str Name

	void start {
		Name = "Big Ben"
		T.on_tick show_time
		B.on_tick show_time
		B.on_ring chime
	}

	void show_time {
		println Name, "tick", T.Count
	}

	void chime {
		println "chimes for", Name
	}

	void stop {
		B.Ring.clear
	}
}

int main {
	clock C
	println C.T.Tick.is_set
	C.start
	println C.T.Tick.is_set
	C.T.step
	C.T.step
	list clock L
	L.add C                  // moved: the handler still finds it
	L[0].T.step
	clock D
	D.T.step                 // no handler: nothing happens
	println D.T.Count
	L[0].B.Ring.call
	L[0].stop
	println L[0].B.Ring.is_set
	return 0
}

### processes_talking
//> got: apple
//> got: fig
//> got: pear
//> status 0
//> one
//> status 3 3 false
//> stopped: 143
use processes

int main {
	process P
	P.start "sort"
	P.send "pear"
	P.send "apple"
	P.send "fig"
	P.end_input
	until P.at_end {
		println "got:", P.read_line
	}
	println "status", P.wait
	process Q
	Q.start "echo one; echo two; exit 3"
	println Q.read_line
	println "status", Q.wait, Q.status, Q.is_running
	process Slow
	Slow.start "sleep 5"
	Slow.stop
	println "stopped:", Slow.status
	return 0
}

### processes_handlers
//> before
//> waiting
//> -> line 1
//> -> line 2
//> -> line 3
//> ended with 2 after 3 lines
//> wait gave 2
//> dropped after waiting: done
use processes
use files

object watcher {
	process P
	int Lines

	void go {
		P.on_line got_line
		P.on_end finished
		P.start "for i in 1 2 3; do echo line $i; done; exit 2"
		println "waiting"
		int S = P.wait
		println "wait gave", S
	}

	void got_line {
		Lines++
		println "->", P.line
	}

	void finished {
		println "ended with", P.status, "after", Lines, "lines"
	}
}

void run_late {
	process Late
	Late.start "sleep 0.1; echo done > cabby-late.txt"
}

int main {
	println "before"
	watcher W
	W.go
	run_late                       // Late is dropped here: that waits for it
	println "dropped after waiting:", files.read("cabby-late.txt").trim
	files.delete "cabby-late.txt"
	return 0
}

### processes_errors_apart
// (stderr as lines of its own, read or handed to a handler, while its
// stdout fills too; text sent without a line end)
//> no line end, still none
//> oops true true
//> out: [out 1, out 2, out 3, , last]
//> errors: [err 1, err 2, err 3, 70000 e's]
//> status 3
// panic: 'echo x' has no error lines of its own: call keep_errors_apart before starting it
use processes

object listener {
	process P
	list str Out
	list str Errors

	void begin {
		P.keep_errors_apart
		P.on_line out_line
		P.on_error_line error_line
		P.start "for i in 1 2 3; do echo out $i; echo err $i >&2; done; head -c 70000 /dev/zero | tr '\\0' e >&2; echo; echo last; exit 3"
		int Status = P.wait
		println "out:", Out
		println "errors:", Errors
		println "status", Status
	}

	void out_line {
		str Line = P.line
		Out.add Line
	}

	void error_line {
		str Line = P.error_line
		if Line.length > 20 {
			Line = Line.length.text + " " + Line[0] + "'s"
		}
		Errors.add Line
	}
}

int main {
	process Q
	Q.keep_errors_apart
	Q.start "cat; echo oops >&2"
	Q.write "no line end"
	Q.write ", still none"
	Q.end_input
	println Q.read_line
	println Q.read_error_line, Q.errors_at_end, Q.at_end
	Q.wait
	listener L
	L.begin
	process R
	R.start "echo x"
	println R.read_error_line
	return 0
}

