### extern_c_functions
//> v=42 1.41
//> [owned]
//> 124
extern int printf str fmt, ...
extern long labs long x
extern double sqrt double x
// (a C function that fills in a variable: modf, which gives back the
// fraction and puts the whole part in its second; sscanf would do, but
// it takes `...`, and declared without, its value goes astray on ARM64)
extern double modf double x, double &whole
int main {
	printf("%s=%ld %.2f\n", "v", labs(-42), sqrt(2.0))
	str s = "owned"
	printf("[%s]\n", s)
	double w
	modf(123.75, w)
	println (long)w + 1
	return 0
}

