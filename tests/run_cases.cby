//> 300 44 7
int main {
	unsigned char uc = 255
	uc++
	char c = 127
	c++
	short s = 32767
	s += 1
	unsigned u = 0
	u--
	unsigned long big = 18446744073709551615u
	long l = 5000000000
	println (int)uc, (int)c, s, u, big, l
	int i = -1
	unsigned v = 1
	println i < v, (long)i < (long)v
