### json_struct_round_trip
//> {"name":"Ada","age":36,"grade":"A","height":1.7,"shirt":"GREEN","at":{"x":1,"y":2},"trail":[{"x":3,"y":4}],"tags":["fast"],"scores":{"math":99},"best":[0,7,0],"seen":["RED"],"extra":null,"html_page":"p"}
//> Ada 36 A 1.7 true 1 2 1 fast 99 7 1 p
//> Grace 36 3 9
use json

double kind meters

enum color {
	RED
	GREEN
}

struct point {
	int x
	int y
}

struct player {
	str Name
	unsigned short Age
	char Grade
	meters Height
	color Shirt
	point At
	list point Trail
	list str Tags
	lookup str int Scores
	int Best[3]
	list color Seen
	json Extra
	str HTMLPage
}

int main {
	player P = {"Ada", 36, 'A', 1.7, GREEN, {1, 2}}
	P.Trail.add {3, 4}
	P.Tags.add "fast"
	P.Scores["math"] = 99
	P.Best[1] = 7
	P.Seen.add RED
	P.HTMLPage = "p"
	json J = json.from P
	println J
	json Back = json.read(J.text)
	player Q
	Back.fill Q
	println Q.Name, Q.Age, Q.Grade, Q.Height, Q.Shirt == GREEN, Q.At.x, Q.At.y, Q.Trail.length, Q.Tags[0], Q.Scores["math"], Q.Best[1], Q.Seen.length, Q.HTMLPage
	json.read("{\"name\": \"Grace\", \"at\": {\"x\": 3}, \"trail\": null, \"bestScore\": 5, \"Best\": [9]}").fill Q
	println Q.Name, Q.Age, Q.At.x, Q.Best[0]
	return 0
}

