### lists_in_objects_and_functions
//> tea, milk 3.75 true
//> 5 16 2
//> a 2
//> b 2
//> zero|one|three|four five
//> 0 one+three
//> abx
//> c
//> def
//> 1 true
//> 2 c
//> 1 true
object shop {
	list str Items
	list double Prices

	void add const str &Name, double Price {
		Items.add Name.copy
		Prices.add Price
	}

	double total const {
		double Sum = 0.0
		for p in Prices {
			Sum += p
		}
		return Sum
	}
}

struct row {
	str Label
	list int Cells
}

list int evens int n {
	list int Out
	for i in n {
		if i % 2 == 0 {
			Out.add i
		}
	}
	return Out
}

void double_all list int &Values {
	for i in Values.length {
		Values[i] *= 2
	}
}

int main {
	shop Corner
	Corner.add "tea", 2.5
	Corner.add "milk", 1.25
	println Corner.Items.join(", "), Corner.total, Corner.Items.contains("milk")

	list int E = evens(10)
	double_all E
	println E.length, E[4], E.find(8)

	list row Rows
	Rows.add row{.Label = "a", .Cells = {1, 2}}
	Rows.add row{.Label = "b", .Cells = {3}}
	Rows[1].Cells.add 4
	for R in Rows {
		println R.Label, R.Cells.length
	}

	list str Words = "one two three four five".split(" ")
	Words.remove_at 1
	str Last = Words.take_last
	Words.insert 0, "zero"
	println Words.join("|"), Last
	list str Few = Words[1 to 2]
	Words.clear
	println Words.length, Few.join("+")

	list list str Grid = {{"a", "b"}, {"c"}}
	Grid[0].add "x"
	Grid.add {"d", "e", "f"}
	for Line in Grid {
		println Line.join("")
	}
	list bool Flags = {true, false, true}
	println Flags.find(false), Flags.contains(true)
	list char Letters = {'c', 'a', 'b'}
	println Letters.find('b'), Letters[0]
	list double D = {0.5, -0.0}
	println D.find(0.0), D.contains(0.5)
}

