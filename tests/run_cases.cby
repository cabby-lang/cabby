### globals_and_statics
//> hello 3 3 3 6
//> 7 6
const int LIMIT = 3
const str GREETING = "hello"
int counter
int table[LIMIT] = {1, 2, 3}
int bump {
	static int calls
	calls++
	counter += calls
	return calls
}
int main {
	bump
	bump
	println GREETING, counter, table[2], bump(), counter
	table[0] = 7
	println table[0], LIMIT * 2
	return 0
}

