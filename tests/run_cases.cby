### made_and_inner
//> countdown made
//> rocket made: Apollo 3
//> Apollo lift off!
//> countdown made
//> rocket made:  3
//> big rocket made
//> countdown made
//> rocket made: Gemini 3
//> 1
//> Gemini packed up
//> Saturn packed up
//> Apollo packed up
object countdown {
	int Left
	inner handler Done

	countdown {
		Left = 3
		println "countdown made"
	}

	void on_done handler h {
		Done = h
	}

	void tick {
		Left--
		if Left == 0 {
			Done.call
		}
	}
}

object rocket {
	str Name
	countdown Count
	bool Launched

	rocket {
		Count.on_done launch
		println "rocket made:", Name, Count.Left
	}

	inner void launch {
		Launched = true
		println Name, "lift off!"
	}

	~rocket {
		println Name, "packed up"
	}
}

object big_rocket : rocket {
	big_rocket {
		println "big rocket made"
	}
}

int main {
	rocket R = {.Name = "Apollo"}
	until R.Launched {
		R.Count.tick
	}
	big_rocket B
	B.Name = "Saturn"
	list rocket Fleet
	Fleet.add rocket{.Name = "Gemini"}
	println Fleet.length
	return 0
}

### addresses_basics
//> 5
//> 6
//> 12
//> 10 20 30 40
//> 3 true true
//> 99
//> 169
//> 50
//> 51
//> true false true
//> 5
//> 2 l
//> l
use addresses

struct point {
	int X
	int Y
}

extern address char strchr address char s, int c
extern long strlen address char s

void double_it address int A {
	A.value = A.value * 2
}

int main {
	int Count = 5
	address int A = addresses.of Count
	println A.value
	A.value = 6
	println Count
	double_it A
	println Count

	int Scores[4] = {10, 20, 30, 40}
	address int S = addresses.of Scores
	println S.value, S[1], (S + 2).value, S[3]
	address int Last = addresses.of Scores[3]
	println Last - S, Last > S, Last == S + 3
	S[2] = 99
	println Scores[2]
	int Total = 0
	for address int P = S; P < S + 4; P = P + 1 {
		Total += P.value
	}
	println Total

	point Pt = {1, 2}
	address point Q = addresses.of Pt
	Q.value.Y = 50
	println Pt.Y
	address int PY = addresses.of Pt.Y
	PY.value++
	println Pt.Y

	address int N = addresses.none
	println N.is_none, A.is_none, N == addresses.none

	char Text[6] = {'h', 'e', 'l', 'l', 'o', '\0'}
	address char T = addresses.of Text
	println strlen(T)
	address char L = strchr(T, 'l')
	println L - T, L.value
	L.value = 'L'
	println L[1]
	return 0
}

