	Days += "in 3 days,in a week,in two weeks,in 1 month,3 days ago,a year ago,2 weeks later,next week,last month,next year,"
	Days += "25 Dec,Dec 25th,December 25 2027,the 3rd of January,2026-12-31,25/12/2026,3.4.2027,1 Nov,Thurs,in a fortnight"
	for Text in Days.split(",") {
		println Text + ":", dates.read_loosely_from(Text, From)
	}
	str Times = "tomorrow at 5pm,friday 9:30am,now,in 2 hours,in 90 minutes,noon,tomorrow midnight,3 hours ago,5 o'clock,next monday 17:45,25 Dec at 6 pm"
	for Text in Times.split(",") {
		println Text + ":", dates.read_date_time_loosely_from(Text, From)
	}
	println dates.can_read_loosely("someday"), dates.can_read_loosely("31 Feb"), dates.can_read_loosely("next tuesday")
	date Bad = dates.read_loosely "the 32nd of May"
	return 0
}

### archives_xz_zip64
// (.tar.xz and .xz files; a zip with zip64's records, as one over 4 GB
// has, read back)
//> [xzcase/, xzcase/a.txt, xzcase/sub/, xzcase/sub/b.txt]
//> hello | world
//> true
//> [xzcase/, xzcase/a.txt, xzcase/sub/, xzcase/sub/b.txt] world
//> back: hello
// panic: isn't a gzipped (.gz) or xz (.xz) file
use archives
use files
use directories
use shell

int main {
	directories.make "xzcase/sub"
	files.write "xzcase/a.txt", "hello"
	files.write "xzcase/sub/b.txt", "world"
	archives.make "xzcase.tar.xz", {"xzcase"}
	println archives.list("xzcase.tar.xz")
	println archives.read("xzcase.tar.xz", "xzcase/a.txt"), "|", archives.read("xzcase.tar.xz", "xzcase/sub/b.txt")
	archives.compress_xz "xzcase/a.txt"
	archives.decompress_to "xzcase/a.txt.xz", "xzcase-a.txt"
	println files.read("xzcase-a.txt") == "hello"
	files.delete "xzcase/a.txt.xz"
	shell.set "CABBY_ZIP64", "1"
	archives.make "xzcase64.zip", {"xzcase"}
	shell.unset "CABBY_ZIP64"
	println archives.list("xzcase64.zip"), archives.read("xzcase64.zip", "xzcase/sub/b.txt")
	archives.unpack "xzcase64.zip", "xzcase-back"
	println "back:", files.read("xzcase-back/xzcase/a.txt")
	shell.status "rm -rf xzcase xzcase-back xzcase.tar.xz xzcase64.zip xzcase-a.txt nothing"
	str Plain = shell.get("CABBY_SAVE_FOLDERS") + "/xzcase-a.txt"   // (the tests' own folder: the panic leaves it)
	files.write Plain, "plain"
	archives.decompress_to Plain, "nothing"
	return 0
}

### sound_midi_synthesizer_monitoring
// (a synthesizer, written down by CABBY_MIDI_OUT, read back; a keyboard
// (CABBY_MIDI_IN's file) sent on to it, an octave up by its handler, and
// as it is by send_to (in a millisecond or two: sorted, as their order may
// differ); monitoring's settings; note names)
//> outputs: 1 inputs: 1
//> C4 C#4 B3 A0 C8
//> violin: A4 C4 C5 C5 C6 E4 E5 G4 G5
//> drums: C2
//> monitoring: false 1.0 -> true 0.5
// panic: a velocity is from 1 to 127, not 200
use sound
use events
use shell

object relay {
	sound.keyboard K
	sound.keyboard Again
	sound.synthesizer S
	int Heard

	void begin {
		S = sound.open_synthesizer
		S.set_instrument "violin"
		S.play_note "A4", 20
		K = sound.open_keyboard
		K.on_note played
		events.run
		Again = sound.open_keyboard
		Again.send_to S
		Again.on_note counted
		Heard = 0
		events.run
		S.set_instrument "drums"
		S.play_note "C2", 10
		S.close
	}

	void played {
		if K.pressed {
			S.start_key K.key + 12
		} else {
			S.stop_key K.key + 12
		}
		Heard += 1
		if Heard == 8 {
			K.close
		}
	}

	void counted {
		Heard += 1
		if Heard == 8 {
			events.stop
		}
	}
}

int main {
	println "outputs:", sound.midi_outputs.length, "inputs:", sound.midi_inputs.length
	println sound.note_name(60), sound.note_name(61), sound.note_name(59), sound.note_name(21), sound.note_name(108)
	relay R
	R.begin
	sound.song Got = sound.read_song shell.get("CABBY_MIDI_OUT")
	for P in Got.Parts {
		list str Names
		for N in P.Notes {
			Names.add N.name
		}
		Names.sort
		println P.instrument + ":", Names.join(" ")
	}
	print "monitoring:", sound.monitoring, sound.monitor_volume
	sound.set_monitoring true
	sound.set_monitor_volume 0.5
	println " ->", sound.monitoring, sound.monitor_volume
	sound.synthesizer S = sound.open_synthesizer
	S.set_velocity 200
	return 0
}

### sound_from_workers
// (two workers playing, writing and reading songs while the main program
// plays: each worker's song is its own)
//> worker 0 read back 15 notes, from C4
//> worker 1 read back 15 notes, from C#4
//> all played
use threads
use sound
use files

object singer : threads.worker {
	int Number
	str Path
	int Read
	str First

	void work {
		for I in 3 {
			sound.play_note "C4", 10
			sound.part Tune
			Tune.set_instrument "flute"
			Tune.notes "C4 D4 E4 F4 G4", 0.25
			Tune.transpose Number
			sound.song Song
			Song.add Tune
			Song.save Path
			sound.song Back = sound.read_song Path
			Read += Back.Parts[0].Notes.length
			First = Back.Parts[0].Notes[0].name
		}
	}
}

int main {
	singer Singers[2]
	for I in 2 {
		Singers[I].Number = I
		Singers[I].Path = "worker-song-" + I.text + ".mid"
		Singers[I].start
	}
	for I in 10 {
		sound.play_note "E4", 10
	}
	for I in 2 {
		Singers[I].wait
		println "worker", Singers[I].Number, "read back", Singers[I].Read, "notes, from", Singers[I].First
	}
	sound.wait
	println "all played"
	for I in 2 {
		files.delete Singers[I].Path
	}
	return 0
}

### archives_passwords
// (zips with a password: AES-256 made and read; another program's AES-128
// (AE-1) and `zip -e`'s ZipCrypto read; a wrong password; a tar can't
// have one)
//> [pwcase/, pwcase/note.txt, pwcase/sub/, pwcase/sub/big.txt]
//> needs a password: true false
//> Ein Geheimnis: ünd mehr
//> big: true
//> AES-128, AE-1, kept by another program.
//> Made by zip -e, the old way.
// panic: only a zip file can have a password
use archives
use files
use directories
use shell

int main {
	str Big = "Lorem ipsum dolor sit amet. ".repeat(5000)
	directories.make "pwcase/sub"
	files.write "pwcase/note.txt", "Ein Geheimnis: ünd mehr"
	files.write "pwcase/sub/big.txt", Big
	archives.make_with_password "pwcase.zip", {"pwcase"}, "correct horse battery"
	println archives.list("pwcase.zip")
	archives.make "pwcase-plain.zip", {"pwcase/note.txt"}
	println "needs a password:", archives.needs_password("pwcase.zip"), archives.needs_password("pwcase-plain.zip")
	println archives.read_with_password("pwcase.zip", "pwcase/note.txt", "correct horse battery")
	archives.unpack_with_password "pwcase.zip", "pwcase-back", "correct horse battery"
	println "big:", files.read("pwcase-back/pwcase/sub/big.txt") == Big
	print archives.read_with_password("tests/archives/aes128-ae1.zip", "note.txt", "swordfish")
	print archives.read_with_password("tests/archives/zipcrypto.zip", "old.txt", "swordfish")
	shell.status "rm -rf pwcase pwcase-back pwcase.zip pwcase-plain.zip"
	archives.make_with_password shell.get("CABBY_SAVE_FOLDERS") + "/pw.tar.gz", {"tests/archives"}, "x"
	return 0
}

