### memory_by_hand
//> 0 0
//> 360
//> 7 7
use addresses

struct pair
{
	int A
	int B
}

int main {
	address int Buffer = addresses.allocate 4
	println Buffer[0], Buffer[3]
	for i in 4 {
		Buffer[i] = (i + 1) * 10
	}
	Buffer = addresses.reallocate Buffer, 8
	for i in 4 to 7 {
		Buffer[i] = (i + 1) * 10
	}
	int Total = 0
	for i in 8 {
		Total += Buffer[i]
	}
	println Total
	addresses.free Buffer
	address pair P = addresses.allocate 1
	P.value.A = 7
	P.value.B = P.value.A
	println P.value.A, P[0].B
	addresses.free P
	address int Nothing = addresses.none
	addresses.free Nothing
	address int Grown = addresses.reallocate Nothing, 2
	addresses.free Grown
	return 0
}

