### lookups_basics
//> {Ada: 36, Alan: 41} 2
//> 38 false true
//> Ada 38
//> Alan 41
//> Grace 85
//> Ada Alan Grace
//> {Ada: 38, Grace: 85} [Ada, Grace] [38, 85]
//> 2 {Ada: 38, Grace: 85, Zed: 1}
//> minus one {3: three, -1: minus one} {a: true}
//> {true: YES, false: no}
//> {Ada: [9, 7, 10]}
//> bye Rex
//> {} 0
//> 10 999
//> bye Tom
object pet {
	str Name
	~pet {
		println "bye", Name
	}
}

int main {
	lookup str int Ages = {"Ada": 36, "Alan": 41}
	println Ages, Ages.length
	Ages["Grace"] = 85
	Ages["Ada"] = 37
	Ages["Ada"] += 1
	println Ages["Ada"], Ages.contains("Bob"), Ages.contains("Alan")
	for Name, Age in Ages {
		println Name, Age
	}
	str Line
	for Name in Ages {
		Line += Name + " "
	}
	println Line.trim
	Ages.remove "Alan"
	println Ages, Ages.keys, Ages.values
	lookup str int Second = Ages.copy
	Second["Zed"] = 1
	println Ages.length, Second
	lookup int str Names = {3: "three", -1: "minus one"}
	lookup char bool Seen
	Seen['a'] = true
	println Names[-1], Names, Seen
	lookup bool str Yes = {true: "yes", false: "no", true: "YES"}
	println Yes
	lookup str list int Marks
	Marks["Ada"] = {9, 7}
	Marks["Ada"].add 10
	println Marks
	lookup str pet Pets
	pet P
	P.Name = "Rex"
	Pets["dog"] = P
	pet Q
	Q.Name = "Tom"
	Pets["dog"] = Q
	Ages.clear
	println Ages, Ages.length
	for i in 1000 {
		Ages[i.text] = i
	}
	for i in 990 {
		Ages.remove i.text
	}
	println Ages.length, Ages["999"]
	return 0
}

### lookups_in_objects_and_functions
//> {Ada: [9, 7], Alan: [8]} {101: Lab}
//> {the: 3, cat: 1, and: 2, hat: 1, bat: 1}
//> 11
//> [{the: 3, cat: 11, and: 2, hat: 1, bat: 1}, {x: 1}] [{the: 3, cat: 11, and: 2, hat: 1, bat: 1}, {x: 1, y: 2}]
//> {a: {b: 1, c: 2}} {a: {c: 2}}
//> a b 1
//> a c 2
//> [] [] {}
//> {cat: 11, and: 2, hat: 1, bat: 1, the: 2}
object school {
	lookup str list int Marks
	lookup int str Rooms

	void mark const str &Name, int Score {
		if !Marks.contains(Name) {
			Marks[Name] = {}
		}
		Marks[Name].add Score
	}
}

lookup str int count_words const str &Text {
	lookup str int Counts
	for Word in Text.split(" ") {
		if Counts.contains(Word) {
			Counts[Word] += 1
		} else {
			Counts[Word] = 1
		}
	}
	return Counts
}

void bump lookup str int &Counts, const str &Word {
	Counts[Word] += 10
}

int main {
	school S
	S.mark "Ada", 9
	S.mark "Ada", 7
	S.mark "Alan", 8
	S.Rooms[101] = "Lab"
	println S.Marks, S.Rooms
	lookup str int W = count_words("the cat and the hat and the bat")
	println W
	bump W, "cat"
	println W["cat"]
	list lookup str int Many
	Many.add W.copy
	Many.add {"x": 1}
	list lookup str int Again = Many.copy
	Again[1]["y"] = 2
	println Many, Again
	lookup str lookup str int Nested
	Nested["a"] = {"b": 1}
	Nested["a"]["c"] = 2
	lookup str lookup str int N2 = Nested.copy
	N2["a"].remove "b"
	println Nested, N2
	for K, V in Nested {
		for K2, V2 in V {
			println K, K2, V2
		}
	}
	lookup str str Empty
	println Empty.keys, Empty.values, Empty.copy
	for K in Empty {
		println "never"
	}
	for i in 3 {
		W.remove "the"
		W["the"] = i
	}
	println W
	return 0
}

### loops_over_member_results
//> {Fruit: [apples, pears, bags], Dairy: [milk, bags]}
//> c a b
//> [3, 1, 2, 3, 1, 2] {x: 1, y: 1}
list str make_words {
	return "c a b".split " "
}

int main {
	lookup str list str ShoppingList = {"Fruit": {"pears", "apples"}, "Dairy": {"milk"}}
	for Aisle in ShoppingList.keys {
		ShoppingList[Aisle].sort
		ShoppingList[Aisle].add "bags"
	}
	println ShoppingList
	str Line
	for W in make_words {
		Line += W + " "
	}
	println Line.trim
	list int Scores = {3, 1, 2}
	for X in Scores.copy {
		Scores.add X
	}
	lookup str int A = {"x": 1}
	for V in A.values {
		A["y"] = V
	}
	println Scores, A
	return 0
}

### files_and_directories
//> 36 36
//> 3 [first line, second line, third, no end]
//> - first line
//> - second line
//> - third, no end
//> false true true false
//> [2026, a.txt]
//> [2026/nov/c.txt, a.txt]
//> [2026, a.txt]
//> [a.txt, old]
//> 0 0 true
//> false
use files
use directories

int main {
	str Top = directories.current
	directories.make "cabby-files-test/notes/2026/nov"
	directories.change_to "cabby-files-test"
	files.write "notes/a.txt", "first line\nsecond line\n"
	files.append "notes/a.txt", "third, no end"
	println files.read("notes/a.txt").length, files.size "notes/a.txt"
	list str Lines = files.lines "notes/a.txt"
	println Lines.length, Lines
	for Line in files.lines "notes/a.txt" {
		println "-", Line
	}
	files.copy "notes/a.txt", "notes/2026/b.txt"
	files.rename "notes/2026/b.txt", "notes/2026/nov/c.txt"
	bool Moved = files.exists "notes/2026/nov/c.txt"
	println files.exists("notes/2026/b.txt"), Moved, directories.exists("notes"), files.exists("notes")
	println directories.list "notes"
	println directories.all_files "notes"
	directories.change_to "notes"
	println directories.list "."
	directories.change_to ".."
	files.delete "notes/2026/nov/c.txt"
	directories.remove "notes/2026/nov"
	directories.rename "notes/2026", "notes/old"
	println directories.list "notes"
	files.write "empty.txt", ""
	println files.lines("empty.txt").length, files.read("empty.txt").length, directories.home.length > 0
	files.delete "empty.txt"
	files.delete "notes/a.txt"
	directories.remove "notes/old"
	directories.remove "notes"
	directories.change_to Top
	directories.remove "cabby-files-test"
	println directories.exists "cabby-files-test"
	return 0
}

### file_streams
//> doubled: 56
//> 1 first line
//> 2 no end 42 true
//> 3 error 28 - disk full
//> 4 note: from a function
//> 5 after a move
//> started
//> from a method
//> true
//> false
use files
use directories

int report const str &What, int Code {
	println "error", Code, "-", What
	return Code * 2
}

void note file &Log, const str &Text {
	Log println "note:", Text
}

object logger {
	file Out

	void start const str &Path {
		Out = files.open_to_write Path
		Out println "started"
	}

	void say const str &Text {
		Out println Text
	}
}

void write_all {
	file Log = files.open_to_write "log.txt"
	Log println "first line"
	Log print "no end "
	Log println 42, true
	int Doubled = Log report "disk full", 28
	note Log, "from a function"
	println "doubled:", Doubled
	file Moved = Log
	Moved println "after a move"
	logger L
	L.start "obj.txt"
	L.say "from a method"
}

int main {
	str Top = directories.current
	directories.make "cabby-stream-test"
	directories.change_to "cabby-stream-test"
	write_all
	file In = files.open "log.txt"
	int Count = 0
	while !In.at_end {
		str Line = In.read_line
		Count++
		println Count, Line
	}
	for Line in files.lines "obj.txt" {
		println Line
	}
	println In.at_end
	files.write "empty.txt", ""
	file E = files.open "empty.txt"
	println !E.at_end
	files.delete "log.txt"
	files.delete "obj.txt"
	files.delete "empty.txt"
	directories.change_to Top
	directories.remove "cabby-stream-test"
	return 0
}

