### long_chain_drops
//> 299999
//> done
object node {
	int Value
	list node Next
}

int main {
	node Head
	for i in 300000 {
		node New
		New.Value = i
		New.Next.add Head
		Head = New
	}
	println Head.Value
	node Empty
	Head = Empty          // the whole chain is dropped here
	println "done"
	return 0
}

