### threads_workers
//> before: true
//> 4 workers: 0 1 2 3
//> sums 1249975000 3749975000 6249975000 8749975000
//> again: 1249975000
//> dropped while working: 220
use threads

object summer : threads.worker {
	long From
	long Upto
	long Total

	void work {
		Total = 0
		for long I = From; I < Upto; I++ {
			Total += I
		}
	}
}

object slow : threads.worker {
	list str Words
	long Letters

	void work {
		for int N = 0; N < 60; N++ {
			Letters += Words[N % Words.length].length
		}
		println "dropped while working:", Letters
	}
}

void drop_one {
	slow S
	S.Words = {"one", "three", "two"}
	S.start
}

int main {
	summer Sums[4]
	println "before:", Sums[0].is_done
	for I in 4 {
		Sums[I].From = I * 50000
		Sums[I].Upto = (I + 1) * 50000
		Sums[I].start
	}
	print "4 workers:"
	for I in 4 {
		Sums[I].wait
		print "", I
	}
	println
	println "sums", Sums[0].Total, Sums[1].Total, Sums[2].Total, Sums[3].Total
	Sums[0].start
	Sums[0].wait
	println "again:", Sums[0].Total
	drop_one
	return 0
}

