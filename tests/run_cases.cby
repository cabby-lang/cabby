//> false true false
bool noisy const str &tag, bool v {
	println "eval", tag
	return v
}
int main {
	bool a = noisy("1", false) && noisy("2", true)
	bool b = noisy("3", true) || noisy("4", true)
	bool c = noisy("5", true) && noisy("6", false)
	println a, b, c
	return 0
}

### control_flow
//> 16
//> 111
//> 21
//> 4
//> 5
//> 2
int main {
	int total = 0
	for int i = 0; i < 10; i++ {
		if i % 2 == 0 {
			continue
		}
		if i > 7 {
			break
		}
		total += i
	}
	println total
	int n = 27
	int steps = 0
	while n != 1 {
		if n % 2 == 0 {
			n = n / 2
		} else {
			n = 3 * n + 1
		}
		steps++
	}
	println steps
	int grid[2][3] = {{1, 2, 3}, {4, 5, 6}}
	int s = 0
	for int r = 0; r < 2; r++ {
		for int c = 0; c < 3; c++ {
			s += grid[r][c]
		}
	}
	println s
	int found = 0
	for int i = 0; i < 10; i++ {
		for int j = 0; j < 10; j++ {
			if i * j == 6 {
				found++
				break
			}
		}
	}
	println found
	int k = 0
	do {
		k += 5
	} while k < 3
	println k
	for ;; {
		k--
		if k == 2 {
			break
		}
	}
	println k
	return 0
}

### switch_fallthrough
//> red
//> green
//> green or blue
//> green or blue
//> unknown 9
//> b
//> c
enum color {
	RED
	GREEN = 5
	BLUE
}
void name int c {
	switch c {
		case RED:
			println "red"
			break
		case GREEN:
			println "green"
		case BLUE:
			println "green or blue"
			break
		default:
			println "unknown", c
	}
}
int main {
	name(RED)
	name(GREEN)
	name(BLUE)
	name(9)
	char ch = 'b'
	switch ch {
		case 'a':
			println "a"
		case 'b':
			println "b"
		case 'c':
			println "c"
	}
	return 0
}

### goto_cleanup_drops
//> worked
//> cleanup
//> release a
//> 0
//> release b
//> cleanup
//> release a
//> 1
object res {
	str name
	~res {
		println "release", name
	}
}
int work int fail {
	res a = {"a"}
	if fail {
		res b = {"b"}
		goto cleanup
	}
	println "worked"
	cleanup:
	println "cleanup"
	return fail
}
int main {
	println work(0)
	println work(1)
	return 0
}

### recursion
//> 6765 2432902008176640000
long fib long n {
	if n < 2 {
		return n
	}
	return fib(n - 1) + fib(n - 2)
}
long fact long n {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}
int main {
	println fib(20), fact(20)
	return 0
}

### drop_scopes_and_moves
//> inner
//> drop c
//> consuming b
//> drop b
//> end
//> drop d
//> drop a
object noisy {
	str name
	~noisy {
		println "drop", name
	}
}
void consume noisy n {
	println "consuming", n.name
}
int main {
	noisy a = {"a"}
	noisy b = {"b"}
	if true {
		noisy c = {"c"}
		println "inner"
	}
	consume(b)
	noisy d = {"d"}
	noisy e = d
	println "end"
	return 0
}

### drop_order_inheritance
//> made
//> whole.drop w 7
//> left.drop
//> base.drop w
//> part.drop 7
object base {
	str tag
	~base {
		println "base.drop", tag
	}
}
object part {
	int id
	~part {
		println "part.drop", id
	}
}
object left : base {
	~left {
		println "left.drop"
	}
}
object right : base {
}
object whole : left, right {
	part p
	~whole {
		println "whole.drop", tag, p.id
	}
}
int main {
	whole w = {"w", part{7}}
	println "made"
	return 0
}

### temporaries
//> value 1
//> drop t 1
//> drop t 2
//> drop t 4
//> drop t 3
//> x 7
object t {
	int n
	int get const {
		return n
	}
	~t {
		println "drop t", n
	}
}
t make int n {
	return t{n}
}
int main {
	println "value", make(1).get()
	make(2)
	int x = make(3).get() + make(4).get()
	println "x", x
	return 0
}

### virtual_dispatch_diamond
//> Tom has 4 legs
//> Tom purrs for Ann
//> Tom purrs for Ann
//> 1
//> Bob makes a sound
//> 0
//> mouser Tom
//> Ann 4
object animal {
	str name
	int legs
	int speak const {
		println name, "makes a sound"
		return 0
	}
	void describe const {
		println name, "has", legs, "legs"
		speak()
	}
}
object pet : animal {
	str owner
	int speak const {
		println name, "purrs for", owner
		return 1
	}
}
object worker : animal {
	str job
}
object catbot : pet, worker {
	int model
}
int talk const animal &a {
	return a.speak()
}
int main {
	catbot c = {"Tom", 4, "Ann", "mouser", 9}
	c.describe
	println talk(c)
	worker w = {"Bob", 2, "builder"}
	println talk(w)
	const worker &r = c
	println r.job, r.name
	const pet &pr = c
	println pr.owner, pr.legs
	return 0
}

### mutation_through_refs
//> 8
//> 0 10 20
//> 21
//> 0 99
//> 2
object counter {
	int n
	void bump int amount {
		n += amount
	}
	int get const {
		return n
	}
	void set int v {
		n = v
	}
}
void inc int &x {
	x++
}
void fill int a[], int n, int v {
	for int i = 0; i < n; i++ {
		a[i] = v * i
	}
}
int main {
	counter c
	c.bump 5
	counter &r = c
	r.bump 2
	inc(c.n)
	println c.n
	int arr[3]
	fill(arr, 3, 10)
	println arr[0], arr[1], arr[2]
	inc(arr[2])
	println arr[2]
	int b[3] = arr
	b[0] = 99
	println arr[0], b[0]
	counter k = {1}
	k.set(k.get() + 1)
	println k.get()
	return 0
}

