### shell_commands
//> words: 3
//> [a, b]
//> status: 3
//> before
//> from the command
//> after
//> false hello there
//> hello there
//> false 137
//> 2
use shell
use files

int main {
	str Words = shell.run "echo one two three | wc -w"
	println "words:", Words.trim
	println shell.run("printf 'a\nb\n\n'").split("\n")
	int Status = shell.status "exit 3"
	println "status:", Status
	println "before"
	if shell.status("echo from the command") == 0 {
		println "after"
	}
	bool Had = shell.has "CABBY_TEST_SHELL"
	shell.set "CABBY_TEST_SHELL", "hello there"
	println Had, shell.get "CABBY_TEST_SHELL"
	println shell.run "echo $CABBY_TEST_SHELL"
	shell.unset "CABBY_TEST_SHELL"
	println shell.has("CABBY_TEST_SHELL"), shell.status "kill -9 $$"
	files.write "cabby-shell-test.txt", "x\ny\n"   // written out before the command reads it
	str Count = shell.run "wc -l < cabby-shell-test.txt"
	files.delete "cabby-shell-test.txt"
	println Count.trim
	return 0
}

### directory_held
// (a directory held open: entries one at a time, files in it by name, and
// still the same directory once it's renamed and the program has moved)
//> [a.txt, b.txt, inner] beta! 5 true false false
//> 3
//> true alpha
//> [c.txt] gamma
//> [b.txt, inner, z.txt] true
//> panic next
// panic: can't read '../etc': give just a name in the directory, not a path
use directories
use files

int main {
	directories.make "cabby-held/inner"
	files.write "cabby-held/a.txt", "alpha"
	directory D = directories.open "cabby-held"
	D.write "b.txt", "beta"
	D.add_to "b.txt", "!"
	println D.names, D.read("b.txt"), D.size("a.txt"), D.is_directory("inner"), D.is_file("inner"), D.has("zzz")
	list str Seen
	while D.next {
		Seen.add D.name
	}
	println Seen.length
	directories.rename "cabby-held", "cabby-held-2"
	directories.change_to "cabby-held-2/inner"
	println D.path.ends_with("/cabby-held-2"), D.read("a.txt")
	directory I = D.open_inside "inner"
	I.write "c.txt", "gamma"
	println I.names, files.read("c.txt")
	I.remove "c.txt"
	D.rename "a.txt", "z.txt"
	println D.names, D.path_of("z.txt").ends_with("cabby-held-2/z.txt")
	directories.change_to "../.."
	D.remove "z.txt"
	D.remove "b.txt"
	D.remove "inner"
	directories.remove "cabby-held-2"
	println "panic next"
	D.read "../etc"
	return 0
}

### else_catches_panics
// (a panic in a statement with an else is caught: in a library, deep in
// the program's own calls, a list's position, text that isn't a number,
// dividing by zero; else Value, else { }, else Why { } with break,
// continue and return; nested, and an object made in the declaration)
//> fallback
//> -1 -1 0
//> total 60
//> 10 20 30 stopped at 3: index 3 is outside a list of length 3 (positions 0 to 2)
//> nothing to delete
//> skipped 2 skipped 4
//> inner fallback
//> db: can't open the database '/no/such/folder/x.db': unable to open database file
//> still going
//> done
use files
use databases

int pick const list int &L, int I {
	list str Made = {"a", "b"}
	return L[I]
}

int deep const list int &L, int I {
	return pick(L, I) * 1
}

int divide int A, int B {
	return A / B
}

int main {
	str Text = files.read "cabby-no-such-file.txt" else "fallback"
	println Text
	int A = "12x".to_int else -1
	int B = divide(7, 0) else -1
	lookup str int Ages = {"Ana": 30}
	int C = Ages["Bo"] else 0
	println A, B, C
	list int L = {10, 20, 30}
	int Total = 0
	for I in 5 {
		Total += deep(L, I) else 0
	}
	println "total", Total
	for I in 5 {
		int V = deep(L, I) else Why {
			println "stopped at", I.text + ":", Why
			break
		}
		print V, ""
	}
	files.delete "cabby-no-such-file.txt" else {
		println "nothing to delete"
	}
	str Skipped = ""
	for I in 1 to 4 {
		if I % 2 == 1 {
			continue
		}
		int W = divide(I, 0) else {
			Skipped += " skipped " + I.text
			continue
		}
		println W
	}
	println Skipped.trim
	files.delete "cabby-no-such-file.txt" else Why {
		str Inner = files.read "cabby-no-such-file-2.txt" else "inner fallback"
		println Inner
	}
	databases.database D = databases.open "/no/such/folder/x.db" else Why {
		println "db:", Why
		println "still going"
		println "done"
		return 0
	}
	return 1
}

### else_drops_what_failed_calls_made
// (what the calls a caught panic leaves had made is dropped, its
// destructors run, the last made first, in both modes; an object being
// made isn't, as it never was)
//> made outer
//> made inner
//> inner gone
//> outer gone
//> caught: index 5 is outside a list of length 1 (positions 0 to 0)
//> after
use files

object noisy {
	str Name
	~noisy {
		println Name, "gone"
	}
}

object held {
	str Name
	long Size
	~held {
		println Name, "gone"
	}
}

long size_of_missing {
	return files.size "cabby-no-such-file.txt"
}

int deeper {
	noisy N
	N.Name = "inner"
	println "made", N.Name
	list int L = {1}
	return L[5]
}

int outer {
	noisy N
	N.Name = "outer"
	println "made", N.Name
	return deeper()
}

int main {
	int X = outer() else Why {
		println "caught:", Why
		X = 0
		held H = held{.Name = "held", .Size = size_of_missing()} else {
			println "after"
			return 0
		}
		return 1
	}
	return 2
}

### cabbys_own_abs_random_exit
// (abs for every kind of number, in its own kind; random a to b, the same
// after random_seed; .text places; exit from inside a function)
//> 7 7 5000000000 2.5 3 -2147483648
//> 4.50 0.667 7.00 0.00 1234568 3 -2.50
//> true true true
//> true true
//> 7 is still 7
//> leaving
// exit: 4
int abs_twice int N {
	return abs(N) * 2
}

void leave {
	println "leaving"
	exit 4
}

int main {
	println abs(-7), abs(7), abs(-5000000000), abs(-2.5), abs((char)-3), abs(-2147483647 - 1)
	double Price = 4.5
	println Price.text(2), (2.0 / 3).text(3), 7.text(2), (-0.001).text(2), 1234567.891.text(0), 3.text(0), (-2.5).text(2)
	random_seed 42
	int First = random 1 to 6
	long Big = random 1 to 5000000000
	random_seed 42
	bool Same = First == random(1 to 6) && Big == random(1 to 5000000000)
	bool InRange = true
	lookup int int Seen
	for I in 6000 {
		int R = random 1 to 6
		InRange = InRange && R >= 1 && R <= 6
		Seen[R] = 1
		double D = random 0.0 to 1.0
		InRange = InRange && D >= 0 && D < 1
	}
	println Same, InRange, Seen.length == 6
	str Bad = Price.text(-1) else "no"
	println Bad == "no", random(3 to 3) == 3
	println abs_twice(-7) / 2, "is still 7"
	leave
	return 0
}

### lists_of_a_base_hold_its_derived
// (a list of shapes holds squares and circles, and one made from two
// objects; each answers as itself, its fields found and its destructors
// run as what it is, through the list, a variable, or taken out)
//> sq: 4.00
//> ci: 3.14
//> fa: 6.28
//> 4.0 fa
//> renamed: 3.14
//> took fa: 6.28
//> t: 9.00
//> square t gone, with 0 notes
//> shape t gone
//> shape fa gone
//> square sq gone, with 1 notes
//> shape sq gone
//> shape renamed gone
//> shape plain gone
object shape {
	str Name
	double area const {
		return 0
	}
	str describe const {
		return Name + ": " + area.text(2)
	}
	~shape {
		println "shape", Name, "gone"
	}
}

object square : shape {
	double Side
	list str Notes
	double area const {
		return Side * Side
	}
	~square {
		println "square", Name, "gone, with", Notes.length, "notes"
	}
}

object circle : shape {
	double R
	double area const {
		return 3.14159 * R * R
	}
}

object labelled {
	str Label
}

object fancy : circle, labelled {
	double area const {
		return 2 * 3.14159 * R * R
	}
}

int main {
	list shape Shapes
	square S
	S.Name = "sq"
	S.Side = 2
	S.Notes.add "red"
	Shapes.add S
	circle C
	C.Name = "ci"
	C.R = 1
	Shapes.add C
	fancy F
	F.Name = "fa"
	F.R = 1
	F.Label = "shiny"
	Shapes.add F
	for X in Shapes {
		println X.describe
	}
	println Shapes[0].area, Shapes[2].Name
	Shapes[1].Name = "renamed"
	println Shapes[1].describe
	shape One = Shapes.take_last
	println "took", One.describe
	shape Plain
	Plain.Name = "plain"
	Shapes.add Plain
	square T
	T.Name = "t"
	T.Side = 3
	shape Held = T
	println Held.describe
	return 0
}

