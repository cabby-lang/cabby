### printing_to_stderr
//> start
//> problem: just testing (code 0)
//> Result: 3
//> n is 7
//> 6
//> back on stdout
//> end
void report const str &What, int Code {
	println "problem:", What, "(code " + Code.text + ")"
}

int count_things {
	println "counting..."
	return 3
}

str describe int n {
	print "describing "
	println n
	return "n is " + n.text
}

int main {
	println "start"
	stderr report "disk full", 28
	report "just testing", 0
	stderr println "Error:", 5
	int Result = stderr count_things
	println "Result:", Result
	str Text = stderr describe 7
	println Text
	println (stderr describe 8).length
	stderr stdout println "back on stdout"
	println "end"
	return 0
}

### string_find_replace_slice
//> true false false
//> 4 -1 0 0
//> true true false
//> [hi there] []
//> HELLO, WORLD 42 hello, world 42
//> the dog sat on the dog mat
//> bb abc a--b--c
//> -------------------- []
//> true true true true true true
//> ADA 3
//> 8 true
//> cab age abbag
//> age cab [] []
//> cabbage Xbbag
//> [] c
//> CAB ge!
int main {
	str Line = "the cat sat on the cat mat"
	println Line.contains("cat"), Line.contains("dog"), Line.contains(',')
	println Line.find("cat"), Line.find("dog"), Line.find(""), Line.find('t')
	println Line.starts_with("the"), Line.ends_with("mat"), Line.ends_with("cat")
	println "[" + "  hi there \t\n".trim + "]", "[" + "   ".trim + "]"
	println "Hello, World 42".upper, "Hello, World 42".lower
	println Line.replace("cat", "dog")
	println "aaaa".replace("aa", "b"), "abc".replace("", "x"), "a.b.c".replace('.', "--")
	println "-".repeat(20), "[" + "ab".repeat(0) + "]"
	println "apple" < "banana", "pear" > "peach", "Zebra" < "apple", "abc" <= "abc", "ab" < "abc", "" < "a"
	str Name = "ada"
	Name = Name.upper
	println Name, Name.length
	long Where = Line.find "sat"
	bool Has = Line.contains "mat"
	println Where, Has

	str Word = "cabbage"
	println Word[0 to 2], Word[4 to Word.length - 1], Word[1 to 5]
	println Word[4 to], Word[to 2], "[" + Word[3 to 2] + "]", "[" + Word[7 to] + "]"
	str Middle = Word[1 to 5]
	Middle[0] = 'X'
	println Word, Middle
	int i = 0
	println "[" + Word[0 to i - 1] + "]", Word[i to i]
	println Word.upper[to 2], (Word + "!")[5 to]
	return 0
}

