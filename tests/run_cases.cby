//>  0 8 1 8 2 8
//>  2147483645 2147483646 2147483647
//>  10 20 21
int main {
	for i in 5 {
		print "", i
	}
	println
	for i in 1 to 5 {
		print "", i
	}
	println
	for i in 5 down to 1 {
		print "", i
	}
	println
	for i in 0 to 20 by 5 {
		print "", i
	}
	println
	for i in 10 down to 0 by 3 {
		print "", i
	}
	println
	for unsigned i in 3 down to 0 {
		print "", i
	}
	println
	for unsigned char b in 250 to 255 {
		print "", (int)b
	}
	println
	for char c in 'a' to 'e' {
		print c
	}
	println
	for c in 'v' to 'z' {
		print c
	}
	println
	unsigned long n = 4
	for i in n {
		print "", i, sizeof i
	}
	println
	for i in 5 to 1 {
		println "never"
	}
	for i in 10 {
		if i == 2 {
			continue
		}
		if i == 5 {
			break
		}
		print "", i
	}
	println
	int lim = 3
	for long i in lim {
		print "", i, sizeof i
	}
	println
	for i in 2147483645 to 2147483647 {
		print "", i
	}
	println
	for i in 3 {
		for j in i {
			print "", i * 10 + j
		}
	}
	println
}

### call_rules
// exit: 3
//> 5
//> 6
//> 6
//> 3
//> 1 2
//> 1 2
//> 6
//> 5 5 10
//> 6 9
//> 8 7
//> 56 112 56
//> 224 224
//> 16
//> 4
//> 4
//> 0123
use strings
object win {
	int w
	int h
	int area const {
		return w * h
	}
	void resize int nw, int nh {
		w = nw
		h = nh
	}
	win twice const {
		return win{w * 2, h * 2}
	}
}
int add int a, int b {
	return a + b
}
int tick {
	return 7
}
int sq int x {
	return x * x
}
int main {
	int a = 1
	int b = 2
	print a + b * 2
	println
	print (a + b) * 2
	println
	print(a + b) * 2
	println
	println(a + b)
	println (a), b
	println(a), b
	int n = (add a, b) * 2
	println n
	str s = "hello"
	int len = (int)strlen(s)
	unsigned long l2 = strlen s
	unsigned long l3 = (strlen s) + 5
	println len, l2, l3
	println add(a, b) * 2, sq 3
	println tick + 1, tick
	win w = {3, 4}
	w.resize 5, 6
	w.resize(7, 8)
	println w.area, w.area * 2, w.area()
	println w.twice.area, w.twice().area()
	int m = sq a + 3
	println m
	int k = sq(a) + 3
	println k
	println sq (a) + 3
	if sq 2 == 4 {
		println "four"
	}
	for i in sq 2 {
		print i
	}
	println
	return add a, b
	// (exit status 3)
}

### string_tools
// panic: index 20 is out of bounds for a string of length 9
//> John Joan 4 4
//> desserts  a
//> >abcdefg! 9 > !
//> jello hello
//> f
//> jfllo
//> 4 10
//> 24 6
//> [] 0
//> John Joan
//> false true
str reverse_str const str &text {
	str out = text.copy
	long n = text.length
	for i in n / 2 {
		char c = out[i]
		out[i] = out[n - 1 - i]
		out[n - 1 - i] = c
	}
	return out
}
int total const int xs[] {
	int t = 0
	for i in xs.length {
		t += xs[i]
	}
	return t
}
object box {
	int w
	int h
	int area const {
		return w * h
	}
}
int five {
	return 5
}
const str HELLO = "hello"
int main {
	str name = "John"
	str name_cpy = name.copy
	name_cpy[2] = 'a'
	name_cpy[3] = 'n'
	println name, name_cpy, name.length, name.copy().length
	println reverse_str("stressed"), reverse_str(""), reverse_str("a")
	str s = "ab" + "cd"
	s += "ef"
	s += 'g'
	s = s + '!'
	s = '>' + s
	println s, s.length, s[0], s[s.length - 1]
	str h = HELLO.copy
	h[0] = 'j'
	println h, HELLO
	char c = h[1]
	c++
	println c
	h[1] += 1
	println h
	int nums[4] = {1, 2, 3, 4}
	println nums.length, total(nums)
	box b = {3, 4}
	println b.area * 2, five + 1
	str empty
	println "[" + empty + "]", empty.length
	str x = name + " " + name_cpy
	println x
	println x == "John Jaan", x != name
	println x[20]
}

### string_append_growth
//> 1288890 3 abcdabcdefgh 12
//> cat dog
//> [] 0 [x] 1
//> 0123456789012345678901234567890123456789 40
int main {
	// many small appends (the buffer grows in place)
	str s
	for i in 200000 {
		s += i.text
		s += ' '
	}
	long sevens = 0
	for i in 100 {
		if s[i] == '7' {
			sevens++
		}
	}
	// appending to a literal, to itself, and a char
	str lit = "ab"
	lit += "cd"
	lit += lit
	lit += 'e'
	lit += "fgh"
	println s.length, sevens, lit, lit.length
	// the original is untouched when a copy grows
	str a = "cat"
	str b = a.copy
	b += " and more text to make it grow"
	b = "dog"
	println a, b
	// empty appends
	str e
	e += ""
	str x = "x"
	x += ""
	println "[" + e + "]", e.length, "[" + x + "]", x.length
	// growing past the first buffer, then reading back
	str d
	for i in 40 {
		d += (char)('0' + i % 10)
	}
	println d, d.length
}

### minus_starts_an_argument
//> 7 7 4 6
//> 4 -1 9 5
//> -8 -6
//> 2 2 2
//> 9 4
//> said -5
use standard

int twice int x {
	return x * 2
}

int tick {
	return 10
}

void say int n {
	println "said", n
}

object box {
	int Size

	int grow int n {
		return Size + n
	}

	int less const {
		return Size -1
	}
}

int main {
	int A = abs -7
	long L = labs -7
	println A, L, (abs -7 + 3), (abs -2 * 3)
	int n = 5
	println n -1, n - 2 * 3, tick -1, tick - 2 * 3 + 1
	int Twice = twice -4
	println Twice, twice -4 + 1
	box B = {.Size = 3}
	println (B.grow -1), B.Size -1, B.less
	int twice = 10
	println twice -1, twice - 2 * 3
	say -5
	return 0
}

### reading_input
// stdin: Ada\n  41 \nforty\n2.5e1\r\n\nlast
//> Name? Hello, Ada!
//> 42
//> false true
//> 50.0
//> [] false
//> [last] false
//> [] true
//> 42 true false true 1000.0 false false true 0.5 -2147483648
int main {
	str Name = input "Name? "
	println "Hello,", Name + "!"
	str Age = read_line
	println Age.to_int + 1
	str Word = read_line
	println Word.is_int, Word.is_number == false
	println read_line.to_double * 2
	str Empty = read_line
	println "[" + Empty + "]", end_of_input
	str Last = read_line
	println "[" + Last + "]", end_of_input
	str Nothing = read_line
	println "[" + Nothing + "]", end_of_input
	println " 42 ".to_int, "-7".is_int, "2147483648".is_int, "2147483648".is_long, "1e3".to_double, "abc".is_number, "".is_int, "3.".is_number, ".5".to_double, "-2147483648".to_int
	return 0
}

