### images_changed
// pictures changed into new ones: scaled, cut out, turned, mirrored,
// grayed, blurred; and text, in the font built in (the same everywhere)
use images

int main {
	images.picture P = images.new 200, 100
	P.fill_with "white"
	P.set_color "red"
	P.fill_rectangle 0, 0, 100, 50
	P.set_color "blue"
	P.fill_rectangle 100, 50, 100, 50
	images.picture S = P.scaled 100, 50
	println "scaled:", S.width, S.height, S.red(10, 10), S.blue(75, 40), S.red(49, 24), S.green(50, 25)
	images.picture Big = P.scaled 400, 200
	println "bigger:", Big.width, Big.height, Big.red(20, 20), Big.blue(380, 180)
	images.picture C = P.cropped 90, 40, 50, 50
	println "cut out:", C.width, C.height, C.red(0, 0), C.blue(20, 20)
	images.picture Edge = P.cropped 180, 80, 50, 50
	println "at the edge:", Edge.width, Edge.height
	images.picture T = P.turned 90
	println "a quarter turn:", T.width, T.height, T.red(99, 0), T.blue(0, 199)
	images.picture Back = T.turned -90
	println "and back:", Back.width, Back.height, Back.pixel(0, 0) == P.pixel(0, 0), Back.pixel(199, 99) == P.pixel(199, 99)
	images.picture Half = P.turned 180
	println "upside down:", Half.blue(0, 0), Half.red(199, 99)
	images.picture R = P.turned 45
	println "45 degrees:", R.width, R.height, R.pixel(0, 0)
	images.picture M = P.mirrored
	println "mirrored:", M.red(199, 0), M.blue(0, 99)
	images.picture F = P.flipped
	println "flipped:", F.red(0, 99), F.blue(199, 0)
	images.picture G = P.gray
	println "gray:", G.red(10, 10), G.green(10, 10), G.blue(10, 10), G.red(150, 75)
	images.picture B = P.blurred 6
	println "blurred:", B.red(100, 25), B.green(100, 25) > 0, B.green(100, 25) < 255, B.green(5, 5)
	images.picture Fit = P.scaled_to_fit 50, 50
	images.picture Same = P.scaled_to_fit 1000, 1000
	images.picture Twice = P.scaled_by 2
	println "fit:", Fit.width, Fit.height, Same.width, Same.height, Twice.width, Twice.height
	println "the first, as it was:", P.width, P.height, P.red(10, 10)

	images.picture W = images.new 40, 20
	W.fill_with "white"
	W.set_color "black"
	images.set_font "builtin", 16
	W.text 0, 0, "Hi"
	int Ink = 0
	for Y in 20 {
		for X in 40 {
			if W.red(X, Y) == 0 {
				Ink++
			}
		}
	}
	println "text:", Ink, images.text_width("Hi"), images.text_width("Hello\nyou")
	images.set_font "builtin", 32
	println "bigger text:", images.text_width("Hi")
	return 0
}
//> scaled: 100 50 255 255 255 0
//> bigger: 400 200 255 255
//> cut out: 50 50 255 255
//> at the edge: 20 20
//> a quarter turn: 100 200 255 255
//> and back: 200 100 true true
//> upside down: 255 255
//> 45 degrees: 213 213 0
//> mirrored: 255 255
//> flipped: 255 255
//> gray: 54 54 54 18
//> blurred: 255 true true 0
//> fit: 50 25 200 100 400 200
//> the first, as it was: 200 100 255
//> text: 52 16 40
//> bigger text: 32
