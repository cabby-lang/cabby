### html_reading
//> Cabby Weekly
//> Kinds are here | headline big
//> full story https://cabby.dev/kinds
//> tea 3.5
//> cake 5.0
//> 2 5 true none
//> 2 2 3 2
//> One Two a b 1 2 3 x y © ☺
use html

int main {
	str Text = "<html><head><title>Cabby Weekly</title></head><body>"
	Text += "<h1 class='headline big'>Kinds are here</h1>"
	Text += "<p>Read the <a href=\"https://cabby.dev/kinds\">full story</a>.<p>Second &amp; last <br> line"
	Text += "<ul id=prices><li class=price data-item=tea>3.50<li class=price data-item=cake>5.00</ul>"
	Text += "<script>if (a < b) {}</script></body></html>"
	html Page = html.read Text
	println Page.find("title")
	println Page.find("h1.headline").text, "|", Page.find("h1").attribute("class")
	for Link in Page.find_all "a" {
		println Link.text, Link.attribute "href"
	}
	for Price in Page.find_all "#prices > li.price" {
		println Price.attribute("data-item"), Price.text.to_double
	}
	element Missing = Page.find "table"
	println Page.find_all("p").length, Page.find("body").children.length, Missing.is_missing, Page.find("a").attribute_or("title", "none")
	html P = html.read "<DIV ID=Main><P>One<P>Two<UL><LI>a<LI>b</UL><TABLE><TR><TD>1<TD>2<TR><TD>3</TABLE>x&nbsp;y &copy; &#x263A;</DIV>"
	println P.find_all("p").length, P.find_all("li").length, P.find_all("td").length, P.find_all("tr").length
	println P.find("div").text
	return 0
}

### html_building
