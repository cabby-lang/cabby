### events_timers
//> tick 1
//> tick 2
//> once, running: true
//> tick 3
//> tick 4
//> tick 5
//> done: 5
//> stopping the loop
//> after stop, still running: true
use events

object clock {
	timer Tick
	timer Once
	int Count

	clock {
		Tick.on_tick show
		Tick.every time.milliseconds(100)
		Once.on_tick half
		Once.after time.milliseconds(250)
	}

	inner void show {
		Count++
		println "tick", Count
		if Count == 5 {
			Tick.stop
		}
	}

	inner void half {
		println "once, running:", Tick.is_running
	}
}

object quitter {
	timer T
	quitter {
		T.on_tick quit
		T.every time.milliseconds(30)
	}
	inner void quit {
		println "stopping the loop"
		events.stop
	}
}

int main {
	clock C
	events.run
	println "done:", C.Count
	quitter Q
	events.run
	println "after stop, still running:", Q.T.is_running
	return 0
}

### events_with_a_process
//> process says: line 1
//> process says: line 2
//> process says: line 3
//> ended; the timer beat true times while waiting
//> events.run is over
use events
use processes

object watcher {
	process Job
	timer Beat
	int Beats

	watcher {
		Job.on_line got_line
		Job.on_end finished
		Beat.on_tick beat
	}

	void go {
		Job.start "for i in 1 2 3; do echo line $i; sleep 0.1; done"
		Beat.every time.milliseconds(70)
	}

	inner void got_line {
		println "process says:", Job.line
	}

	inner void beat {
		Beats++
	}

	inner void finished {
		Beat.stop
		println "ended; the timer beat", Beats > 2, "times while waiting"
	}
}

int main {
	watcher W
	W.go
	events.run
	println "events.run is over"
	return 0
}

### bytes_basics
//> 48 69 00 ff
//> 4 72 255 H
//> 72,105,0,255,
//> true true false 1 -1
//> Hi
//> 69 00
//> 00000000  48 69 00 ff                                       |Hi..|
//> 07 07 07
use bytes

int main {
	bytes B = "Hi"
	B.add 0
	B.add 255
	println B
	println B.length, B[0], B[3], (char)B[0]
	for X in B {
		print X.text + ","
	}
	println ""
	str Text = "Hi"
	bytes Same = Text                  // read, not moved: Text is still usable
	bytes Hi = Text
	println B.starts_with(Same), Same.same_as(Hi), Same.same_as(B), B.find(bytes.from_hex("69")), B.find("x")
	println Text
	println B.part(1, 2)
	println B.dump
	println bytes.filled(3, 7)
	return 0
}

### bytes_numbers
//> 80 02 00 00 00 00 02 80
//> 640 640 -2147352576
//> ff ff -1 65535
//> 2.5 2.5 -7
//> 4294967295 9000000000
//> 01 00 00 00
use bytes

int main {
	bytes B
	B.add_int 640
	B.add_int_big 640
	println B
	println B.int_at(0), B.int_at_big(4), B.int_at_big(0)
	bytes S
	S.add_short 65535
	println S, S.short_at(0), S.unsigned_short_at(0)
	bytes D
	D.add_double 2.5
	D.add_double_big 2.5
	D.add_long -7
	println D.double_at(0), D.double_at_big(8), D.long_at(16)
	bytes U
	U.add_int -1
	U.add_long_big 9000000000
	println U.unsigned_int_at(0), U.long_at_big(4)
	bytes C = bytes.filled(4, 0)
	C.set_int_at 0, 1
	int First = C[0]
	C[0] = First
	println C
	return 0
}

### bytes_files
//> 10
//> 00 01 02 03 04 05 06 07 08 09 aa bb
//> 2 4 12
//> 02 03 04 63 64 65
//> 12 12
//> line one
//> two
use files

int main {
	bytes B
	for i in 10 {
		B.add i
	}
	files.write_bytes "cabby-test.bin", B
	println files.size("cabby-test.bin")
	files.append_bytes "cabby-test.bin", bytes.from_hex("aa bb")
	println files.read_bytes("cabby-test.bin")
	file F = files.open_to_change "cabby-test.bin"
	F.move_to 2
	bytes Got = F.read_bytes 3
	F.write_bytes "cde"
	println Got[0], F.read_bytes(0).length + 4, F.size
	F.move_to 2
	println F.read_bytes(6)
	F.move_to_end
	println F.position, F.read_bytes(5).length + 12
	file W = files.open_to_write "cabby-test.txt"
	W println "line one"
	W.write_bytes "two"
	file R = files.open "cabby-test.txt"
	println R.read_line
	println R.read_bytes(10).str
	files.delete "cabby-test.bin"
	files.delete "cabby-test.txt"
	return 0
}

