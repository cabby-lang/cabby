	S[S[0]] = S[S[1]]
	println S[0], S[1], S[2]
	int K = 5
	Flags[K] = true
	return 0
}

### lookup_number_keys
// (keys of each size: found in place when compiled)
//> 3 2 8
//> YES no true
//> 11 2 3 4 false
//> 7 8 false
//> 1
//> 1000 2000000 335 false
//> 1417 again
int main {
	lookup char int Letters
	for C in "hello world" {
		if Letters.contains(C) {
			Letters[C] += 1
		} else {
			Letters[C] = 1
		}
	}
	println Letters['l'], Letters['o'], Letters.length
	lookup bool str Names
	Names[true] = "yes"
	Names[false] = "no"
	Names[true] = "YES"
	println Names[true], Names[false], Names.contains(true)
	lookup long int Big
	Big[-5] = 1
	Big[9000000000] = 2
	Big[-9000000000] = 3
	Big[0] = 4
	Big[-5] += 10
	println Big[-5], Big[9000000000], Big[-9000000000], Big[0], Big.contains(5)
	lookup short int Small
	Small[-1] = 7
	Small[32767] = 8
	println Small[-1], Small[32767], Small.contains(1)
	lookup unsigned int int U
	U[4000000000] = 1
	println U[4000000000]
	lookup int str Grow
	for i in 2000 {
		Grow[i * 3 - 1000] = i.text
	}
	for i in 1000 {
		Grow.remove i * 6 - 1000
	}
	long Sum = 0
	for K, V in Grow {
		Sum += K
	}
	println Grow.length, Sum, Grow[5], Grow.contains(-1000)
	for i in 500 {
		Grow[i] = "again"
	}
	println Grow.length, Grow[3]
	return 0
}

### bytecode_switch
// (switch in bytecode: falling through, break, continue)
//> a 11
//>   -1
//> y 10
//> z 100
//> 120
//> red green other
//> four x4
//> 3
//> 6
enum colour {
	RED
	GREEN
	BLUE
}

str name colour C {
	switch C {
		case RED:
			return "red"
		case GREEN:
			return "green"
		default:
			return "other"
	}
}

int score char C {
	int S = 0
	switch C {
		case 'a':
		case 'e':
		case 'o':
			S += 1
		case 'y':
			S += 10
			break
		case ' ':
			S = -1
			break
		default:
			S = 100
	}
	return S
}

int main {
	int Total = 0
	for C in "a yz" {
		Total += score(C)
		println C, score(C)
	}
	println Total
	println name(RED), name(GREEN), name(BLUE)
	int Odd = 0
	for I in 10 {
		switch I % 3 {
			case 0:
				continue
			case 1:
				Odd++
		}
		if I > 7 {
			break
		}
		str Text = "x" + I.text
		switch I {
			case 4:
				println "four", Text
		}
	}
	println Odd
	int N = 0
	while true {
		N++
		switch N {
			case 5:
				break
		}
		if N >= 6 {
			break
		}
	}
	println N
	return 0
}

### bytecode_object_init
// (objects made with number fields, in bytecode)
//> 0 1 w0 false
//> gone w0
//> 5 2 w5 false
//> gone w5
//> 10 3 w10 false
//> gone w10
//> 4.0 2.5 0
//> 12 7
//> gone w12
object box {
	int W
	int H
	str Label
	bool Big

	box {
		Label = "w" + W.text
		Big = W * H > 50
	}

	~box {
		println "gone", Label
	}
}

struct pt {
	double X
	double Y
	int Tag
}

int counter = 0

int next {
	counter++
	return counter
}

int main {
	for I in 3 {
		box B = {.W = I * 5, .H = next()}
		println B.W, B.H, B.Label, B.Big
	}
	pt P = {.Y = 2.5, .X = (double)next()}
	println P.X, P.Y, P.Tag
	int K = 7
	box C = {.H = K, .W = K + next()}
	println C.W, C.H
	return 0
}

### patterns_own_matcher
// (patterns matches by itself: lazy repeats, \b, \1, looking ahead, and
// the first alternative that works)
//> [<a>, <b>] [<a><b>]
//> [cat, cat]
//> [ll, aa, bb, cc]
//> [x, x] [x]
//> abcd [a, bcd, ]
//> cat
//> [Ada, Lovelace, Σοφία]
//> 3000 x
//> [12, 34] [123, 45]
//> true false true
//> [Cabby, CABBY] true
//> 1,234,567
// panic: the pattern '\2(a)' has \2, but only 1 ( ) part
use patterns

int main {
	println patterns.make("<.+?>").find_all("<a><b>"), patterns.make("<.+>").find_all("<a><b>")
	println patterns.make("\\bcat\\b").find_all("cat concat cat's bobcat")
	println patterns.make("(\\w)\\1").find_all("hello aabb cc")
	println patterns.make("x(?=y)").find_all("xy xz xy"), patterns.make("x(?!y)").find_all("xy xz xy")
	patterns.pattern Tricky = patterns.make "(a|ab)(c|bcd)(d*)"
	println Tricky.find("abcd"), Tricky.parts("abcd")
	println patterns.make("cat|category").find("category")
	println patterns.make("[[:upper:]][[:lower:]]+").find_all("Ada Lovelace ΣΟΦΙΑ Σοφία")
	patterns.pattern Each = patterns.make "(.)*"
	println Each.find("x".repeat(3000)).length, Each.parts("x".repeat(3000))[0]
	println patterns.make("\\d{2,3}?").find_all("12345"), patterns.make("\\d{2,3}").find_all("12345")
	println patterns.make("colou?r").matches("colour"), patterns.make("a|ab").matches("abc"), patterns.make("a|ab").matches("ab")
	patterns.pattern Name = patterns.make_ignoring_case "\\bcabby\\b"
	println Name.find_all("Cabby cabbyish CABBY"), patterns.make_ignoring_case("(a)\\1").matches("aA")
	println patterns.make("\\B(?=(\\d{3})+$)").replace_all("1234567", ",")
	patterns.pattern Bad = patterns.make "\\2(a)"
	return 0
}

### patterns_behind_and_named
// (looking behind, a letter at a time; parts with names, in a pattern and
// in what replaces it)
//> [12, 7] [30, 8]
//> [x, x] [a, c, e]
//> 2026 11 [year, month, ] false true
//> 16/11/2026 is is
// panic: the pattern '(x)' has no part named y
use patterns

int main {
	println patterns.make("(?<=\\$)\\d+").find_all("$12, €30, $7"), patterns.make("(?<!\\$)\\b\\d+").find_all("$12, 30, $7, 8")
	println patterns.make("(?<=é)x").find_all("éx ax éx"), patterns.make("(?<=^|,)\\w").find_all("ab,cd,ef")
	patterns.pattern Date = patterns.make "(?<year>\\d{4})-(?<month>\\d\\d)-(\\d\\d)"
	println Date.part("year", "on 2026-11-16"), Date.part("month", "on 2026-11-16"), Date.part_names, Date.has_part("day"), Date.has_part("year")
	println Date.replace_all("2026-11-16", "\\3/\\k<month>/\\k<year>"), patterns.make("(?<w>\\w+) \\k<w>").find("it is is so")
	println patterns.make("(x)").part("y", "x")
	return 0
}

### html_pseudo_classes
// (pseudo-classes, + and ~, and attribute tests; dc:creator is still a name)
//> tea bread tea
//> [tea, jam] [cake, bread] [tea, cake, jam]
//> [jam, bread] [cake]
//> [tea, jam, bread] jam [jam, bread]
//> 1 0 1 1
//> [a1, a3] [a2] [a4] [a1] [a3]
//> first last first only
//> [x, y] 1 [z]
//> 5 4
//> Ada
// panic: about a page being shown
use html
use xml

list str texts const list element &Found {
	list str Texts
	for Each in Found {
		Texts.add Each.text
	}
	return Texts
}

int main {
	html Page = html.read "<ul><li>tea</li><li class='sale'>cake</li><li>jam</li><li>bread</li></ul>"
	println Page.find("li:first-child").text, Page.find("li:last-child").text, Page.find("li:nth-child(1)").text
	println texts(Page.find_all("li:nth-child(odd)")), texts(Page.find_all("li:nth-child(2n)")), texts(Page.find_all("li:nth-child(-n+3)"))
	println texts(Page.find_all("li:nth-last-child(-n+2)")), texts(Page.find_all("li:is(.sale, .none)"))
	println texts(Page.find_all("li:not(.sale)")), Page.find(".sale + li").text, texts(Page.find_all(".sale ~ li"))
	html Doc = html.read "<div><p>one</p><img src='a.png'></div><div><span>two</span></div><h2>t</h2><p>after</p>"
	println Doc.find_all("div:has(img)").length, Doc.find_all("div:has(> p > img)").length, Doc.find_all("div:has(> span)").length, Doc.find_all("h2:has(+ p)").length
	html Links = html.read "<a href='https://x.org/a.pdf' id='a1'>1</a><a href='http://y.org' id='a2' lang='en-GB'>2</a><a href='https://z.org/b' id='a3' class='big red'>3</a><a href='ftp://w' id='a4' lang='fr'>4</a>"
	list str Ids
	for A in Links.find_all "a[href^=https]" {
		Ids.add A.attribute("id")
	}
	list str Lang
	for A in Links.find_all "[lang|=en]" {
		Lang.add A.attribute("id")
	}
	list str Big
	for A in Links.find_all "a[class~=red]" {
		Big.add A.attribute("id")
	}
	list str Ftp
	for A in Links.find_all "a[href$=w]" {
		Ftp.add A.attribute("id")
	}
	list str Has
	for A in Links.find_all "a[href*='.org/']:not([id=a3])" {
		Has.add A.attribute("id")
	}
	println Ids, Lang, Ftp, Has, Big
	html Kinds = html.read "<div><h1>h</h1><p>first</p><p>mid</p><p>last</p><em>only</em></div>"
	println Kinds.find("p:first-of-type").text, Kinds.find("p:last-of-type").text, Kinds.find("p:nth-of-type(1)").text, Kinds.find("em:only-of-type").text
	html Form = html.read "<input value='x' checked><input value='y' disabled><input value='z'><p></p><p> </p>"
	list str Checked
	for I in Form.find_all ":is(input:checked, input:disabled)" {
		Checked.add I.attribute("value")
	}
	list str On
	for I in Form.find_all "input:enabled:not(:checked)" {
		On.add I.attribute("value")
	}
	println Checked, Form.find_all("p:empty").length, On
	println Form.find_all(":root").length, Page.find_all(":root > *").length
	xml Feed = xml.read "<rss><item><dc:creator>Ada</dc:creator></item></rss>"
	println Feed.find("item > dc:creator:first-child").text
	Page.find "a:hover"
	return 0
}

### databases_statements_records_bytes
// (statements made once, values of any kind, records into structs, bytes;
// and a struct called item, which json.hby has a method called)
//> rows: 2 last id: 2
//> [{"name":"milk","price":2.1,"stock":3,"note":"cold","photo":null},{"name":"bread","price":4.5,"stock":12,"note":null,"photo":"89504e470001"}]
//> milk 2.1 3
//> bread 4.5 12
//> 6 true 1
//> 0
//> milk
//> 2
// panic: it has 1 ?s, and 2 values were given
use databases

struct item {
	str Name
	double Price
	int Stock
}

int main {
	databases.database Shop = databases.open ":memory:"
	Shop.run "create table items (name text, price real, stock integer, note text, photo blob)"
	databases.statement Add = Shop.prepare "insert into items values (?, ?, ?, ?, ?)"
	Add.add_text "bread"
	Add.add_number 4.5
	Add.add_whole 12
	Add.add_nothing
	Add.add_bytes bytes.from_hex("89 50 4e 47 00 01")
	Add.run
	Add.add_text "milk"
	Add.add_number 2.1
	Add.add_whole 3
	Add.add_text "cold"
	Add.add_nothing
	Add.run
	println "rows:", Shop.value("select count(*) from items"), "last id:", Shop.last_id
	json All = Shop.records "select name, price, stock, note, photo from items order by price"
	println All.text
	for Row in All {
		item I
		Row.fill I
		println I.Name, I.Price, I.Stock
	}
	bytes Photo = Shop.bytes_value_with("select photo from items where name = ?", {"bread"})
	println Photo.length, Photo.starts_with(bytes.from_hex("89 50 4e 47")), Photo[5]
	println Shop.bytes_value("select photo from items where name = 'none'").length
	databases.statement Find = Shop.prepare "select name from items where price < ?"
	Find.add_number 3
	println Find.value
	println Find.rows_with({"5"}).length
	Find.add_text "x"
	Find.add_text "y"
	Find.run
	return 0
}

