// Argon2id passwords (OpenSSL 3.2 or later: run_secrets_tests.sh skips
// this where there isn't one): hashes made by Argon2's own reference
// program, then Cabby's own.
//> reference, checked: true false
//> reference, 4 lanes: true
//> hashed: true, starts $argon2id$v=19$m=65536,t=3,p=4$, twice the same: false
//> checked: true false
//> pbkdf2 still: true
use secrets

int main {
	str Reference = "$argon2id$v=19$m=19456,t=2,p=1$c2FsdHNhbHRzYWx0c2FsdA$AdweBLwcflnNX2HVW8i1Mtu7frrn4Ki7h/rYSGuU7Is"
	println "reference, checked:", secrets.check_password("correct horse", Reference), secrets.check_password("correct horses", Reference)
	str Lanes = "$argon2id$v=19$m=65536,t=3,p=4$MDEyMzQ1Njc4OWFiY2RlZg$Fo9G0NB3jwnyipFQRefqOSUD4msnbYq6V0zqWeG02JE"
	println "reference, 4 lanes:", secrets.check_password("Ἀρχὴ", Lanes)
	str Hash = secrets.hash_password_argon2 "hunter2"
	str Head = "$argon2id$v=19$m=65536,t=3,p=4$"
	println "hashed: " + secrets.can_use_argon2.text + ", starts " + Hash[to Head.length - 1] + ", twice the same:", Hash == secrets.hash_password_argon2("hunter2")
	println "checked:", secrets.check_password("hunter2", Hash), secrets.check_password("hunter3", Hash)
	println "pbkdf2 still:", secrets.check_password("x", secrets.hash_password("x"))
	return 0
}
