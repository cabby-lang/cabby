// Public keys (Ed25519): RFC 8032's examples, then signing and checking.
//> public key (RFC 8032, 1): true
//> signature (RFC 8032, 1): true
//> public key (RFC 8032, 2): true
//> signature (RFC 8032, 2): true
//> checked: true
//> lengths: 44 44 88
//> checks: true false false false
//> unicode: true
//> a different key each time: true
//> panic next
// panic: that isn't a private key
use secrets

int main {
	str Private1 = "nWGxne/9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A="
	str Public1 = "11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo="
	str Signed1 = "5VZDAMNgrHKQhuLMgG6CioSHfx645dl02HPgZSJJAVVfuIIVkKM7rMYeOXAc+bRr0lv18FlbviRlUUFDjnoQCw=="
	println "public key (RFC 8032, 1):", secrets.public_key(Private1) == Public1
	println "signature (RFC 8032, 1):", secrets.sign("", Private1) == Signed1
	str Private2 = "TM0Imyj/ltqdtsNG7BFOD1uKMZ81q6Yk2oz27U+4pvs="
	str Public2 = "PUAXw+hDiVqStwqnTRt+vJyYLM8uxJaMwM1V8Sr0Zgw="
	str Signed2 = "kqAJqfDUyrhyDoILX2QlQKKye1QWUD+Ps3YiI+vbadoIWsHkPhWZbkWPNhPQ8R2MOHsurrQwKu6wDSkWErsMAA=="
	println "public key (RFC 8032, 2):", secrets.public_key(Private2) == Public2
	println "signature (RFC 8032, 2):", secrets.sign("r", Private2) == Signed2
	println "checked:", secrets.check_signed("r", Public2, Signed2)

	str Private = secrets.make_private_key
	str Public = secrets.public_key Private
	str Signature = secrets.sign "Pay Bo 5 dollars.", Private
	println "lengths:", Private.length, Public.length, Signature.length
	bool Right = secrets.check_signed "Pay Bo 5 dollars.", Public, Signature
	bool Changed = secrets.check_signed "Pay Bo 500 dollars.", Public, Signature
	bool OtherKey = secrets.check_signed "Pay Bo 5 dollars.", Public2, Signature
	bool NotOne = secrets.check_signed "Pay Bo 5 dollars.", Public, "not a signature"
	println "checks:", Right, Changed, OtherKey, NotOne
	println "unicode:", secrets.check_signed("Λόγος", Public, secrets.sign("Λόγος", Private))
	println "a different key each time:", secrets.make_private_key != Private
	println "panic next"
	secrets.sign "x", "short"
	return 0
}
