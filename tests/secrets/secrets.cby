// The secrets library: standard examples for what it's built on, then
// each of its own.
//> pbkdf2 (RFC 7914): 55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783
//> pbkdf2, 80000 rounds: 4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d
//> gcm (NIST, case 14): cea7403d4d606b6e074ec5d3baf39d18d0d1c8a799996bf0265b98b5d48ab919
//> gcm (NIST, case 15): 522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662898015adb094dac5d93471bdec1a502270e3cc6c
//> hmac (RFC 4231, case 2): 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
//> signature checks: true false
//> random numbers in 1 to 6: true, all six: true
//> random text: 22 true
//> passwords: 16 true true
//> random bytes: 32 different: true
//> hashed: true, starts $pbkdf2-sha256$600000$, twice the same: false
//> checked: true false
//> not a hash: false
//> unlocked: The safe's code is 4812. Ünïcödé too.
//> locked twice the same: false
//> wrong password: false
//> changed: false
//> bytes: true 256
//> file: true Scales: C, G and D.
//> file, wrong password: false
//> same: true false false
//> panic next
// panic: it can't be unlocked: the password is wrong
use secrets
use files

extern long cby_secrets_test_pbkdf2 str password, str salt, long rounds, long length
extern long cby_secrets_test_gcm str key, str iv, str plain

int main {
	println "pbkdf2 (RFC 7914):", secrets_handed(cby_secrets_test_pbkdf2("passwd", "salt", 1, 64))
	println "pbkdf2, 80000 rounds:", secrets_handed(cby_secrets_test_pbkdf2("Password", "NaCl", 80000, 64))
	str Zero = "0".repeat 64
	println "gcm (NIST, case 14):", secrets_handed(cby_secrets_test_gcm(Zero, "000000000000000000000000", "00000000000000000000000000000000"))
	str Key = "feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308"
	str Plain = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"
	println "gcm (NIST, case 15):", secrets_handed(cby_secrets_test_gcm(Key, "cafebabefacedbaddecaf888", Plain))
	println "hmac (RFC 4231, case 2):", secrets.shared_signature("what do ya want for nothing?", "Jefe")
	str Sig = secrets.shared_signature "pay Ana 50", "shared key"
	println "signature checks:", secrets.check_shared_signature("pay Ana 50", "shared key", Sig), secrets.check_shared_signature("pay Ana 500", "shared key", Sig)

	lookup long bool Seen
	bool InRange = true
	for I in 300 {
		long N = secrets.random_number 1, 6
		InRange = InRange && N >= 1 && N <= 6
		Seen[N] = true
	}
	println "random numbers in 1 to 6: " + InRange.text + ", all six:", Seen.length == 6
	str T = secrets.random_text 22
	bool Safe = true
	for i in T.length {
		char C = T[i]
		Safe = Safe && (C >= 'a' && C <= 'z' || C >= 'A' && C <= 'Z' || C >= '0' && C <= '9' || C == '-' || C == '_')
	}
	println "random text:", T.length, Safe
	str P = secrets.random_password 16
	str Plain2 = secrets.random_password_without_symbols 12
	println "passwords:", P.length, P != secrets.random_password(16), !Plain2.contains("!")
	bytes R = secrets.random_bytes 32
	println "random bytes:", R.length, "different:", !R.same_as(secrets.random_bytes(32))

	str Kept = secrets.hash_password "correct horse battery"
	println "hashed: true, starts " + Kept[to 21] + ", twice the same:", Kept == secrets.hash_password("correct horse battery")
	println "checked:", secrets.check_password("correct horse battery", Kept), secrets.check_password("correct horse", Kept)
	println "not a hash:", secrets.check_password("x", "plain text")

	str Locked = secrets.lock "The safe's code is 4812. Ünïcödé too.", "hunter2"
	println "unlocked:", secrets.unlock(Locked, "hunter2")
	println "locked twice the same:", Locked == secrets.lock("The safe's code is 4812. Ünïcödé too.", "hunter2")
	println "wrong password:", secrets.can_unlock(Locked, "hunter3")
	str Changed = Locked[to 39] + "A" + Locked[41 to]
	if Locked[40] == 'A' {
		Changed = Locked[to 39] + "B" + Locked[41 to]
	}
	println "changed:", secrets.can_unlock(Changed, "hunter2")

	bytes All
	for I in 256 {
		All.add I
	}
	bytes Back = secrets.unlock_bytes secrets.lock_bytes(All, "pw"), "pw"
	println "bytes:", Back.same_as(All), Back.length

	files.write "notes.txt", "Scales: C, G and D."
	secrets.lock_file "notes.txt", "notes.locked", "pw"
	bool Opened = secrets.unlock_file "notes.locked", "notes.again", "pw"
	println "file:", Opened, files.read("notes.again")
	println "file, wrong password:", secrets.unlock_file("notes.locked", "notes.wrong", "nope")
	files.delete "notes.txt"
	files.delete "notes.locked"
	files.delete "notes.again"
	println "same:", secrets.same("abc", "abc"), secrets.same("abc", "abd"), secrets.same("abc", "abcd")
	println "panic next"
	secrets.unlock Locked, "wrong"
	return 0
}
