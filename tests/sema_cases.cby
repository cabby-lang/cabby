### ok_mut_ref_reborrow
// expect: ok
object counter {
	int n
}
void inc counter &c {
	c.n += 1
}
void twice counter &c {
	inc(c)
	inc(c)
	c.n++
}
int main {
	counter c
	twice(c)
	twice(c)
	println c.n
	return 0
}

### ok_loops_and_arrays
// expect: ok
object p {
	int x
}
int sum const int a[], int n {
	int t = 0
	for int i = 0; i < n; i++ {
		t += a[i]
	}
	return t
}
int main {
	int nums[] = {1, 2, 3}
	int total = sum(nums, 3)
	p ps[2] = {p{1}, p{2}}
	for int i = 0; i < 2; i++ {
		total += ps[i].x
	}
	int grid[2][2] = {{1, 2}, {3, 4}}
	grid[1][0] = 9
	println total, grid[1][0], sizeof grid, sizeof(int)
	return 0
}

### ok_upcast_refs_and_static
// expect: ok
object named {
	str name
	void greet const {
		println "hi", name
	}
}
object shape {
	int sides
	double area const {
		return 0.0
	}
}
object square : named, shape {
	double side
	double area const {
		return side * side
	}
	static square make double s {
		return square{.name = "square", .sides = 4, .side = s}
	}
	void grow {
		side *= 2.0
	}
}
void describe const named &n, const shape &s {
	n.greet
	println s.area()
}
int main {
	square sq = square.make(2.0)
	sq.grow
	describe(sq, sq)
	square &r = sq
	r.grow
	describe(r, r)
	return 0
}

### ok_c_conversions
// expect: ok
int main {
	char c = 65
	short s = c
	int i = s
	long l = i
	unsigned u = 7
	unsigned long ul = u
	double d = l
	float f = 1.5
	double d2 = f
	bool b = i
	int narrowed = (int)l
	char back = (char)(c + 1)
	int sum = c + 'a'
	println c, s, i, l, u, ul, d, f, d2, b, narrowed, back, sum
	return 0
}

### ok_logic_and_bits
// expect: ok
int main {
	int x = 0b1010
	bool even = (x & 1) == 0
	bool both = even && x || !x
	int mask = ~x ^ (x << 2) | x >> 1
	double f = (double)x / 3.0
	if x {
		println even, both, mask, f
	}
	while x {
		x >>= 1
	}
	return 0
}

### ok_strings
// expect: ok
object person {
	str name
}
void show const str &s {
	println s
}
int main {
	person p = {"Ada"}
	show(p.name)
	show("literal")
	bool same = p.name == "Ada"
	println same, p.name != "Bob"
	return 0
}

### ok_returns_everywhere
// expect: ok
int classify int n {
	if n < 0 {
		return -1
	} else if n == 0 {
		return 0
	} else {
		return 1
	}
}
int spin {
	int i = 0
	while true {
		i++
		if i > 10 {
			return i
		}
	}
}
int main {
	println classify(-5), spin()
	return 0
}

