### ok_diamond_shared_base
// expect: ok
object A {
	int v
	int who const {
		return 0
	}
}
object B : A {
	int b
	int who const {
		return 1
	}
}
object C : A {
	int c
	int who const {
		return 2
	}
}
object D : B, C {
	int d
}
void show const A &x {
	println x.v, x.who()
}
int main {
	D d = {1, 2, 3, 4}
	show(d)
	println d.v, d.b, d.c, d.d
	return 0
}

