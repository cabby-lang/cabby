### ok_string_tools
// expect: ok
str shout const str &s {
	return s + "!"
}
int main {
	str a = "x"
	str b = a + "y" + 'z'
	b += a
	b += '.'
	b[0] = 'X'
	b[1] += 1
	char c = b[2]
	str d = b.copy
	long n = d.length + a.length
	println shout(b), a, c, n, d.copy().length
	return 0
}

