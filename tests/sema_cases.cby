### ok_two_phase_method_call
// expect: ok
object counter {
	int n
	int get const {
		return n
	}
	void set int v {
		n = v
	}
}
int main {
	counter c
	c.set(c.get() + 1)
	for int i = 0; i < 3; i++ {
		c.set(c.get() * 2)
	}
	println c.get()
	return 0
}

