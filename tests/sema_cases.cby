### err_goto_skips_reinit
// expect: 's' may have been moved
void eat str s {
}
int main {
	str s = "x"
	int n = 1
	eat(s)
	if n == 1 {
		goto out
	}
	s = "y"
	out:
	println s
	return 0
}

