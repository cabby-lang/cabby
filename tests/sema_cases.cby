### threads_worker_global
// expect: 'Count' is a global that can change, and 'counter' (a worker) can reach it from 'work'
use threads

int Count = 0

void bump {
	Count++
}

object counter : threads.worker {
	void work {
		bump
	}
}

int main {
	counter C
	C.start
	return 0
}

### threads_worker_const_global
// expect: ok
use threads

const int STEP = 3

object counter : threads.worker {
	int Count

	void work {
		Count += STEP
	}
}

int main {
	counter C
	C.start
	C.wait
	println C.Count
	return 0
}

### threads_worker_destructor
// expect: a worker can't have a destructor of its own
use threads

object counter : threads.worker {
	void work {
	}

	~counter {
	}
}

int main {
	counter C
	return 0
}

### threads_worker_handler
// expect: a worker can't keep a handler
use threads

object counter : threads.worker {
	handler Told

	void work {
	}
}

int main {
	counter C
	return 0
}

### threads_done_handler_is_the_libraries
// expect: 'DoneHandler' is threads.worker's own
use threads

object sneaky : threads.worker {
	void work {
		DoneHandler.call
	}
}

int main {
	sneaky S
	return 0
}

### threads_message_handler_is_the_libraries
// expect: 'say_message' is threads.worker's own
use threads

object sneaky : threads.worker {
	void work {
		say_message
	}
}

int main {
	sneaky S
	return 0
}

### else_block_after_declaration_must_leave
// expect: 'A' has no value if this fails, so the 'else' block has to leave
use files

int main {
	str A = files.read "x" else {
		println "no"
	}
	println A
	return 0
}

### else_value_has_the_variables_type
// expect: expected 'int' for 'N' (after 'else'), found 'str'
int main {
	int N = "7".to_int else "seven"
	return N
}

### else_value_after_a_call_alone
// expect: 'else' with a value needs something to give it to
use files

int main {
	files.delete "x" else 3
	return 0
}

### else_after_two_declarations
// expect: 'else' goes after one variable's declaration with a value
int main {
	int A, B = 1 else 2
	return A + B
}

### else_after_a_reference
// expect: 'else' can't follow a reference's declaration
int main {
	str A = "x"
	str &R = A else A
	return 0
}

### else_why_is_text
// expect: '+' joins a 'str' with a 'str' or a 'char', not 'int'
int main {
	int N = "x".to_int else Why {
		println Why + 1
		return 1
	}
	return N
}

### else_forms_check
// expect: ok
use files

int main {
	str A = files.read "x" else ""
	int N = A.to_int else Why {
		println Why
		return 1
	}
	N += A.length else 0
	files.delete "x" else { }
	files.delete "x" else Why {
		println Why
	}
	for I in 3 {
		int M = "y".to_int else {
			continue
		}
		println M, I
	}
	return N
}

### list_of_a_base_holds_its_derived
// expect: ok
object shape {
	double area const {
		return 0
	}
}
object square : shape {
	double Side
	double area const {
		return Side * Side
	}
}
int main {
	list shape Shapes
	square S
	Shapes.add S
	shape One = Shapes.take_last
	println One.area
	return 0
}

### list_of_a_derived_takes_no_base
// expect: expected 'square' for an element of 'list square', found 'shape'
object shape {
	int Sides
}
object square : shape {
	int Side
}
int main {
	list square Squares
	shape P
	Squares.add P
	return 0
}

