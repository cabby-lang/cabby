### ok_switch_goto_do
// expect: ok
enum color {
	RED
	GREEN = 5
	BLUE
}
int main {
	int n = 6
	switch n {
		case RED:
			println "red"
			break
		case GREEN:
		case BLUE:
			println "green or blue"
		default:
			println "other"
	}
	do {
		n--
	} while n > 0
	if n == 0 {
		goto done
	}
	println "unreachable in practice"
	done:
	return 0
}

### ok_globals_and_statics
// expect: ok
const int LIMIT = 3
const str GREETING = "hello"
int counter
int table[LIMIT] = {1, 2, 3}
int bump {
	static int calls
	calls++
	counter += calls
	return calls
}
int main {
	bump
	bump
	println GREETING, counter, table[2], bump()
	return 0
}

### ok_struct_union_typedef
// expect: ok
unsigned long aka size_t
struct point {
	int x
	int y
}
union bits {
	float f
	unsigned int u
}
point add point a, point b {
	return point{a.x + b.x, a.y + b.y}
}
int main {
	point a = {1, 2}
	point b = a
	point c = add(a, b)
	bits w
	w.f = 1.0f
	size_t n = sizeof(point)
	println c.x, c.y, w.u, n, a.x
	return 0
}

### ok_implicit_self_and_shadow
