// Tutorial 2: Variables and the basic types
//
// Run it:      cabby 002-variables.cby
// Keywords:    int, double, char, bool, true, false, str
//
// A declaration is the type, then the name, then (optionally) `=` and a
// starting value. Cabby has no uninitialized memory: a variable declared
// without a value starts at zero (0, 0.0, false, the empty string).

int main {
	int Apples = 3          // a whole number
	double Price = 0.45     // a floating-point number
	char Grade = 'A'        // one byte, written in single quotes
	bool Ripe = true        // true or false
	str Name = "Granny Smith"   // a string of text

	println Name, Apples, Price, Grade, Ripe

	// Arithmetic works as you'd expect.
	double Total = Apples * Price
	println "total:", Total

	// Variables can change.
	Apples = Apples + 2
	Apples += 1             // the same as Apples = Apples + 1
	Apples++                // add one more
	println "apples now:", Apples

	// No value given: every variable starts at zero.
	int Count
	double Weight
	bool Done
	str Empty
	println "zeros:", Count, Weight, Done, "[" , Empty, "]"

	// Several variables in one declaration.
	int x = 1, y = 2, z
	println x, y, z

	// Every variable says its type, so a reader never has to work it out.
	double Ratio = 0.75
	long Big = 5000000000   // too big for an int, so long
	str Word = "hi"
	println Ratio, Big, Word

	// Booleans come from comparisons.
	bool Cheap = Price < 1.0
	println "cheap?", Cheap, "expensive?", !Cheap
}

// Try this:
//  - Print `Grade + 1`. A char is also a small number: what do you get?
//    Now try `(char)(Grade + 1)`.
//  - Declare `int n = 2.5`. Cabby refuses, because the .5 would be lost.
//    Then try `int n = (int)2.5`: an explicit cast says "I know".

// ---------------------------------------------------------------- output
//> Granny Smith 3 0.45 A true
//> total: 1.35
//> apples now: 7
//> zeros: 0 0.0 false [  ]
//> 1 2 0
//> 0.75 5000000000 hi
//> cheap? true expensive? false
