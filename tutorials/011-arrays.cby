// Tutorial 11: Arrays
//
// Run it:      cabby 011-arrays.cby
// Topics:      fixed-size arrays, initializers, passing arrays to functions
//
// `int Scores[5]` is five ints, numbered 0 to 4. The size is fixed when the
// array is declared. Every index is checked: reading Scores[5] stops the
// program with a panic instead of reading someone else's memory.

// A parameter written `T name[]` borrows an array of any length; .length
// says how long it is.
int sum const int Xs[] {
	int Total = 0
	for i in Xs.length {
		Total += Xs[i]
	}
	return Total
}

// Without const, the function may change the caller's array.
void double_all int Xs[] {
	for i in Xs.length {
		Xs[i] *= 2
	}
}

int main {
	int Scores[5] = {70, 85, 90, 65, 100}
	println "first:", Scores[0], "last:", Scores[4]

	Scores[3] = 75
	println "sum:", sum(Scores)

	// Missing values are zero; with [] the length comes from the values.
	int Partial[4] = {1, 2}
	int Primes[] = {2, 3, 5, 7, 11}
	println Partial[0], Partial[1], Partial[2], Partial[3]
	println Primes.length, "primes"       // .length: the number of elements

	// Find the largest.
	int Best = Scores[0]
	for i in 1 to Scores.length - 1 {
		if Scores[i] > Best {
			Best = Scores[i]
		}
	}
	println "best:", Best

	double_all Primes
	print "doubled:"
	for i in Primes.length {
		print "", Primes[i]
	}
	println

	// An array of numbers is copied by assignment: changing the copy
	// leaves the original alone.
	int Copy[5] = Scores
	Copy[0] = 0
	println Scores[0], Copy[0]

	// Two dimensions: an array of arrays.
	int Grid[3][3]
	for r in 3 {
		for c in 3 {
			Grid[r][c] = r * 3 + c
		}
	}
	println Grid[1][2], Grid[2][0]

	// Arrays of other types work the same way.
	str Names[3] = {"Ann", "Bo", "Cy"}
	char Word[5] = {'h', 'e', 'l', 'l', 'o'}
	println Names[1], Word[0], Word[4]
}

// Try this:
//  - Read Scores[5]. Look at the panic message: it gives the index, the
//    length and the line.
//  - Write `int count_above const int Xs[], int Limit` that counts
//    the values bigger than Limit.

// ---------------------------------------------------------------- output
//> first: 70 last: 100
//> sum: 420
//> 1 2 0 0
//> 5 primes
//> best: 100
//> doubled: 4 6 10 14 22
//> 70 0
//> 5 6
//> Bo h o
