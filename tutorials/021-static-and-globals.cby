// Tutorial 21: static and global variables
//
// Run it:      cabby 021-static-and-globals.cby
// Keywords:    static
//
// A variable declared outside any function is a GLOBAL: every function can
// use it, and it lives for the whole program. Cabby allows globals of
// plain data (numbers, bool, char, enums, structs and arrays of them), and
// `const str` constants. A mutable global str or object isn't allowed,
// because nothing would own it.

int CallsMade                       // starts at 0, like every variable
const str VERSION = "1.0"

// `static` inside a function: the variable keeps its value between calls,
// and is initialized only once.
int next_id {
	static int Id = 100
	Id++
	CallsMade++
	return Id
}

// `static` at the top level means "private to this file": other files that
// `use` this one can't see it (tutorial 33 shows that in action).
static int helper int x {
	return x * x
}

void count_visits {
	static int Visits
	Visits++
	println "visit number", Visits
}

int main {
	println "version", VERSION
	println next_id, next_id, next_id
	println "calls made:", CallsMade

	count_visits
	count_visits
	count_visits

	println helper(7)
}

// Try this:
//  - Remove `static` from `static int Id = 100`. What does next_id return
//    now, and why?
//  - Try a mutable global string: `str Title = "x"` at the top level.

// ---------------------------------------------------------------- output
//> version 1.0
//> 101 102 103
//> calls made: 3
//> visit number 1
//> visit number 2
//> visit number 3
//> 49
