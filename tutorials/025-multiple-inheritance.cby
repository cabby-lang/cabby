// Tutorial 25: Multiple inheritance and diamonds
//
// Run it:      cabby 025-multiple-inheritance.cby
// Topics:      object c : a, b, shared bases, method resolution order
//
// An object may have several parents: `object catbot : pet, robot`. It
// gets the fields and methods of all of them.
//
// The famous difficulty is the DIAMOND: pet and robot both inherit from
// `thing`. Does a catbot contain one thing or two? In Cabby, as in
// Python, ONE: a shared base appears once.
//
// When two parents both have a method, which one wins? Cabby uses the same
// rule as Python (the "C3 linearization"): the child first, then its
// parents from left to right, and a shared base only after everything
// that inherits from it. For catbot: catbot, pet, robot, thing.

object thing {
	str Name
	void hello const {
		println "I am", Name
	}
	void kind const {
		println Name, "is a thing"
	}
	~thing {
		println "  (", Name, "dismantled )"
	}
}

object pet : thing {
	str Owner
	void kind const {
		println Name, "is a pet of", Owner
	}
	void cuddle const {
		println Name, "purrs"
	}
}

object robot : thing {
	int Battery
	void kind const {
		println Name, "is a robot"
	}
	void charge {
		Battery = 100
		println Name, "charged to", Battery
	}
}

object catbot : pet, robot {
	int Model
}

void identify const thing &t {
	t.kind
}

int main {
	// Fields are laid out base-most first, then parent by parent from left
	// to right: Name, Owner, Battery, Model. So `{"Tom", "Ann", 20, 9000}`
	// would work too, but naming the fields keeps working if the parents
	// are ever reordered.
	catbot Tom = {.Name = "Tom", .Owner = "Ann", .Battery = 20, .Model = 9000}

	Tom.hello            // from thing
	Tom.cuddle           // from pet
	Tom.charge           // from robot
	Tom.kind             // pet and robot both have kind: pet comes first

	// One shared `thing`, so there's only one name:
	Tom.Name = "Tom II"
	Tom.hello

	// Borrowed as any of its ancestors, it's still a catbot.
	identify Tom
	const robot &r = Tom
	r.kind               // virtual: catbot's choice, pet.kind, even here

	println "model", Tom.Model, "owned by", Tom.Owner
}                        // dropped once, so dismantled once

// Cabby rejects hierarchies that would be ambiguous: two parents that each
// declare a field with the same name, or parent orders with no consistent
// C3 order (A : B, C next to B2 : C, B ...).
//
// Try this:
//  - Swap the parents: `object catbot : robot, pet`. Which kind wins now?
//  - Give robot a field `str Owner` too, and read the error.

// ---------------------------------------------------------------- output
//> I am Tom
//> Tom purrs
//> Tom charged to 100
//> Tom is a pet of Ann
//> I am Tom II
//> Tom II is a pet of Ann
//> Tom II is a pet of Ann
//> model 9000 owned by Ann
//>   ( Tom II dismantled )
