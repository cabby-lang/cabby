// Tutorial 3: Integer types
//
// Run it:      cabby 03-integers.cby
// Keywords:    char, short, int, long, signed, unsigned, sizeof
//
// Cabby has four sizes of integer:
//
//   char   1 byte     short  2 bytes     int  4 bytes     long  8 bytes
//
// Each comes `signed` (the default, can be negative) or `unsigned` (only
// zero and up, but twice the range).

int main {
	char c = 'x'
	short s = 30000
	int i = 2000000000
	long l = 9000000000000000000

	// sizeof gives a type's or a variable's size in bytes.
	println sizeof(char), sizeof(short), sizeof(int), sizeof(long)
	println sizeof c, sizeof l

	// unsigned: no negatives, larger maximum.
	unsigned char Byte = 255
	unsigned int Ui = 4000000000
	// Every char type prints as a character, so cast a byte to int to
	// see its number.
	println (int)Byte, Ui

	// `signed` just says what is already the default for int.
	signed int Si = -5
	println Si

	// Integers wrap around when they overflow, like a car's odometer.
	unsigned char Odometer = 255
	Odometer++
	println "255 + 1 in one byte:", (int)Odometer
	int Top = 2147483647
	Top++
	println "biggest int + 1:", Top

	// Integer division throws away the remainder; % gives the remainder.
	println 17 / 5, 17 % 5

	// Mixing types: the smaller one is widened first.
	long Sum = i + l
	println Sum

	// Narrowing needs a cast, because information can be lost.
	long Wide = 300
	unsigned char Narrow = (unsigned char)Wide
	println "300 squeezed into a byte:", (int)Narrow

	// Literals in other bases, and the bitwise operators.
	int Flags = 0b1010              // binary
	int Mask = 0x0F                 // hexadecimal
	int Perms = 0o755               // octal (a bare leading 0, 0755, is an error)
	println Flags, Mask, Perms
	println Flags & 0b0010, Flags | 1, Flags ^ 0b1111, Flags << 2, ~0
}

// Try this:
//  - Divide by zero: `println 1 / (i - i)`. That is a *panic*, Cabby's
//    word for a run-time error that stops the program.
//  - Shift too far: `println 1 << 40` on an int. Why does that panic?

// ---------------------------------------------------------------- output
//> 1 2 4 8
//> 1 8
//> 255 4000000000
//> -5
//> 255 + 1 in one byte: 0
//> biggest int + 1: -2147483648
//> 3 2
//> 9000000002000000000
//> 300 squeezed into a byte: 44
//> 10 15 493
//> 2 11 5 40 -1
