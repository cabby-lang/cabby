// Tutorial 30: goto and labels
//
// Run it:      cabby 030-goto.cby
// Keywords:    goto
//
// `goto name` jumps to the line labeled `name:` (a label is indented like
// any other line of its block). Cabby keeps it safe by
// allowing only *forward* jumps, to a label in the same block or an
// enclosing one, and never past a declaration. Its classic use is getting
// out of several nested loops at once.

int main {
	// Find the first pair (a, b) with a * b == 42 and a + b == 13.
	int FoundA = 0, FoundB = 0
	for int a = 1; a < 20; a++ {
		for int b = 1; b < 20; b++ {
			if a * b == 42 && a + b == 13 {
				FoundA = a
				FoundB = b
				goto found          // leaves both loops at once
			}
		}
	}
	println "no pair"
	found:
	println "pair:", FoundA, FoundB

	// Skipping ahead past the rest of a block.
	int Stock = 0
	if Stock == 0 {
		goto restock
	}
	println "selling"
	restock:
	println "restocking"
}

// Why only forward? A backward goto is a loop in disguise, and Cabby
// already has three kinds of loop that say what they mean.
//
// Try this:
//  - Move `found:` above the loops. Read the error.
//  - Rewrite the search without goto, using a bool and two breaks. Which
//    version is easier to read?

// ---------------------------------------------------------------- output
//> pair: 6 7
//> restocking
