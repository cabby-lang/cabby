// Tutorial 36: A whole program — reversing a string
//
// Run it:      cabby 036-reverse.cby stressed
// Or compile:  cabby -c 036-reverse.cby && ./036-reverse stressed
//
// This program puts several earlier tutorials together: command-line
// arguments (28), a header and its implementation (27), borrowing (15),
// and the string tools (13). The work is done in the reverse folder:
//
//   reverse/reverse.hby   declares reverse_str
//   reverse/reverse.cby   defines it
//
// Notice the call `(reverse_str Argv[1])`. A function name followed by its
// arguments, without parentheses around them, is a call anywhere: here inside
// println's arguments, so it gets parentheses of its own to show where its
// arguments end.

use local reverse/reverse

// (For Cabby's test suite: the arguments to run this tutorial with.)
// args: stressed

int main int Argc, str Argv[] {
	if Argc != 2 {
		println "Error! One argument needed..."
		return 1
	}

	println reverse_str Argv[1]

	// Argv[1] was only borrowed, so it is still there:
	str Word = Argv[1].copy
	str Back = reverse_str Word
	println Word, "<->", Back
	println "palindrome?", Word == Back

	str Racecar = "racecar"
	println Racecar, "palindrome?", Racecar == (reverse_str Racecar)
	return 0
}

// Try this:
//  - Run it with no argument, then with two. What exit status do you get?
//    (`echo $?` shows it.)
//  - Add `bool is_palindrome const str &s` to the header and write it in
//    reverse.cby without building a reversed copy: compare s[i] with
//    s[s.length - 1 - i].

// ---------------------------------------------------------------- output
//> desserts
//> stressed <-> desserts
//> palindrome? false
//> racecar palindrome? true
