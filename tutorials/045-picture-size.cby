// Tutorial 45: Bytes
//
// Run it:      cabby 045-picture-size.cby
//              cabby 045-picture-size.cby pictures/cabby.png   (and any pictures of yours)
// Or compile:  cabby -c 045-picture-size.cby && ./045-picture-size pictures/cabby.png
// Library:     use bytes (use files brings it too)
// Topics:      bytes, B[i], .add, .part, hexadecimal, bytes.from_hex,
//              .starts_with, numbers inside bytes and byte order (add_int,
//              int_at, int_at_big...), files.read_bytes and write_bytes
//
// A picture file starts with a few bytes that say what kind of picture it
// is, and a little after them, how big it is. This program makes a small
// picture of its own, a flag (open flag.bmp in a picture viewer, and zoom
// in), then reads the size of it, of a tiny PNG picture, and of any
// pictures you name when you run it.

use files

const int WIDTH = 6
const int HEIGHT = 4

// ---- making a picture: a BMP file, byte by byte

// The color of one dot: three bytes, as BMP keeps them (blue, green, red)
void add_color bytes &Picture, int Red, int Green, int Blue {
	Picture.add Blue
	Picture.add Green
	Picture.add Red
}

bytes make_flag {
	bytes Picture
	int RowSize = WIDTH * 3          // three bytes a dot
	while RowSize % 4 != 0 {         // BMP rows are a multiple of 4 bytes long
		RowSize++
	}
	int PixelBytes = RowSize * HEIGHT

	// The file header: 14 bytes. BMP keeps its numbers smallest byte
	// first (little-endian), the order the plain add_ methods use.
	Picture.add_bytes "BM"            // "this is a BMP": the letters' bytes
	Picture.add_int 54 + PixelBytes  // the file's size
	Picture.add_int 0                 // (kept for later; always 0)
	Picture.add_int 54                // where the dots start: after 54 bytes of headers

	// The picture header: 40 more bytes
	Picture.add_int 40                // this header's size
	Picture.add_int WIDTH
	Picture.add_int HEIGHT
	Picture.add_short 1               // one layer
	Picture.add_short 24              // 24 bits (3 bytes) a dot
	Picture.add_int 0                 // not compressed
	Picture.add_int PixelBytes
	Picture.add_int 2835              // dots per meter, across and down (72 an inch)
	Picture.add_int 2835
	Picture.add_int 0                 // colors in a palette: none, every dot has its own
	Picture.add_int 0

	// The dots, row by row, from the bottom row up: three stripes
	for Row in HEIGHT {
		for Column in WIDTH {
			if Column < WIDTH / 3 {
				add_color Picture, 0, 85, 164         // blue
			} else if Column < WIDTH * 2 / 3 {
				add_color Picture, 255, 255, 255      // white
			} else {
				add_color Picture, 239, 65, 53        // red
			}
		}
		for i in RowSize - WIDTH * 3 {   // each row padded to a multiple of 4
			Picture.add 0
		}
	}
	return Picture
}

// ---- reading a picture's size

// "PNG, 3 x 1": what kind of picture the bytes are, and how big
str picture_size const bytes &Data {
	if Data.length < 26 {
		return "too short to be a picture"
	}
	// Every PNG file starts with these 8 bytes
	bytes Png = bytes.from_hex "89 50 4e 47 0d 0a 1a 0a"
	if Data.starts_with Png {
		// PNG keeps its numbers biggest byte first (big-endian): _big
		return "PNG, " + Data.int_at_big(16).text + " x " + Data.int_at_big(20).text
	}
	if Data.starts_with "BM" {
		// BMP: smallest byte first. (A height below 0 means the rows
		// are stored from the top down.)
		int Height = Data.int_at 22
		if Height < 0 {
			Height = -Height
		}
		return "BMP, " + Data.int_at(18).text + " x " + Height.text
	}
	if Data.starts_with "GIF8" {
		// GIF: 2-byte numbers, smallest byte first, counted from 0 up
		return "GIF, " + Data.unsigned_short_at(6).text + " x " + Data.unsigned_short_at(8).text
	}
	return "not a kind of picture I know"
}

int main int Argc, str Argv[] {
	// ---- byte order: the same number, both ways round
	bytes Number
	Number.add_int 640                // 640 is 2 x 256 + 128: bytes 2 and 128 (80 in hexadecimal)
	println "640, smallest byte first:", Number
	bytes Big
	Big.add_int_big 640
	println "640, biggest byte first: ", Big
	println "read back:", Number.int_at(0), Big.int_at_big(0)

	// ---- our own picture
	bytes Flag = make_flag
	files.write_bytes "flag.bmp", Flag
	println "\nflag.bmp:", Flag.length, "bytes; the first 14:"
	bytes Header = Flag.part 0, 14
	println Header
	println "byte [0] is", Flag[0], "which is the letter", (char)Flag[0]
	println "flag.bmp is a", picture_size(files.read_bytes("flag.bmp"))

	// ---- a tiny PNG (3 dots by 1), written in hexadecimal
	str Hex = "89 50 4e 47 0d 0a 1a 0a 00 00 00 0d 49 48 44 52 00 00 00 03 00 00 00 01 08 02 00 00 00 94 82 83 e3 "
	Hex += "00 00 00 12 49 44 41 54 78 9c 63 f8 cf c0 c0 c0 f0 ff ff ff ff 00 12 f7 04 fc 57 7c 0d db "
	Hex += "00 00 00 00 49 45 4e 44 ae 42 60 82"
	bytes Tiny = bytes.from_hex Hex
	files.write_bytes "tiny.png", Tiny
	println "\ntiny.png, as a hex dump:"
	println Tiny.dump
	println "tiny.png is a", picture_size(Tiny)

	// ---- and any pictures named when the program was run
	for i in 1 to Argc - 1 {
		if files.exists Argv[i] {
			println Argv[i], "is a", picture_size(files.read_bytes(Argv[i]))
		} else {
			println Argv[i], "isn't there"
		}
	}
	return 0
}

// Output (with no pictures named):

// Try this:
//  - Run `045-picture-size.cby` with the pictures in your own Pictures
//    folder after it (`cabby 045-picture-size.cby ~/Pictures/*.png`).
//  - Change the flag's colors and size (keep `WIDTH` a multiple of 3), and
//    look at it in a picture viewer.
//  - A WAV sound file keeps its number of channels at byte 22 (a short),
//    and its samples a second at byte 24 (an int), smallest byte first.
//    Print them for a `.wav` file you have.

// ---------------------------------------------------------------- output
//> 640, smallest byte first: 80 02 00 00
//> 640, biggest byte first:  00 00 02 80
//> read back: 640 640
//>
//> flag.bmp: 134 bytes; the first 14:
//> 42 4d 86 00 00 00 00 00 00 00 36 00 00 00
//> byte [0] is 66 which is the letter B
//> flag.bmp is a BMP, 6 x 4
//>
//> tiny.png, as a hex dump:
//> 00000000  89 50 4e 47 0d 0a 1a 0a  00 00 00 0d 49 48 44 52  |.PNG........IHDR|
//> 00000010  00 00 00 03 00 00 00 01  08 02 00 00 00 94 82 83  |................|
//> 00000020  e3 00 00 00 12 49 44 41  54 78 9c 63 f8 cf c0 c0  |.....IDATx.c....|
//> 00000030  c0 f0 ff ff ff ff 00 12  f7 04 fc 57 7c 0d db 00  |...........W|...|
//> 00000040  00 00 00 49 45 4e 44 ae  42 60 82                 |...IEND.B`.|
//> tiny.png is a PNG, 3 x 1
