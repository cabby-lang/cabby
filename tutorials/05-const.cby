// Tutorial 5: const
//
// Run it:      cabby 05-const.cby
// Keywords:    const
//
// `const` means "this can't be changed". Cabby checks it before the
// program runs, so a const value really is constant.

// A const at the top level is a global constant, usable everywhere.
const int DAYS_PER_WEEK = 7
const double PI = 3.141592653589793
const str APP = "Cabby tutorials"

// A constant can size an array.
int Rainfall[DAYS_PER_WEEK] = {3, 0, 0, 12, 5, 0, 1}

int main {
	println APP

	const int WEEKS = 4
	println WEEKS * DAYS_PER_WEEK, "days in", WEEKS, "weeks"

	double r = 2.0
	println "circle area:", PI * r * r

	int Wet = 0
	for d in DAYS_PER_WEEK {
		if Rainfall[d] > 0 {
			Wet++
		}
	}
	println Wet, "wet days"

	// Uncomment the next line and run: Cabby stops with an error, pointing
	// at the assignment and at the declaration that made it const.
	// WEEKS = 5
}

// const also appears in two other places, which later tutorials cover:
//   - `const T &name`: a read-only borrow (tutorial 14)
//   - a `const` method, which promises not to change its object (tutorial 22)
//
// Try this:
//  - Uncomment `WEEKS = 5` and read the error.
//  - Make `Rainfall` const, then try to change `Rainfall[0]`.

// ---------------------------------------------------------------- output
//> Cabby tutorials
//> 28 days in 4 weeks
//> circle area: 12.566370614359172
//> 4 wet days
