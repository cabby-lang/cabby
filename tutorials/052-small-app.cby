// Tutorial 52: A small app — a tip calculator
//
// Run it:      cabby 052-small-app.cby
// Or compile:  cabby -c 052-small-app.cby && ./052-small-app
// Library:     use gui
// Topics:      rows, several handlers, on_change, numbers as text (.text)
//
// This puts together what a typical small app needs: a form to type into,
// buttons side by side in a row, and results that update as you type.

use gui

object tipper : gui.window {
	gui.entry Bill
	gui.label TipLine
	gui.label TotalLine
	int Percent

	void build {
		set_title "Tip calculator"
		set_size 320, 220
		Percent = 10

		add_label "Bill:"
		Bill = add_entry
		Bill.on_change recalculate       // every time the text changes

		// A row puts things side by side.
		add_label "Tip:"
		gui.row Choices = add_row
		gui.button Ten = Choices.add_button "10%"
		gui.button Fifteen = Choices.add_button "15%"
		gui.button Twenty = Choices.add_button "20%"
		Ten.on_click tip_10
		Fifteen.on_click tip_15
		Twenty.on_click tip_20

		TipLine = add_label ""
		TotalLine = add_label ""
		recalculate
	}

	// Each button needs its own handler, because a handler takes no
	// arguments. Small handlers that set something and call a shared
	// method keep that tidy.
	void tip_10 {
		choose 10
	}
	void tip_15 {
		choose 15
	}
	void tip_20 {
		choose 20
	}

	void choose int p {
		Percent = p
		recalculate
	}

	void recalculate {
		double Amount = 0.0
		str Typed = Bill.text
		if Typed.is_number {             // "" or text that isn't a number counts as 0
			Amount = Typed.to_double
		}
		double Tip = Amount * Percent / 100.0
		TipLine.set_text "Tip (" + Percent.text + "%): " + Tip.text
		TotalLine.set_text "Total: " + (Amount + Tip).text
		println Percent.text + "%:", Amount, "->", Amount + Tip
	}
}

int main {
	tipper t
	t.run
}

// (For Cabby's test suite: what to do in the window.)
// script: type 1 50; click 20%; type 1 80; close
//
// Try this:
//  - Add a "Split between" text box and show what each person pays.
//  - Round the amounts to cents: `use math`, then floor(x * 100.0 + 0.5) / 100.0.

// ---------------------------------------------------------------- output
//> 10%: 0.0 -> 0.0
//> 10%: 5.0 -> 5.5
//> 10%: 50.0 -> 55.0
//> 20%: 50.0 -> 60.0
//> 20%: 0.0 -> 0.0
//> 20%: 8.0 -> 9.6
//> 20%: 80.0 -> 96.0
