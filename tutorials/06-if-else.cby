// Tutorial 6: Making decisions
//
// Run it:      cabby 06-if-else.cby
// Keywords:    if, else, bool, true, false
//
// Conditions have no parentheses: `if x > 5 {`. They must be followed by
// a block in braces, even for one statement.

void judge int Score {
	if Score >= 90 {
		println Score, "excellent"
	} else if Score >= 50 {
		println Score, "pass"
	} else {
		println Score, "try again"
	}
}

int main {
	judge 95
	judge 70
	judge 12

	// Comparisons:  ==  !=  <  <=  >  >=   (they give a bool)
	// Logic:        &&  (and)   ||  (or)   !  (not)
	int Age = 34
	bool Member = true
	if Age >= 18 && Member {
		println "welcome back"
	}
	if Age < 13 || Age > 65 {
		println "discount"
	} else {
		println "full price"
	}
	if !Member {
		println "please join"
	}

	// && and || stop as soon as the answer is known ("short-circuit").
	// Here the division never happens, because Count == 0 is false.
	int Total = 10, Count = 0
	if Count != 0 && Total / Count > 2 {
		println "never printed"
	}

	// & | ^ ~ are the *bitwise* operators: different operators, used on
	// the bits of numbers (tutorial 3). Mixing them up is a common C bug;
	// in Cabby && and & are always distinct.
	int Bits = 0b0110
	if (Bits & 0b0100) != 0 {
		println "bit 2 is set"
	}

	// A number works as a condition too: zero is false, anything else true.
	int Items = 3
	if Items {
		println "not empty"
	}

	// The else may go on a later line as well.
	if Items > 5 {
		println "lots"
	}
	else {
		println "a few"
	}
}

// Try this:
//  - Remove the parentheses in `(Bits & 0b0100) != 0`. Cabby warns you
//    that & binds more loosely than !=, and suggests the fix.
//  - Write a function `sign int n` that prints "negative", "zero" or
//    "positive".

// ---------------------------------------------------------------- output
//> 95 excellent
//> 70 pass
//> 12 try again
//> welcome back
//> full price
//> bit 2 is set
//> not empty
//> a few
