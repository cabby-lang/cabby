// Tutorial 60: Drawing — a rainfall chart
//
// Run it:      cabby 060-drawing.cby
// Or compile:  cabby -c 060-drawing.cby && ./060-drawing
// Library:     use gui (or use tui: change gui to tui and it draws in a terminal)
// Topics:      add_canvas, on_draw, redraw, set_color, lines, rectangles,
//              circles, polygons, write, on_click, on_key, mouse_x, key, save
//
// A canvas is a part of a window to draw on. You don't draw on it straight
// away: you give it an on_draw handler, and the canvas calls it whenever
// it needs drawing (when the window first shows, and after `redraw`). So
// the handler draws everything from what the program knows, every time;
// to change the picture, change a field and call `redraw`.
//
// Positions are in pixels, counted from the canvas's top left corner: x
// goes right, and y goes *down* (so y = 0 is the top edge). A chart's bars
// grow upwards, so this program works out where each bar's top is with
// "bottom minus height".
//
// Click a bar to hear about it; the left and right arrow keys choose a bar
// too (click the chart first, so the keys go to it), and S saves the chart
// as rainfall.png.

use gui

const int WIDTH = 360
const int HEIGHT = 240
const int BOTTOM = 200              // where the bars stand: the y of the axis
const int LEFT = 40                 // the x of the first bar
const int BAR = 32                  // each bar's width
const int GAP = 12                  // and the space after it
const int SCALE = 6                 // pixels for each millimeter of rain

object rainfall : gui.window {
	gui.canvas Chart
	gui.label Status
	list str Days
	list int Rain
	int Chosen

	void build {
		Days = {"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}
		Rain = {4, 12, 0, 21, 8, 15, 3}
		set_title "Rainfall"
		Chart = add_canvas WIDTH, HEIGHT
		Chart.on_draw draw_chart
		Chart.on_click clicked
		Chart.on_key pressed
		Status = add_label "Click a bar."
		Chosen = -1
	}

	// ---- drawing: everything, from Days, Rain and Chosen

	void draw_chart {
		Chart.fill_with "white"
		Chart.set_color "black"
		Chart.set_font_size 16
		Chart.write LEFT, 8, "Rain this week (mm)"

		// the axis, and a line for every 5 mm
		Chart.set_color "lightgray"
		for Mm in 1 to 4 {
			int y = BOTTOM - Mm * 5 * SCALE
			Chart.line LEFT - 6, y, WIDTH - 10, y
		}
		Chart.set_color "black"
		Chart.set_line_width 2
		Chart.line LEFT - 6, BOTTOM, WIDTH - 10, BOTTOM

		// the bars, with each day's name under its bar
		Chart.set_font_size 12
		for i in Days.length {
			long x = LEFT + i * (BAR + GAP)
			int Height = Rain[i] * SCALE
			if i == Chosen {
				Chart.set_color "darkorange"
			} else {
				Chart.set_color "steelblue"
			}
			Chart.fill_rectangle x, BOTTOM - Height, BAR, Height
			Chart.set_color "black"
			Chart.write x + 4, BOTTOM + 6, Days[i]
		}

		// the wettest day gets a raindrop: a circle with a point on top
		long Wettest = 0
		for i in Rain.length {
			if Rain[i] > Rain[Wettest] {
				Wettest = i
			}
		}
		double Mid = LEFT + Wettest * (BAR + GAP) + BAR / 2
		double Top = BOTTOM - Rain[Wettest] * SCALE - 16
		Chart.set_color "dodgerblue"
		Chart.fill_circle Mid, Top, 6
		Chart.fill_polygon {Mid - 6, Top - 1, Mid + 6, Top - 1, Mid, Top - 14}
	}

	// ---- the mouse and keys

	void clicked {
		int Bar = (Chart.mouse_x - LEFT) / (BAR + GAP)
		if Chart.mouse_x >= LEFT && Bar < Days.length {
			choose Bar
		}
	}

	void pressed {
		if Chart.key == "left" && Chosen > 0 {
			choose Chosen - 1
		} else if Chart.key == "right" && Chosen < Days.length - 1 {
			choose Chosen + 1
		} else if Chart.key == "s" {
			Chart.save "rainfall.png"
			Status.set_text "Saved as rainfall.png"
			println "saved rainfall.png"
		}
	}

	void choose int Bar {
		Chosen = Bar
		Status.set_text Days[Bar] + ": " + Rain[Bar].text + " mm"
		println Status.text
		Chart.redraw                 // draw it again, with this bar in orange
	}
}

int main {
	rainfall r
	r.run
}

// (Cabby's tests run this in a virtual display, clicking and pressing keys:)
// script: wait 200; press 1 150 150; key right; key right; key left; close
//
// Try this:
//  - Write each bar's number of millimeters above it.
//  - Change `use gui` and every `gui.` to `tui`, and run it in a terminal.
//  - Let a click above a bar add a millimeter of rain to it.

// ---------------------------------------------------------------- output
//> Wed: 0 mm
//> Thu: 21 mm
//> Fri: 8 mm
//> Thu: 21 mm
