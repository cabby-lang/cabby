// Tutorial 63: Workers — jobs done on threads of their own
//
// Run it:      cabby 063-workers.cby
// Or compile:  cabby -c 063-workers.cby && ./063-workers
// Library:     use threads
// Topics:      threads.worker, work, start, wait, is_done, threads.cores;
//              sharing out a job; two kinds of job at once; what's safe
//
// A worker does one job on a thread of its own, while the rest of the
// program carries on. It's an object of yours, made from threads.worker,
// as a window is made from gui.window: its fields hold what it's given and
// what it works out, and its `work` method is the job.
//
// Compiled, workers run at the same moment, on as many cores as the
// computer has: four workers, a quarter of the time. Interpreted, they
// take turns (as threads do in Python), so the job takes as long, but the
// rest of the program still carries on meanwhile.

use threads

// ---- a job shared out: counting the primes below a number, a part each

object prime_counter : threads.worker {
	int From                        // what it's given: where its part starts
	int Upto                        // and ends (not included)
	int Primes                      // what it works out

	void work {
		Primes = 0
		for int N = From; N < Upto; N++ {
			if is_prime N {
				Primes++
			}
		}
	}

	bool is_prime int N const {
		if N < 2 {
			return false
		}
		for int D = 2; D * D <= N; D++ {
			if N % D == 0 {
				return false
			}
		}
		return true
	}
}

// ---- another kind of job: the longest chain in the "3n + 1" game
//
// Halve an even number, and make an odd one three times itself and one
// more; again and again, until it's 1. 27 takes 111 steps.

object chain_finder : threads.worker {
	int Below                       // given
	int Longest                     // worked out: which number's chain is longest
	int Steps                       // and how many steps it takes

	void work {
		for int Start = 1; Start < Below; Start++ {
			int Count = steps_from Start
			if Count > Steps {
				Steps = Count
				Longest = Start
			}
		}
	}

	int steps_from int Start const {
		long N = Start
		int Count = 0
		while N != 1 {
			if N % 2 == 0 {
				N /= 2
			} else {
				N = 3 * N + 1
			}
			Count++
		}
		return Count
	}
}

const int PARTS = 4
const int LIMIT = 100000

int main {
	// four workers, each a quarter of the numbers
	prime_counter Counters[PARTS]
	for I in PARTS {
		Counters[I].From = I * LIMIT / PARTS
		Counters[I].Upto = (I + 1) * LIMIT / PARTS
		Counters[I].start           // off it goes; the loop carries on at once
	}

	// and a fifth, at a different job, alongside them
	chain_finder Finder
	Finder.Below = 30000
	Finder.start
	println "five workers started"

	// what they worked out, as each is done: wait gives a worker back
	int Total = 0
	for I in PARTS {
		Counters[I].wait
		println "primes from", Counters[I].From, "to", Counters[I].Upto - 1, ":", Counters[I].Primes
		Total += Counters[I].Primes
	}
	println "primes below", LIMIT, ":", Total

	Finder.wait
	println "below", Finder.Below.text + ",", Finder.Longest, "has the longest chain:", Finder.Steps, "steps"

	// a worker that's done can start again, with new numbers
	Counters[0].From = 0
	Counters[0].Upto = 100
	Counters[0].start
	Counters[0].wait
	println "primes below 100 :", Counters[0].Primes
	println "done:", Counters[0].is_done

	// While a worker works, what's in it is its own. Reading Finder.Steps
	// between Finder.start and Finder.wait is a panic: "that worker is
	// still working...". And `work` can't use a global that can change
	// (int Total = 0, outside main): the checker says so. Constants, as
	// PARTS and LIMIT, are fine.
	return 0
}

// Try this:
//  - println threads.cores: how many can work at once here? Make PARTS
//    that many, and compile it: is it quicker?
//  - Time it: use time, and time.now before and after (chapter 39).
//  - Read Finder.Steps before Finder.wait, and see what Cabby says.

// ---------------------------------------------------------------- output
//> five workers started
//> primes from 0 to 24999 : 2762
//> primes from 25000 to 49999 : 2371
//> primes from 50000 to 74999 : 2260
//> primes from 75000 to 99999 : 2199
//> primes below 100000 : 9592
//> below 30000, 26623 has the longest chain: 307 steps
//> primes below 100 : 25
//> done: true
