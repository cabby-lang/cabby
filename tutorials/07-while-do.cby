// Tutorial 7: while, until and do loops
//
// Run it:      cabby 07-while-do.cby
// Keywords:    while, until, do
//
// `while cond { ... }` repeats while the condition is true, checking it
// first. `until cond { ... }` repeats until it is true. `do { ... } while
// cond` (or `until cond`) checks it after, so its body always runs at
// least once.

int main {
	// Count down.
	int n = 3
	while n > 0 {
		println n, "..."
		n--
	}
	println "lift off!"

	// How many times can we halve 1000 before we get below 1?
	int Halvings = 0
	double x = 1000.0
	while x >= 1.0 {
		x = x / 2
		Halvings++
	}
	println Halvings, "halvings"

	// Digits of a number, last one first: do runs at least once, so even
	// 0 prints one digit.
	int Value = 4096
	do {
		print Value % 10
		Value = Value / 10
	} while Value > 0
	println

	int Zero = 0
	do {
		print Zero % 10
		Zero = Zero / 10
	} while Zero > 0
	println

	// Until: keep adding 1, 2, 3 ... until the total reaches 10.
	int Rolls = 0
	int Total = 0
	until Total >= 10 {
		Rolls++
		Total += Rolls
	}
	println Rolls, "rolls make", Total

	// The Collatz sequence: halve even numbers, triple-and-add-one odd ones.
	// Nobody has proved it always reaches 1, but it does for every number
	// anyone has tried.
	int c = 6
	int Steps = 0
	print "6:"
	until c is 1 {
		if c % 2 is 0 {
			c = c / 2
		} else {
			c = 3 * c + 1
		}
		print "", c
		Steps++
	}
	println
	println Steps, "steps"
}

// Try this:
//  - Start the Collatz sequence from 27. How many steps does it take?
//  - Write `while true { }` and run it. Press Ctrl-C to stop it.

// ---------------------------------------------------------------- output
//> 3 ...
//> 2 ...
//> 1 ...
//> lift off!
//> 10 halvings
//> 6904
//> 0
//> 4 rolls make 10
//> 6: 3 10 5 16 8 4 2 1
//> 8 steps
