// Tutorial 71: A bigger world — exploring with a camera
//
// Run it:      cabby 071-exploring.cby
// Or compile:  cabby -c 071-exploring.cby && ./071-exploring
// Library:     use game
// Topics:      set_world_size, follow, camera_x, camera_y, a lookup of
//              signs, drawing what stays put while the world moves
//
// Tutorial 69's town fitted on the stage. This world is bigger: 32 tiles
// by 22. set_world_size makes the world that big, and `follow Hero` keeps
// the camera on the hero, so the world scrolls past as they walk. Near
// an edge the camera stops, so it never shows past the world.
//
// Sprites are placed in the world, wherever the camera is; what the
// stage's on_draw draws stays put on the stage (a message box, where you
// are), however the world moves.
//
// There are three signs to find. Walk up to one and press Space.

use game
// Topics:      add_sprite, animate, set_picture, a map of tiles, walking
//              tile by tile, which way a character faces, reading a sign
//
// In the old handheld adventure games, the world is a grid of tiles, and
// the hero walks from one tile to the next: a press of an arrow key starts
// a step, and the step always finishes on a tile. While walking, the
// hero's legs move: three pictures for each way they can face (standing,
// left foot forward, right foot forward), shown in turn by `animate`.
//
// The town is a list of strings, a character for each tile: T a tree, ~
// water, S a sign, = the path, f flowers, and . grass. Trees, water and
// the sign are in the way. Walk up to the sign and press Space to read it.
//
// The pictures are in pictures/ next to this file (tools/make-town-pictures.py
// draws them).

use game

const int TILE = 48                 // each tile's size, in pixels
const int COLUMNS = 32              // the world's size, in tiles
const int ROWS = 22
const int SHOWN_COLUMNS = 13        // how much of it the stage shows
const int SHOWN_ROWS = 9
const int SPEED = 3                 // pixels a frame: a step takes 48 / 3 = 16 frames
const int LEG_TIME = 130            // milliseconds for each picture of the walk

object town : game.window {
	list str Map
	lookup str str Signs            // what each sign says, by where it is: "col,row"
	str Message                     // the sign being read
	game.sprite Hero
	int Col                         // the tile the hero is on
	int Row
	str Facing                      // "down", "up", "left" or "right"
	int Dx                          // the way the hero is stepping: -1, 0 or 1
	int Dy
	int StepsLeft                   // frames left of this step (0: standing on a tile)
	bool Walking
	bool Reading

	void build {
		Map = {
			"TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT",
			"T...f.......T.......~~~~~~.....T",
			"T.======....T..f....~~~~~~..f..T",
			"T.=S...=....T.......~~~~~~.....T",
			"T.=....=....TTTT.....~~~~......T",
			"T.=..f.===========......=====..T",
			"T.=..............=......=...=..T",
			"T.=====....TTT...=..f...=.S.=..T",
			"T.....=....TfT...=......=...=..T",
			"TTTT..=....TTT...==========.=..T",
			"T.....=.....................=..T",
			"T..f..=======================..T",
			"T.....=..........T.T.T.T.......T",
			"T.~~~.=..TTTT....f.f.f.f.......T",
			"T.~~~.=..T..T..................T",
			"T.~~~.=..T..T..======S.........T",
			"T.....=..TTTT..=...............T",
			"T..f..=========....T....TTTT...T",
			"T.................TTT...T..T...T",
			"T....f.......f...TTTTT..TTTT...T",
			"T..............................T",
			"TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
		}
		Signs = {
			"3,3": "Cabby Town: the lake is to the east.",
			"26,7": "The lake. No swimming!",
			"21,15": "You found the last sign. Well explored!"
		}
		set_title "Cabby Woods"
		set_size SHOWN_COLUMNS * TILE, SHOWN_ROWS * TILE
		set_world_size COLUMNS * TILE, ROWS * TILE
		add_tiles
		Col = 2
		Row = 2
		Facing = "down"
		Hero = add_sprite "pictures/hero-down-1.png", middle_of(Col), middle_of(Row)
		follow Hero                     // the camera keeps the hero in the middle
		on_frame step
		stage.on_draw draw_message
	}

	// one sprite for each tile; flowers and water move a little
	void add_tiles {
		for R in Map.length {
			for C in Map[R].length {
				char Tile = Map[R][C]
				long X = middle_of C
				long Y = middle_of R
				if Tile == 'T' {
					add_sprite "pictures/tile-tree.png", X, Y
				} else if Tile == '~' {
					game.sprite Water = add_sprite "pictures/tile-water-1.png", X, Y
					Water.animate {"pictures/tile-water-1.png", "pictures/tile-water-2.png"}, 600
				} else if Tile == 'f' {
					game.sprite Flowers = add_sprite "pictures/tile-flowers-1.png", X, Y
					Flowers.animate {"pictures/tile-flowers-1.png", "pictures/tile-flowers-2.png"}, 800
				} else if Tile == 'S' {
					add_sprite "pictures/tile-sign.png", X, Y
				} else if Tile == '=' {
					add_sprite "pictures/tile-path.png", X, Y
				} else {
					add_sprite "pictures/tile-grass.png", X, Y
				}
			}
		}
	}

	long middle_of long Tile const {
		return Tile * TILE + TILE / 2
	}

	bool is_free int C, int R const {
		char Tile = Map[R][C]
		return Tile != 'T' && Tile != '~' && Tile != 'S'
	}

	// ---- every frame

	void step {
		if Reading {
			if key_press "space" {
				Reading = false             // the message goes away
			}
			return
		}
		if StepsLeft > 0 {
			// part of the way through a step: keep going
			Hero.move Dx * SPEED, Dy * SPEED
			StepsLeft--
			if StepsLeft > 0 {
				return
			}
			Col += Dx
			Row += Dy
		}

		// on a tile: an arrow key held down starts the next step
		str Way = ""
		if key_hold "up" {
			Way = "up"
		} else if key_hold "down" {
			Way = "down"
		} else if key_hold "left" {
			Way = "left"
		} else if key_hold "right" {
			Way = "right"
		}
		if Way == "" {
			if Walking {
				stand_still
			}
			if key_press "space" {
				read_sign
			}
			return
		}
		walk Way
	}

	void walk str Way {
		bool Turned = Way != Facing
		Dx = 0
		Dy = 0
		if Way == "up" {
			Dy = -1
		} else if Way == "down" {
			Dy = 1
		} else if Way == "left" {
			Dx = -1
		} else {
			Dx = 1
		}
		Facing = Way                        // (Way is moved into Facing: used last)
		if !is_free(Col + Dx, Row + Dy) {
			bool Bumped = Turned || Walking
			stand_still                     // facing the way, but going nowhere
			if Bumped {
				println "bump", Facing
			}
			return
		}
		StepsLeft = TILE / SPEED
		if Turned || !Walking {
			// the walk's pictures: standing, one foot, standing, the other foot
			str Name = "pictures/hero-" + Facing
			Hero.animate {Name + "-1.png", Name + "-2.png", Name + "-1.png", Name + "-3.png"}, LEG_TIME
			Walking = true
		}
	}

	void stand_still {
		if Walking {
			println "stopped at", Col, Row, "- the camera shows from", camera_x, camera_y
		}
		Hero.set_picture "pictures/hero-" + Facing + "-1.png"
		Walking = false
	}

	void read_sign {
		int C = Col
		int R = Row
		if Facing == "up" {
			R--
		} else if Facing == "down" {
			R++
		} else if Facing == "left" {
			C--
		} else {
			C++
		}
		if Map[R][C] == 'S' {
			Message = Signs[C.text + "," + R.text].copy
			Reading = true
			println "the sign says:", Message
		}
	}

	// ---- over the sprites, where they stay put: where the hero is, and the
	// sign's message in a box at the bottom

	void draw_message {
		stage.set_color "#2b2b38"
		stage.set_font_size 14
		stage.write 10, 8, "Tile " + Col.text + ", " + Row.text
		if !Reading {
			return
		}
		int Top = height - 90
		stage.set_color "white"
		stage.fill_rectangle 12, Top, width - 24, 78
		stage.set_color "#2b2b38"
		stage.set_line_width 4
		stage.rectangle 12, Top, width - 24, 78
		stage.set_font_size 20
		stage.write 32, Top + 22, Message
		stage.set_font_size 14
		stage.write 32, Top + 52, "(Space to close)"
	}
}

int main {
	town t
	t.run
}

// (Cabby's tests explore a little:)
// script: frames 5; tap right; frames 20; tap down; tap space; frames 5; tap space; tap left; frames 20; hold down; frames 120; release down; hold right; frames 140; release right; hold down; frames 70; release down; hold right; frames 110; release right; frames 20; close
//
// Try this:
//  - Hold B to run, as in tutorial 69; watch the camera keep up.
//  - Make the world bigger still, and add a sign of your own.
//  - Show a small map in a corner: one dot for each tree, drawn in
//    draw_message, and one for the hero.

// ---------------------------------------------------------------- output
//> stopped at 3 2 - the camera shows from 0.0 0.0
//> bump down
//> the sign says: Cabby Town: the lake is to the east.
//> stopped at 2 2 - the camera shows from 0.0 0.0
//> stopped at 2 8 - the camera shows from 0.0 192.0
//> bump down
//> stopped at 10 8 - the camera shows from 192.0 192.0
//> bump right
//> stopped at 10 12 - the camera shows from 192.0 384.0
//> bump down
//> stopped at 16 12 - the camera shows from 480.0 384.0
//> bump right
