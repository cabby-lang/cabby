// Tutorial 73: A world in files — areas, depth and people
//
// Run it:      cabby 073-world-in-files.cby
// Or compile:  cabby -c 073-world-in-files.cby && ./073-world-in-files
// Library:     use game, use files
// Topics:      maps read from files, going from one area to the next,
//              set_layer and sort_by_depth, people who turn and talk
//
// Tutorial 71's world was written into the program. Here each area is a
// file of its own in maps/ (woods.txt and town.txt): the map, a character
// for each tile, then a line for each sign, each way out, and each person.
// Change the town in a text editor, and the program needn't change at all.
//
// Trees here are taller than a tile: the trunk stands on its tile, and the
// leaves reach up over half the tile above. Standing north of a tree, the hero
// should be behind the leaves; south of it, in front. That's what
// sort_by_depth does: in its layer, whatever is lower on the stage is
// drawn in front. The ground (grass, paths, water) is a layer below, so
// it's always under everyone. Walk behind the trees, and behind the houses.
//
// The path south leads from the woods into Cabby Town. Face someone and
// press Space: they turn to you, and talk.

use game
use files

const int TILE = 48                 // each tile's size, in pixels
const int SHOWN_COLUMNS = 13        // how much of the world the stage shows
const int SHOWN_ROWS = 9
const int SPEED = 3                 // pixels a frame: a step takes 48 / 3 = 16 frames
const int LEG_TIME = 130            // milliseconds for each picture of the walk

const int GROUND = 0                // the layers: the ground, under everything,
const int STANDING = 1              // and what stands on it, lower in front

// someone in the town
object townsperson {
	game.sprite Sprite
	str Picture                     // "elder": pictures/elder-down.png, elder-up.png ...
	int Col
	int Row
	str Words
}

object world : game.window {
	list str Map
	lookup str str Signs            // what each sign says, by where it is: "col,row"
	lookup str str Ways             // where each way out leads: "town 8,1"
	list townsperson People
	str Message                     // what's being read or said
	game.sprite Hero
	int Col                         // the tile the hero is on
	int Row
	str Facing                      // "down", "up", "left" or "right"
	int Dx                          // the way the hero is stepping: -1, 0 or 1
	int Dy
	int StepsLeft                   // frames left of this step (0: standing on a tile)
	bool Walking
	bool Reading

	void build {
		set_title "Cabby Town"
		set_size SHOWN_COLUMNS * TILE, SHOWN_ROWS * TILE
		sort_by_depth STANDING          // the hero, trees, houses and people
		Facing = "down"
		go_to "woods", 5, 3
		on_frame step
		stage.on_draw draw_message
	}

	// ---- an area: read from its file, and built

	void go_to const str &Area, int C, int R {
		for Old in sprites_in "" {
			Old.remove                  // the last area's sprites, and the hero
		}
		Map.clear
		Signs.clear
		Ways.clear
		People.clear
		read_area Area
		set_world_size (int)Map[0].length * TILE, (int)Map.length * TILE
		add_tiles
		Col = C
		Row = R
		Hero = add_sprite "pictures/hero-" + Facing + "-1.png", middle_of(Col), middle_of(Row)
		Hero.set_layer STANDING
		follow Hero
		Walking = false
		StepsLeft = 0
		println "in the", Area, "at", Col, Row
	}

	// the map's lines, until a line of ---; then a line for each thing in it
	void read_area const str &Area {
		bool InMap = true
		for Line in files.lines "maps/" + Area + ".txt" {
			if Line.starts_with("//") || Line.trim == "" {
				continue                // a note for whoever edits the map
			}
			if Line == "---" {
				InMap = false
			} else if InMap {
				Map.add Line.copy
			} else {
				add_thing Line
			}
		}
	}

	// sign 3,2 The woods.   way 8,13 town 8,1   person 11,3 elder down Salve!
	void add_thing const str &Line {
		list str Words = Line.split " "
		str Where = Words[1].copy        // "col,row"
		if Words[0] == "sign" {
			Signs[Where] = Words[2 to Words.length - 1].join " "
		} else if Words[0] == "way" {
			Ways[Where] = Words[2 to Words.length - 1].join " "
		} else if Words[0] == "person" {
			townsperson Someone
			Someone.Col = column_of Where
			Someone.Row = row_of Where
			Someone.Picture = Words[2].copy
			Someone.Words = Words[4 to Words.length - 1].join " "
			str Picture = "pictures/" + Someone.Picture + "-" + Words[3] + ".png"
			Someone.Sprite = add_sprite Picture, middle_of(Someone.Col), middle_of(Someone.Row)
			Someone.Sprite.set_layer STANDING
			People.add Someone
		} else {
			println "maps: what is", Words[0], "?"
		}
	}

	int column_of const str &Where const {
		return Where.split(",")[0].to_int
	}

	int row_of const str &Where const {
		return Where.split(",")[1].to_int
	}

	// the ground on every tile; trees, houses and signs on it
	void add_tiles {
		for R in Map.length {
			for C in Map[R].length {
				char Tile = Map[R][C]
				long X = middle_of C
				long Y = middle_of R
				if Tile == '~' {
					game.sprite Water = add_sprite "pictures/tile-water-1.png", X, Y
					Water.animate {"pictures/tile-water-1.png", "pictures/tile-water-2.png"}, 600
				} else if Tile == 'f' {
					game.sprite Flowers = add_sprite "pictures/tile-flowers-1.png", X, Y
					Flowers.animate {"pictures/tile-flowers-1.png", "pictures/tile-flowers-2.png"}, 800
				} else if Tile == '=' {
					add_sprite "pictures/tile-path.png", X, Y
				} else if Tile == 'S' {
					add_sprite "pictures/tile-sign.png", X, Y
				} else {
					add_sprite "pictures/tile-grass.png", X, Y
				}
				// (all of those are on the ground: layer 0, where sprites start)
				if Tile == 'T' {
					// a tile and a half tall: the trunk on this tile, the leaves
					// reaching halfway up the one above
					game.sprite Tree = add_sprite "pictures/tall-tree.png", X, Y - TILE / 4
					Tree.set_layer STANDING
				} else if Tile == 'D' {
					// three tiles square, its door on this tile, its roof two rows up
					game.sprite House = add_sprite "pictures/house.png", X, Y - TILE
					House.set_layer STANDING
				}
			}
		}
	}

	long middle_of long Tile const {
		return Tile * TILE + TILE / 2
	}

	bool is_free int C, int R const {
		if R < 0 || R >= Map.length || C < 0 || C >= Map[R].length {
			return false
		}
		char Tile = Map[R][C]
		if Tile == 'T' || Tile == '~' || Tile == 'S' || Tile == 'H' || Tile == 'D' {
			return false
		}
		return person_at(C, R) < 0
	}

	// who is standing there (-1: nobody)
	int person_at int C, int R const {
		for I in People.length {
			if People[I].Col == C && People[I].Row == R {
				return (int)I
			}
		}
		return -1
	}

	// ---- every frame

	void step {
		if Reading {
			if key_press "space" {
				Reading = false             // the message goes away
			}
			return
		}
		if StepsLeft > 0 {
			// part of the way through a step: keep going
			Hero.move Dx * SPEED, Dy * SPEED
			StepsLeft--
			if StepsLeft > 0 {
				return
			}
			Col += Dx
			Row += Dy
			str Here = Col.text + "," + Row.text
			if Ways.contains Here {
				// a way out: "town 8,1" is the town's map, on tile 8,1
				list str To = Ways[Here].split " "
				go_to To[0], column_of(To[1]), row_of(To[1])
				return
			}
		}

		// on a tile: an arrow key held down starts the next step
		str Way = ""
		if key_hold "up" {
			Way = "up"
		} else if key_hold "down" {
			Way = "down"
		} else if key_hold "left" {
			Way = "left"
		} else if key_hold "right" {
			Way = "right"
		}
		if Way == "" {
			if Walking {
				stand_still
			}
			if key_press "space" {
				look_ahead
			}
			return
		}
		walk Way
	}

	void walk str Way {
		bool Turned = Way != Facing
		Dx = 0
		Dy = 0
		if Way == "up" {
			Dy = -1
		} else if Way == "down" {
			Dy = 1
		} else if Way == "left" {
			Dx = -1
		} else {
			Dx = 1
		}
		Facing = Way                        // (Way is moved into Facing: used last)
		if !is_free(Col + Dx, Row + Dy) {
			bool Bumped = Turned || Walking
			stand_still                     // facing the way, but going nowhere
			if Bumped {
				println "bump", Facing
			}
			return
		}
		StepsLeft = TILE / SPEED
		if Turned || !Walking {
			str Name = "pictures/hero-" + Facing
			Hero.animate {Name + "-1.png", Name + "-2.png", Name + "-1.png", Name + "-3.png"}, LEG_TIME
			Walking = true
		}
	}

	void stand_still {
		if Walking {
			println "stopped at", Col, Row
		}
		Hero.set_picture "pictures/hero-" + Facing + "-1.png"
		Walking = false
	}

	// Space: whoever, or whatever, the hero is facing
	void look_ahead {
		int C = Col
		int R = Row
		if Facing == "up" {
			R--
		} else if Facing == "down" {
			R++
		} else if Facing == "left" {
			C--
		} else {
			C++
		}
		int Who = person_at C, R
		if Who >= 0 {
			// they turn to face the hero, and talk
			People[Who].Sprite.set_picture "pictures/" + People[Who].Picture + "-" + opposite(Facing) + ".png"
			Message = People[Who].Words.copy
			Reading = true
			println "the", People[Who].Picture, "says:", Message
		} else if R >= 0 && R < Map.length && C >= 0 && C < Map[R].length && Map[R][C] == 'S' {
			Message = Signs[C.text + "," + R.text].copy
			Reading = true
			println "the sign says:", Message
		}
	}

	str opposite const str &Way const {
		if Way == "up" {
			return "down"
		} else if Way == "down" {
			return "up"
		} else if Way == "left" {
			return "right"
		}
		return "left"
	}

	// ---- over the sprites, where it stays put: what's being read or said

	void draw_message {
		if !Reading {
			return
		}
		int Top = height - 90
		stage.set_color "white"
		stage.fill_rectangle 12, Top, width - 24, 78
		stage.set_color "#2b2b38"
		stage.set_line_width 4
		stage.rectangle 12, Top, width - 24, 78
		stage.set_font_size 18
		stage.write 32, Top + 22, Message
		stage.set_font_size 14
		stage.write 32, Top + 52, "(Space to close)"
	}
}

int main {
	world w
	w.run
}

// (Cabby's tests read the sign, walk from the woods into town, and talk
// to the baker:)
// script: frames 5; tap left; frames 20; tap left; frames 20; tap up; tap space; frames 5; tap space; frames 5; hold right; frames 75; release right; frames 20; hold down; frames 165; release down; frames 30; hold down; frames 110; release down; frames 20; tap left; frames 20; tap left; frames 5; tap space; frames 5; tap space; frames 5; close
//
// Try this:
//  - Add a person of your own to town.txt, and a sign to the woods.
//  - Make a third area, a beach, with a way to it from the town.
//  - Let people say more than one thing: a list of what they say, and
//    the next one each time Space is pressed.

// ---------------------------------------------------------------- output
//> in the woods at 5 3
//> stopped at 4 3
//> stopped at 3 3
//> bump up
//> the sign says: The woods. Cabby Town is to the south.
//> stopped at 8 3
//> in the town at 8 1
//> stopped at 8 2
//> stopped at 8 9
//> stopped at 7 9
//> the baker says: Good morning! The bread is fresh today.
