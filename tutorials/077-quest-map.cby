// Tutorial 77: Cabby Quest, part 1 — the map
//
// Run it:      cabby 077-quest-map.cby
// Or compile:  cabby -c 077-quest-map.cby && ./077-quest-map
// Library:     use game, use files
// Topics:      a game built a little at a time: a map read from a file,
//              ground and what stands on it, layers, the camera
//
// Tutorials 77 to 88 build one game, Cabby Quest, from an empty window to
// an adventure with music, people who walk and talk, a quest, saving,
// menus and battles. Each tutorial is the whole game so far, and each adds
// one part.
//
// The code is in numbered sections of no more than ten lines, in the order
// they're built, each with a heading like this:
//
//     // ==== 77.3  Building the world ====
//
// The number is the tutorial that wrote it. Later tutorials keep these
// sections, under the same numbers, so what's new in each is the sections
// with its own number. A section a later tutorial changes says so in its
// heading: (changed in 79). The manual's chapters 77 to 88 go through the
// new sections one by one.
//
// This part: the woods, read from quest/woods.txt, with the ground in
// one layer and the trees in another, and the hero standing in them.
//
// The pictures are in pictures/, and the maps in quest/, next to this file.

use game
use files

// ==== 77.1  Sizes ========================================================

const int TILE = 48                 // each tile's size, in pixels
const int SHOWN_COLUMNS = 13        // how much of the world the stage shows
const int SHOWN_ROWS = 9
const int GROUND = 0                // the layers: the ground, under everything,
const int STANDING = 1              // and what stands on it, lower in front

// ==== 77.2  The world ====================================================

object world : game.window {
	list str Map                    // the area's tiles, a character each
	lookup char str Grounds         // the picture for each kind of ground
	game.sprite Hero

	// ==== 77.3  Building the world =======================================

	void build {
		set_title "Cabby Quest"
		set_size SHOWN_COLUMNS * TILE, SHOWN_ROWS * TILE
		set_background "black"
		sort_by_depth STANDING          // the hero, trees and houses
		Grounds = {'~': "water", 'f': "flowers", '=': "path", 'S': "sign"}
		go_to "woods", 5, 3
	}

	// ==== 77.4  Going to an area =========================================

	void go_to const str &Area, int C, int R {
		read_area Area
		set_world_size (int)Map[0].length * TILE, (int)Map.length * TILE
		add_tiles
		Hero = add_sprite "pictures/hero-down-1.png", middle_of(C), middle_of(R)
		Hero.set_layer STANDING
		follow Hero                     // the camera keeps the hero in the middle
		println "in the", Area, "at", C, R
	}

	// ==== 77.5  Reading an area's map ====================================

	// quest/woods.txt: notes (//) first, then the map, a line a row
	void read_area const str &Area {
		for Line in files.lines "quest/" + Area + ".txt" {
			if Line == "---" {
				break                   // (what's after the map comes later)
			} else if !Line.starts_with("//") && Line.trim != "" {
				Map.add Line.copy
			}
		}
	}

	// ==== 77.6  A sprite for every tile ==================================

	void add_tiles {
		for R in Map.length {
			for C in Map[R].length {
				add_ground Map[R][C], middle_of(C), middle_of(R)
				add_standing Map[R][C], middle_of(C), middle_of(R)
			}
		}
	}

	// ==== 77.7  Which ground =============================================

	// grass, unless Grounds says otherwise
	str ground_of char Tile const {
		if Grounds.contains Tile {
			return Grounds[Tile].copy
		}
		return "grass"
	}

	// ==== 77.8  The ground ===============================================

	// water and flowers move a little: two pictures, in turn
	void add_ground char Tile, long X, long Y {
		str Name = ground_of Tile
		str Picture = "pictures/tile-" + Name
		if Name == "water" || Name == "flowers" {
			game.sprite Moving = add_sprite Picture + "-1.png", X, Y
			Moving.animate {Picture + "-1.png", Picture + "-2.png"}, 700
		} else {
			add_sprite Picture + ".png", X, Y
		}
	}

	// ==== 77.9  What stands on the ground ================================

	// taller than their tile: placed so their bottom is on it
	void add_standing char Tile, long X, long Y {
		if Tile == 'T' {
			game.sprite Tree = add_sprite "pictures/tall-tree.png", X, Y - TILE / 4
			Tree.set_layer STANDING
		} else if Tile == 'D' {
			game.sprite House = add_sprite "pictures/house.png", X, Y - TILE
			House.set_layer STANDING
		}
	}

	// ==== 77.10  Where a tile is =========================================

	// the middle of a tile, in pixels, from its column (or row)
	long middle_of long Tile const {
		return Tile * TILE + TILE / 2
	}
}

// ==== 77.11  Starting ====================================================

int main {
	world w
	w.run
}

// (Cabby's tests just look:)
// script: frames 5; close
//
// Try this:
//  - Start the hero somewhere else: go_to "woods", 10, 8.
//  - Draw a new tree into quest/woods.txt, and run it again.
//  - Take out Tree.set_layer STANDING: the tree is on the ground layer
//    then, and the grass of the tile above is drawn over its leaves.

// ---------------------------------------------------------------- output
//> in the woods at 5 3
