// Tutorial 99: Linux — inside the computer
//
// Run it:      cabby 099-linux.cby
// Or compile:  cabby -c 099-linux.cby && ./099-linux
// Library:     use linux
// Topics:      linux.temperatures, linux.fans, linux.block_devices,
//              linux.usb_devices, linux.modules, linux.module_loaded,
//              linux.setting, linux.has_setting, linux.services,
//              linux.has_service, linux.service_named
//
// What a Linux computer has that a Mac doesn't, read from the files the
// kernel keeps for it: its temperatures and fans, its disks and their
// partitions, what's plugged in by USB, the kernel's modules (its
// drivers) and settings, and the services systemd keeps running.
//
// On a Mac there's none of this (each is a panic that says so), so the
// program asks `system.kind` first. The output below is one computer's.

use linux
use system

int main {
	if system.kind != "linux" {
		println "This is", system.name + ": the linux library is for Linux"
		return 0
	}
	println "Inside", system.hostname + ":"
	for T in linux.temperatures {
		str Hot = ""
		if T.high > 0 && T.value >= T.high {
			Hot = "  (hot!)"
		}
		println "  " + T.chip, T.label + ":", T.value.text(1), T.unit + Hot
	}
	for F in linux.fans {
		println "  a fan,", F.label + ":", F.value, F.unit
	}
	for D in linux.block_devices {
		if D.kind == "disk" {
			str Kind = "a hard disk"
			if D.ssd {
				Kind = "an SSD"
			}
			println "  " + D.name + ":", Kind + ",", D.model, D.size / 1000000000, "GB"
		} else if D.mounted_at != "" {
			println "    " + D.name, "is mounted at", D.mounted_at
		}
	}
	for U in linux.usb_devices {
		println "  USB:", U.maker, U.name, "(" + U.vendor_id + ":" + U.product_id + ")"
	}
	println "  " + linux.modules.length.text, "modules loaded; Bluetooth's:", linux.module_loaded("bluetooth")
	if linux.has_setting "vm.swappiness" {
		println "  vm.swappiness is", linux.setting("vm.swappiness")
	}
	int Failed = 0
	for S in linux.services {
		if S.active == "failed" {
			Failed++
			println "  failed:", S.name
		}
	}
	println "  " + linux.services.length.text, "services,", Failed, "of them failed"
	if linux.has_service "ssh" {
		linux.service Ssh = linux.service_named "ssh"
		println "  ssh is", Ssh.active, "and", Ssh.enabled
	}
}

// Try this:
//  - Warn when any temperature is within 10 degrees of its `high`.
//  - Say which disks can be taken out (`D.removable`).
//  - List this person's own services (`linux.user_services`): PipeWire's,
//    perhaps.

// ---------------------------------------------------------------- output
// output varies: what one computer said (a virtual one, with no sensors, USB or systemd; five of its disks left out)
//> Inside vm:
//>   vda: a hard disk, 0x1af4 274 GB
//>   0 modules loaded; Bluetooth's: false
//>   vm.swappiness is 60
//>   0 services, 0 of them failed
