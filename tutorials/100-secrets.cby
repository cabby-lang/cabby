// Tutorial 100: Secrets — passwords, locks and signatures
//
// Run it:      cabby 100-secrets.cby
// Or compile:  cabby -c 100-secrets.cby && ./100-secrets
// Library:     use secrets
// Topics:      secrets.random_number, random_text, random_password;
//              hash_password, check_password; lock, unlock, can_unlock,
//              lock_file, unlock_file; signature, check_signature, same;
//              make_private_key, public_key, sign, check_signed
//
// Four things a program keeps safe:
//   - a password: kept as its hash, which can check a password but can't
//     be turned back into one
//   - a secret: locked with a password, and unlocked only with it
//   - a message: signed, so whoever has the key can tell it's unchanged
//   - a message for everyone: signed with a private key, and checked by
//     anyone with the public key that goes with it
// And random numbers and text no one can guess, as dice and `random`
// aren't meant to be.
//
// What's random is different each time, so it's checked here rather than
// printed: its length, and what it's made of.

use secrets
use files

int main {
	// ---- random, for what no one must guess
	str Code = secrets.random_text 16
	str Password = secrets.random_password 12
	long Die = secrets.random_number 1, 6
	println "a code of", Code.length, "characters, a password of", Password.length.text + ",", "and a die that says 1 to 6:", Die >= 1 and Die <= 6

	// ---- a password, kept as its hash
	str Kept = secrets.hash_password "correct horse battery staple"
	println "the hash starts", Kept[0 to 14], "and is", Kept.length, "characters"
	println "the right password:", secrets.check_password("correct horse battery staple", Kept)
	println "a wrong one:", secrets.check_password("correct horse", Kept)

	// ---- a secret, locked with a password
	str Locked = secrets.lock "The safe's code is 4812.", "hunter2"
	println "locked:", Locked.length > 40, "and not readable:", !Locked.contains("4812")
	println "unlocked:", secrets.unlock(Locked, "hunter2")
	println "with the wrong password:", secrets.can_unlock(Locked, "hunter3")
	files.write "cabby-diary.txt", "Dear diary, today I learned Cabby."
	secrets.lock_file "cabby-diary.txt", "cabby-diary.locked", "tea4two"
	println "the diary, unlocked:", secrets.unlock_file("cabby-diary.locked", "cabby-diary.back", "tea4two"), files.read("cabby-diary.back")
	files.delete "cabby-diary.txt"
	files.delete "cabby-diary.locked"
	files.delete "cabby-diary.back"

	// ---- a message, signed with a key both ends know
	str Key = "the key the two ends share"
	str Signature = secrets.signature "pay Ana $20", Key
	println "signed:", Signature.length, "hexadecimal digits"
	println "unchanged:", secrets.check_signature("pay Ana $20", Key, Signature)
	println "changed:", secrets.check_signature("pay Ana $2000", Key, Signature)
	println "the same, carefully:", secrets.same(Signature, Signature)

	// ---- a message for everyone, signed with a private key
	if secrets.can_use_keys {
		str Private = secrets.make_private_key
		str Public = secrets.public_key Private
		str Signed = secrets.sign "Cabby 1.0 is out", Private
		println "checked with the public key:", secrets.check_signed("Cabby 1.0 is out", Public, Signed)
		println "and a forgery:", secrets.check_signed("Cabby 2.0 is out", Public, Signed)
	}
}

// Try this:
//  - Keep users' password hashes in a file (name, then hash, a line each),
//    and write a log-in that checks one.
//  - Lock a note with a password typed in (`input`), and unlock it again.
//  - Print secrets.random_password 20 a few times: no two are alike.

// ---------------------------------------------------------------- output
//> a code of 16 characters, a password of 12, and a die that says 1 to 6: true
//> the hash starts $pbkdf2-sha256$ and is 91 characters
//> the right password: true
//> a wrong one: false
//> locked: true and not readable: true
//> unlocked: The safe's code is 4812.
//> with the wrong password: false
//> the diary, unlocked: true Dear diary, today I learned Cabby.
//> signed: 64 hexadecimal digits
//> unchanged: true
//> changed: false
//> the same, carefully: true
//> checked with the public key: true
//> and a forgery: false
