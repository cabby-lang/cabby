// Tutorial 12: Strings
//
// Run it:      cabby 12-strings.cby
// Keywords:    str
// Topics:      .length, s[i], + and +=, .copy, searching, slices, .text,
//              text to numbers,
//              reading input, comparing, borrowing
//
// A `str` owns its text: it lives on the heap and is freed automatically
// when its owner is done with it (tutorial 13 explains exactly when). A
// literal like "hi" is fixed text built into the program; it becomes an
// owned str wherever one is needed.
//
// Every string has:
//   s.length      how many characters (bytes) it has, as a long
//   s[i]          one character, numbered from 0; you can also assign to it
//   a + b         a new string: a str joined with a str or a char
//   s += b        add to the end of s
//   s.copy        a second, independent string with the same text
//   a < b         dictionary order (also <=, >, >=)
//
// Searching and changing (each gives a new string or an answer; s itself
// stays as it was):
//   s.contains t, s.starts_with t, s.ends_with t     true or false
//   s.find t        where t starts, or -1          (t: a str or a char)
//   s.replace a, b  every a replaced by b
//   s.trim          without spaces, tabs and Enters at either end
//   s.upper, s.lower, s.repeat n
//
// Slices: s[a to b] is a new string of characters a to b, both included.
// s[a to] goes to the end, s[to b] starts at 0.
//
// And every number, bool and char has .text: itself as a string.
//
// Going the other way, text to a number:
//   s.is_int      is it a whole number that fits in an int? ("42", " -7 ")
//   s.to_int      that number (it panics if the text isn't one: check first)
//   s.is_long, s.to_long, s.is_number, s.to_double   the same for long and
//                 double ("2.5", "1e3")
//
// Reading what is typed (a line at a time, without its Enter):
//   str Name = input "Name: "    shows the prompt, then reads a line
//   str Line = read_line         reads a line, with no prompt
//   end_of_input                 true once a read found nothing left
//                                (Ctrl-D, or the end of a file)

// `const str &` borrows a string to read it, without taking it over.
void shout const str &Word {
	println Word + "!"
}

// Count the times a character appears.
int count const str &Text, char c {
	int n = 0
	for i in Text.length {
		if Text[i] == c {
			n++
		}
	}
	return n
}

int main {
	str Greeting = "hello"
	println Greeting, "has", Greeting.length, "characters"

	// One character at a time. Characters are numbered from 0.
	println "first:", Greeting[0], "last:", Greeting[Greeting.length - 1]
	Greeting[0] = 'j'
	println Greeting

	// Building strings.
	str Name = "Ada"
	str Line = "Hi, " + Name + '!'
	println Line
	Line += " Welcome back."
	println Line

	// Spell a word out with a space between the letters.
	str Spaced
	for i in Name.length {
		if i > 0 {
			Spaced += ' '
		}
		Spaced += Name[i]
	}
	println Spaced

	println "the l's in hello:", count("hello", 'l')

	// Searching and changing. Calls sharing a line need parentheses.
	str Sentence = "  the cat sat on the mat "
	Sentence = Sentence.trim
	println Sentence.contains("cat"), Sentence.find("sat"), Sentence.ends_with("mat")
	println Sentence.replace("cat", "dog").upper

	// Slices: characters a to b, both included.
	str Word = "cabbage"
	println Word[0 to 2], Word[4 to], Word[to 1]

	// Numbers as text: + joins strings and chars, so a number goes in as
	// its .text (the same text println shows for it).
	int Age = 36
	double Height = 1.75
	str About = Name + " is " + Age.text + ", " + Height.text + "m tall"
	println About

	// Text to numbers: check, then convert.
	str Typed = "41"
	if Typed.is_int {
		println "one more is", Typed.to_int + 1
	}
	println "2.5".to_double * 2, "forty".is_int

	// Comparing text: == and !=, and < > for dictionary order.
	println Greeting == "jello", Greeting != Name, "apple" < "banana"

	// Borrowing: shout reads Greeting, and Greeting is still ours afterwards.
	shout Greeting
	println Greeting

	// Strings are MOVED, not copied (tutorial 13). To keep the original and
	// have a second string you can change, ask for a copy.
	str Original = "cat"
	str Changed = Original.copy
	Changed[0] = 'b'
	println Original, Changed

	// Escapes in literals: \n newline, \t tab, \" quote, \\ backslash.
	println "a\tb \"quoted\" back\\slash"

	// The empty string: the starting value of every str.
	str Nothing
	println "[" + Nothing + "]", Nothing.length
}

// A character is a byte. Text in English fits one character per byte;
// letters like é or Greek α take two or more bytes each (UTF-8), so they
// count as more than one in .length and s[i].
//
// Try this:
//  - Read Greeting[10]. Look at the panic message.
//  - Write `str reversed const str &s` that returns s backwards (tutorial
//    30 has one way to do it).
//  - Try `str Bad = "n = " + Age`. Read the error and its suggestion.
//  - Print a name's initials: the first letter, and the letter after the
//    space (use .find ' ' and s[i]).
//  - Read Word[5 to 9] and read the panic.
//  - Ask for the user's name and age with `input`, and print how old they
//    will be next year. Keep asking while the age isn't `.is_int`.

// ---------------------------------------------------------------- output
//> hello has 5 characters
//> first: h last: o
//> jello
//> Hi, Ada!
//> Hi, Ada! Welcome back.
//> A d a
//> the l's in hello: 2
//> true 8 true
//> THE DOG SAT ON THE MAT
//> cab age ca
//> Ada is 36, 1.75m tall
//> one more is 42
//> 5.0 false
//> true true true
//> jello!
//> jello
//> cat bat
//> a	b "quoted" back\slash
//> [] 0
