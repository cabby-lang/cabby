// a bear: the strongest of them, and as rare
critter woods_bear {
	critter Bear
	Bear.set_up "bear", 8, 30, 15, 11, 9
	Bear.Lift = 0
	Bear.Top = 0.95
	Bear.Moving = "walk"
	Bear.Moves = {"Swipe", "Maul"}
	Bear.Powers = {50, 45}
	return Bear
}

// ==== 130.3  A wild one, by its kind ======================================

// "border collie": its numbers, as it's met in the wild
critter wild_of const str &Kind {
	if Kind == "hill crow" {
		return hill_crow
	} else if Kind == "border collie" {
		return border_collie
	} else if Kind == "cow" {
		return meadow_cow
	} else if Kind == "bison" {
		return bison
	} else if Kind == "bear" {
		return woods_bear
	}
	return field_mouse
}

// its model
str model_path const str &Kind {
	if Kind == "Ember" {
		return EMBER_MODEL.copy
	} else if Kind == "Bruno" {
		return BRUNO_MODEL.copy
	} else if Kind == "hill crow" {
		return CROW_MODEL.copy
	} else if Kind == "border collie" {
		return COLLIE_MODEL.copy
	} else if Kind == "cow" {
		return COW_MODEL.copy
	} else if Kind == "bison" {
		return BISON_MODEL.copy
	} else if Kind == "bear" {
		return BEAR_MODEL.copy
	}
	return MOUSE_MODEL.copy
}

// ==== 127.1  One of the party  (changed in 130) ==========================

// one caught: its kind, its level, how hurt it is, and its experience
// toward its next level; kept in the saved game as a line, "hill
// crow|4|0|10" (a game saved by part 19 has "hill crow 4")
struct member {
	str Kind
	int Level
	int Wounds
	int Experience
}

member member_from const str &Line {
	member One
	if Line.contains "|" {
		list str Parts = Line.split "|"
		One.Kind = Parts[0].copy
		One.Level = Parts[1].to_int
		One.Wounds = Parts[2].to_int
		One.Experience = Parts[3].to_int
	} else {
		list str Words = Line.split " "
		int Last = (int)Words.length - 1
		One.Kind = Line[0 to Line.length - Words[Last].length - 2]
		One.Level = Words[Last].to_int
	}
	return One
}

str line_of_member const member &One {
	return One.Kind + "|" + One.Level.text + "|" + One.Wounds.text + "|" + One.Experience.text
}

// its numbers at its level: the wild one's, and for each level above that,
// two more health and one more of each of the rest (as Bruno's grow)
critter member_critter const member &One {
	critter It = wild_of One.Kind       // (130) whatever kind it is
	int Up = One.Level - It.Level
	str Called = It.Name[0 to 0].upper + It.Name[1 to It.Name.length - 1]   // ("Hill crow", as a name)
	It.set_up Called, One.Level, It.Most + 2 * Up, It.Strength + Up, It.Toughness + Up, It.Speed + Up
	It.Health = It.Most - One.Wounds
	if It.Health < 0 {
		It.Health = 0
	}
	return It
}

// ==== 109.2  An area next door ===========================================

// another area's map, built beyond an edge of this one; Col and Row are
// where its top left tile is, counted on this area's map (tutorial 79's)
object neighbour {
	str Area                        // "woods"
	str Side                        // the edge it's beyond: "north"
	list str Map
	int Col
	int Row
	bool Corner                     // next door to next door: seen, not walked into

	// beyond its edge of Here (this area's map), Along tiles along it
	void place_beside const list str &Here, int Along {
		if Side == "north" || Side == "south" {
			Col = Along
			Row = beyond Side == "south", (int)Here.length, (int)Map.length
		} else {
			Row = Along
			Col = beyond Side == "east", (int)Here[0].length, (int)Map[0].length
		}
	}

	// (an area at a corner: placed beside the area next door, then moved
	// with it)
	void move_by int Columns, int Rows {
		Col += Columns
		Row += Rows
	}

	// the first row (or column) past the edge: just after Here's last, or
	// far enough before 0 to fit its own (Mine)
	int beyond bool After, int Here, int Mine const {
		if After {
			return Here
		}
		return -Mine
	}

	// whether the tile C, R (counted on this area's map) is in it, and what
	// it is
	bool has int C, int R const {
		return R >= Row && R < Row + (int)Map.length && C >= Col && C < Col + (int)Map[R - Row].length
	}

	char tile int C, int R const {
		return Map[R - Row][C - Col]
	}
}

// ==== 114.1  What the hero has done  (changed in 117, 123, 126, 127, 128, 133)

struct progress {
	lookup str str Answers          // what they answered: "elder name": "Livia"
	str Quest                       // the baker's spoon: "", "asked" or "done"
	list str Items                  // what the hero carries: "spoon"
	list str Taken                  // what's been picked up: "bakery 9,4"
	list str Noticed                // who has noticed them: "baker"
	int Wounds                      // how hurt Ember is (0: well)
	int EmberLevel                  // her level (before any battle: 0, which is 5)
	int EmberExperience             // and her experience toward the next
	double Time                     // (117) the time of day: 0 midnight, 0.5 noon
	bool Raining
	str Town                        // (123) the last town the hero was in ("": Cabby Town)
	int Balls                       // (126) Cabbyballs carried
	list str Party                  // the Cabbymon caught, and their levels: "field mouse 3"
	list str Seen                   // every kind met in the wild: "hill crow"
	list str Caught                 // and every kind caught
	int Lead                        // (127) who leads: 0 Ember, 1 the first caught, ...
	int Days                        // (128) how many days have passed: 0 on the first
	int Denarii                     // (133) the hero's money
	str Area                        // and where the hero is (when saved)
	int Col
	int Row
	str Facing
}

// ==== 108.7  What's happening  (changed in 109, 112, 113, 114) ===========

enum mode {
	PLAYING                         // walking about
	READING                         // words showing: Space goes on
	FADING_OUT                      // the light going down, to go through a way
	FADING_IN                       // and coming up again, there
	BATTLE                          // (112) in a battle
	NOTICED                         // (113) someone has seen the hero, and comes over
	CHOOSING                        // (114) a question's answers showing
}

// ==== 108.8  The world  (changed in 109, 110, 111, 112, 113) =============

object quest : world.window {
	list str Map                    // the area's tiles, a character each
	list str Things                 // the lines after the map: signs ...
	walker Hero
	list walker People              // (110) everyone else in the area
	mode Mode
	world.text Words                // what's being read, over the world
	world.text Shade                // (the same, a little lower: a shadow for it)
	str Turned                      // the arrow key that turned the hero

	// ==== 109.3  Going somewhere else ====================================

	str Area                        // the area the hero is in: "town"
	str NextArea                    // and where they're going, when it's dark
	int NextCol
	int NextRow
	int FadeFrame                   // how far through the fade
	list neighbour Joins            // the areas next door
	world.text Name                 // the area's name, at the top left for a moment
	world.text NameShade
	long NameFrom                   // the frame it appeared in
	bool Inside                     // in a house: no sky

	// ==== 112.16  A battle's state =======================================

	critter Ours                    // Ember
	critter Foe                     // and what she's facing
	int ZoomFrame                   // how far down into the world the camera is
	bool Leaving                    // and it's going back up
	bool Over                       // won, lost or run from: it ends after the words
	bool Lost
	bool Reading                    // words showing, until Space
	world.text OursLine             // how each is doing, in words
	world.text FoeLine

	// ==== 112.17  What comes next ========================================

	list str Beats                  // what's said next, in turn
	list int Hits                   // after each, what happens (112.31)
	list int HealthAfter            // and the health it leaves
	int Hit                         // what happens after the words showing
	int HitTo                       // and the health it leaves

	// ==== 112.18  The menu showing =======================================

	str Menu                        // the menu showing: "battle", "moves" ("": none)
	list str Choices                // its choices
	int Choice                      // the one the arrow points at
	world.text Options              // (shown under the words)
	world.text OptionsShade

	// ==== 113.5  Who has noticed the hero ================================

	lookup str int Sight            // how far each sees: {"baker": 3}
	int Comer                       // who has noticed the hero, and is coming over
	int NoticeFrame                 // frames since (the "!" shows for the first few)
	world.shape Bang                // the "!" over their head

	// ==== 113.6  Rufus's battle ==========================================

	str Owner                       // whose critter Ember is facing ("": a wild one)
	bool Challenge                  // Rufus has asked for a battle
	bool BackedOff                  // and stepped back, to make room for it
	bool WalkingOff                 // he's walking away, after it
	int Leaver                      // (which of the people he is)

	// ==== 114.2  The story so far ========================================

	progress Story                  // (Ember's wounds, and her level, are in it)

	// ==== 115.1  What the title shows ====================================

	bool OnTitle                    // the title is showing
	world.text Title                // "Cabby Quest", big
	world.text TitleShade
	double Round                    // how far round the town the camera is, in degrees

	// ==== 115.2  Options  (changed in 117) ===============================

	bool NoShadows                  // (fields start false: shadows on, to begin with)
	bool Far                        // the camera, further from the hero
	bool QuickDays                  // (117) a day of two minutes, not 24

	// ==== 116.2  In the water ============================================

	bool Swimming                   // the hero is in the water (or stepping in)
	int OriginX                     // where this area's top left tile is in the
	int OriginZ                     // world (116.11): 0, 0 until an edge is crossed

	// ==== 117.3  The light, and the rain =================================

	double Fade                     // the light, faded (109.15): 1, all of it
	double Wet                      // how hard it's raining: 0 dry, 1 pouring
	bool Night                      // (to say when it falls)
	list world.shape Drops          // the raindrops
	list world.shape Windows        // the houses' windows
	list world.lamp WindowLamps     // and the light from each
	lookup str list str Maps        // each area's file, read once: "town": its lines
	double Bobbed                   // how far the hero has bobbed up, in the water

	// ==== 118.2  In the dark =============================================

	bool Dark                       // this area is a cave: no sun, no sky
	bool Dim                        // (136) under trees: darker than outside, but not dark
	str Going                       // (136) the way the hero was going, as a wild one appeared
	list world.lamp CaveLamps       // its crystals' light, and the lantern (the last)
	list world.lamp Daylight        // (128) a dark room's light, by day
	list world.lamp Fires           // (135) a fire's light, flickering
	list world.shape Bats           // bats, flying round
	list world.shape Wings          // (two for each)
	list double BatX                // and where each flies round
	list double BatZ
	list world.shape Drips          // a drop of water, falling from the dark (one)

	// ==== 119.2  What's playing ==========================================

	str Playing                     // the music playing: "town" ("": none)
	bool NoMusic                    // (the options: fields start false, so on)
	bool NoSounds
	lookup str sound.track Near     // sounds heard from somewhere in the world, loaded once
	sound.track Rain                // the rain, round and round
	bool RainLoaded
	double Flash                    // lightning: 1 at its brightest, fading to 0

	// ==== 122.2  The start  (changed in 123) =============================

	int Scene                       // how far through the start's story: a step at a time
	int SceneFrame                  // and how many frames into this step
	world.shape Train               // the train's engine: the rest is joined to it
	list world.shape Puffs          // steam, rising from its chimney
	list int PuffAges               // (and how many frames each has risen)
	bool Resting                    // (123) worn out: back to the elder
	list world.shape Thrown         // (126) a Cabbyball, caught in it, out in a battle
	int Current                     // (127) who's out in a battle: 0 Ember, 1 the first caught, ...
	bool HoursDue                   // (128) night's fallen, or the day's come: who's out changes
	list int Battled                // (129) who's been out in this battle: 0 Ember, 1 the first caught, ...
	list int Others                 // and, while choosing, who can be switched in
	lookup str int Chats            // (132) how often each of the folk has been talked to
	bool Riding                     // (133) aboard the train, out of sight, until it's gone
	bool Rolling                    // (134) the credits rolling up the title
	double RollY                    // and how far up they are
	world.text Credits
	world.text CreditsShade
	bool FoeAfter                   // (131) switched: the wild one has its go once the other's out
	int BallDoing                   // (131) the Cabbyball: 0 still, or THROWN, WOBBLING, OPENING
	int BallFrame                   // how far through that it is
	double BallFromX                // where it was thrown from
	double BallFromY
	double BallFromZ

	// ==== 121.2  Ember, following ========================================

	walker Follower                 // Ember, a step behind the hero
	list world.shape FollowerParts  // (her shapes, to hide and show)
	list footstep Steps             // the hero's moves she's still to make
	bool Waiting                    // on the hero's tile, out of sight
	bool Crossing                   // the hero is walking into the next area
	int FollowCol                   // and where she'll be in it
	int FollowRow
	double FollowFeet

	// ==== 120.2  By the sea ==============================================

	list double BatY                // (fliers, bats or gulls: how high each flies,
	list double BatWide             // how wide it goes round, and what it cries)
	list str BatCry
	list world.shape Beams          // the lighthouse's beam
	list world.shape LampRooms      // and the room at its top, its lamp in it
	list world.lamp Beacons         // and its light
	sound.track Surf                // the waves, round and round
	bool SurfLoaded
	list world.shape Ripples        // rings spreading on the water (two shapes each)
	list int RippleAges             // and how many frames each has spread
	list double RippleSizes         // and how big each grows (1: a swimmer's)

	// ==== 108.9  Building it  (changed in 109, 112, 114, 115, 134) =======

	void build {
		set_title "Cabby Quest"
		set_size 800, 600
		set_sun -0.3, -1, -0.5
		NameShade = add_text "", 22, 18
		NameShade.set_color "black"
		Name = add_text "", 20, 16
		Shade = add_text "", 22, 532
		Shade.set_color "black"
		Words = add_text "", 20, 530
		OptionsShade = add_text "", 22, 564          // (112)
		OptionsShade.set_color "black"
		Options = add_text "", 20, 562
		FoeLine = add_text "", 500, 16
		TitleShade = add_text "", 214, 124           // (115)
		TitleShade.set_size 64
		TitleShade.set_color "#2b2b38"
		Title = add_text "", 210, 120
		Title.set_size 64
		OursLine = add_text "", 20, 490
		CreditsShade = add_text "", 0, 700      // (134) out of sight, until they roll
		CreditsShade.set_color "black"
		Credits = add_text "", 0, 700
		read_maps                       // (117)
		show_title                      // (115)
		on_frame step
	}

	// ==== 115.3  Showing the title  (changed in 116, 119, 134) ===========

	// the town, with nobody walking about in it, the camera circling it,
	// and "Cabby Quest" over it
	void show_title {
		OriginX = 0                     // (116) the town where the camera circles it
		OriginZ = 0
		go_to "town", 8, 4
		Hero.Body.set_visible false
		Story.Time = 0.45               // (117) late morning, while the title shows
		light 1
		Name.set_text ""
		NameShade.set_text ""
		OnTitle = true
		Title.set_text "Cabby Quest"
		TitleShade.set_text "Cabby Quest"
		music "woods"                   // (119)
		title_menu
	}

	// what to do: Continue only when there's a saved game
	void title_menu {
		list str Choices = {"New game"}
		if files.exists save_path {
			Choices.add "Continue"
		}
		Choices.add "Options"
		Choices.add "Credits"           // (134)
		ask "title", "Left and right to choose; Space to go.", Choices
	}

	// ==== 115.4  Circling the town =======================================

	// a little further round each frame, high up, looking at its middle
	void circle_town {
		Round += 0.15
		double A = Round * PI / 180
		move_camera_to 12 + 16 * sin(A), 10, 8 + 16 * cos(A)
		point_camera_at 12, 0, 8
	}

	// ==== 115.5  Off the title ===========================================

	void leave_title {
		OnTitle = false
		Title.set_text ""
		TitleShade.set_text ""
	}

	// ==== 115.6  A new game  (changed in 117, 122, 127) ==================

	// all that's been done forgotten, and the start: (122) on the train
	void new_game {
		leave_title
		progress Fresh
		Story = Fresh
		Story.Time = 0.3                // (117) a little after sunrise
		Story.Answers["start"] = "train"   // (122) on the train, arriving
		Story.Lead = 0                  // (127)
		Story.Days = 0                  // (128)
		Scene = 0
		SceneFrame = 0
		Hero.Facing = "right"
		start_at "station", 3, 7
	}

	// ==== 114.4  Where saved games go ====================================

	// the computer's place for them: ~/.local/share/Cabby Quest 3D on
	// Linux, ~/Library/Application Support/Cabby Quest 3D on a Mac
	str save_path const {
		return directories.save_folder("Cabby Quest 3D") + "/saved.json"
	}

	// ==== 114.5  Saving ==================================================

	// where the hero is, into Story; then all of Story, as JSON
	void save_game {
		Story.Area = Area.copy
		Story.Col = Hero.Col
		Story.Row = Hero.Row
		Story.Facing = Hero.Facing.copy
		files.write save_path, json.from(Story).pretty
		say "Saved."
	}

	// ==== 114.6  Carrying on  (changed in 115) ===========================

	// Story back from the file, and the hero where they were
	void load_game {
		json.read(files.read(save_path)).fill Story
		Hero.Facing = Story.Facing.copy
		leave_title                     // (115)
		start_at Story.Area.copy, Story.Col, Story.Row
	}

	// ==== 109.4  Arriving  (changed in 116, 119) =========================

	// there, out of the dark
	void start_at const str &Place, int C, int R {
		OriginX = 0                     // (116) in the dark: anywhere will do
		OriginZ = 0
		enter Place, C, R
		Mode = FADING_IN
		FadeFrame = 0
		light 0
	}

	// the area built, the hero in it, and its name showing
	void enter const str &Place, int C, int R {
		go_to Place, C, R
		area_music                      // (119)
		show_name
		println "in the", Area, "at", C, R
	}

	// ==== 109.5  Going to an area  (changed in 110, 111, 113, 114, 116, 117, 118, 121, 122, 123, 128, 136)

	// everything there is taken away, and the area and those next door built
	void go_to const str &Place, int C, int R {
		str Facing = facing_now
		clear_area
		Area = Place.copy
		read_area Place
		Dark = Things.contains "dark"   // (118) (a line on its own)
		Dim = Things.contains "dim"     // (136) and another
		Inside = has_walls || Dark
		add_tiles_of Map.copy, 0, 0     // (a copy: building changes the world, Map with it)
		add_joins
		add_ground
		Hero = new_walker "hero", C, R, Facing
		stand_on_tile                   // (111)
		Bobbed = 0                      // (117)
		add_people
		add_rival                       // (113)
		add_follower                    // (121)
		add_scene                       // (122)
		if setting("rest") != "" {
			Story.Town = Area.copy      // (123) a town, with an elder to wake beside
		}
		add_sights
		add_items                       // (114)
		light_by_day                    // (128)
		add_mouths                      // (118)
		to_its_place                    // (116)
		if Dark {
			into_the_dark
		}
		add_fliers "bats"               // (120) bats, or gulls, in any area
		add_fliers "gulls"
		look_at_hero
	}

	// ==== 116.11  One world  (changed in 117, 118) =======================

	// everything just built (made at its tile on the area's own map) moved
	// to where the area is in the world: so walking over an edge, nothing
	// in the world moves, the shadows, the trees' swaying, the camera
	// (what's joined moves with what it's joined to)
	void to_its_place {
		for Shape in shapes_in "" {
			if !Shape.joined {
				Shape.move OriginX, 0, OriginZ
			}
		}
		for Lamp in WindowLamps {
			Lamp.move_to Lamp.x + OriginX, Lamp.y, Lamp.z + OriginZ   // (117)
		}
		for Lamp in CaveLamps {
			Lamp.move_to Lamp.x + OriginX, Lamp.y, Lamp.z + OriginZ   // (118)
		}
		for Lamp in Beacons {
			Lamp.move_to Lamp.x + OriginX, Lamp.y, Lamp.z + OriginZ   // (120)
		}
	}

	// ==== 109.6  Clearing the world  (changed in 110, 116, 117, 118, 122, 128, 135)

	// every shape removed, and the last area's map (and people) forgotten
	void clear_area {
		for Old in shapes_in "" {
			Old.remove
		}
		Map.clear
		Things.clear
		Joins.clear
		People.clear
		WalkingOff = false              // (whoever was walking off went with them)
		Ripples.clear                   // (116) (gone with the rest)
		Puffs.clear                     // (122)
		PuffAges.clear
		RippleAges.clear
		RippleSizes.clear
		Drops.clear                     // (117) and the lamps, which aren't shapes
		Windows.clear
		for Lamp in WindowLamps {
			Lamp.remove
		}
		WindowLamps.clear
		for Lamp in CaveLamps {
			Lamp.remove                 // (118)
		}
		CaveLamps.clear
		for Lamp in Daylight {
			Lamp.remove                 // (128)
		}
		Daylight.clear
		for Lamp in Fires {
			Lamp.remove                 // (135)
		}
		Fires.clear
		for Lamp in Beacons {
			Lamp.remove                 // (120)
		}
		Beacons.clear
		Beams.clear
		LampRooms.clear
		BatY.clear
		BatWide.clear
		BatCry.clear
		Bats.clear
		Wings.clear
		BatX.clear
		BatZ.clear
		Drips.clear
	}

	// ==== 110.3  The people in an area  (changed in 128) =================

	// (by number: add_person changes the world, which a loop through one
	// of its lists can't let happen)
	void add_people {
		for I in Things.length {
			add_if_out Things[I].copy   // (128) if they're out at this hour
		}
	}

	// "person 11,3 elder down wanders": where, who, which way, and whether
	// they walk about
	void add_person const str &Line {
		list str Words = Line.split " "
		list str At = Words[1].split ","
		walker Someone = new_walker Words[2], At[0].to_int, At[1].to_int, Words[3]
		Someone.Wanders = Words.length > 4
		People.add Someone
	}

	// ==== 113.8  The rival ===============================================

	// "rival 13,7 left": Rufus, who's there until he's met the hero
	void add_rival {
		str Line = setting "rival"
		bool There = !Story.Noticed.contains("rival")
		if setting("rematch") != "" {
			Line = setting "rematch"            // (120) at the coast, until he's had his rematch
			There = !Story.Answers.contains("rematch")
		}
		if Line != "" && There {
			list str Words = Line.split " "
			list str At = Words[0].split ","
			walker Rufus = new_walker "rival", At[0].to_int, At[1].to_int, Words[1]
			People.add Rufus
		}
	}

	// ==== 114.7  Things to pick up =======================================

	// "item 9,4 spoon": the spoon, on tile 9,4 (unless it's been picked
	// up), in a group of its own, to take it away by
	void add_items {
		for I in Things.length {
			if Things[I].starts_with "item " {
				add_item Things[I].copy
			}
		}
	}

	void add_item const str &Line {
		list str Words = Line.split " "
		list str At = Words[1].split ","
		int C = At[0].to_int
		int R = At[1].to_int
		if item_at(C, R) != "" {
			world.shape Thing = make_item Words[2], C, R
			Thing.set_group "item " + Words[1]
		}
	}

	// ==== 114.8  A spoon  (changed in 116, 118) ==========================

	// a wooden handle, lying down, and its bowl, joined to it
	world.shape make_item const str &Name, int C, int R {
		if Name == "shell" {
			return make_shell C, R        // (116)
		} else if Name == "crystal" {
			return make_crystal C, R, 0.35   // (118)
		}
		world.shape Handle = add_cylinder 0.04, 0.6, "#f3dba8", C, 0.35, R
		Handle.set_tilt 90                  // (lying along z)
		world.shape Bowl = add_ball 0.12, "#e9c88a", C, 0.35, R - 0.36
		Bowl.set_size 0.22, 0.08, 0.28
		Bowl.join Handle
		return Handle
	}

	// ==== 116.3  A shell =================================================

	// pale pink, fanned: half a squashed ball, and ridges joined on
	world.shape make_shell int C, int R {
		world.shape Shell = add_ball 0.2, "#f6c1c9", C, 0.35, R
		Shell.set_size 0.4, 0.12, 0.32
		for I in 5 {
			world.shape Ridge = add_box 0.03, 0.03, 0.3, "#fbe3e7", C + (I - 2) * 0.07, 0.4, R
			Ridge.set_angle (I - 2) * 12
			Ridge.join Shell
		}
		return Shell
	}

	// ==== 114.9  Turning in the air ======================================

	// each frame, every thing to pick up turns a little, and bobs
	void turn_items {
		for Line in Things {
			if Line.starts_with "item " {
				for Thing in shapes_in "item " + Line.split(" ")[1] {
					Thing.turn 2
					Thing.move_to Thing.x, 0.35 + 0.06 * sin(frame / 20.0), Thing.z
				}
			}
		}
	}

	// ==== 114.10  A thing to pick up, here  (changed in 128) =============

	// the item on that tile ("spoon"), if it hasn't been picked up yet
	str item_at int C, int R const {
		if Story.Taken.contains(Area + " " + C.text + "," + R.text) || too_dark {
			return ""                   // ((128) or not to be seen, in the dark)
		}
		return thing_at "item", C, R
	}

	// ==== 113.9  How far they see ========================================

	// "sees baker 3": the baker sees the hero up to three tiles in front of
	// her
	void add_sights {
		Sight.clear
		for Line in Things {
			list str Words = Line.split " "
			if Words[0] == "sees" {
				Sight[Words[1]] = Words[2].to_int
			}
		}
	}

	// a new area, the hero facing as they were ("down" the first time)
	str facing_now const {
		if Hero.Facing == "" {
			return "down"
		}
		return Hero.Facing.copy
	}

	// a house, inside: its map has walls (#)
	bool has_walls const {
		for Line in Map {
			if Line.contains '#' {
				return true
			}
		}
		return false
	}

	// ==== 109.7  Its name ================================================

	// "name Cabby Town" after the map: at the top left, for a moment
	void show_name {
		str Called = setting "name"
		Name.set_text Called
		NameShade.set_text Called
		NameFrom = frame
	}

	// what a line after the map, "name Cabby Town", says ("": no such line)
	str setting const str &Key const {
		for Line in Things {
			if Line.starts_with Key + " " {
				return Line[Key.length + 1 to Line.length - 1]
			}
		}
		return ""
	}

	// ==== 108.10  Reading an area's map  (changed in 117, 122) ===========

	// quest/town.txt: notes (//) first, then the map, a line a row; then,
	// after ---, a line for each thing in the area (as in tutorial 78)
	void read_area const str &Area {
		bool InMap = true
		for Line in Maps[Area] {
			if Line == "---" {
				InMap = false
			} else if !Line.starts_with("//") && Line.trim != "" {
				if InMap {
					Map.add Line.copy
				} else {
					Things.add Line.copy
				}
			}
		}
		for_the_3d_quest                // (122)
	}

	// ==== 109.8  Just a map  (changed in 117, 122) =======================

	// an area's map, the rows before its ---, into Rows
	void read_map const str &Place, list str &Rows const {
		for Line in Maps[Place] {
			if Line == "---" {
				break
			} else if !Line.starts_with("//") && Line.trim != "" {
				Rows.add Line.copy
			}
		}
	}

	// an area's join lines, into Lines
	void read_joins const str &Place, list str &Lines const {
		for Line in Maps[Place] {
			if Line.starts_with "join " {
				Lines.add Line.copy
			} else if Line.starts_with "3d join " {
				Lines.add Line[3 to Line.length - 1]    // (122)
			}
		}
	}

	// ==== 108.11  The ground, and what's on each tile  (changed in 109, 116, 118, 122, 135, 137)

	// a map's tiles, its top left one at Left, Top: this area's at 0, 0,
	// and the areas' next door beside it
	void add_tiles_of const list str &Rows, int Left, int Top {
		for R in Rows.length {
			for C in Rows[R].length {
				add_tile Rows[R][C], Left + C, Top + R
			}
		}
	}

	void add_tile char Tile, double X, double Z {
		if Dark {
			add_cave Tile, X, Z         // (118)
		} else if Tile == '=' {
			add_plane 1, 1, "#d9c38c", X, 0.005, Z            // the path
		} else if Tile == '~' {
			add_water X, Z                                    // (116)
		} else if Tile == 'f' {
			add_flowers X, Z
		} else if Tile == 's' || Tile == 'K' || Tile == 'u' || Tile == 'Y' || Tile == 'L' {
			add_coast Tile, X, Z        // (120)
		} else if Tile == 'r' || Tile == 'p' || Tile == 'Q' {
			add_station Tile, X, Z      // (122)
		} else if Tile == 'N' || Tile == 'G' || Tile == 'k' || Tile == 'y' {
			add_built Tile, X, Z        // (137)
		} else if Tile == 'F' {
			add_campfire X, Z           // (135)
		} else if Tile == 'T' {
			add_tree X, Z
		} else if Tile == 'S' {
			add_sign X, Z
		} else if Tile == 'D' {
			add_house X, Z
		} else {
			add_inside Tile, X, Z
			add_hills Tile, X, Z
		}
	}

	// ==== 109.9  The ground under it all =================================

	// outside, grass as far as the trees go round the areas; inside, the
	// floor is the map's own, and dark beyond
	void add_ground {
		if Inside {
			return
		}
		int Left = 0
		int Top = 0
		int Right = (int)Map[0].length
		int Bottom = (int)Map.length
		for Next in Joins {
			Left = min_of Left, Next.Col
			Top = min_of Top, Next.Row
			Right = max_of Right, Next.Col + (int)Next.Map[0].length
			Bottom = max_of Bottom, Next.Row + (int)Next.Map.length
		}
		double Wide = Right - Left + 2 * RING
		double Deep = Bottom - Top + 2 * RING
		add_plane Wide, Deep, "#6fbf4a", Left - RING + (Wide - 1) / 2, 0, Top - RING + (Deep - 1) / 2
	}

	int min_of int A, int B const {
		if A < B {
			return A
		}
		return B
	}

	int max_of int A, int B const {
		if A > B {
			return A
		}
		return B
	}

	// ==== 108.12  Flowers  (changed in 116) ==============================

	// (116) each in the group "flowers", to sway
	void add_flowers double X, double Z {
		flower "yellow", X - 0.2, Z - 0.15
		flower "white", X + 0.15, Z + 0.1
		flower "#e8457a", X - 0.05, Z + 0.25
	}

	void flower const str &Color, double X, double Z {
		world.shape Petals = add_ball 0.06, Color, X, 0.06, Z
		Petals.set_group "flowers"
	}

	// ==== 116.4  Water ===================================================

	// a tile of it, in the group "water", to shimmer; and on one tile in
	// three, a wave, a thin pale line, in the group "waves", to drift
	void add_water double X, double Z {
		world.shape Water = add_plane 1, 1, "#3a7bd5", X, 0.005, Z
		Water.set_group "water"
		int Mix = (int)(7 * X + 3 * Z + 1000)      // (a number that differs from tile to tile)
		if Mix % 3 == 0 {
			world.shape Wave = add_box 0.35, 0.008, 0.04, "#cfe6ff", X, 0.01, Z - 0.3 + 0.25 * (Mix % 4)
			Wave.set_group "waves"
		}
	}

	// ==== 108.13  A tree: a trunk, its leaves joined on  (changed in 116)

	void add_tree double X, double Z {
		world.shape Trunk = add_cylinder 0.1, 0.5, "#7a4a24", X, 0.25, Z
		world.shape Leaves = add_cone 0.45, 1.1, "#2f7d32", X, 1.0, Z
		Leaves.join Trunk
		Trunk.set_group "trees"         // (116) to sway
	}

	// ==== 108.14  A sign: a post, its board joined on ====================

	void add_sign double X, double Z {
		world.shape Post = add_box 0.08, 0.7, 0.08, "#7a4a24", X, 0.35, Z
		world.shape Board = add_box 0.6, 0.35, 0.06, "#c8a165", X, 0.62, Z + 0.05
		Board.join Post
	}

	// ==== 108.15  A house: walls, a door and a roof, joined  (changed in 117)

	// at its door (D, with a wall either side and above it on the map):
	// the walls cover three tiles across and two up
	void add_house double X, double Z {
		world.shape Walls = add_box 3, 1.4, 2, "#f2e6d0", X, 0.7, Z - 0.5
		world.shape Door = add_box 0.55, 0.95, 0.06, "#8b5a2b", X, 0.475, Z + 0.52
		Door.join Walls
		// the roof: two boards, sloping down to the front and to the back
		world.shape Front = add_box 3.3, 0.08, 1.35, "#b5452c", X, 1.78, Z + 0.05
		Front.set_tilt 35               // (its back edge up: the ridge)
		Front.join Walls
		world.shape Back = add_box 3.3, 0.08, 1.35, "#b5452c", X, 1.78, Z - 1.05
		Back.set_tilt -35
		Back.join Walls
		add_window X - 1, Z + 0.52                      // (117)
		add_window X + 1, Z + 0.52
	}

	// ==== 117.12  The maps, read once  (changed in 130, 133) =============

	// every area's file in quest/, its lines kept by the area's name, so
	// walking into an area (and its next door, and theirs) reads none
	void read_maps {
		for Name in directories.list "quest" {
			if Name.ends_with ".txt" {
				Maps[Name[0 to Name.length - 5]] = files.lines "quest/" + Name
			}
		}
		for Name in Maps.keys {
			grow_grass Name             // (130) "3d grass" lines
			lay_tiles Name              // (133) "3d tiles" lines
		}
	}

	// ==== 117.13  Bobbing ===============================================

	// in the water, the hero goes up and down a little, slowly; out of it,
	// not (Feet, and the ground under them, don't change: it's only how
	// they're shown)
	void bob {
		double Up = 0
		if Swimming {
			Up = 0.025 * sin(frame / 25.0)
		}
		Hero.Body.move 0, Up - Bobbed, 0
		Bobbed = Up
	}

	// ==== 117.4  A window ================================================

	// a pane on the front wall, and a lamp just in front of it: dark, and
	// no light, by day
	void add_window double X, double Z {
		world.shape Pane = add_box 0.5, 0.4, 0.04, "#4a5866", X, 0.9, Z
		Windows.add Pane
		world.lamp Glow = add_lamp X, 0.9, Z + 0.5, "black", 3
		WindowLamps.add Glow
	}

	// Lit (0 to 1) as dark as it is: warm yellow, at night
	void light_windows double Lit {
		str Pane = css blend(rgb_of(74, 88, 102), rgb_of(255, 214, 130), Lit), 1
		str Glow = rgb 255, 196, 120, 0.8 * Lit
		for Window in Windows {
			Window.set_color Pane
		}
		for Lamp in WindowLamps {
			Lamp.set_color Glow
		}
	}

	// ==== 109.10  Inside a house  (changed in 135) =======================

	// its walls (#), floor (,), oven (O), a table (b) and the doormat (M)
	void add_inside char Tile, double X, double Z {
		if Tile == '#' {
			add_box 1, 1, 1, "#d7c4a3", X, 0.5, Z
		} else if Tile == ',' {
			add_plane 1, 1, "#a0703c", X, 0.005, Z
		} else if Tile == 'O' {
			add_plane 1, 1, "#a0703c", X, 0.005, Z
			add_box 0.9, 0.9, 0.8, "#55555e", X, 0.45, Z
			add_fire X, 0.2, Z + 0.32         // (135) in its open front
		} else if Tile == 'b' {
			add_plane 1, 1, "#a0703c", X, 0.005, Z
			if tile_at((int)X - 1, (int)Z) != 'b' {
				add_model TABLE_MODEL, X + table_reach(X, Z), 0, Z   // (135) once, over all its tiles
			}
		} else if Tile == 'M' {
			add_plane 1, 1, "#b03a2e", X, 0.006, Z
		}
	}

	// ==== 109.11  The hills  (changed in 112) ============================

	// high ground (h), its cliff (C) and steps up (z), a bridge (B, or P
	// over the path), ledges to hop down (v), and tall grass (w)
	void add_hills char Tile, double X, double Z {
		if Tile == 'h' {
			add_box 1, HIGH, 1, "#5fa83f", X, HIGH / 2, Z
		} else if Tile == 'C' {
			add_box 1, HIGH, 1, "#8d7b68", X, HIGH / 2, Z
		} else if Tile == 'z' {
			for I in STAIRS {
				double Up = HIGH * (I + 1) / STAIRS
				double Deep = 1.0 / STAIRS
				add_box 1, Up, Deep, "#a89a86", X, Up / 2, Z + 0.5 - (I + 0.5) * Deep
			}
		} else if Tile == 'B' || Tile == 'P' {
			if Tile == 'P' {
				add_plane 1, 1, "#d9c38c", X, 0.005, Z
			}
			add_box 1, 0.12, 1, "#8b5a2b", X, HIGH - 0.06, Z
		} else if Tile == 'v' {
			world.shape Ledge = add_wedge 1, 0.3, 1, "#5fa83f", X, 0.15, Z
			Ledge.set_angle 180             // (a slope up to it; its drop down the map)
		} else if Tile == 'w' {
			blade X - 0.2, Z - 0.1, 0.45          // (112)
			blade X + 0.15, Z + 0.15, 0.5
			blade X, Z + 0.3, 0.4
		}
	}

	// ==== 112.19  A blade of tall grass ==================================

	// in the group "grass", to be found again (112.22)
	void blade double X, double Z, double Tall {
		world.shape Blade = add_cone 0.12, Tall, "#3d8b2f", X, Tall / 2, Z
		Blade.set_group "grass"
	}

	// ==== 109.12  The areas next door ====================================

	// a line for each, after the map; their own next door, at the corners;
	// then a ring of trees round all of them
	void add_joins {
		for I in Things.length {
			if Things[I].starts_with "join " {
				add_join Things[I].copy
			}
		}
		add_corners
		add_rings
	}

	// "join north woods 0": the woods' map, beyond the north edge of Here
	// (this area's map, or an area next door's), its column 0 beside Here's
	neighbour beside const str &Line, const list str &Here const {
		list str Words = Line.split " "
		neighbour Next
		Next.Side = Words[1].copy
		Next.Area = Words[2].copy
		read_map Words[2], Next.Map
		Next.place_beside Here, Words[3].to_int
		return Next
	}

	// beyond this area's edge
	void add_join const str &Line {
		neighbour Next = beside Line, Map
		list str Rows = Next.Map.copy
		int Left = Next.Col
		int Top = Next.Row
		Joins.add Next                  // (first: its tiles can see each other)
		add_tiles_of Rows, Left, Top
	}

	// ==== 109.13  Corners ================================================

	// the areas next door's own areas next door: one at a corner is seen
	// from here, before it's walked to (tutorial 79's)
	void add_corners {
		int Count = (int)Joins.length
		for I in Count {
			list str Lines
			read_joins Joins[I].Area, Lines
			for Line in Lines {
				add_corner Line, (int)I
			}
		}
	}

	void add_corner const str &Line, int I {
		neighbour Corner = beside Line, Joins[I].Map
		Corner.move_by Joins[I].Col, Joins[I].Row
		if join_named(Corner.Area) < 0 && Corner.Area != Area {
			Corner.Corner = true
			list str Rows = Corner.Map.copy
			int Left = Corner.Col
			int Top = Corner.Row
			Joins.add Corner
			add_tiles_of Rows, Left, Top
		}
	}

	// which of Joins that area is (-1: none)
	int join_named const str &Place const {
		for I in Joins.length {
			if Joins[I].Area == Place {
				return (int)I
			}
		}
		return -1
	}

	// which of Joins has the tile C, R (-1: none)
	int join_at int C, int R const {
		for I in Joins.length {
			if Joins[I].has C, R {
				return (int)I
			}
		}
		return -1
	}

	// ==== 120.3  The nearest edge =========================================

	// a column (or row) beyond a map's edges, moved back to its edge: Start,
	// and Count of them
	int edge_of int At, int Start, int Count const {
		if At < Start {
			return Start
		} else if At >= Start + Count {
			return Start + Count - 1
		}
		return At
	}

	// ==== 109.14  Trees all round  (changed in 122, 136) =================

	// round this area and each next door, RING deep, wherever no area is:
	// the woods go on (and outside, only there: there's no more to see)
	void add_rings {
		if Inside {
			return
		}
		lookup str bool Planted
		add_ring 0, 0, (int)Map[0].length, (int)Map.length, Planted
		for I in Joins.length {
			add_ring Joins[I].Col, Joins[I].Row, (int)Joins[I].Map[0].length, (int)Joins[I].Map.length, Planted
		}
	}

	void add_ring int Left, int Top, int Wide, int Deep, lookup str bool &Planted {
		for R in Top - RING to Top + Deep + RING - 1 {
			for C in Left - RING to Left + Wide + RING - 1 {
				str Place = C.text + "," + R.text
				if !on_map(C, R) && join_at(C, R) < 0 && !Planted.contains(Place) {
					Planted[Place] = true
					char Edge = tile_at edge_of(C, Left, Wide), edge_of(R, Top, Deep)
					if Edge == '~' {
						add_water C, R      // (120) the sea goes on
					} else if Edge == 'r' {
						add_rails C, R      // (122) and the railway
					} else if Edge == '=' && (C == edge_of(C, Left, Wide) || R == edge_of(R, Top, Deep)) {
						add_plane 1, 1, "#d9c38c", C, 0.005, R   // (136) and a path, on into the trees
					} else {
						add_cone 0.45, 1.3, "#2f7d32", C, 0.65, R   // (a tree, all leaves: there are many)
					}
				}
			}
		}
	}

	bool on_map int C, int R const {
		return R >= 0 && R < Map.length && C >= 0 && C < Map[R].length
	}

	// ==== 108.16  A new walker: shapes joined to their body  (changed in 110, 124, 132)

	// on their tile, their feet on the ground, dressed as who they are
	walker new_walker const str &Who, int C, int R, const str &Facing {
		if Who == "elder" {
			return modelled_walker Who, ELDER_MODEL, C, R, Facing   // (124)
		} else if person_model(Who) != "" {
			return modelled_walker Who, person_model(Who), C, R, Facing   // (132)
		}
		walker Someone
		Someone.Who = Who.copy
		Someone.Col = C
		Someone.Row = R
		Someone.Body = add_box 0.4, 0.45, 0.25, clothes_of(Who), C, 0.575, R
		Someone.Left = add_box 0.15, 0.35, 0.15, legs_of(Who), C - 0.1, 0.175, R
		Someone.Right = add_box 0.15, 0.35, 0.15, legs_of(Who), C + 0.1, 0.175, R
		Someone.Left.join Someone.Body
		Someone.Right.join Someone.Body
		world.shape Head = add_ball 0.17, "#f1c27d", C, 0.97, R
		Head.join Someone.Body
		dress Someone.Body, Who, C, R
		Someone.face Facing
		return Someone
	}

	// ==== 110.4  Dressed as who they are  (changed in 113) ===============

	str clothes_of const str &Who const {
		if Who == "elder" {
			return "#7b5e57"            // a brown robe
		} else if Who == "baker" {
			return "white"
		} else if Who == "rival" {
			return "#2e7d32"            // (113) a green jacket
		}
		return "royalblue"
	}

	str legs_of const str &Who const {
		if Who == "elder" {
			return "#7b5e57"            // (the robe, down to his feet)
		} else if Who == "baker" {
			return "#dddddd"
		} else if Who == "rival" {
			return "#5d4037"
		}
		return "#333344"
	}

	// what's on their head (and the elder's chin), joined to their body;
	// the front of a walker, facing up the map, is towards -z
	void dress const world.shape &Body, const str &Who, int C, int R {
		if Who == "elder" {
			world.shape Hair = add_ball 0.18, "#eeeeee", C, 1.0, R + 0.02
			Hair.set_size 0.36, 0.25, 0.36
			Hair.join Body
			world.shape Beard = add_cone 0.12, 0.25, "#eeeeee", C, 0.82, R - 0.12
			Beard.set_tilt 180              // (its point down)
			Beard.join Body
		} else if Who == "baker" {
			world.shape Hat = add_cylinder 0.15, 0.3, "white", C, 1.25, R
			Hat.join Body
		} else if Who == "rival" {
			spiky_hair Body, C, R           // (113)
		} else {
			world.shape Cap = add_cylinder 0.19, 0.1, "#c62828", C, 1.15, R
			Cap.join Body
		}
	}

	// ==== 113.10  Spiky hair =============================================

	// Rufus's: three cones, leaning out, and one at the back
	void spiky_hair const world.shape &Body, int C, int R {
		for I in 3 {
			world.shape Spike = add_cone 0.08, 0.2, "#6d4c41", C + (I - 1) * 0.09, 1.15, R + 0.03
			Spike.set_roll (1 - I) * 25
			Spike.join Body
		}
		world.shape Back = add_cone 0.09, 0.2, "#6d4c41", C, 1.1, R + 0.1
		Back.set_tilt -35
		Back.join Body
	}

	// ==== 108.17  The camera  (changed in 111, 115) =======================

	// above and behind the hero, looking down at them, as in FireRed; (111)
	// as high again as the ground they're on (not bobbing up in a hop)
	void look_at_hero {
		move_camera_to Hero.Body.x, camera_up + Hero.Ground, Hero.Body.z + camera_back
		point_camera_at Hero.Body.x, 0.5 + Hero.Ground, Hero.Body.z
	}

	// ==== 115.7  Near, or far ============================================

	// how high above the hero the camera is, and how far behind (115.2)
	double camera_up const {
		if Far {
			return 10
		}
		return 7
	}

	double camera_back const {
		if Far {
			return 7.5
		}
		return 5
	}

	// ==== 109.15  The light  (changed in 117) ===========================

	// all of it at Amount (1: as bright as the time of day; 0: dark)
	void light double Amount {
		Fade = Amount
		shine
	}

	// ==== 117.5  The sun, the sky and the light all round  (changed in 118, 119, 136)

	// from the time of day, and the rain: the sun (or at night the moon)
	// where it is, its color, the light all round, and the sky; inside, a
	// lamp's light, day and night, and no sky
	void shine {
		if Dark {
			set_sun_color "black"       // (118) only the lamps
			set_ambient rgb(36, 34, 48, Fade)
			set_background "black"
			return
		} else if Inside {
			set_sun_color rgb(217, 217, 204, Fade)
			set_ambient rgb(89, 89, 102, Fade)
			set_background "black"
			return
		}
		double Up = sun_height
		double Day = daylight
		place_sun Up
		tint Sun = blend rgb_of(235, 140, 80), rgb_of(217, 217, 204), Up * 3  // golden low down
		Sun = blend rgb_of(0, 0, 0), Sun, Up / 0.12          // going down, fading out
		if Up < 0 {
			Sun = blend rgb_of(0, 0, 0), rgb_of(58, 80, 160), -Up / 0.12   // the moon, coming up
		}
		Sun = blend Sun, rgb_of(0, 0, 0), 0.65 * Wet
		tint All = blend rgb_of(22, 34, 86), rgb_of(89, 89, 102), Day
		All = blend All, rgb_of(0, 0, 0), 0.2 * Wet
		tint Sky = blend rgb_of(250, 150, 110), rgb_of(135, 206, 235), Day * 2 - 1
		if Day < 0.5 {
			Sky = blend rgb_of(10, 16, 42), rgb_of(250, 150, 110), Day * 2
		}
		Sky = blend Sky, blend(rgb_of(20, 24, 32), rgb_of(120, 126, 138), Day), 0.75 * Wet
		All = blend All, rgb_of(230, 235, 255), 0.8 * Flash    // (119) lightning
		Sky = blend Sky, rgb_of(230, 235, 255), 0.8 * Flash
		if Dim {
			Sun = blend Sun, rgb_of(0, 0, 0), 0.6                      // (136) the trees keep the sun out
			All = blend All, rgb_of(12, 22, 16), 0.45
			Sky = blend Sky, rgb_of(20, 34, 26), 0.7
		}
		set_sun_color css(Sun, Fade)
		set_ambient css(All, Fade)
		set_background css(Sky, Fade)
		light_windows 1 - Day
	}

	// ==== 117.6  How high the sun is =====================================

	// 1 at noon, 0 at sunrise and sunset, -1 at midnight
	double sun_height const {
		return sin 2 * PI * (Story.Time - 0.25)
	}

	// and how much of the day's light there is: none a little after
	// sunset, all of it once the sun's a little way up
	double daylight const {
		double Day = (sun_height + 0.1) / 0.4
		if Day < 0 {
			return 0
		} else if Day > 1 {
			return 1
		}
		return Day
	}

	// ==== 117.7  Where the sun shines from ===============================

	// rising in the east (+x), setting in the west, a little behind the
	// camera; never quite flat (the shadows would go on for ever); at
	// night, the moon, across the sky from it
	void place_sun double Up {
		double A = 2 * PI * (Story.Time - 0.25)
		double Down = -sin(A)
		double Across = -cos(A)
		if Up < 0 {
			Down = sin A
			Across = cos A
		}
		if Down > -0.15 {
			Down = -0.15
		}
		set_sun Across, Down, -0.35
	}

	// ==== 117.8  A color, written ========================================

	// "rgb(217, 217, 204)", that much of it
	str css const tint &C, double Amount const {
		int Red = (int)(C.Red + 0.5)
		int Green = (int)(C.Green + 0.5)
		int Blue = (int)(C.Blue + 0.5)
		return rgb Red, Green, Blue, Amount
	}

	// "rgb(217, 217, 204)", each part that much of itself
	str rgb int Red, int Green, int Blue, double Amount const {
		return "rgb(" + part(Red, Amount).text + ", " + part(Green, Amount).text + ", " + part(Blue, Amount).text + ")"
	}

	// that much of a color's part, to the nearest whole number
	int part int Of, double Amount const {
		return (int)(Of * Amount + 0.5)
	}

	// ==== 108.18  Every frame  (changed in 109, 110, 112, 113, 114, 115, 116, 117, 118, 119, 121, 122, 123, 135)

	void step {
		if Mode == BATTLE {
			battle_step
		} else if Mode == FADING_OUT || Mode == FADING_IN {
			fade_step
		} else if Mode == NOTICED {
			notice_step                 // (113)
		} else if Mode == CHOOSING {
			choose                      // (114)
		} else if Mode == READING {
			if key_press "space" {
				Mode = PLAYING
				Words.set_text ""
				Shade.set_text ""
			}
		} else if Challenge {
			challenge_step              // (113)
		} else if WalkingOff && !People[Leaver].stepping {
			step_away                   // (113)
		} else if Hero.stepping {
			if Hero.StepsLeft == Hero.Frames && (Hero.Dx != 0 || Hero.Dy != 0) {
				keep_footstep           // (121) a move begun: kept for Ember
			}
			if Hero.keep_stepping {
				arrived
			}
		} else if in_scene {
			scene_step                  // (122) the start, not yet free to walk
		} else {
			walk_or_look
		}
		if Mode != FADING_OUT {
			move_people
		}
		turn_items                      // (114)
		move_world                      // (116)
		spread_ripples
		if !OnTitle {
			pass_time                   // (117)
			weather
			hear_rain                   // (119)
			storm
		}
		shine
		bob
		if Dark {
			in_the_dark                 // (118)
		}
		fly_bats                        // (120)
		run_trains                      // (123)
		flicker                         // (135)
		turn_beam
		hear_surf
		if frame - NameFrom == NAME_FRAMES {
			Name.set_text ""
			NameShade.set_text ""
		}
		if OnTitle {
			circle_town                 // (115)
		} else if Mode != BATTLE {
			look_at_hero
		}
	}

	// ==== 110.5  People walking  (changed in 111, 113, 121, 132) =========

	// each step they're in, a frame on; and now and then, a new one (113:
	// only while the hero's walking about)
	void move_people {
		for I in People.length {
			if People[I].stepping {
				People[I].keep_stepping
			}
			walking People[I]           // (132) a model walks as it goes
		}
		follow_hero                     // (121)
		if frame % 75 == 0 && Mode == PLAYING {
			wander
		}
	}

	// a step a random way, for one in three of those who wander, to
	// anywhere free, but not through a way out or over the edge (they
	// live here); (111) and on the ground
	void wander {
		list str Ways = {"up", "down", "left", "right"}
		for I in People.length {
			if People[I].Wanders && !People[I].stepping && random(1, 3) == 1 {
				str Way = Ways[random(0, 3)].copy
				int C = People[I].Col + across_of(Way)
				int R = People[I].Row + down_of(Way)
				if on_map(C, R) && is_free(C, R) && thing_at("way", C, R) == "" && level_at(C, R) == 0 && !follower_at(C, R) {
					People[I].step Way, true    // ((121) nor onto Ember)
				}
			}
		}
	}

	// ==== 109.16  Each frame of a fade ===================================

	// the light going down, then (dark) the next area built; or coming up,
	// then walking on
	void fade_step {
		FadeFrame++
		double Done = FadeFrame / (double)FADE_FRAMES
		if Mode == FADING_OUT {
			light 1 - Done
		} else {
			light Done
		}
		if FadeFrame < FADE_FRAMES {
			return
		} else if Mode == FADING_OUT {
			start_at NextArea.copy, NextCol, NextRow
		} else {
			Mode = PLAYING
		}
	}

	// ==== 109.17  On the next tile  (changed in 111, 112, 113, 116, 119, 121) ===

	// (111) up high now, or down again? Over the edge, into the area next
	// door? Or a way out starts here? (112) Or something in the grass?
	// (113) Or has someone noticed them?
	void arrived {
		println "at", Hero.Col, Hero.Row
		settle_level
		settle_swimming                 // (116)
		meet_in_grass
		look_out
		str Way = thing_at "way", Hero.Col, Hero.Row
		if !on_map(Hero.Col, Hero.Row) {
			cross_over
		} else if Way != "" {
			leave_by Way
		}
	}

	// into the area next door: it's the area now, with no fade, and the
	// hero on the same tile, counted on its map, so the camera doesn't jump
	void cross_over {
		int J = join_at Hero.Col, Hero.Row
		str Place = Joins[J].Area.copy
		int C = Hero.Col - Joins[J].Col
		int R = Hero.Row - Joins[J].Row
		OriginX += Joins[J].Col         // (116) the area next door's place in the world
		OriginZ += Joins[J].Row
		keep_follower Joins[J].Col, Joins[J].Row   // (121)
		enter Place, C, R
	}

	// "bakery 6,7": into the bakery, on its tile 6,7, once it's dark
	void leave_by const str &Way {
		list str To = Way.split " "
		NextArea = To[0].copy
		NextCol = To[1].split(",")[0].to_int
		NextRow = To[1].split(",")[1].to_int
		effect "door"                   // (119)
		Mode = FADING_OUT
		FadeFrame = 0
	}

	// ==== 108.19  On a tile: walk, or look  (changed in 114, 115, 128, 133, 134)

	// an arrow key held down starts the next step; Space looks ahead;
	// (114) S saves; (115) Escape opens the menu
	void walk_or_look {
		if HoursDue {
			keep_hours                  // (128) between whatever else is going on
		}
		if Riding {
			ride_on                     // (133) aboard: nothing to do but wait
			return
		} else if Rolling {
			roll_on                     // (134) the credits, until they've gone
			return
		}
		str Way = held_way
		if Way != "" {
			arrow_held Way
		} else if key_press "space" {
			look_ahead
		} else if key_press "s" {
			save_game
		} else if key_press "escape" {
			open_menu                   // (115)
		}
	}

	// ==== 108.20  Turning, or walking ====================================

	// a new way only turns the hero; held a moment longer, they walk
	void arrow_held const str &Way {
		if Way != Hero.Facing {
			Hero.face Way
			Turned = Way.copy
		} else if Way != Turned || key_press(Way) || key_held_for(Way) >= TURN_TIME {
			walk Way
		}
	}

	// the way an arrow key held down points ("": none)
	str held_way const {
		list str Ways = {"up", "down", "left", "right"}
		for Way in Ways {
			if key_hold Way {
				return Way.copy
			}
		}
		return ""
	}

	// ==== 108.21  Walking  (changed in 109, 110, 111, 114, 116, 118, 119) ===

	// onto the next tile if it's free, else a step on the spot; (111) over
	// a ledge, a hop; and up or down, to the next tile's height
	void walk const str &Way {
		if hops_over Way {
			Hero.hop Way
			effect "hop"                // (119)
			println "hopped", Way, "over a ledge"
			return
		}
		int C = Hero.Col + across_of(Way)
		int R = Hero.Row + down_of(Way)
		bool Free = can_go Way
		Hero.step Way, Free
		if Free {
			Hero.To = height_at C, R, Hero.Level
			Hero.Edge = edge_height Way, C, R
			if Swimming {
				ripple Hero.Body.x, Hero.Body.z     // (116)
				effect "stroke"         // (119)
			} else {
				effect "step"
			}
		} else {
			effect "bump"
			println "bump", Way
		}
	}

	// ==== 111.6  At the hero's height  (changed in 116) ==================

	// the next tile that way: free, and at the hero's height; or stairs, or
	// a bridge (on it from up high, under it from below); or anywhere free
	// from the stairs, up or down
	bool can_go const str &Way const {
		int C = Hero.Col + across_of(Way)
		int R = Hero.Row + down_of(Way)
		int To = level_at C, R
		if Swimming && water_at(C, R) && !someone_at(C, R) {
			return true                 // (116) on through the water
		}
		return is_free(C, R) && (To < 0 || To == Hero.Level || tile_at(Hero.Col, Hero.Row) == 'z')
	}

	// ==== 111.7  The tile at C, R ========================================

	// on this area's map, or the area next door's beyond its edge; anywhere
	// else, as if grass
	char tile_at int C, int R const {
		if on_map C, R {
			return Map[R][C]
		}
		int J = join_at C, R
		if J >= 0 {
			return Joins[J].tile C, R
		}
		return '.'
	}

	// ==== 111.8  How high a tile is  (changed in 116, 122) ===============

	// 1 high ground; 0 the ground; -1 stairs or a bridge, where the hero
	// stays as they were (on the stairs, part way up; on a bridge, over
	// it, or under it)
	int level_at int C, int R const {
		char Tile = tile_at C, R
		if Tile == 'z' || Tile == 'B' || Tile == 'P' {
			return -1
		}
		return (int)(Tile == 'h')
	}

	// and how high someone's feet are there, at that level: on the high
	// ground, its top; on the stairs, half way up; on a bridge, its top,
	// or the ground under it
	double height_at int C, int R, int Level const {
		char Tile = tile_at C, R
		if Tile == 'h' {
			return HIGH
		} else if Tile == 'K' {
			return PIER                 // (120) on the boards
		} else if Tile == 'p' {
			return PLATFORM             // (122)
		} else if Tile == '~' {
			return DEEP                 // (116) in it, swimming
		} else if Tile == 'z' {
			return HIGH / 2
		} else if Tile == 'B' || Tile == 'P' {
			return HIGH * Level
		}
		return 0
	}

	// ==== 111.12  The edge between two tiles  (changed in 116) ===========

	// how high the hero's feet are as they step from their tile onto the
	// next: the stairs climb north, so their top edge is the high ground's
	// height, and their bottom edge the ground's; anywhere else, half way
	double edge_height const str &Way, int C, int R const {
		char Here = tile_at Hero.Col, Hero.Row
		char There = tile_at C, R
		if (Here == 'z' && Way == "up") || (There == 'z' && Way == "down") {
			return HIGH
		} else if (Here == 'z' && Way == "down") || (There == 'z' && Way == "up") {
			return 0
		} else if Swimming && (Here == '~') != (There == '~') {
			return 0                    // (116) the shore: climbing out, or in
		}
		return (Hero.From + Hero.To) / 2
	}

	// ==== 111.9  Up high, or not =========================================

	// on high ground, the hero's up high; on the ground, they're down; on
	// stairs or a bridge, as they were
	void settle_level {
		int Here = level_at Hero.Col, Hero.Row
		if Here >= 0 && Here != Hero.Level {
			Hero.Level = Here
			if Here == 1 {
				println "up high"
			} else {
				println "down again"
			}
		}
	}

	// ==== 111.10  Arriving at a height  (changed in 116) =================

	// (in a new area, or through a door) at the height of the tile they're
	// on: on a bridge, over it
	void stand_on_tile {
		Hero.Level = (int)(level_at(Hero.Col, Hero.Row) != 0)
		Hero.stand_at height_at(Hero.Col, Hero.Row, Hero.Level)
		Swimming = water_at Hero.Col, Hero.Row   // (116) saved while swimming
	}

	// ==== 111.11  A ledge ahead ==========================================

	// walking down into one, on the ground, with a free tile beyond it: the
	// hero hops over it (from below, it's in the way)
	bool hops_over const str &Way const {
		int C = Hero.Col + across_of(Way)
		int R = Hero.Row + down_of(Way)
		int Beyond = R + down_of(Way)
		return Way == "down" && Hero.Level == 0 && tile_at(C, R) == 'v' && is_free(C, Beyond) && level_at(C, Beyond) == 0
	}

	// a tile on the map, or in an area next door (not a corner), that
	// isn't in the way, with nobody on it (or stepping onto it); a door, if
	// a way starts there
	bool is_free int C, int R const {
		if someone_at C, R {
			return false
		}
		if on_map C, R {
			if thing_at("way", C, R) != "" {
				return true             // (118) a door, or a cave's mouth
			} else if Map[R][C] == 'D' {
				return false
			}
			return !BLOCKING.contains(Map[R][C]) && item_at(C, R) == ""   // (114) nor a thing
		}
		int J = join_at C, R
		return J >= 0 && !Joins[J].Corner && !BLOCKING.contains(Joins[J].tile(C, R))
	}

	// ==== 112.20  Tall grass  (changed in 130) ===========================

	// each step into it: now and then, something's there (a mouse, or one
	// time in three, a crow)
	void meet_in_grass {
		if Mode == PLAYING && tile_at(Hero.Col, Hero.Row) == 'w' && random(1, MEETING) == 1 {
			start_battle met_here       // (130) by the area's chances
		}
	}

	// ==== 112.21  A battle begins  (changed in 113, 126, 130, 136) =======

	// the hero turns to where there's room; there, the one met, still
	// under the grass, and Ember, ready to jump out; and the camera starts
	// down
	void start_battle const str &Kind {
		Going = Hero.Facing.copy        // (136) to go on that way, after
		Hero.face battle_way
		begin_battle wild_of(Kind), "", 2.1   // ((130) any kind)
		if !Story.Seen.contains(Foe.Name) {
			Story.Seen.add Foe.Name.copy   // (126) met: in the book
		}
	}

	// ==== 113.11  A battle with someone, or something  (changed in 116, 119, 121, 127, 128, 129)

	// Other is Whose ("": nobody's), Ahead of the hero (Ember, at her
	// level, beside them)
	void begin_battle critter Other, const str &Whose, double Ahead {
		Foe = Other
		Owner = Whose.copy
		music "battle"                  // (119)
		Current = first_able Story.Lead   // (127) the leader, if it can
		Battled.clear
		Battled.add Current             // (129)
		Ours = critter_of Current
		double A = angle_of(Hero.Facing) * PI / 180
		double Fx = -sin(A)                    // (ahead, the way the hero faces)
		double Fz = -cos(A)
		double Rx = cos A                      // (and to their right)
		double Rz = -sin(A)
		double G = Hero.Ground
		double Across = 0.75 - 0.3 * (Ahead + 1)   // (seen from the camera, as far left)
		double X = Hero.Body.x + Ahead * Fx + Across * Rx
		double Z = Hero.Body.z + Ahead * Fz + Across * Rz
		str Kind = Foe.Name.copy
		Foe.put_out made_of(Kind, X, G, Z), X, Z, G, angle_of(opposite(Hero.Facing))
		double Front = 0.6                  // (to the hero's right; or, with no
		double Right = 0.9                  // room there, their left; or in front)
		if !room_beside(1) {
			Right = -0.9
			if !room_beside(-1) {
				Front = 0.5
				Right = 0.2
			}
		}
		X = Hero.Body.x + Front * Fx + Right * Rx
		Z = Hero.Body.z + Front * Fz + Right * Rz
		str Ourselves = kind_of Ours.Name   // ((127) whoever it is: its kind)
		Ours.put_out made_of(Ourselves, X, G, Z), X, Z, G, angle_of(Hero.Facing)
		Foe.BarBack = bar_back
		Foe.Bar = bar
		Ours.BarBack = bar_back
		Ours.Bar = bar
		flatten_grass true
		show_follower false             // (128) out of the way, until she's sent out
		Mode = BATTLE
		ZoomFrame = 0
		Leaving = false
		Over = false
		Lost = false
		if Owner == "" {
			println "something in the grass!"
		} else {
			println "a battle with", Owner
		}
	}

	// is there room for Ember beside the hero, on that Side (1 their
	// right, -1 their left), and a tile ahead of that? Nothing in the way,
	// and the ground as high as the hero's (not a ledge, or a cliff)
	bool room_beside int Side const {
		int Ahead = across_of Hero.Facing
		int Down = down_of Hero.Facing
		int C = Hero.Col - Down * Side
		int R = Hero.Row + Ahead * Side
		return room_at(C, R) && room_at(C + Ahead, R + Down)
	}

	bool room_at int C, int R const {
		double Rise = height_at(C, R, Hero.Level) - Hero.Ground
		return !BLOCKING.contains(tile_at(C, R)) && Rise < 0.05 && Rise > -0.05
	}

	// ==== 112.22  Grass flattened ========================================

	// the tall grass between Ember and the other (and round them) out of
	// the way while they battle; or (Flat false) back again
	void flatten_grass bool Flat {
		for Blade in shapes_in "grass" {
			Blade.set_visible !Flat || !in_the_way(Blade.x, Blade.z)
		}
	}

	// near the line from Ember to the other, or the camera behind her
	bool in_the_way double X, double Z const {
		double Ax = Ours.X - 1.2 * (Foe.X - Ours.X) / 2
		double Az = Ours.Z - 1.2 * (Foe.Z - Ours.Z) / 2
		double Lx = Foe.X - Ax
		double Lz = Foe.Z - Az
		double T = ((X - Ax) * Lx + (Z - Az) * Lz) / (Lx * Lx + Lz * Lz)
		if T < 0 {
			T = 0
		} else if T > 1 {
			T = 1
		}
		double Dx = X - (Ax + T * Lx)
		double Dz = Z - (Az + T * Lz)
		return Dx * Dx + Dz * Dz < 0.8 * 0.8
	}

	// ==== 112.23  Room for a battle ======================================

	// the way the hero faces, if three tiles of ground are clear that way;
	// else the first way that has them
	str battle_way const {
		list str Ways = {"up", "down", "left", "right"}
		if room_for Hero.Facing {
			return Hero.Facing.copy
		}
		for Way in Ways {
			if room_for Way {
				return Way.copy
			}
		}
		return Hero.Facing.copy
	}

	bool room_for const str &Way const {
		for I in 3 {
			int C = Hero.Col + across_of(Way) * (I + 1)
			int R = Hero.Row + down_of(Way) * (I + 1)
			if BLOCKING.contains(tile_at(C, R)) || level_at(C, R) != 0 {
				return false
			}
		}
		return true
	}

	// ==== 112.24  A critter, made  (changed in 113, 124, 125, 127, 130) ===

	// its shapes, made facing up the map (-z): its body first
	list world.shape made_of const str &Kind, double X, double G, double Z {
		return model_of model_path(Kind), X, G, Z   // (124, 125; 130: by its kind)
	}

	// ==== 112.25  Its bar ================================================

	// a health bar, and the dark behind it (each placed every frame)
	world.shape bar {
		return add_box BAR, 0.06, 0.04, "#3cc453", 0, -5, 0
	}

	world.shape bar_back {
		return add_box BAR + 0.04, 0.1, 0.02, "#333333", 0, -5, 0
	}

	// ==== 112.26  A fox, made ============================================

	// orange, with a white chest, pointed ears and a bushy tail, tipped white
	list world.shape make_fox double X, double G, double Z {
		list world.shape All = {add_box(0.22, 0.2, 0.42, "#e8762c", X, G + 0.25, Z)}
		join_on All, add_ball(0.13, "#e8762c", X, G + 0.42, Z - 0.24)
		join_on All, add_cone(0.06, 0.12, "white", X, G + 0.38, Z - 0.36)
		join_on All, add_box(0.16, 0.12, 0.04, "white", X, G + 0.27, Z - 0.21)
		for Side in 2 {
			double Out = Side * 0.14 - 0.07
			join_on All, add_cone(0.05, 0.13, "#c45a1c", X + Out, G + 0.57, Z - 0.22)
			join_on All, add_ball(0.025, "black", X + Out * 0.8, G + 0.46, Z - 0.35)
			join_on All, add_box(0.06, 0.15, 0.06, "#4a2a14", X + Out, G + 0.075, Z - 0.15)
			join_on All, add_box(0.06, 0.15, 0.06, "#4a2a14", X + Out, G + 0.075, Z + 0.15)
		}
		world.shape Tail = add_cylinder 0.07, 0.34, "#e8762c", X, G + 0.36, Z + 0.32
		Tail.set_tilt 55                // (up behind her)
		world.shape Tip = add_ball 0.05, "white", X, G + 0.47, Z + 0.47
		Tip.join Tail                   // ((121) swaying with it)
		join_on All, Tail
		All.add Tip
		return All
	}

	// ==== 112.27  A field mouse, made ====================================

	// small and grey, with round pink ears and a long thin tail
	list world.shape make_mouse double X, double G, double Z {
		world.shape Body = add_ball 0.15, "#9a948c", X, G + 0.13, Z
		Body.set_size 0.26, 0.22, 0.34
		list world.shape All = {Body}
		join_on All, add_ball(0.09, "#9a948c", X, G + 0.18, Z - 0.18)
		join_on All, add_ball(0.025, "#f2a0b0", X, G + 0.18, Z - 0.27)
		for Side in 2 {
			double Out = Side * 0.14 - 0.07
			world.shape Ear = add_ball 0.05, "#f2a0b0", X + Out, G + 0.28, Z - 0.15
			Ear.set_size 0.1, 0.1, 0.03
			join_on All, Ear
			join_on All, add_ball(0.018, "black", X + Out * 0.6, G + 0.21, Z - 0.25)
		}
		world.shape Tail = add_cylinder 0.012, 0.32, "#f2a0b0", X, G + 0.06, Z + 0.3
		Tail.set_tilt 80
		join_on All, Tail
		return All
	}

	// ==== 112.28  A hill crow, made ======================================

	// black, with a yellow beak, wings at its sides and thin orange legs
	list world.shape make_crow double X, double G, double Z {
		world.shape Body = add_ball 0.15, "#22222a", X, G + 0.32, Z
		Body.set_size 0.26, 0.26, 0.36
		list world.shape All = {Body}
		join_on All, add_ball(0.1, "#22222a", X, G + 0.48, Z - 0.15)
		world.shape Beak = add_cone 0.04, 0.14, "#f2c230", X, G + 0.47, Z - 0.3
		Beak.set_tilt -90                       // (its point ahead)
		join_on All, Beak
		for Side in 2 {
			double Out = Side * 2 - 1
			world.shape Wing = add_box 0.04, 0.18, 0.3, "#3a3a46", X + Out * 0.14, G + 0.33, Z + 0.03
			Wing.set_roll Out * 15
			join_on All, Wing
			join_on All, add_ball(0.02, "white", X + Out * 0.06, G + 0.52, Z - 0.22)
			join_on All, add_cylinder(0.015, 0.2, "#e08a2c", X + Out * 0.06, G + 0.1, Z)
		}
		return All
	}

	// ==== 113.12  A pup, made ============================================

	// brown, with floppy ears, a dark snout and a tail up behind
	list world.shape make_pup double X, double G, double Z {
		list world.shape All = {add_box(0.24, 0.22, 0.42, "#8d6e63", X, G + 0.27, Z)}
		join_on All, add_ball(0.14, "#8d6e63", X, G + 0.45, Z - 0.25)
		join_on All, add_box(0.1, 0.08, 0.12, "#6d4c41", X, G + 0.41, Z - 0.39)
		join_on All, add_ball(0.03, "black", X, G + 0.44, Z - 0.45)
		for Side in 2 {
			double Out = Side * 2 - 1
			world.shape Ear = add_box 0.05, 0.15, 0.09, "#5d4037", X + Out * 0.13, G + 0.46, Z - 0.24
			Ear.set_roll Out * -20
			join_on All, Ear
			join_on All, add_ball(0.025, "black", X + Out * 0.06, G + 0.5, Z - 0.37)
			join_on All, add_box(0.07, 0.17, 0.07, "#5d4037", X + Out * 0.08, G + 0.085, Z - 0.15)
			join_on All, add_box(0.07, 0.17, 0.07, "#5d4037", X + Out * 0.08, G + 0.085, Z + 0.15)
		}
		world.shape Tail = add_cylinder 0.025, 0.22, "#8d6e63", X, G + 0.42, Z + 0.27
		Tail.set_tilt -40               // (up behind it)
		join_on All, Tail
		return All
	}

	// ==== 112.29  Each frame of a battle  (changed in 131) ===============

	// the critters moving, and their bars; the camera coming down (or
	// going back up); then words to read, a hit to land, a menu, or
	// what's said next
	void battle_step {
		Ours.animate
		Foe.animate
		move_ball                       // (131)
		double View = angle_of Hero.Facing
		Ours.show_bar View
		Foe.show_bar View
		show_lines
		if Leaving {
			zoom_out
		} else if ZoomFrame < ZOOM_FRAMES {
			zoom_in
		} else if Reading {
			if key_press "space" {
				Reading = false
				Words.set_text ""
				Shade.set_text ""
			}
		} else if Hit != 0 {
			land_hit
		} else if Ours.busy || Foe.busy || !Ours.caught_up || !Foe.caught_up || BallDoing != 0 {
			return                      // ((131) or the Cabbyball's moving)
		} else if Menu != "" {
			choose
		} else {
			next_beat
		}
	}

	// ==== 112.30  Down into the world, and back up  (changed in 113, 115, 116, 119, 121, 123, 126, 136)

	// a frame further down; once there, the critter pops up, and says so
	void zoom_in {
		ZoomFrame++
		battle_camera ZoomFrame / (double)ZOOM_FRAMES
		if ZoomFrame == ZOOM_FRAMES {
			Foe.start RISING
			beat appearing, 0, 0
			beat "Go, " + Ours.Name + "!", 3, 0
		}
	}

	// a frame further up; once there, walking about again
	void zoom_out {
		ZoomFrame--
		battle_camera ZoomFrame / (double)ZOOM_FRAMES
		if ZoomFrame == 0 {
			Ours.remove
			Foe.remove
			for Ball in Thrown {
				Ball.remove             // (126)
			}
			Thrown.clear
			flatten_grass false
			OursLine.set_text ""
			FoeLine.set_text ""
			Mode = PLAYING
			area_music                  // (119)
			show_follower !Waiting      // (121) following again
			println "the battle is over"
			if Owner == "" && Going != "" {
				Hero.face Going.copy    // (136) on the way they were going
				Going = ""
			}
			WalkingOff = Owner != "" && Area != "coast"   // (113) Rufus goes on his way; (120) not here
			if Owner != "" && Area == "coast" {
				Story.Answers["rematch"] = "done"
			}
			if Lost {
				back_to_the_elder       // (123)
			}
		}
	}

	// the camera, Done of the way (0 to 1) from where it is as the hero
	// walks to low behind the hero, over their right shoulder, looking
	// between Ember and the other; eased, so it starts and stops gently
	void battle_camera double Done {
		double T = Done * Done * (3 - 2 * Done)
		double A = angle_of(Hero.Facing) * PI / 180
		double Fx = -sin(A)
		double Fz = -cos(A)
		double Rx = cos A
		double Rz = -sin(A)
		double X = Hero.Body.x
		double Z = Hero.Body.z
		double G = Hero.Ground
		move_camera_to mix(X, X - 1.0 * Fx + 0.75 * Rx, T), mix(camera_up + G, 1.2 + G, T), mix(Z + camera_back, Z - 1.0 * Fz + 0.75 * Rz, T)
		point_camera_at mix(X, X + 1.5 * Fx + 0.3 * Rx, T), mix(0.5 + G, 0.3 + G, T), mix(Z, Z + 1.5 * Fz + 0.3 * Rz, T)
	}

	// From, To of the way to To
	double mix double From, double To, double Done const {
		return From + (To - From) * Done
	}

	// ==== 113.13  Who it is ==============================================

	// "The wild field mouse", or "Rufus's Bruno"
	str foe_name const {
		if Owner == "" {
			return "The wild " + Foe.Name
		}
		return Owner + "'s " + Foe.Name
	}

	str appearing const {
		if Owner == "" {
			return "A wild " + Foe.Name + " appeared!"
		}
		return Owner + " sent out " + Foe.Name + "!"
	}

	// ==== 112.31  Saying, in turn  (changed in 131) ======================

	// words to say; then what happens (1 the foe is hit, 2 Ember is; 3
	// Ember comes out; 4 the foe faints, 5 Ember does; 0 nothing), and
	// the health it leaves
	void beat const str &Said, int Then, int Health {
		Beats.add Said.copy
		Hits.add Then
		HealthAfter.add Health
	}

	// the next words (and whoever hits, jumping at the other as they
	// show), and what happens after them; none left: the turn's over
	void next_beat {
		if Beats.length == 0 {
			turn_over
			return
		}
		if Beats[0] != "" {
			tell Beats[0].copy          // ((131) a beat with no words: only what happens)
		}
		Hit = Hits[0]
		HitTo = HealthAfter[0]
		Beats.remove_at 0
		Hits.remove_at 0
		HealthAfter.remove_at 0
		if Hit == 1 {
			Ours.start LUNGING
		} else if Hit == 2 {
			Foe.start LUNGING
		}
	}

	// words over the world, until Space (113: wrapped)
	void tell const str &Said {
		show_words Said
		Reading = true
		println "said:", Said
	}

	// ==== 112.32  What happens  (changed in 119, 126, 127, 129, 131) =====

	// once the words have gone: a hit shakes whoever's hit, and their bar
	// falls; Ember jumps out; or someone faints
	void land_hit {
		if Hit == 1 {
			Foe.Goal = HitTo
			Foe.start SHAKING
			effect "boom"               // (119)
		} else if Hit == 2 {
			Ours.Goal = HitTo
			Ours.start SHAKING
			effect "boom"
		} else if Hit == 3 {
			ember_from                  // (121) out from behind the hero
			show_follower false
			Ours.start RUNNING
		} else if Hit == 4 {
			Foe.start FAINTING
		} else if Hit == 5 {
			Ours.start FAINTING
		} else if Hit == 6 {
			into_the_ball               // (126)
		} else if Hit == 7 {
			send_out_next               // (127)
			if FoeAfter {
				FoeAfter = false        // (131) now it's out, the wild one's go
				foe_goes random(0, (int)Foe.Moves.length - 1)
			}
		} else if Hit == 9 {
			throw_the_ball              // (131)
		} else if Hit == 10 {
			ball_starts WOBBLING
		} else if Hit == 11 {
			ball_starts OPENING
		} else if Hit == 8 {
			ember_from                  // (129) back behind the hero
			Ours.start RETURNING
		}
		Hit = 0
	}

	// ==== 112.33  How each is doing ======================================

	// "Ember  Lv5  21/21", once they're out
	void show_lines {
		OursLine.set_text line_of(Ours)
		FoeLine.set_text line_of(Foe)
	}

	str line_of const critter &Who const {
		if !Who.Out {
			return ""
		}
		return Who.Name + "  Lv" + Who.Level.text + "  " + ((int)(Who.Shown + 0.99)).text + "/" + Who.Most.text
	}

	// ==== 112.34  The turn's end  (changed in 126, 127) ==================

	// over: Ember goes back, then the other, if they're still out, and the
	// camera goes back up; else, what next
	void turn_over {
		if !Over {
			ask "battle", "What will " + Ours.Name + " do?", battle_choices   // (126)
		} else if Ours.Out {
			ember_from                  // (121) back behind the hero
			Ours.start RETURNING
		} else if Foe.Out {
			Foe.start SINKING
		} else {
			keep_wounds                 // (127) whoever was out
			if Lost {
				heal_all
			}
			Leaving = true
		}
	}

	// ==== 112.35  A menu  (changed in 119) ===============================

	// a question, and its choices under it, the arrow at the first; (114)
	// asked outside a battle, the hero chooses (and walks no further)
	void ask const str &Which, const str &Question, list str Answers {
		if Mode != BATTLE {
			Mode = CHOOSING
		}
		Menu = Which.copy
		Choices = Answers
		Choice = 0
		show_words Question
		show_choices
		println "asked:", Question
	}

	// "> Fight    Run": the arrow at the one chosen
	void show_choices {
		str Line = ""
		for I in Choices.length {
			if I == Choice {
				Line = Line + "> "
			} else {
				Line = Line + "   "
			}
			Line = Line + Choices[I] + "      "
		}
		Options.set_text Line
		OptionsShade.set_text Line
	}

	// left and right move the arrow; Space chooses
	void choose {
		if key_press("right") && Choice + 1 < Choices.length {
			Choice++
			effect "menu-move"          // (119)
			show_choices
		} else if key_press("left") && Choice > 0 {
			Choice--
			effect "menu-move"
			show_choices
		} else if key_press "space" {
			effect "menu-choose"
			str Which = Menu.copy
			str Chosen = Choices[Choice].copy
			Menu = ""
			Options.set_text ""
			OptionsShade.set_text ""
			Words.set_text ""
			Shade.set_text ""
			println "chose:", Chosen
			if Mode == CHOOSING {
				Mode = PLAYING          // (114) someone's question: they answer back
				answered Which, Chosen
			} else {
				chosen Which, Chosen
			}
		}
	}

	// ==== 112.36  What Ember does  (changed in 113, 126, 129) ============

	// Fight: which move; Run: away, at once; a move: the turn
	void chosen const str &Which, const str &Answer {
		if Answer == "Fight" {
			ask "moves", "Which move?", Ours.Moves.copy
		} else if Answer == "Run" {
			run_away                    // (113) if she can
		} else if Answer == "Ball" {
			throw_ball                  // (126)
		} else if Answer == "Switch" {
			ask_switch                  // (129)
		} else if Which == "switch" {
			switch_to Answer
		} else if Which == "moves" {
			take_turn Choice
		}
	}

	// ==== 113.14  Running away ===========================================

	// from something wild; not from someone's
	void run_away {
		if Owner != "" {
			beat "There's no running from a battle with " + Owner + "!", 0, 0
		} else {
			beat "Got away safely!", 0, 0
			Over = true
		}
	}

	// ==== 112.37  A turn  (changed in 113, 123, 127, 129) ================

	// the quicker one goes first; the other, if it can still go, after
	void take_turn int Move {
		int Theirs = random 0, (int)Foe.Moves.length - 1
		if Ours.Speed >= Foe.Speed {
			ember_goes Move
			foe_goes Theirs
		} else {
			foe_goes Theirs
			ember_goes Move
		}
	}

	void ember_goes int Move {
		if Over {
			return
		}
		Foe.Health = hurt Foe.Health, damage(Ours, Ours.Powers[Move], Foe)
		beat Ours.Name + " used " + Ours.Moves[Move] + "!", 1, Foe.Health
		if Foe.Health == 0 {
			beat foe_name + " fainted!", 4, 0
			Over = true
			after_fainting false
		}
	}

	void foe_goes int Move {
		if Over {
			return
		}
		Ours.Health = hurt Ours.Health, damage(Foe, Foe.Powers[Move], Ours)
		beat foe_name + " used " + Foe.Moves[Move] + "!", 2, Ours.Health
		if Ours.Health == 0 {
			beat Ours.Name + " is worn out!", 5, 0
			keep_wounds                 // (127) as it is, worn out
			int Next = first_able Current
			if Next >= 0 {
				Current = Next          // (127) the next sent out
				battled Next            // (129)
				beat "Go, " + name_of(Next) + "!", 7, 0
			} else {
				after_fainting true
				beat "You hurry them back to the elder.", 0, 0   // (123, 127: all of them)
				Over = true
				Lost = true
			}
		}
	}

	// ==== 113.15  Won, or lost  (changed in 129, 133) ====================

	// winning, experience; and someone's owner says what they think
	void after_fainting bool Ember {
		if !Ember {
			share_out Foe.Level * 10    // (129) among all who battled
			earn                        // (133) and some denarii
		}
		if Owner != "" {
			beat owner_says(Ember), 0, 0
		}
	}

	// (120) at the coast, what he says is the coast's
	str owner_says bool Won const {
		if Area == "coast" && Won {
			return Owner + ": Ha! All that training paid off. Come back when you're stronger!"
		} else if Area == "coast" {
			return Owner + ": Beaten again! The sea air must suit you and that fox."
		} else if Won {
			return Owner + ": Ha! Told you we'd win. See you at the coast!"
		}
		return Owner + ": Argh, beaten! Bruno and I will train, and I'll still beat you to the coast!"
	}

	// ==== 113.16  Experience  (changed in 127) ===========================

	// enough of it (ten times her level), and Ember grows a level
	void gain int Points {
		if Current > 0 {
			member_gains Points         // (127) one of the party's
			return
		}
		Story.EmberExperience += Points
		beat Ours.Name + " gained " + Points.text + " experience!", 0, 0
		if Story.EmberExperience >= ember_level * 10 {
			Story.EmberExperience -= ember_level * 10
			Story.EmberLevel = ember_level + 1
			beat Ours.Name + " grew to level " + Story.EmberLevel.text + "!", 0, 0
		}
	}

	// 5 to begin with
	int ember_level const {
		if Story.EmberLevel < 5 {
			return 5
		}
		return Story.EmberLevel
	}

	// ==== 112.38  How hard a hit is ======================================

	// as FireRed works it out, more or less: by the level, the move's
	// power, and strength against toughness; then from 85% to all of it
	int damage const critter &By, int Power, const critter &Target const {
		int Most = (By.Level * 2 / 5 + 2) * Power * By.Strength / Target.Toughness / 50 + 2
		return Most * random(85, 100) / 100
	}

	// health, less a hit, but never below 0
	int hurt int Health, int Damage const {
		if Damage >= Health {
			return 0
		}
		return Health - Damage
	}

	// ==== 113.17  Looking out for the hero ===============================

	// on a tile that makes someone notice; or in front of someone who sees
	void look_out {
		int Who = watcher
		if Who < 0 {
			Who = seen_by
		}
		if Mode == PLAYING && Who >= 0 {
			noticed_by Who
		}
	}

	// "watch 8,1 elder" on this tile: the elder (-1: nobody, or they've
	// noticed the hero already)
	int watcher const {
		str Name = thing_at "watch", Hero.Col, Hero.Row
		if Name == "" || Story.Noticed.contains(Name) {
			return -1
		}
		return person_named Name
	}

	int person_named const str &Name const {
		for I in People.length {
			if People[I].Who == Name {
				return (int)I
			}
		}
		return -1
	}

	// ==== 113.18  Who can see the hero ===================================

	// the first who does (-1: nobody): standing still, facing the hero,
	// near enough, with nothing in between; who hasn't noticed them before
	int seen_by const {
		for I in People.length {
			str Name = People[I].Who.copy
			if Sight.contains(Name) && !Story.Noticed.contains(Name) && !People[I].stepping {
				if in_sight People[I].Col, People[I].Row, People[I].Facing, Sight[Name] {
					return (int)I
				}
			}
		}
		return -1
	}

	// the tiles that way from C, R, as far as Far, until something's in the
	// way: is the hero on one?
	bool in_sight int C, int R, const str &Way, int Far const {
		int X = C + across_of(Way)
		int Y = R + down_of(Way)
		while Far > 1 && !Hero.at(X, Y) && is_free(X, Y) {
			X += across_of Way
			Y += down_of Way
			Far--
		}
		return Hero.at X, Y
	}

	// ==== 113.19  Noticed  (changed in 119) ==============================

	// a "!" over their head (not joined on: they stand still while it
	// shows), and the hero stands still
	void noticed_by int Who {
		Story.Noticed.add People[Who].Who.copy
		Comer = Who
		NoticeFrame = 0
		Mode = NOTICED
		double X = People[Who].Body.x
		double Y = People[Who].Body.y
		double Z = People[Who].Body.z
		Bang = add_box 0.12, 0.4, 0.12, "#e53935", X, Y + 1.25, Z
		world.shape Dot = add_ball 0.08, "#e53935", X, Y + 0.95, Z
		Dot.join Bang
		effect "notice"                 // (119)
		if People[Who].Who == "rival" {
			music "rival"               // (his tune, from the moment he sees the hero)
		}
		println "noticed by the", People[Who].Who
	}

	// ==== 113.20  Coming over ============================================

	// the "!" for a moment (jumping up a little); then a step at a time
	// toward the hero, and talk
	void notice_step {
		NoticeFrame++
		if NoticeFrame < NOTICE_FRAMES {
			Bang.move 0, 0.012 * (NOTICE_FRAMES / 2 - NoticeFrame) / (NOTICE_FRAMES / 2), 0
			return
		} else if NoticeFrame == NOTICE_FRAMES {
			Bang.remove
		}
		if !People[Comer].stepping && !come_closer {
			arrived_to_talk
		}
	}

	// a step closer (false: they're next to the hero, or can't get any
	// closer)
	bool come_closer {
		str Way = way_toward People[Comer].Col, People[Comer].Row
		if Way != "" {
			People[Comer].step Way, true
		}
		return Way != ""
	}

	// ==== 113.21  Which way to go ========================================

	// from C, R toward the hero: the way that's further first, if it's free
	// ("" when they're next to the hero, or neither way is free)
	str way_toward int C, int R const {
		for Way in ways_toward C, R {
			if Way != "" && !next_to_hero(C, R) && on_map(C + across_of(Way), R + down_of(Way)) && is_free(C + across_of(Way), R + down_of(Way)) {
				return Way.copy
			}
		}
		return ""
	}

	// the way across, and the way down, the one that's further first
	list str ways_toward int C, int R const {
		int Dx = Hero.Col - C
		int Dy = Hero.Row - R
		list str Ways = {way_of(Dx, "left", "right"), way_of(Dy, "up", "down")}
		if Dy * Dy > Dx * Dx {
			Ways.reverse
		}
		return Ways
	}

	// below 0, Less ("left"); above it, More ("right"); 0: ""
	str way_of int D, const str &Less, const str &More const {
		if D < 0 {
			return Less.copy
		} else if D > 0 {
			return More.copy
		}
		return ""
	}

	bool next_to_hero int C, int R const {
		int Dx = Hero.Col - C
		int Dy = Hero.Row - R
		return Dx * Dx + Dy * Dy <= 1
	}

	// ==== 113.22  Face to face ===========================================

	// next to the hero (or as near as they can get): the hero turns to
	// them, they turn to the hero, and talk
	void arrived_to_talk {
		str Way = ways_toward(People[Comer].Col, People[Comer].Row)[0].copy
		Hero.face opposite(Way)
		Mode = PLAYING
		talk_to Comer
	}

	// ==== 113.23  The rival's challenge ==================================

	// once his words have gone: a step back, to make room, if he can; he
	// turns to face the hero; then the battle he asked for
	void challenge_step {
		if People[Leaver].stepping {
			return
		}
		int C = People[Leaver].Col + across_of(Hero.Facing)
		int R = People[Leaver].Row + down_of(Hero.Facing)
		if !BackedOff && next_to_hero(People[Leaver].Col, People[Leaver].Row) && on_map(C, R) && is_free(C, R) {
			People[Leaver].step Hero.Facing, true
			BackedOff = true
			return
		}
		People[Leaver].face opposite(Hero.Facing)
		Challenge = false
		begin_battle rival_pup(pup_level), "Rufus", 1.2
	}

	// ==== 113.24  Walking off ============================================

	// east, a step at a time, as far as he can go; then he's gone
	void step_away {
		int C = People[Leaver].Col + 1
		int R = People[Leaver].Row
		if on_map(C, R) && is_free(C, R) {
			People[Leaver].step "right", true
		} else {
			People[Leaver].Body.remove
			People.remove_at Leaver
			WalkingOff = false
			println "the rival has gone"
		}
	}

	// ==== 115.8  The game's menu  (changed in 126, 128) ==================

	// what the hero carries, and what to do
	void open_menu {
		list str Choices = {"Party", "Bag"}     // (126)
		if Story.Answers.contains "balls" {
			Choices.add "Book"
		}
		Choices.add "Save"
		Choices.add "Options"
		Choices.add "Title"
		Choices.add "Back"
		ask "menu", day_and_time, Choices   // (128)
	}

	// ==== 115.9  A menu's answer  (changed in 126, 127, 134) =============

	// the title's, the game's menu's, or the options'
	void menu_chosen const str &Which, const str &Answer {
		if Answer == "New game" {
			new_game
		} else if Answer == "Continue" {
			load_game
		} else if Answer == "Options" {
			show_options 0
		} else if Answer == "Credits" {
			roll_credits                // (134)
		} else if Answer == "Save" {
			save_game
		} else if Answer == "Title" {
			show_title
		} else if Answer == "Party" {
			show_party                  // (126, 127)
		} else if Answer == "Bag" {
			say bag_list
		} else if Answer == "Book" {
			say book_list
		} else if Which == "options" {
			option_chosen Answer
		} else if Which == "party" && Answer != "Back" {
			change_lead Choice          // (127)
		}
	}

	// ==== 115.10  The options  (changed in 117, 119) =====================

	// each says what it is now; choosing it changes it, and the arrow stays
	// on it (At)
	void show_options int At {
		list str Choices = {"Shadows: " + on_or_off(!NoShadows), "Camera: " + near_or_far, "Day: " + day_length}
		Choices.add "Music: " + on_or_off(!NoMusic)     // (119)
		Choices.add "Sounds: " + on_or_off(!NoSounds)
		Choices.add "Back"
		ask "options", "Options", Choices
		Choice = At
		show_choices
	}

	str on_or_off bool On const {
		if On {
			return "on"
		}
		return "off"
	}

	str day_length const {
		if QuickDays {
			return "2 minutes"
		}
		return "24 minutes"
	}

	str near_or_far const {
		if Far {
			return "far"
		}
		return "near"
	}

	// ==== 119.3  Music on, or off ========================================

	// off: stopped; on again: what should be playing, from its start
	void music_on bool On {
		NoMusic = !On
		if On {
			str Was = Playing.copy
			Playing = ""
			music Was
		} else {
			sound.stop_music
		}
	}

	// ==== 115.11  An option chosen  (changed in 117, 119) ================

	// shadows on or off, the camera near or far; or back where they came
	// from: the title, or the game's menu
	void option_chosen const str &Answer {
		if Answer.starts_with "Shadows" {
			NoShadows = !NoShadows
			set_shadows !NoShadows
			show_options 0
		} else if Answer.starts_with "Camera" {
			Far = !Far
			show_options 1
		} else if Answer.starts_with "Day" {
			QuickDays = !QuickDays          // (117)
			show_options 2
		} else if Answer.starts_with "Music" {
			music_on NoMusic                // (119)
			show_options 3
		} else if Answer.starts_with "Sounds" {
			NoSounds = !NoSounds
			show_options 4
		} else if OnTitle {
			title_menu
		} else {
			open_menu
		}
	}

	// ==== 116.5  A world that moves ======================================

	// a little each frame: the water's shimmer, its waves, and the wind
	// in the flowers and the trees; each a little out of step with the
	// rest, by where it is (its "phase")
	void move_world {
		double T = frame / 60.0                 // seconds
		for Water in shapes_in "water" {
			double Shine = 0.5 + 0.5 * sin(1.5 * T + phase(Water.x, Water.z))
			Water.set_color rgb(58 + (int)(12 * Shine), 123 + (int)(16 * Shine), 213 + (int)(14 * Shine), 1)
		}
		for Wave in shapes_in "waves" {
			double Home = round Wave.x          // (it drifts less than half a tile)
			double Drift = sin 0.8 * T + phase(Home, Wave.z)
			Wave.move_to Home + 0.25 * Drift, 0.01, Wave.z
			Wave.set_size 0.25 + 0.15 * (1 - Drift * Drift), 0.008, 0.04
		}
		for Foam in shapes_in "foam" {
			double Home = floor(Foam.x) + 0.5    // (120) at the sand's edge
			Foam.move_to Home + 0.18 * sin(1.2 * T + phase(Home, Foam.z)), 0.012, Foam.z
		}
		for Hull in shapes_in "boats" {
			double Rock = sin 0.9 * T + phase(Hull.x, Hull.z)
			Hull.move_to Hull.x, 0.12 + 0.04 * Rock, Hull.z
			Hull.set_roll 5 * Rock
		}
		for Petals in shapes_in "flowers" {
			Petals.move 0.0006 * cos(2 * T + phase(Petals.x, Petals.z)), 0, 0
		}
		for Trunk in shapes_in "trees" {
			double Wind = phase round(Trunk.x), round(Trunk.z)
			Trunk.set_tilt 1.5 * sin(1.1 * T + Wind)
			Trunk.set_roll 1.2 * sin(0.9 * T + 2 * Wind)
		}
	}

	// ==== 116.6  Out of step =============================================

	// a number from where something is: things near each other differ,
	// but only a little
	double phase double X, double Z const {
		return 0.4 * X + 0.7 * Z
	}

	double round double X const {
		return floor X + 0.5
	}

	// ==== 117.9  The time passing  (changed in 128) ======================

	// a frame's worth of the day; and when night falls, or the day comes,
	// it says so
	void pass_time {
		Story.Time += 1.0 / day_frames
		if Story.Time >= 1 {
			Story.Time -= 1
			Story.Days++                // (128) midnight: a new day
		}
		bool Dark = daylight < 0.5
		if Dark != Night {
			Night = Dark
			HoursDue = true             // (128)
			if Night {
				println "night falls"
			} else {
				println "the sun rises"
			}
		}
	}

	// how long a day is, in frames: as the options say
	int day_frames const {
		if QuickDays {
			return QUICK_DAY
		}
		return DAY_FRAMES
	}

	// ==== 117.10  The weather ============================================

	// now and then the rain starts: one check in so many that it's about
	// once in RAIN_DAYS days, however long a day is; raining, one check
	// in six it stops, so a shower lasts a few minutes. It comes on, and
	// goes off, over three seconds; and the drops fall
	void weather {
		if frame % RAIN_CHECK == 0 {
			int Checks = (int)(RAIN_DAYS * day_frames / RAIN_CHECK)
			if !Story.Raining && random(1, Checks) == 1 {
				Story.Raining = true
				println "it starts to rain"
			} else if Story.Raining && random(1, 6) == 1 {
				Story.Raining = false
				println "the rain stops"
			}
		}
		if Story.Raining && Wet < 1 {
			Wet += 1.0 / 180
		} else if !Story.Raining && Wet > 0 {
			Wet -= 1.0 / 180
		}
		fall
	}

	// ==== 117.11  Raindrops ==============================================

	// as many as it's wet (outside); each falls, and when it lands, it
	// starts again up above somewhere near the hero (on water, a ripple)
	void fall {
		int Wanted = (int)(DROPS * Wet)
		if Inside {
			Wanted = 0
		}
		while Drops.length < Wanted {
			world.shape Drop = add_box 0.02, 0.3, 0.02, "#c9d6e3", Hero.Body.x, -1, Hero.Body.z
			Drops.add Drop
		}
		while Drops.length > Wanted {
			int Last = (int)Drops.length - 1
			Drops[Last].remove
			Drops.remove_at Last
		}
		for I in Drops.length {
			if Drops[I].y <= 0 {
				land (int)I
			} else {
				Drops[I].move -0.02, -0.3, 0          // (falling, a little slanted)
			}
		}
	}

	// up above again: somewhere in sight, more of them in front of the hero
	void land int I {
		double X = Drops[I].x
		double Z = Drops[I].z
		if Drops[I].y > -1 && water_at((int)floor(X - OriginX + 0.5), (int)floor(Z - OriginZ + 0.5)) && random(1, 4) == 1 && Ripples.length < 40 {
			small_ripple X, Z, 0.3      // (a raindrop's: small)
		}
		Drops[I].move_to Hero.Body.x + random(-80, 80) / 10.0, 3 + random(0, 40) / 10.0, Hero.Body.z + random(-70, 30) / 10.0
	}

	// ==== 119.4  A sound =================================================

	// sounds/step.wav ...: played once, while the game goes on (unless
	// the options have turned the sounds off)
	void effect const str &Name {
		if !NoSounds {
			sound.play "sounds/" + Name + ".wav"
		}
	}

	// ==== 119.5  A sound from somewhere ==================================

	// as loud as it's near the hero: all of it close by, none HEARD
	// metres off; each loaded once, and played again from the start
	void effect_at const str &Name, double X, double Z {
		double Dx = X - Hero.Body.x
		double Dz = Z - Hero.Body.z
		double Loud = 1 - sqrt(Dx * Dx + Dz * Dz) / HEARD
		if NoSounds || Loud <= 0 {
			return
		}
		if !Near.contains Name {
			Near[Name] = sound.load "sounds/" + Name + ".wav"
		}
		Near[Name].stop
		Near[Name].set_volume Loud
		Near[Name].play
	}

	// ==== 119.6  Music ===================================================

	// music/town.mid, round and round, fading in as the last fades out;
	// the same again goes on as it is
	void music const str &Name {
		if Name == Playing {
			return
		}
		Playing = Name.copy
		if NoMusic {
			return
		} else if Name == "" {
			sound.fade_out_music 1000
		} else {
			sound.change_music "music/" + Name + ".mid", 1000
		}
	}

	// the area's own (its "music" line), after a battle, say
	void area_music {
		music setting("music")
	}

	// ==== 119.7  The rain, heard =========================================

	// rain.wav, round and round, as loud as it's raining (not inside)
	void hear_rain {
		if !RainLoaded {
			Rain = sound.load "sounds/rain.wav"
			Rain.set_looping true
			RainLoaded = true
		}
		double Loud = 0.6 * Wet
		if Inside || NoSounds {
			Loud = 0
		}
		if Loud > 0.01 && !Rain.playing {
			Rain.play
		} else if Loud <= 0.01 && Rain.playing {
			Rain.stop
		}
		Rain.set_volume Loud
	}

	// ==== 119.8  Thunder =================================================

	// raining hard, now and then (once in 20 seconds or so): a flash, and
	// the thunder
	void storm {
		if Wet > 0.9 && !Inside && random(1, 1200) == 1 {
			Flash = 1
			effect "thunder"
			println "thunder"
		}
		if Flash > 0 {
			Flash -= 0.05
		}
	}

	// ==== 118.3  A cave's tiles ==========================================

	// rock, of uneven heights; the floor; a stalagmite; a crystal, glowing
	// (a lamp of its own); water; and the way out
	void add_cave char Tile, double X, double Z {
		int Mix = (int)(7 * X + 13 * Z + 1000)
		if Tile == 'R' {
			double Tall = 1.0 + 0.15 * (Mix % 5)
			add_box 1, Tall, 1, ROCK, X, Tall / 2, Z
			return
		} else if Tile == '~' {
			add_water X, Z
			return
		}
		add_plane 1, 1, "#3b3530", X, 0.005, Z
		if Tile == 'A' {
			add_cone 0.25, 0.7 + 0.1 * (Mix % 3), "#6b625a", X, 0.35, Z
		} else if Tile == 'X' {
			make_crystal X, Z, 0.25
			world.lamp Glow = add_lamp X, 0.6, Z, "#6fd3ff", 2.5
			CaveLamps.add Glow
		} else if Tile == 'o' {
			add_plane 1, 1, "#140f0c", X, 0.008, Z      // (the way out: darker)
		}
	}

	// ==== 118.4  A crystal ===============================================

	// two cones, point to point, pale blue: one standing, one hanging
	// under it
	world.shape make_crystal double X, double Z, double Y {
		world.shape Top = add_cone 0.12, 0.3, "#9fe6ff", X, Y + 0.15, Z
		world.shape Under = add_cone 0.12, 0.2, "#6fd3ff", X, Y - 0.1, Z
		Under.set_tilt 180
		Under.join Top
		return Top
	}

	// ==== 118.5  A cave's mouth ==========================================

	// a way in from a cliff (C): a dark opening in its face (by number:
	// adding a shape changes the world, Things with it)
	void add_mouths {
		for I in Things.length {
			if Things[I].starts_with "way " {
				list str At = Things[I].split(" ")[1].split ","
				int C = At[0].to_int
				int R = At[1].to_int
				if on_map(C, R) && Map[R][C] == 'C' {
					add_box 0.7, 0.9, 0.06, "#120e0c", C, 0.45, R + 0.5
				}
			}
		}
	}

	// ==== 118.6  Into the dark ===========================================

	// the lantern, the bats, and a drop of water ready to fall
	void into_the_dark {
		world.lamp Lantern = add_lamp Hero.Body.x, 2.6, Hero.Body.z, "#ffcf8a", LANTERN
		CaveLamps.add Lantern
		world.shape Drip = add_box 0.025, 0.08, 0.025, "#bfe3ff", 0, -1, 0
		Drips.add Drip
	}

	// ==== 118.7  A bat, or a gull  (changed in 120, 125) =================

	// "bats 3", or (120) "gulls 3": that many, each over a tile picked at
	// random (a bat's, the cave's floor), going round it
	void add_fliers const str &Kind {
		str Many = setting Kind
		if Many != "" {
			for I in Many.to_int {
				add_flier Kind == "gulls"
			}
		}
	}

	// a small body, two wings joined to it: a bat, dark, low and close
	// round; a gull, white, higher, and wider round
	void add_flier bool Gull {
		int C = random 1, (int)Map[0].length - 2
		int R = random 1, (int)Map.length - 2
		while !Gull && Map[R][C] != '.' {
			C = random 1, (int)Map[0].length - 2
			R = random 1, (int)Map.length - 2
		}
		double X = C + OriginX
		double Z = R + OriginZ
		str Color = "#1b1720"
		str WingColor = "#2a2430"
		double Y = 1.8
		if Gull {
			Color = "white"
			WingColor = "#d8dde2"
			Y = 3.6
		}
		world.shape Body = add_ball 0.07, Color, X, Y, Z
		Body.set_size 0.12, 0.1, 0.16
		if Gull {
			// (125) a gull is a model, flying, its wings its own: the two
			// below, out of sight, are only for fly_bats to flap
			Body.remove
			Body = add_model GULL_MODEL, X, Y, Z
			Body.play "fly"
		}
		for Side in 2 {
			double Out = Side * 2 - 1
			world.shape Wing = add_box 0.22, 0.015, 0.12, WingColor, X + Out * 0.13, Y, Z
			Wing.join Body
			Wing.set_visible !Gull
			Wings.add Wing
		}
		if Gull {
			BatWide.add 3.5
			BatCry.add "gull"
		} else {
			BatWide.add 1.3
			BatCry.add "squeak"
		}
		Bats.add Body
		BatX.add X
		BatZ.add Z
		BatY.add Y
	}

	// ==== 118.8  Each frame in the dark ==================================

	// the lantern goes with the hero, flickering; the bats fly; the water
	// drips
	void in_the_dark {
		int Last = (int)CaveLamps.length - 1          // (the lantern)
		CaveLamps[Last].move_to Hero.Body.x, Hero.Body.y + 2, Hero.Body.z   // (held up high)
		CaveLamps[Last].set_reach LANTERN + 0.25 * sin(frame / 7.0) + 0.15 * sin(frame / 3.1)
		drip
	}

	// ==== 118.9  Bats flying  (changed in 119) ===========================

	// each round its tile, a little up and down, facing the way it flies,
	// its wings flapping; each out of step with the others
	void fly_bats {
		for I in Bats.length {
			double Wide = BatWide[I]
			double A = frame / (35 * Wide) + I * 2.1        // (120) wider round, slower
			Bats[I].move_to BatX[I] + Wide * cos(A), BatY[I] + 0.2 * sin(3 * A), BatZ[I] + Wide * sin(A)
			Bats[I].set_angle 180 - A * 180 / PI
			double Flap = 40 * sin(frame / (2 * Wide) + I)
			Wings[2 * I].set_roll Flap
			Wings[2 * I + 1].set_roll -Flap
			if random(1, 500) == 1 {
				effect_at BatCry[I].copy, Bats[I].x, Bats[I].z   // (119)
			}
		}
	}

	// ==== 118.10  Dripping  (changed in 119) =============================

	// a drop falls, faster and faster; landing (on water, a ripple), it
	// waits a little, then falls again somewhere near the hero
	void drip {
		if Drips.length == 0 {
			return
		}
		double X = Drips[0].x
		double Y = Drips[0].y
		double Z = Drips[0].z
		if Y > 0.05 {
			Drips[0].move 0, -0.08, 0
		} else if Y > -0.5 {
			if water_at((int)floor(X - OriginX + 0.5), (int)floor(Z - OriginZ + 0.5)) {
				small_ripple X, Z, 0.5      // (a drip's: smaller)
			}
			effect_at "drip", X, Z      // (119)
			Drips[0].move_to 0, -1, 0           // (out of sight: waiting)
		} else if random(1, 90) == 1 {
			Drips[0].move_to Hero.Body.x + random(-40, 40) / 10.0, 2.8, Hero.Body.z + random(-40, 20) / 10.0
		}
	}

	// ==== 120.4  The coast's tiles ========================================

	// sand (and on it, where the sea meets it, foam); the pier, boards on
	// posts over the water; a boat, at anchor on it; a palm; the lighthouse
	void add_coast char Tile, double X, double Z {
		if Tile == 's' {
			add_plane 1, 1, SAND, X, 0.004, Z
			if tile_at((int)X + 1, (int)Z) == '~' {
				world.shape Foam = add_box 0.08, 0.012, 0.9, "#f4f8fb", X + 0.5, 0.012, Z
				Foam.set_group "foam"
			}
		} else if Tile == 'K' {
			add_water X, Z
			add_box 1, 0.06, 0.9, "#9b7653", X, PIER - 0.03, Z
			add_cylinder 0.06, 0.6, "#6b4f36", X - 0.4, -0.15, Z + 0.4
			add_cylinder 0.06, 0.6, "#6b4f36", X + 0.4, -0.15, Z + 0.4
		} else if Tile == 'u' {
			add_water X, Z
			add_boat X, Z
		} else if Tile == 'Y' {
			add_plane 1, 1, SAND, X, 0.004, Z
			add_palm X, Z
		} else if Tile == 'L' && tile_at((int)X - 1, (int)Z) != 'L' && tile_at((int)X, (int)Z - 1) != 'L' {
			add_lighthouse X + 0.5, Z + 0.5     // (once, at its top left tile)
		}
	}

	// ==== 120.5  A boat  (changed in 135) ================================

	// a hull, its bow a wedge, a mast and a sail, joined: in the group
	// "boats", to rock on the water
	void add_boat double X, double Z {
		world.shape Yacht = add_model YACHT_MODEL, X, -0.05, Z   // (135) a model, a little low in the water
		Yacht.set_group "boats"
	}

	// ==== 120.6  A palm ==================================================

	// a tall trunk, leaning, and its fronds, flat boxes joined to its top,
	// all round, drooping: in the group "trees", to sway as they do
	void add_palm double X, double Z {
		world.shape Trunk = add_cylinder 0.08, 1.6, "#9a7b54", X, 0.8, Z
		Trunk.set_roll 8
		Trunk.set_group "trees"
		for I in 6 {
			double A = I * 60 * PI / 180
			world.shape Frond = add_box 0.8, 0.03, 0.2, "#3f8f3a", X + 0.4 * cos(A), 1.55, Z + 0.4 * sin(A)
			Frond.set_angle -I * 60
			Frond.set_roll 18
			Frond.join Trunk
		}
	}

	// ==== 120.7  The lighthouse ==========================================

	// a white tower, red bands round it, a lamp room at its top and a red
	// roof; a lamp in it, and its beam, a long pale bar, both lit at night.
	// The beam glows (set_glow): drawn its own color, not shaded by the
	// moonlight, and casting no shadow, as light wouldn't
	void add_lighthouse double X, double Z {
		add_cylinder 0.75, 0.3, "#8a8178", X, 0.15, Z           // (its rocks)
		world.shape Tower = add_cylinder 0.6, 4, "white", X, 2, Z
		for I in 3 {
			world.shape Band = add_cylinder 0.62, 0.35, "#c8352c", X, 0.8 + I * 1.2, Z
			Band.join Tower
		}
		world.shape Room = add_cylinder 0.42, 0.6, "#fff3c4", X, 4.3, Z
		Room.join Tower
		world.shape Roof = add_cone 0.55, 0.6, "#c8352c", X, 4.9, Z
		Roof.join Tower
		world.shape Beam = add_box 7, 0.12, 0.12, "#fff6cf", X + 3.5, 4.3, Z
		Beam.set_glow true
		Beams.add Beam
		LampRooms.add Room
		world.lamp Light = add_lamp X, 4.3, Z, "black", 12
		Beacons.add Light
	}

	// ==== 120.8  Its beam going round ====================================

	// at night, the lamp lit, its room glowing, and the beam sweeping round,
	// out from the tower; by day, none of them
	void turn_beam {
		double Lit = 1 - daylight
		for I in Beams.length {
			double Tower = Beacons[I].x
			double TowerZ = Beacons[I].z
			double A = frame * 1.2
			double R = A * PI / 180
			Beams[I].set_angle A
			Beams[I].move_to Tower + 3.5 * cos(R), 4.3, TowerZ - 3.5 * sin(R)
			Beams[I].set_visible Lit > 0.3
			LampRooms[I].set_glow Lit > 0.3
			Beacons[I].set_color rgb(255, 240, 200, Lit)
		}
	}

	// ==== 120.9  The sea, heard ==========================================

	// surf.wav, round and round, in an area by the sea ("sea" after its
	// map)
	void hear_surf {
		if !SurfLoaded {
			Surf = sound.load "sounds/surf.wav"
			Surf.set_looping true
			SurfLoaded = true
		}
		bool By = Things.contains("sea") && !NoSounds
		if By && !Surf.playing {
			Surf.set_volume 0.5
			Surf.play
		} else if !By && Surf.playing {
			Surf.stop
		}
	}

	// ==== 120.10  Rufus, again ===========================================

	// the first time: he's been training here, and Bruno's grown; after,
	// he's off on the next boat
	void at_the_coast int Who {
		if Story.Answers.contains "rematch" {
			say "Good battle, " + hero_name + ". I'm off on the next boat. Who knows what's out there?"
		} else {
			say "So you found the coast too, " + hero_name + "! Bruno and I have been training here. Ready? Let's battle!"
			if !Story.Noticed.contains("rival") {
				Story.Noticed.add "rival"   // (met: he's not waiting in the meadow)
			}
			Challenge = true
			BackedOff = false
			Leaver = Who
		}
	}

	// how strong Bruno is: at the coast, he's trained
	int pup_level const {
		if Area == "coast" {
			return 8
		}
		return 6
	}

	// ==== 116.7  Asking the water ========================================

	// the tile ahead is water, and the hero isn't in it: may they swim?
	void ask_the_water {
		ask "water", "The water is deep and calm. Swim across?", {"Swim", "Not now"}
	}

	bool water_at int C, int R const {
		return tile_at(C, R) == '~'
	}

	// ==== 116.8  In they go  (changed in 119) ============================

	// a step into the water, down to their chest as they go
	void swim_in {
		Swimming = true
		Hero.step Hero.Facing.copy, true
		Hero.To = DEEP
		ripple Hero.Body.x + Hero.Dx, Hero.Body.z + Hero.Dy   // (where they go in)
		effect "splash"                 // (119)
		println "swimming"
	}

	// ==== 116.9  Climbing out  (changed in 119) ==========================

	// on land again (or in water, still swimming)
	void settle_swimming {
		bool Wet = water_at Hero.Col, Hero.Row
		if Swimming && !Wet {
			effect "splash"             // (119)
			println "out of the water"
		}
		Swimming = Wet
	}

	// ==== 116.10  Ripples ================================================

	// a ring on the water: a pale disc, with one the water's color just
	// inside it, a little higher, so only its edge shows
	void ripple double X, double Z {
		small_ripple X, Z, 1
	}

	// one Size as big (a raindrop's, smaller)
	void small_ripple double X, double Z, double Size {
		world.shape Edge = add_cylinder 0.2 * Size, 0.004, "#e8f4ff", X, 0.012, Z
		world.shape Middle = add_cylinder 0.18 * Size, 0.004, "#3a7bd5", X, 0.016, Z
		Ripples.add Edge
		Ripples.add Middle
		RippleAges.add 0
		RippleSizes.add Size
	}

	// each a little bigger, and nearer the water's color, until it's gone
	// (the oldest first in the list: two shapes for each)
	void spread_ripples {
		for I in RippleAges.length {
			RippleAges[I]++
			double Age = RippleAges[I] / 45.0
			double Wide = RippleSizes[I] * (0.3 + 1.2 * Age)
			Ripples[2 * I].set_size Wide, 0.004, Wide
			Ripples[2 * I].set_color rgb(232 - (int)(174 * Age), 244 - (int)(121 * Age), 255 - (int)(42 * Age), 1)
			double Inner = Wide - 0.06 * RippleSizes[I]
			Ripples[2 * I + 1].set_size Inner, 0.004, Inner
		}
		if RippleAges.length > 0 && RippleAges[0] >= 45 {
			Ripples[0].remove
			Ripples[1].remove
			Ripples.remove_at 0
			Ripples.remove_at 0
			RippleAges.remove_at 0
			RippleSizes.remove_at 0
		}
	}

	// ==== 121.3  Ember, in the area  (changed in 124, 127) ===============

	// built with it: walking in from next door, a step behind, where she
	// was; through a door (or starting), on the hero's tile, out of sight,
	// with nothing to follow yet
	void add_follower {
		double Feet = Hero.Feet
		if Crossing {
			Feet = FollowFeet
		}
		FollowerParts = model_of model_for(lead_kind), Hero.Col, Feet, Hero.Row   // (124, 127)
		Follower.Who = lead_kind
		Follower.Body.Id = FollowerParts[0].Id   // (the same shape: its Id)
		// ((124) her legs are the model's: these two, out of sight, are only
		// for the walker to swing)
		Follower.Left = add_box 0.01, 0.01, 0.01, "white", Hero.Col, Feet, Hero.Row
		Follower.Right = add_box 0.01, 0.01, 0.01, "white", Hero.Col, Feet, Hero.Row
		Follower.Left.set_visible false
		Follower.Right.set_visible false
		Follower.Left.join Follower.Body
		Follower.Right.join Follower.Body
		Follower.Col = Hero.Col
		Follower.Row = Hero.Row
		Follower.StepsLeft = 0
		Follower.Feet = Feet
		Follower.stand_at Feet
		Follower.face Hero.Facing.copy
		if Crossing {
			Follower.Body.move FollowCol - Hero.Col, 0, FollowRow - Hero.Row
			Follower.Col = FollowCol
			Follower.Row = FollowRow
			Crossing = false
			Waiting = false
		} else {
			Steps.clear
			Waiting = true
		}
		show_follower !Waiting
	}

	// the hero walking into the area next door (which is Left, Top on this
	// one's map): where she'll be in it, on the tile she's stepping to
	void keep_follower int Left, int Top {
		Crossing = !Waiting
		FollowCol = Follower.Col - Left
		FollowRow = Follower.Row - Top
		FollowFeet = Follower.Feet
		if Follower.stepping {
			FollowCol += Follower.Dx * Follower.Tiles
			FollowRow += Follower.Dy * Follower.Tiles
			FollowFeet = Follower.To
		}
	}

	void show_follower bool On {
		for Part in FollowerParts {
			Part.set_visible On
		}
	}

	// she's there (or stepping there), and seen
	bool follower_at int C, int R const {
		return !Waiting && Follower.at(C, R)
	}

	// ==== 121.4  A footstep kept  (changed in 122) =======================

	// the hero has begun a move: kept, to make after the next begins. If
	// she was waiting on the hero's tile, it's free now: there she is
	void keep_footstep {
		footstep Step = {.Way = Hero.Facing.copy, .Tiles = Hero.Tiles, .From = Hero.From, .Edge = Hero.Edge, .To = Hero.To}
		Steps.add Step
		if Waiting && start_stage == "done" {   // ((122) once she's been given)
			Waiting = false
			show_follower Mode != BATTLE
		}
	}

	// ==== 121.5  Following  (changed in 124, 127) ========================

	// each frame: standing still, and the hero gone on another move since
	// the one she's to make, she makes it; and then a frame of her step
	void follow_hero {
		if !Waiting && !Follower.stepping && Steps.length > 1 {
			str Way = Steps[0].Way.copy
			if Steps[0].Tiles == 2 {
				Follower.hop Way
			} else {
				Follower.step Way, true
			}
			Follower.Edge = afloat Steps[0].Edge
			Follower.To = afloat Steps[0].To
			Steps.remove_at 0
		}
		if Follower.stepping {
			Follower.keep_stepping
		}
		if Follower.stepping {
			FollowerParts[0].play walk_of(Follower.Who)   // (124) her own legs, and tail; (127) its own way
			FollowerParts[0].set_animation_speed 2
		} else {
			FollowerParts[0].play "idle"
			FollowerParts[0].set_animation_speed 1
		}
	}

	// where Ember runs out from, into a battle, and back to: where she's
	// following (or, out of sight on the hero's tile, just behind them)
	void ember_from {
		Ours.FromX = Follower.Body.x
		Ours.FromZ = Follower.Body.z
		if Waiting {
			Ours.FromX = Hero.Body.x - 0.8 * across_of(Hero.Facing)
			Ours.FromZ = Hero.Body.z - 0.8 * down_of(Hero.Facing)
		}
	}

	// as high as the hero was, there; but in the water (under 0), not as
	// deep: she's smaller, and swims with her head up
	double afloat double Height const {
		if Height < 0 {
			return Height * 0.6
		}
		return Height
	}

	// ==== 122.3  Lines for the 3D quest =================================

	// "3d way 16,5 home 6,7": a line only this quest reads (the 2D quest,
	// reading the same map, skips it), with its "3d " taken off; a way
	// put where a sign is takes its place
	void for_the_3d_quest {
		list str Ways
		for I in Things.length {
			if Things[I].starts_with "3d " {
				Things[I] = Things[I][3 to Things[I].length - 1]
				if Things[I].starts_with "way " {
					Ways.add "sign " + Things[I].split(" ")[1] + " "
				}
			}
		}
		int I = 0
		while I < Things.length {
			bool Replaced = false
			for Way in Ways {
				if Things[I].starts_with Way {
					Replaced = true
				}
			}
			if Replaced {
				Things.remove_at I
			} else {
				I++
			}
		}
	}

	// ==== 122.4  The station's tiles, and a bed  (changed in 135) ========

	// the railway (r); the platform (p), a yellow line along its edge by
	// the rails; and (Q) a bed, its pillow on its top tile
	void add_station char Tile, double X, double Z {
		if Tile == 'r' {
			add_rails X, Z
		} else if Tile == 'p' {
			add_box 1, PLATFORM, 1, "#b9b2a6", X, PLATFORM / 2, Z
			if tile_at((int)X - 1, (int)Z) == 'r' {
				add_box 0.08, 0.004, 1, "#e8c547", X - 0.42, PLATFORM + 0.002, Z
			}
		} else if Tile == 'Q' {
			add_plane 1, 1, "#a0703c", X, 0.005, Z
			if tile_at((int)X - 1, (int)Z) != 'Q' && tile_at((int)X, (int)Z - 1) != 'Q' {
				add_model BED_MODEL, X + 0.5, 0, Z + 0.5   // (135) once, at its top left tile: two by two
			}
		}
	}

	// two rails on sleepers, on stones; (beyond the map's edges too, from
	// the trees round it)
	void add_rails double X, double Z {
		add_plane 1, 1, "#8a8278", X, 0.004, Z
		for I in 2 {
			add_box 1.1, 0.05, 0.16, "#6b4f36", X, 0.03, Z - 0.25 + I * 0.5
			add_box 0.06, 0.08, 1, "#9aa0a6", X - 0.45 + I * 0.9, 0.09, Z
		}
	}

	// ==== 122.5  A train, made ===========================================

	// an engine, heading down the map (+z): a green boiler on its side, a
	// chimney, a cab, red at the front, black wheels; and two carriages
	// behind it, maroon, with windows. All joined to the engine's base,
	// so moving that moves the train
	world.shape make_train double X, double Z {
		world.shape Base = add_box 0.9, 0.25, 2.4, "#333333", X, 0.45, Z
		list world.shape On
		world.shape Boiler = add_cylinder 0.36, 1.5, "#2f6b3f", X, 0.95, Z + 0.4
		Boiler.set_tilt 90              // (on its side, along the train)
		On.add Boiler
		On.add add_cylinder(0.1, 0.45, "#222222", X, 1.5, Z + 0.85)          // the chimney
		On.add add_box(0.9, 0.8, 0.8, "#2f6b3f", X, 1.0, Z - 0.75)           // the cab
		On.add add_box(1.0, 0.08, 0.95, "#5c5c5c", X, 1.44, Z - 0.75)        // its roof
		On.add add_box(0.95, 0.18, 0.08, "#b3261e", X, 0.42, Z + 1.22)       // the buffer beam
		for Side in 2 {
			for K in 3 {
				world.shape Wheel = add_cylinder 0.22, 0.08, "#1d1d1d", X - 0.47 + Side * 0.94, 0.25, Z - 0.7 + K * 0.7
				Wheel.set_roll 90
				On.add Wheel
			}
		}
		for Car in 2 {
			double Cz = Z - 2.7 - Car * 2.8     // (each carriage's middle)
			On.add add_box(0.9, 0.9, 2.6, "#7a2430", X, 0.85, Cz)
			On.add add_box(1.0, 0.1, 2.7, "#a3a3a3", X, 1.35, Cz)
			for Side in 2 {
				for K in 3 {
					On.add add_box(0.03, 0.32, 0.45, "#f3e6c0", X - 0.46 + Side * 0.92, 1.0, Cz - 0.8 + K * 0.8)
				}
				for K in 2 {
					world.shape Wheel = add_cylinder 0.18, 0.08, "#1d1d1d", X - 0.47 + Side * 0.94, 0.2, Cz - 0.9 + K * 1.8
					Wheel.set_roll 90
					On.add Wheel
				}
			}
		}
		for Part in On {
			Part.join Base
		}
		return Base
	}

	// ==== 122.6  Steam ===================================================

	// a puff from the chimney, rising, growing, gone after
	// three-quarters of a second
	void puff {
		world.shape Puff = add_ball 0.08, "#f2f2f2", Train.x, 1.75, Train.z + 0.85
		Puffs.add Puff
		PuffAges.add 0
	}

	void rise_puffs {
		for I in PuffAges.length {
			PuffAges[I]++
			double Wide = 0.16 + PuffAges[I] * 0.005
			Puffs[I].set_size Wide, Wide, Wide
			Puffs[I].move 0, 0.025, -0.02
		}
		if PuffAges.length > 0 && PuffAges[0] >= 45 {
			Puffs[0].remove
			Puffs.remove_at 0
			PuffAges.remove_at 0
		}
	}

	// ==== 122.7  How far the start has got  (changed in 123) =============

	// "train", on it; "home", taken home; "done", Ember given, and free to
	// go anywhere (a game saved before part 15: done)
	str start_stage const {
		if Story.Answers.contains "start" {
			return Story.Answers["start"].copy
		}
		return "done"
	}

	bool in_scene const {
		return !OnTitle && (start_stage != "done" || Resting)   // ((123) or waking)
	}

	// the area built: at the station, the train (far off, to pull in), the
	// hero on it, so not yet seen, and the elder on the platform; at home,
	// the elder, by the bed
	void add_scene {
		if Area == "station" {
			Train = make_train 2, TRAIN_STOP - TRAIN_RUN   // ((123) there, always)
		}
		if Area == "station" && start_stage == "train" {
			Hero.Body.set_visible false
			add_person "person 6,7 elder left"
		} else if Resting {
			beside_the_elder            // (123)
		} else if Area == "home" && start_stage == "home" {
			add_person "person 6,4 elder down"
		}
	}

	// ==== 122.8  Each frame of the start  (changed in 123) ===============

	// a step of the story: each, once done, moves on to the next (and
	// while someone speaks, or the hero steps, it waits)
	void scene_step {
		SceneFrame++
		if Resting {
			woken                       // (123)
		} else if Area == "station" {
			at_the_station
		} else if Area == "home" {
			at_home
		}
	}

	void next_scene {
		Scene++
		SceneFrame = 0
	}

	// ==== 122.9  At the station  (changed in 123) ========================

	// the train pulls in, slowing (the way left to go, squared), steam
	// puffing, its whistle as it comes; it stops, and the hero steps off;
	// the elder asks their name; (123) the train pulls out; and off they
	// go, to the hero's new home
	void at_the_station {
		rise_puffs
		if Scene == 0 {
			if SceneFrame == 1 {
				effect "whistle"
				println "a train pulls in"
			}
			double Left = 1 - SceneFrame / (double)TRAIN_FRAMES
			Train.move_to Train.x, Train.y, TRAIN_STOP + OriginZ - TRAIN_RUN * Left * Left
			if SceneFrame % 6 == 0 {
				puff
			}
			if SceneFrame == TRAIN_FRAMES {
				next_scene
			}
		} else if Scene == 1 {
			if SceneFrame % 20 == 0 {
				puff                    // (standing, now and then)
			}
			if SceneFrame == 40 {
				Hero.Body.set_visible true
				walk "right"            // off the train
				next_scene
			}
		} else if Scene == 2 {
			People[0].face "left"
			ask "elder name", "Salve, amice! Welcome to Cabby Town. I'm its elder, and I've come to meet you. What's your name?", {"Marcus", "Livia", "Tiro"}
			next_scene
		} else if Scene == 3 {
			if SceneFrame == 1 {
				effect "whistle"        // (123) the train pulls out
				println "the train pulls out"
			}
			double Gone = SceneFrame / (double)TRAIN_FRAMES
			Train.move_to Train.x, Train.y, TRAIN_STOP + OriginZ + TRAIN_RUN * Gone * Gone
			if SceneFrame % 6 == 0 {
				puff
			}
			if SceneFrame == TRAIN_FRAMES {
				Train.set_visible false
				next_scene
			}
		} else if Scene == 4 {
			Story.Answers["start"] = "home"
			NextArea = "home"
			NextCol = 6
			NextRow = 6
			Hero.Facing = "up"
			Mode = FADING_OUT
			FadeFrame = 0
			Scene = 0
			SceneFrame = 0
			println "to the hero's new home"
		}
	}

	// ==== 122.10  At home ================================================

	// the elder shows them in; there's someone to meet; Ember, given; and
	// the quest begins
	void at_home {
		if Scene == 0 && SceneFrame == 30 {
			say "Here we are: your new home. It's small, but it's all yours."
			next_scene
		} else if Scene == 1 {
			say "And there's someone here who's been waiting to meet you..."
			next_scene
		} else if Scene == 2 {
			ember_given
			say "This is Ember. She's young, and she's brave. Look after her, and she'll look after you."
			next_scene
		} else if Scene == 3 {
			effect "pick-up"
			say "Ember is with you now!"
			next_scene
		} else if Scene == 4 {
			Story.Answers["start"] = "done"
			Scene = 0
			say "The baker looked worried this morning. Go and see her, when you're ready."
		}
	}

	// ==== 122.11  Ember, given ===========================================

	// she runs out to the hero's side, the tile to their right; and when
	// the hero moves, she follows, from there onto the hero's tile (a
	// footstep of her own, to begin with)
	void ember_given {
		Follower.Body.move 1, 0, 0
		Follower.Col = Hero.Col + 1
		Follower.face "left"
		Waiting = false
		Steps.clear
		footstep Step = {.Way = "left", .Tiles = 1, .From = Follower.Feet, .Edge = Follower.Feet, .To = Follower.Feet}
		Steps.add Step
		show_follower true
		println "Ember joins the hero"
	}

	// ==== 123.2  Trains, coming and going ================================

	// how far through the timetable it is now (0 to TRAIN_EVERY - 1): a
	// train pulls in from 0, waits, and pulls out; then there's none, until
	// the next
	int timetable const {
		return (int)(frame % TRAIN_EVERY)
	}

	bool train_waiting const {
		int Now = timetable
		return Area == "station" && Now >= TRAIN_FRAMES && Now < TRAIN_FRAMES + TRAIN_WAITS
	}

	// each frame, at the station (once the start is told): the train where
	// the timetable says, from the time alone; so there's nothing to
	// remember, and arriving at any time, it's where it should be
	void run_trains {
		if Area != "station" || start_stage != "done" {
			return
		}
		rise_puffs
		int Now = timetable
		int Out = TRAIN_FRAMES + TRAIN_WAITS        // (when it pulls out)
		double Z = TRAIN_STOP
		if Now < TRAIN_FRAMES {
			double Left = 1 - Now / (double)TRAIN_FRAMES
			Z -= TRAIN_RUN * Left * Left            // pulling in, slowing
		} else if Now >= Out && Now < Out + TRAIN_FRAMES {
			double Gone = (Now - Out) / (double)TRAIN_FRAMES
			Z += TRAIN_RUN * Gone * Gone            // pulling out, quicker
		}
		bool There = Now < Out + TRAIN_FRAMES
		Train.set_visible There
		Train.move_to Train.x, Train.y, Z + OriginZ
		if Now == 1 || Now == Out {
			effect "whistle"
		}
		bool Moving = Now < TRAIN_FRAMES || (Now >= Out && There)
		if (Moving && Now % 6 == 0) || (There && Now % 20 == 0) {
			puff
		}
	}

	// ==== 123.3  No ticket  (changed in 133) =============================

	void at_the_rails {
		if train_waiting && Story.Items.contains("ticket") {
			board                       // (133)
		} else if train_waiting {
			say "You don't have a ticket."
		} else {
			say "The rails run north and south, a long way. A train stops here every few minutes."
		}
	}

	// ==== 123.4  Worn out  (changed in 127) ==============================

	// the battle lost: back to the last town, beside its elder, in the
	// dark (a fade); where, its "rest" line says
	void back_to_the_elder {
		WalkingOff = false
		Resting = true
		str Town = Story.Town.copy
		if Town == "" {
			Town = "town"
		}
		list str At = line_in(Town, "rest").split ","
		NextArea = Town.copy
		NextCol = At[0].to_int
		NextRow = At[1].to_int
		Hero.Facing = "up"
		Mode = FADING_OUT
		FadeFrame = 0
		Scene = 0
		SceneFrame = 0
		println "back to the elder"
	}

	// "rest" in that area's map (or "3d rest"): what follows it
	str line_in const str &Place, const str &Key const {
		for Line in Maps[Place] {
			if Line.starts_with Key + " " {
				return Line[Key.length + 1 to Line.length - 1]
			} else if Line.starts_with "3d " + Key + " " {
				return Line[Key.length + 4 to Line.length - 1]
			}
		}
		return ""
	}

	// the area built: the elder, just above the hero, facing them
	void beside_the_elder {
		for I in People.length {
			if People[I].Who == "elder" {
				int C = Hero.Col
				int R = Hero.Row - 1
				People[I].Body.move C - People[I].Col, 0, R - People[I].Row
				People[I].Col = C
				People[I].Row = R
				People[I].face "down"
			}
		}
	}

	// awake: he's seen to Ember
	void woken {
		if SceneFrame == 20 {
			Resting = false
			heal_all                    // (127)
			say "You're back, " + hero_name + ". Ember was worn out, so I've seen to her: she's as good as new. Take care out there!"
		}
	}

	// ==== 124.2  A model, as a critter's shapes ==========================

	// one shape, the model (as a list, as a critter's shapes are), at X, Z,
	// its feet on the ground at G, standing about
	list world.shape model_of const str &File, double X, double G, double Z {
		world.shape Model = add_model File, X, G, Z
		Model.play "idle"
		list world.shape All = {Model}
		return All
	}

	// ==== 124.3  A walker who's a model ==================================

	// their body the model; their legs, which a walker swings, two tiny
	// boxes joined to it, out of sight (the model's own legs move as it
	// plays)
	walker modelled_walker const str &Who, const str &File, int C, int R, const str &Facing {
		walker Someone
		Someone.Who = Who.copy
		Someone.Col = C
		Someone.Row = R
		Someone.Body = add_model File, C, 0, R
		Someone.Body.play "idle"
		legs_for Someone
		Someone.face Facing
		return Someone
	}

	void legs_for walker &Someone {
		Someone.Left = add_box 0.01, 0.01, 0.01, "white", Someone.Body.x, 0, Someone.Body.z
		Someone.Right = add_box 0.01, 0.01, 0.01, "white", Someone.Body.x, 0, Someone.Body.z
		Someone.Left.set_visible false
		Someone.Right.set_visible false
		Someone.Left.join Someone.Body
		Someone.Right.join Someone.Body
	}

	// ==== 126.2  Earned  (changed in 127) ================================

	// something done for the town (the baker's spoon found, or Rufus
	// battled at the coast), and no balls given yet
	bool earned_balls const {
		return !Story.Answers.contains("balls") && (Story.Quest == "done" || Story.Answers.contains("rematch"))
	}

	void give_balls {
		Story.Answers["balls"] = "given"
		Story.Balls += BALLS_GIVEN
		heal_all                        // (127)
		effect "pick-up"
		say "You've been a help to the town, " + hero_name + ". Take these: five Cabbyballs, to catch wild Cabbymon with, and a book to keep note of every one you meet. (Ember's well again, too.)"
		println "the elder gives five Cabbyballs, and the book"
	}

	// ==== 126.3  The battle's choices  (changed in 129) ==================

	// a ball, against a wild one, while there are any
	list str battle_choices const {
		list str Choices = {"Fight"}
		if Owner == "" && Story.Balls > 0 {
			Choices.add "Ball"
		}
		if can_switch {
			Choices.add "Switch"        // (129)
		}
		Choices.add "Run"
		return Choices
	}

	// ==== 126.4  A Cabbyball thrown  (changed in 127, 131) ===============

	// its chance, in a hundred: a fifth, and more the more worn out it is
	// (nearly all, at its last); caught, it's the hero's; if not, it
	// breaks free, and has its turn
	void throw_ball {
		Story.Balls--
		int Chance = 20 + 75 * (Foe.Most - Foe.Health) / Foe.Most
		beat "You threw a Cabbyball!", 9, 0   // (131) it flies, and it's in
		bool Got = random(1, 100) <= Chance
		int Wobbles = 3                 // caught: three wobbles; not, fewer
		if !Got {
			Wobbles = random 0, 2
		}
		for W in Wobbles {
			beat "", 10, 0
		}
		if Got {
			beat "Caught! The " + Foe.Name + " is yours.", 6, 0
			caught
			Over = true
		} else {
			beat "", 11, 0
			beat "Oh no! It broke free!", 0, 0
			foe_goes random(0, (int)Foe.Moves.length - 1)
		}
	}

	// into the party (if there's room), and the book
	void caught {
		if !Story.Caught.contains(Foe.Name) {
			Story.Caught.add Foe.Name.copy
		}
		if Story.Party.length + 1 < PARTY_MOST {
			member One = {.Kind = Foe.Name.copy, .Level = Foe.Level, .Wounds = 0, .Experience = 0}
			Story.Party.add line_of_member(One)   // (127)
		} else {
			beat "Your party is full: it goes to the elder's, to be looked after.", 0, 0
		}
		println "caught a", Foe.Name
	}

	// it goes, and the ball's left where it was: red, with a white band
	void into_the_ball {
		effect "pick-up"                // (131) a click: it's in, and the ball's still
		Foe.Out = false
		Foe.show false
	}

	// ==== 126.5  The party, the bag and the book  (changed in 127, 133) ===

	// Ember first, then those caught, each with its level
	str party_list const {
		str Said = "Your party:"
		for I in Story.Party.length + 1 {
			critter One = critter_of((int)I)
			if I > 0 {
				Said += ";"
			}
			Said += " " + One.Name + " (level " + One.Level.text + ", " + One.Health.text + "/" + One.Most.text + ")"
			if I == Story.Lead {
				Said += ", leading"
			}
		}
		return Said + "."
	}

	// the balls, and whatever else is carried
	str bag_list const {
		str Said = "In your bag: "
		if Story.Answers.contains "balls" {
			Said += Story.Balls.text + " Cabbyballs"
		} else {
			Said += "no Cabbyballs yet"
		}
		Said += ", " + Story.Denarii.text + " denarii"   // (133)
		for Thing in Story.Items {
			Said += ", " + Thing
		}
		return Said + "."
	}

	// every kind met, and which are caught
	str book_list const {
		if Story.Seen.length == 0 {
			return "The book is empty: no wild Cabbymon met yet."
		}
		str Said = "The book: " + Story.Seen.length.text + " met, " + Story.Caught.length.text + " caught. "
		list str Lines
		for Kind in Story.Seen {
			if Story.Caught.contains Kind {
				Lines.add Kind + " (caught)"
			} else {
				Lines.add Kind + " (seen)"
			}
		}
		return Said + Lines.join(", ") + "."
	}

	// ==== 127.2  Each of the party ======================================

	// 0 is Ember; 1 on, those caught (Story.Party[I - 1])
	critter critter_of int I const {
		if I == 0 {
			critter Ember = fox ember_level, Story.Wounds
			if Story.Wounds >= Ember.Most {
				Ember.Health = 0        // (worn out: fox gives her 1, to begin a battle with)
			}
			return Ember
		}
		return member_critter member_from(Story.Party[I - 1])
	}

	str name_of int I const {
		if I == 0 {
			return "Ember"
		}
		member One = member_from Story.Party[I - 1]
		return One.Kind.copy
	}

	// the first who can still battle: From, if it can, then each in turn
	// after it, round to the start (-1: none can)
	int first_able int From const {
		int Count = (int)Story.Party.length + 1
		for K in Count {
			int I = (From + (int)K) % Count
			if critter_of(I).Health > 0 {
				return I
			}
		}
		return -1
	}

	// how hurt whoever is out is now, kept with them
	void keep_wounds {
		int Hurt = Ours.Most - Ours.Health
		if Current == 0 {
			Story.Wounds = Hurt
		} else {
			member One = member_from Story.Party[Current - 1]
			One.Wounds = Hurt
			Story.Party[Current - 1] = line_of_member One
		}
	}

	// all of them well again
	void heal_all {
		Story.Wounds = 0
		for I in Story.Party.length {
			member One = member_from Story.Party[I]
			One.Wounds = 0
			Story.Party[I] = line_of_member One
		}
	}

	// experience for one caught: ten times its level, and it grows
	void member_gains int Points {
		member One = member_from Story.Party[Current - 1]
		One.Experience += Points
		beat One.Kind + " gained " + Points.text + " experience!", 0, 0
		if One.Experience >= One.Level * 10 {
			One.Experience -= One.Level * 10
			One.Level++
			beat One.Kind + " grew to level " + One.Level.text + "!", 0, 0
		}
		Story.Party[Current - 1] = line_of_member One
	}

	// ==== 127.3  The next, sent out ======================================

	// the one worn out gone (it's fallen over), and the next where it
	// stood, running out from behind the hero
	void send_out_next {
		double X = Ours.X
		double Z = Ours.Z
		double G = Ours.Ground
		double Angle = Ours.Angle
		Ours.remove
		Ours = critter_of Current
		str Kind = kind_of Ours.Name
		Ours.put_out made_of(Kind, X, G, Z), X, Z, G, Angle
		Ours.BarBack = bar_back
		Ours.Bar = bar
		ember_from
		Ours.start RUNNING
		println "sent out", Ours.Name
	}

	// ==== 127.4  Who leads  (changed in 130, 134) ========================

	// Ember or one caught: its model, and how it walks
	str lead_kind const {
		if Story.Lead > (int)Story.Party.length {
			return "Ember"              // (one led that isn't there)
		}
		return name_of Story.Lead
	}

	str model_for const str &Kind const {
		return model_path Kind          // (130) any kind
	}

	str walk_of const str &Kind const {
		if Kind == "hill crow" {
			return "flap"               // (134) a crow flies after the hero
		}
		return "walk"
	}

	str looked_at const str &Kind const {
		if Kind == "Ember" {
			return "Ember looks up at you, her tail swishing."
		} else if Kind == "hill crow" {
			return "The hill crow tilts its head at you, and caws."
		} else if Kind == "border collie" {
			return "The border collie wags its tail, and waits for you to say where."   // (130)
		} else if Kind == "cow" {
			return "The cow chews, and looks at you kindly."
		} else if Kind == "bison" {
			return "The bison snorts, and stamps a hoof."
		} else if Kind == "bear" {
			return "The bear sniffs the air, and lumbers after you."
		}
		return "The field mouse twitches its whiskers at you."
	}

	// a battler's kind, from its name: Ember is Ember; "Hill crow" is a
	// hill crow
	str kind_of const str &Name const {
		if Name == "Ember" {
			return "Ember"
		}
		return Name.lower
	}

	// "Ember", or "the hill crow": as a sentence names it
	str the_one const str &Kind const {
		if Kind == "Ember" {
			return "Ember"
		}
		return "the " + Kind
	}

	// the party, and who leads: choose one to lead
	void show_party {
		list str Choices
		for I in Story.Party.length + 1 {
			Choices.add name_of((int)I)
		}
		Choices.add "Back"
		ask "party", party_list, Choices
		Choice = Story.Lead
		show_choices
	}

	// the new leader: the follower made again, as it, where the old one was
	void change_lead int I {
		Story.Lead = I
		double X = Follower.Body.x
		double Z = Follower.Body.z
		double Feet = Follower.Feet
		for Part in FollowerParts {
			Part.remove
		}
		Follower.Left.remove
		Follower.Right.remove
		FollowerParts = model_of model_for(lead_kind), X, Feet, Z
		Follower.Who = lead_kind
		Follower.Body.Id = FollowerParts[0].Id
		Follower.Left = add_box 0.01, 0.01, 0.01, "white", X, Feet, Z
		Follower.Right = add_box 0.01, 0.01, 0.01, "white", X, Feet, Z
		Follower.Left.set_visible false
		Follower.Right.set_visible false
		Follower.Left.join Follower.Body
		Follower.Right.join Follower.Body
		Follower.face Follower.Facing.copy
		show_follower !Waiting
		say "Now " + the_one(lead_kind) + " leads: following you, and first into a battle."
	}

	// ==== 128.1  Who's out, at this hour  (changed in 132, 133) ==========

	// "shut baker": the baker's here by day, while her shop's shut (once
	// it's open, she's in it); "shop 5,3 baker down": in her shop, by
	// day, once it's open; at night, both have gone home
	void add_if_out const str &Line {
		list str Words = Line.split " "
		if Words[0] == "clerk" && office_open {
			add_person "person " + Words[1] + " clerk " + Words[2]   // (133)
		} else if Words[0] == "person" && out_now(Words[2]) {
			add_person Line
		} else if Words[0] == "folk" {
			add_person "person " + Line[5 to Line.length - 1]   // (132)
		} else if Words[0] == "shop" && shop_open {
			add_person "person " + Line[5 to Line.length - 1]
		}
	}

	bool out_now const str &Who const {
		if Things.contains "shut " + Who {
			return !shop_open && !dark_now
		}
		return true
	}

	// the baker's spoon back, and the sun up
	bool shop_open const {
		return Story.Quest == "done" && !dark_now
	}

	bool dark_now const {
		return daylight < 0.5
	}

	// "unlit": a room with no lamps, where nothing's found at night (not
	// "dark", which is a cave, 109.5)
	bool too_dark const {
		return Things.contains("unlit") && dark_now
	}

	// ==== 128.2  Keeping hours ===========================================

	// those who keep hours go, and those out now come back (each where
	// they start: the baker doesn't walk about); and in the dark, what
	// there is to find can't be seen
	void keep_hours {
		HoursDue = false
		int I = 0
		while I < People.length {
			if keeps_hours People[I].Who {
				People[I].Body.remove
				People.remove_at I
			} else {
				I++
			}
		}
		for J in Things.length {
			list str Words = Things[J].split " "
			if Words.length > 2 && keeps_hours(Words[2]) {
				add_if_out Things[J].copy
			}
		}
		for J in Things.length {
			if Things[J].starts_with "item " {
				for Thing in shapes_in "item " + Things[J].split(" ")[1] {
					Thing.remove
				}
				add_item Things[J].copy
			}
		}
		light_by_day
		println "the town keeps its hours:", time_of_day
	}

	// a dark room, by day: the light through its windows (none at night)
	void light_by_day {
		for Lamp in Daylight {
			Lamp.remove
		}
		Daylight.clear
		if Things.contains("unlit") && !dark_now {
			double X = (Map[0].length - 1) / 2.0
			double Z = (Map.length - 1) / 2.0
			world.lamp Light = add_lamp X, 3, Z, "white", 16
			Daylight.add Light
		}
	}

	// someone with a "shut" line, or a "shop" line, here
	bool keeps_hours const str &Who const {
		for Line in Things {
			list str Words = Line.split " "
			if Line == "shut " + Who || (Words[0] == "shop" && Words[2] == Who) {
				return true
			}
		}
		return false
	}

	// ==== 128.3  A bed ===================================================

	// at night, sleep until morning (a new day, and everyone rested); by
	// day, rest until dark
	void ask_to_sleep {
		if dark_now {
			ask "bed", "Sleep until morning?", {"Sleep", "Not yet"}
		} else {
			ask "bed", "Rest until it's dark?", {"Rest", "Not yet"}
		}
	}

	void sleep {
		if dark_now {
			if Story.Time > 0.5 {
				Story.Days++            // (through midnight)
			}
			Story.Time = 0.3
			heal_all
			say "You sleep well, and wake with the sun. A new day! Your Cabbymon are rested, too."
		} else {
			Story.Time = 0.76
			say "You rest a while... and it's dark when you wake."
		}
		println "slept until", time_of_day
	}

	// ==== 128.4  The day, and the time ===================================

	str time_of_day const {
		if Story.Time < 0.25 || Story.Time >= 0.75 {
			return "night"
		} else if Story.Time < 0.5 {
			return "morning"
		} else if Story.Time < 0.65 {
			return "afternoon"
		}
		return "evening"
	}

	str day_and_time const {
		int Day = Story.Days + 1
		return "Day " + Day.text + ", " + time_of_day + "."
	}

	// ==== 128.5  Fresh bread =============================================

	// once a day, in her shop: some for the hero, and some for their
	// Cabbymon, which makes them all well again
	void bread_of_the_day {
		if Story.Answers.contains("bread day") && Story.Answers["bread day"] == Story.Days.text {
			say "That's all the bread for today, " + hero_name + ". Come back tomorrow: there's always more."
			return
		}
		Story.Answers["bread day"] = Story.Days.text
		heal_all
		effect "pick-up"
		say "Welcome to the bakery, " + hero_name + "! The bread's just out of the oven: some for you, and some for your Cabbymon. (They're all well again.)"
		println "bread, on day", Story.Days + 1
	}

	// ==== 129.1  Who can switch in ======================================

	// any of the party, but the one out, who can still battle
	bool can_switch const {
		return others_able.length > 0
	}

	list int others_able const {
		list int Able
		for I in Story.Party.length + 1 {
			if (int)I != Current && critter_of((int)I).Health > 0 {
				Able.add (int)I
			}
		}
		return Able
	}

	// ==== 129.2  Switching  (changed in 131) =============================

	// which: each by name, with its health; or back to the battle's
	// choices
	void ask_switch {
		Others = others_able
		list str Choices
		for I in Others {
			critter One = critter_of I
			Choices.add One.Name + " " + One.Health.text + "/" + One.Most.text
		}
		Choices.add "Back"
		ask "switch", "Who will go out?", Choices
	}

	// the one out comes back (its wounds kept), the other goes out, and
	// that's the turn: the other one has its go
	void switch_to const str &Answer {
		if Answer == "Back" {
			turn_over
			return
		}
		int Next = Others[Choice]
		keep_wounds
		beat "Come back, " + Ours.Name + "!", 8, 0
		Current = Next
		battled Next
		beat "Go, " + critter_of(Next).Name + "!", 7, 0
		FoeAfter = true                 // (131) once it's out, not before
	}

	// kept, once each, as having battled
	void battled int I {
		if !Battled.contains(I) {
			Battled.add I
		}
	}

	// ==== 129.3  Sharing it out ==========================================

	// the experience in equal shares (at least one point each) among all
	// who battled and can still battle (the one out, at least)
	void share_out int Points {
		keep_wounds
		list int Sharing
		for I in Battled {
			if I == Current || critter_of(I).Health > 0 {
				Sharing.add I
			}
		}
		int Each = Points / (int)Sharing.length
		if Each < 1 {
			Each = 1
		}
		for I in Sharing {
			gain_for I, Each
		}
	}

	// experience for one of the party: Ember's own, or one caught's; ten
	// times its level, and it grows
	void gain_for int I, int Points {
		if I > 0 {
			int Was = Current
			Current = I
			member_gains Points         // (127) (by Current)
			Current = Was
			return
		}
		Story.EmberExperience += Points
		beat "Ember gained " + Points.text + " experience!", 0, 0
		if Story.EmberExperience >= ember_level * 10 {
			Story.EmberExperience -= ember_level * 10
			Story.EmberLevel = ember_level + 1
			beat "Ember grew to level " + Story.EmberLevel.text + "!", 0, 0
		}
	}

	// ==== 130.4  Who lives here ==========================================

	// "wild border collie 2": a border collie, its chance 2 (against the
	// others' chances added up); with no "wild" lines (the hills), a
	// field mouse, or one time in three a crow, as before
	str met_here const {
		list str Kinds
		list int Chances
		int All = 0
		for Line in Things {
			list str Words = Line.split " "
			if Words[0] == "wild" && Words.length > 2 {
				int Last = (int)Words.length - 1
				Kinds.add Words[1 to Last - 1].join(" ")
				Chances.add Words[Last].to_int
				All += Words[Last].to_int
			}
		}
		if All == 0 {
			if random(1, 3) == 1 {
				return "hill crow"
			}
			return "field mouse"
		}
		int Roll = random 1, All
		for I in Kinds.length {
			Roll -= Chances[I]
			if Roll <= 0 {
				return Kinds[I].copy
			}
		}
		return Kinds[0].copy
	}

	// ==== 130.5  Tall grass, grown =======================================

	// "3d grass 9,8 18,12": on the area's map, every tile of grass (.)
	// from 9,8 to 18,12 is tall grass (w); in the 3D quest only, as the
	// map is read, so the 2D quest's meadow stays as it was
	void grow_grass const str &Area {
		list str From
		list str To
		for Line in Maps[Area] {
			if Line.starts_with "3d grass " {
				list str Words = Line.split " "
				From.add Words[2].copy
				To.add Words[3].copy
			}
		}
		for K in From.length {
			int Left = From[K].split(",")[0].to_int
			int Top = From[K].split(",")[1].to_int
			int Right = To[K].split(",")[0].to_int
			int Bottom = To[K].split(",")[1].to_int
			int Row = 0
			for I in Maps[Area].length {
				str Line = Maps[Area][I].copy
				if Line == "---" {
					break
				} else if Line.starts_with("//") || Line.trim == "" {
					continue
				}
				if Row >= Top && Row <= Bottom {
					for C in Line.length {
						if (int)C >= Left && (int)C <= Right && Line[C] == '.' {
							Line[C] = 'w'
						}
					}
					Maps[Area][I] = Line
				}
				Row++
			}
		}
	}

	// ==== 131.2  Thrown ==================================================

	// a red ball, with a white band, in the hero's hand (a little to
	// their right, at shoulder height); and off it goes
	void throw_the_ball {
		double A = angle_of(Hero.Facing) * PI / 180
		BallFromX = Hero.Body.x + 0.3 * cos(A)
		BallFromY = Hero.Ground + 1.1
		BallFromZ = Hero.Body.z - 0.3 * sin(A)
		world.shape Ball = add_ball 0.1, "#d62828", BallFromX, BallFromY, BallFromZ
		world.shape Band = add_cylinder 0.102, 0.03, "white", BallFromX, BallFromY, BallFromZ
		Band.join Ball
		Thrown.add Ball
		effect "menu-choose"
		ball_starts THROWN
	}

	void ball_starts int What {
		BallDoing = What
		BallFrame = 0
	}

	// ==== 131.3  Each frame of it =======================================

	// thrown: along an arc, to the wild one's middle, spinning; there, it
	// shrinks into it; and the ball falls to the ground. Wobbling: it
	// rocks, left, right, and still. Opening: it's gone, and the wild one
	// grows back
	void move_ball {
		if BallDoing == 0 {
			return
		}
		BallFrame++
		double ToY = Foe.Ground + Foe.Top / 2
		if BallDoing == THROWN && BallFrame <= THROW_FRAMES {
			double T = BallFrame / (double)THROW_FRAMES
			double X = BallFromX + (Foe.X - BallFromX) * T
			double Y = BallFromY + (ToY - BallFromY) * T + 1.2 * sin(T * PI)
			double Z = BallFromZ + (Foe.Z - BallFromZ) * T
			Thrown[0].move_to X, Y, Z
			Thrown[0].set_roll 720 * T
			if BallFrame == THROW_FRAMES {
				effect "boom"
			}
		} else if BallDoing == THROWN && BallFrame <= THROW_FRAMES + SHRINK_FRAMES {
			double Left = 1 - (BallFrame - THROW_FRAMES) / (double)SHRINK_FRAMES
			shrink_foe Left
		} else if BallDoing == THROWN {
			double T = (BallFrame - THROW_FRAMES - SHRINK_FRAMES) / (double)FALL_FRAMES
			Thrown[0].move_to Foe.X, ToY + (Foe.Ground + 0.1 - ToY) * T * T, Foe.Z
			Thrown[0].set_roll 0
			if BallFrame == THROW_FRAMES + SHRINK_FRAMES + FALL_FRAMES {
				BallDoing = 0
			}
		} else if BallDoing == WOBBLING {
			double T = BallFrame / (double)WOBBLE_FRAMES
			Thrown[0].set_roll 25 * sin(T * 2 * PI) * (1 - T)
			if BallFrame == 1 {
				effect "menu-move"
			}
			if BallFrame == WOBBLE_FRAMES {
				BallDoing = 0
			}
		} else if BallDoing == OPENING {
			if BallFrame == 1 {
				effect "boom"
				Thrown[0].remove
				Thrown.clear
				Foe.show true
			}
			shrink_foe BallFrame / (double)SHRINK_FRAMES
			if BallFrame == SHRINK_FRAMES {
				BallDoing = 0
			}
		}
	}

	// the wild one, Size of itself (0 to 1): hidden when there's nothing
	// left of it
	void shrink_foe double Size {
		for Part in Foe.Parts {
			Part.set_scale Size
		}
		Foe.show Size > 0.01
	}

	// ==== 132.3  A person's model  (changed in 136) ======================

	// by their name ("": a person made of shapes, as the hero is)
	str person_model const str &Who const {
		if Who == "baker" {
			return BAKER_MODEL.copy
		} else if Who == "farmer" {
			return FARMER_MODEL.copy
		} else if Who == "traveller" {
			return TRAVELLER_MODEL.copy
		} else if Who == "innkeeper" {
			return INNKEEPER_MODEL.copy     // (136)
		} else if Who == "forester" {
			return FORESTER_MODEL.copy
		}
		return ""
	}

	// ==== 132.4  What they say  (changed in 136) =========================

	// "says farmer Morning!": the farmer's lines, in the area's file, one
	// after another each time they're talked to, and round again
	void talk_to_folk const str &Who {
		if Things.contains "heals " + Who {
			heal_all                    // (136) "heals innkeeper": they make every Cabbymon well
			effect "pick-up"
		}
		list str Lines
		for Line in Things {
			if Line.starts_with "says " + Who + " " {
				Lines.add Line[Who.length + 6 to Line.length - 1]
			}
		}
		if Lines.length == 0 {
			say "Hello!"
			return
		}
		int Said = 0
		if Chats.contains Who {
			Said = Chats[Who]
		}
		Chats[Who] = Said + 1
		say Lines[Said % (int)Lines.length].copy
	}

	// ==== 133.2  Denarii ==================================================

	// for a battle won: a wild one's a little, found in the grass (two for
	// each of its levels); Rufus pays more
	void earn {
		int Got = Foe.Level * 2
		str Said = "You found " + Got.text + " denarii in the grass!"
		if Owner != "" {
			Got = PRIZE
			Said = Owner + " pays you " + Got.text + " denarii."
		}
		Story.Denarii += Got
		beat Said, 0, 0
	}

	// ==== 133.3  The ticket office ======================================

	// open once the hero's been the long way round, and battled Rufus at
	// the coast
	bool office_open const {
		return Story.Answers.contains "rematch"
	}

	// a ticket, if there's money for one; the clerk says what it does
	void talk_to_clerk {
		if Story.Items.contains "ticket" {
			say "Your ticket's good for as long as you like. Show it at the platform while a train's in."
		} else if Story.Denarii >= FARE {
			ask "ticket", "A ticket for the train east, to the coast and back, as often as you like: " + FARE.text + " denarii. You have " + Story.Denarii.text + ".", {"Buy one", "Not now"}
		} else {
			say "A ticket to the coast is " + FARE.text + " denarii. You have " + Story.Denarii.text + ": win a few more battles, and come back."
		}
	}

	void buy_ticket {
		Story.Denarii -= FARE
		Story.Items.add "ticket"
		effect "pick-up"
		say "Here you are: one ticket. Show it at the platform while a train's in."
		println "bought a ticket"
	}

	// ==== 133.4  Aboard ==================================================

	// the ticket shown: the hero (and whoever follows) out of sight, on
	// the train, until it's pulled out
	void board {
		Riding = true
		Hero.Body.set_visible false
		show_follower false
		say "You show your ticket, and step aboard."
		println "aboard the train"
	}

	// each frame, aboard: once the train's gone from the station, the
	// fade, to where the station's "ride" line says: "ride coast 2,5"
	void ride_on {
		if Area == "station" && timetable < TRAIN_FRAMES + TRAIN_WAITS + TRAIN_FRAMES {
			return
		}
		Riding = false
		list str To = line_in(Area, "ride").split " "
		NextArea = To[0].copy
		NextCol = To[1].split(",")[0].to_int
		NextRow = To[1].split(",")[1].to_int
		Hero.Facing = "down"
		Mode = FADING_OUT
		FadeFrame = 0
		println "the train carries you east"
	}

	// ==== 133.5  The halt ================================================

	// "halt 1,4 station 4,7": the halt's sign, and where a train back goes;
	// with a ticket, a wave brings one
	void at_the_halt int C, int R {
		if Story.Items.contains "ticket" {
			ask "halt", "Coast Halt. Wave, and a train stops for you: back to Cabby Town?", {"All aboard!", "Not now"}
		} else {
			say "Coast Halt. Trains to Cabby Town, for those with a ticket."
		}
	}

	// the train back: a fade, and the station's platform
	void ride_back {
		list str To = thing_at("halt", Hero.Col + across_of(Hero.Facing), Hero.Row + down_of(Hero.Facing)).split " "
		NextArea = To[0].copy
		NextCol = To[1].split(",")[0].to_int
		NextRow = To[1].split(",")[1].to_int
		effect "whistle"
		Mode = FADING_OUT
		FadeFrame = 0
		println "the train carries you west"
	}

	// ==== 133.6  Tiles laid  (changed in 135, 137) =======================

	// "3d tiles 1,5 ppp": the tiles from 1,5 rightwards are those, in the
	// 3D quest only, as its map is read (a platform on the coast, for the
	// halt, that the 2D quest's coast hasn't)
	void lay_tiles const str &Area {
		list str Lines
		for Line in Maps[Area] {
			if Line.starts_with("3d tiles ") || Line.starts_with("3d lay ") || Line.starts_with("3d build ") || Line.starts_with("3d plant ") {   // ((135) "lay": that part's own; (137) "build" and "plant": this one's)
				Lines.add Line.copy
			}
		}
		for Line in Lines {
			list str Words = Line.split " "
			int Left = Words[2].split(",")[0].to_int
			int Top = Words[2].split(",")[1].to_int
			int Row = 0
			for I in Maps[Area].length {
				str Text = Maps[Area][I].copy
				if Text == "---" {
					break
				} else if Text.starts_with("//") || Text.trim == "" {
					continue
				}
				if Row == Top {
					for K in Words[3].length {
						Text[Left + (int)K] = Words[3][K]
					}
					Maps[Area][I] = Text
				}
				Row++
			}
		}
	}

	// ==== 134.2  Plain text ==============================================

	// a Markdown table's cell as words: its links' words ("[Crow](https://
	// ...)" is "Crow"), with no backquotes, and "\|" a bar again; and no
	// spaces at its ends
	str plain const str &Cell const {
		str Out
		int I = 0
		while I < Cell.length {
			char C = Cell[I]
			if C == '[' {
				I++                     // (a link's words: kept)
			} else if C == ']' && I + 1 < Cell.length && Cell[I + 1] == '(' {
				while I < Cell.length && Cell[I] != ')' {
					I++                 // (and where it goes: not)
				}
				I++
			} else if C == '`' {
				I++
			} else if C == '\\' {
				I++                     // ("\|": the bar, as itself)
			} else {
				Out += C
				I++
			}
		}
		return Out.trim
	}

	// ==== 134.3  Whose they are ==========================================

	// the credits, a line each: who made the game; then each model in
	// models/CREDITS.md, a row of its table each, "| `crow.glb` (the hill
	// crow) | [Crow](...) | [TheNorthernHarpy](...) | ... |": what it is
	// in the game, its name, and whose it is
	list str credit_lines {
		list str Lines = {"Cabby Quest", "", "Made with Cabby", "by Thomas Paul Whalan", "", "Its models are from Sketchfab,", "shared under CC BY 4.0:", ""}
		for Row in files.lines CREDITS {
			if Row.starts_with "| `" {
				list str Cells = Row.split " | "
				Lines.add what_it_is(Cells[0]) + ": " + plain(Cells[1])
				Lines.add "by " + plain(Cells[2])
				Lines.add ""
			}
		}
		Lines.add "Its music and sounds were made by Cabby too."
		Lines.add ""
		Lines.add "Thank you for playing!"
		return Lines
	}

	// "| `crow.glb` (the hill crow)": "The hill crow"; "| `cow.glb`": "The cow"
	str what_it_is const str &Cell const {
		str Inside = Cell[2 to Cell.length - 1]   // (after its "| ")
		str Name = plain Inside
		if Name.contains "(" {
			Name = Name[Name.find("(") + 1 to Name.length - 2]
		} else {
			Name = "the " + Name[0 to Name.find(".") - 1]
		}
		return Name[0 to 0].upper + Name[1 to Name.length - 1]
	}

	// ==== 134.4  Rolling up ==============================================

	// over the town, the title gone: from below the window, up
	void roll_credits {
		list str Lines = credit_lines
		for Line in Lines {
			println "credits:", Line
		}
		str All = Lines.join "\n"
		Credits.set_text All
		CreditsShade.set_text All
		Title.set_text ""
		TitleShade.set_text ""
		RollY = 600
		place_credits
		Rolling = true
	}

	// each frame, a little higher, until the last line's gone off the top,
	// or Space (or Escape) is pressed: the title again
	void roll_on {
		RollY -= ROLL_SPEED
		place_credits
		double Tall = 24.0 * credit_lines_count
		if RollY < 0 - Tall || key_press("space") || key_press("escape") {
			Rolling = false
			Credits.set_text ""
			CreditsShade.set_text ""
			Title.set_text "Cabby Quest"
			TitleShade.set_text "Cabby Quest"
			println "the credits end"
			title_menu
		}
	}

	void place_credits {
		CreditsShade.move_to 62, RollY + 2
		Credits.move_to 60, RollY
	}

	// how many lines they are, as shown
	int credit_lines_count const {
		return (int)Credits.text.split("\n").length
	}

	// ==== 135.2  A fire ==================================================

	// burning (its model's own flames, moving), and its light: orange
	void add_fire double X, double Y, double Z {
		world.shape Fire = add_model FIRE_MODEL, X, Y, Z
		Fire.play "burn"
		world.lamp Glow = add_lamp X, Y + 0.3, Z, "#ff9a3c", 3.5
		Fires.add Glow
	}

	// a ring of stones, logs across, and the fire on them
	void add_campfire double X, double Z {
		add_plane 1, 1, "#7a6a55", X, 0.004, Z
		for I in 8 {
			double A = I * 45 * PI / 180
			add_ball 0.09, "#8a8a8a", X + 0.32 * cos(A), 0.05, Z + 0.32 * sin(A)
		}
		world.shape Log = add_cylinder 0.05, 0.5, "#6b4f36", X, 0.06, Z
		Log.set_roll 90
		world.shape Other = add_cylinder 0.05, 0.5, "#5a4230", X, 0.1, Z
		Other.set_tilt 90
		add_fire X, 0.08, Z
	}

	// each frame, a fire's light a little brighter or dimmer, and further
	// or not so far: firelight
	void flicker {
		for Glow in Fires {
			double Wave = sin(frame / 5.0) * 0.3 + sin(frame / 2.3) * 0.15
			Glow.set_reach 3.5 + Wave
		}
	}

	// ==== 135.3  The table ===============================================

	// a table's tiles, along a row: its model's middle is halfway along
	double table_reach double X, double Z const {
		int Long = 1
		while tile_at((int)X + Long, (int)Z) == 'b' {
			Long++
		}
		return (Long - 1) / 2.0
	}

	// ==== 137.2  Built, and planted ======================================

	// a barn (N) or a store (G): one model over its block of tiles, added
	// at its top left tile, its middle the block's; an oak (k) or a
	// cypress (y): a tree, on its tile, swaying with the others
	void add_built char Tile, double X, double Z {
		if Tile == 'k' || Tile == 'y' {
			str Model = OAK_MODEL.copy
			if Tile == 'y' {
				Model = CYPRESS_MODEL.copy
			}
			world.shape Tree = add_model Model, X, 0, Z
			Tree.set_group "trees"
			return
		}
		if tile_at((int)X - 1, (int)Z) == Tile || tile_at((int)X, (int)Z - 1) == Tile {
			return                      // (not its top left tile)
		}
		str Model = BARN_MODEL.copy
		if Tile == 'G' {
			Model = STORE_MODEL.copy
		}
		add_model Model, X + (block_wide(X, Z, Tile) - 1) / 2.0, 0, Z + (block_deep(X, Z, Tile) - 1) / 2.0
	}

	// how many tiles of it, from here: rightwards, and down
	int block_wide double X, double Z, char Tile const {
		int Count = 1
		while tile_at((int)X + Count, (int)Z) == Tile {
			Count++
		}
		return Count
	}

	int block_deep double X, double Z, char Tile const {
		int Count = 1
		while tile_at((int)X, (int)Z + Count) == Tile {
			Count++
		}
		return Count
	}

	// ==== 110.6  Who is there ============================================

	// the hero, or one of the people, is there (or stepping there)
	bool someone_at int C, int R const {
		return Hero.at(C, R) || person_at(C, R) >= 0
	}

	// which of the people is there (-1: nobody)
	int person_at int C, int R const {
		for I in People.length {
			if People[I].at C, R {
				return (int)I
			}
		}
		return -1
	}

	// someone standing on that tile, to be talked to: not someone part way
	// off it, nor on their way onto it
	int talker_at int C, int R const {
		int Who = person_at C, R
		if Who >= 0 && !People[Who].stepping && People[Who].Col == C && People[Who].Row == R {
			return Who
		}
		return -1
	}

	// ==== 108.22  Signs  (changed in 110, 114, 116, 121, 123, 127, 128, 133, 135, 137)

	// what a line after the map says about a tile: "sign 16,8 Cabby Town."
	// asked for ("sign", 16, 8) is "Cabby Town."; "" if there's none
	str thing_at const str &Kind, int C, int R const {
		str Start = Kind + " " + C.text + "," + R.text + " "
		for Line in Things {
			if Line.starts_with Start {
				return Line[Start.length to Line.length - 1]
			}
		}
		return ""
	}

	// Space: someone on the tile the hero faces, to talk to; (114) a thing
	// to pick up; or a sign
	void look_ahead {
		int C = Hero.Col + across_of(Hero.Facing)
		int R = Hero.Row + down_of(Hero.Facing)
		int Who = talker_at C, R
		str Sign = thing_at "sign", C, R
		if Who >= 0 {
			talk_to Who
		} else if follower_at C, R {
			say looked_at Follower.Who  // (121, 127)
		} else if tile_at(C, R) == 'r' {
			at_the_rails                // (123)
		} else if tile_at(C, R) == 'Q' {
			ask_to_sleep                // (128)
		} else if tile_at(C, R) == 'F' {
			say "The fire crackles, warm on your face."   // (135)
		} else if tile_at(C, R) == 'N' {
			say "The farm's barn. It smells of hay, and cows."   // (137)
		} else if too_dark && thing_at("item", C, R) != "" {
			say "It's too dark in here to find anything. Come back by day."
		} else if item_at(C, R) != "" {
			pick_up C, R
		} else if thing_at("halt", C, R) != "" {
			at_the_halt C, R            // (133)
		} else if office_open && thing_at("opened", C, R) != "" {
			say thing_at("opened", C, R)
		} else if Sign != "" {
			say Sign
		} else if water_at(C, R) && !Swimming {
			ask_the_water               // (116)
		}
	}

	// ==== 114.11  Picking up  (changed in 118, 119) ======================

	// carried now, remembered as taken, and out of the world
	void pick_up int C, int R {
		str Name = item_at C, R
		str Place = C.text + "," + R.text
		Story.Items.add Name.copy
		Story.Taken.add Area + " " + Place
		for Thing in shapes_in "item " + Place {
			Thing.remove
		}
		effect "pick-up"                // (119)
		say "You found " + description_of(Name) + "!"
	}

	str description_of const str &Name const {
		if Name == "spoon" {
			return "the baker's wooden spoon"
		} else if Name == "bread" {
			return "a loaf of fresh bread"
		} else if Name == "shell" {
			return "a shining shell"
		} else if Name == "crystal" {
			return "a crystal, glowing blue"
		}
		return "a " + Name
	}

	// ==== 110.7  Talking to someone  (changed in 113, 114, 128, 132, 133) ===

	// they turn to face the hero, and say what they say; (113) Rufus asks
	// for a battle; (114) the elder and the baker, each in their own way
	void talk_to int Who {
		People[Who].face opposite(Hero.Facing)
		if Sight.contains(People[Who].Who) && !Story.Noticed.contains(People[Who].Who) {
			Story.Noticed.add People[Who].Who.copy   // (128) talked to: no need to come over
		}
		if People[Who].Who == "elder" {
			talk_to_elder
		} else if People[Who].Who == "rival" && Area == "coast" {
			at_the_coast Who                // (120)
		} else if People[Who].Who == "rival" {
			say "Hey, " + hero_name + "! I'm Rufus. So you're the new one everyone's talking about? Let's see whose is stronger: your fox, or my Bruno!"
			Challenge = true
			BackedOff = false
			Leaver = Who
		} else if People[Who].Who == "clerk" {
			talk_to_clerk               // (133)
		} else if People[Who].Who == "baker" {
			talk_to_baker
		} else {
			talk_to_folk People[Who].Who.copy   // (132) what the areas' files say
		}
	}

	// ==== 114.12  The elder  (changed in 126, 127) =======================

	// he asks the hero's name, once; then he knows it, and sees to Ember
	void talk_to_elder {
		if Story.Answers.contains("elder name") && earned_balls {
			give_balls                  // (126)
		} else if Story.Answers.contains "elder name" {
			heal_all                    // (127) all of them
			say "Salve, " + hero_name + "! Let me see to your Cabbymon... There: all as good as new."
		} else {
			ask "elder name", "Salve, amice! I'm the elder of Cabby Town. What's your name?", {"Marcus", "Livia", "Tiro"}
		}
	}

	// what the hero told the elder they're called ("friend", until then)
	str hero_name const {
		if Story.Answers.contains "elder name" {
			return Story.Answers["elder name"].copy
		}
		return "friend"
	}

	// ==== 114.13  The baker  (changed in 128) ============================

	// what she says depends on how far the quest has got
	void talk_to_baker {
		if Story.Quest == "done" && Area == "bakery" {
			bread_of_the_day            // (128) in her shop
		} else if Story.Quest == "done" {
			say "Thank you again, " + hero_name + "! Come back for bread any time."
		} else if Story.Items.contains "spoon" {
			give_spoon
		} else if Story.Quest == "asked" {
			say "Have you found my spoon? It's in the bakery, the house up the path."
		} else {
			ask "baker spoon", "Oh dear, " + hero_name + ". I left my wooden spoon in the bakery. Could you fetch it?", {"Of course!", "Not now."}
		}
	}

	// ==== 114.14  Giving it back  (changed in 128) =======================

	// the spoon goes, the bread comes, and the quest is done (asked or not:
	// found before she asked, she's surprised)
	void give_spoon {
		str Thanks = "My spoon! Thank you, " + hero_name + "!"
		if Story.Quest == "" {
			Thanks = "My spoon! How did you know I'd lost it? Thank you, " + hero_name + "!"
		}
		Story.Items.remove_at (int)Story.Items.find("spoon")
		Story.Items.add "bread"
		Story.Quest = "done"
		say Thanks + " Here: a loaf of bread, still warm. And now I can open the bakery again: come by in the day, any day."   // (128)
	}

	// ==== 114.15  An answer  (changed in 115, 116, 122, 127, 128, 133) ===

	// kept in Story, by its question; and the one asking answers back
	void answered const str &Which, const str &Answer {
		if Which == "title" || Which == "menu" || Which == "options" || Which == "party" {   // ((127) the party's too)
			menu_chosen Which, Answer   // (115) a menu's, not someone's
			return
		} else if Which == "water" {
			if Answer == "Swim" {
				swim_in                 // (116)
			}
			return
		} else if Which == "ticket" || Which == "halt" {
			if Answer == "Buy one" {
				buy_ticket              // (133)
			} else if Answer == "All aboard!" {
				ride_back
			}
			return
		} else if Which == "bed" {
			if Answer != "Not yet" {
				sleep                   // (128)
			}
			return
		}
		Story.Answers[Which] = Answer.copy
		if Which == "elder name" && start_stage == "train" {
			say "Salve, " + Answer + "! A fine name. Come: your new home is just across the town. I'll show you."   // (122)
		} else if Which == "elder name" {
			say "Salve, " + Answer + "! A fine name. The baker looks worried: go and see her."
		} else if Answer == "Of course!" {
			Story.Quest = "asked"
			say "Thank you, " + hero_name + "! The bakery is the house up the path."
		} else {
			say "Oh. Maybe later, then."
		}
	}

	// words over the world, until Space; (113) wrapped
	void say const str &Said {
		show_words Said
		Mode = READING
		println "said:", Said
	}

	// ==== 113.25  Words, wrapped =========================================

	// over as many lines as they need, the last where one line would be
	void show_words const str &Said {
		list str Lines = lines_of Said
		double Top = 530 - 25 * (Lines.length - 1)
		Words.move_to 20, Top
		Shade.move_to 22, Top + 2
		Words.set_text Lines.join("\n")
		Shade.set_text Lines.join("\n")
	}

	// a word at a time, onto the line, or (too long) a new one
	list str lines_of const str &Said const {
		list str Lines = {""}
		for Word in Said.split " " {
			int Last = (int)Lines.length - 1
			if Lines[Last] == "" {
				Lines[Last] = Word.copy
			} else if Lines[Last].length + 1 + Word.length > WIDE {
				Lines.add Word.copy
			} else {
				Lines[Last] = Lines[Last] + " " + Word
			}
		}
		return Lines
	}
}

// ==== 108.23  Starting ===================================================

int main {
	quest Q
	Q.run
}



















