// ==== 132.2  Walking, and still ==========================================

// a model with a walk walks as it steps, and stands when it stops (play
// goes on with what's playing, so this can be said every frame); a
// function on its own, not the game's, so the game's list of people can
// lend it one of them
void walking walker &Someone {
	if !Someone.Body.animations.contains("walk") {
		return
	}
	if Someone.stepping {
		Someone.Body.play "walk"
	} else {
		Someone.Body.play "idle"
	}
}

