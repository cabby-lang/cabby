// Tutorial 14: References — borrowing
//
// Run it:      cabby 14-references.cby
// Topics:      T &name, const T &name, the borrowing rules
//
// Moving a value into a function every time you want to look at it would
// be tiresome. Instead you can BORROW it: a reference lets a function (or
// a local name) use a value that someone else still owns.
//
//   const T &name    a shared borrow: read only
//   T &name          a mutable borrow: may change the value
//
// The `&` goes in the declaration. At the call you just pass
// the variable; Cabby borrows it for you.

struct account {
	str Owner
	int Balance
}

void show const account &a {
	println a.Owner, "has", a.Balance
}

void deposit account &a, int Amount {
	a.Balance += Amount
}

// Numbers can be borrowed too, to change the caller's variable.
void swap int &x, int &y {
	int t = x
	x = y
	y = t
}

int main {
	account Acc = {"Ann", 100}
	show Acc                 // borrowed, not moved: Acc is still ours
	deposit Acc, 50          // a mutable borrow changes Acc itself
	show Acc

	int p = 1, q = 2
	swap p, q
	println "swapped:", p, q

	// A local reference is another name for the same variable.
	int Score = 10
	int &s = Score
	s += 5
	println "score:", Score

	const account &View = Acc
	println "view sees", View.Balance

	// The rules, checked before the program runs:
	//  1. While something is borrowed it can't be moved away.
	//  2. Any number of shared (const) borrows, OR one mutable borrow, at
	//     a time. A shared borrow also stops the owner changing the value.
	//  3. A borrow ends at its last use, not at the end of its block.
	//  4. References can't be returned, stored in fields or put in arrays,
	//     so a borrow can never outlive what it points to.
	//
	// Rule 3 in action: `View` was last used on the line above, so Acc can
	// be changed again now.
	deposit Acc, 1
	show Acc
}

// Try this:
//  - After `const account &View = Acc`, add `deposit Acc, 1` and THEN use
//    `View` again. Read the error: Acc can't change while View looks at it.
//  - Try to return a reference: `int &pick int &a { return a }`.

// ---------------------------------------------------------------- output
//> Ann has 100
//> Ann has 150
//> swapped: 2 1
//> score: 15
//> view sees 150
//> Ann has 151
