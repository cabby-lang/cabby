// Tutorial 15: Lists
//
// Run it:      cabby 15-lists.cby
// Keywords:    list
// Topics:      making a list, adding and removing, for X in L, searching,
//              copies and slices, split and join, who owns the elements
//
// An array's size is fixed when it is declared. A list grows and shrinks as
// the program runs. `list int Scores` is a list of ints; the element type
// comes straight after `list` and can be anything: str, objects, even
// other lists (`list list int Grid`).
//
//   L.add X           put X on the end
//   L.insert i, X     put X at position i, moving the rest along
//   L.remove_at i     take out the element at i, closing the gap
//   L.take_last       take out the last element and give it to you
//   L.clear           empty the list
//   L.length          how many elements it has
//   L[i]              read or change element i (every index is checked)
//   L.contains X      true if X is in the list
//   L.find X          where X first is, or -1
//   L.sort            put it in order, smallest first
//   L.reverse         turn it around, last first
//   L.copy            a second, independent list
//   L[a to b]         a new list of elements a to b (also L[a to], L[to b])
//   S.split Sep       a string cut into a list str at every Sep
//   L.join Sep        a list str put back together, with Sep between
//   println L         show it all: [90, 85, 77]
//
// A list owns its elements. Adding a string (or object, or list) moves it
// into the list; keep your own with .copy.

// Reading a list without taking it: borrow it with `const list int &`.
int total const list int &Values {
	int Sum = 0
	for v in Values {
		Sum += v
	}
	return Sum
}

// Changing someone else's list: borrow it with `list int &`.
void add_bonus list int &Values, int Bonus {
	for i in Values.length {
		Values[i] += Bonus
	}
}

int main {
	// Making one: empty, or with values in braces.
	list int Scores = {90, 85, 77}
	list str Names
	println Scores.length, Names.length, Scores[0]

	// Adding and removing.
	Scores.add 60
	Scores.insert 0, 100
	Scores.remove_at 2
	int Last = Scores.take_last
	println "scores:", Scores[0], Scores[1], Scores[2], "and", Last, "taken off the end"

	// Going through it: X is each element in turn, read-only.
	str Line
	for Score in Scores {
		Line += Score.text + " "
	}
	println Line.trim
	println "total:", total(Scores)

	// To change the elements, count through the positions instead.
	add_bonus Scores, 5
	println "with a bonus:", total(Scores)

	// Searching.
	println Scores.contains(105), Scores.find(82), Scores.find(1)

	// Printing the whole list, sorting it, and turning it around.
	println Scores
	Scores.sort
	println "sorted:", Scores
	Scores.reverse
	println "highest first:", Scores

	// Strings: adding moves them in, so keep your own with .copy.
	str First = "Ada"
	Names.add First.copy
	Names.add "Grace"
	Names.add "Alan"
	println First, "and", Names.length, "names"
	for Name in Names {
		println " ", Name, "has", Name.length, "letters"
	}

	// Copies and slices.
	list str Some = Names[1 to]
	list str Backup = Names.copy
	Backup[0] = "Edsger"
	println Some.join(" & "), "/", Names[0], Backup[0]

	// split and join.
	list str Words = "the quick brown fox".split " "
	println Words.length, "words:", Words.join("-")
	int Sum = 0
	for Part in "4,8,15".split "," {
		Sum += Part.to_int
	}
	println "sum:", Sum

	// Lists inside lists.
	list list int Grid = {{1, 2}, {3}}
	Grid[1].add 4
	Grid.add {5, 6, 7}
	for Row in Grid {
		println Row.length, "in this row, adding up to", total(Row)
	}
}

// Try this:
//  - Read words with read_line until end_of_input, keep them in a list,
//    and print them backwards (with a counting loop, then with .reverse).
//  - Write `list str unique const list str &Words`, which gives each word
//    once (use .contains).
//  - Inside `for Score in Scores`, try `Scores.add 1`. Read the error.
//  - Read Scores[Scores.length] and read the panic.

// ---------------------------------------------------------------- output
//> 3 0 90
//> scores: 100 90 77 and 60 taken off the end
//> 100 90 77
//> total: 267
//> with a bonus: 282
//> true 2 -1
//> [105, 95, 82]
//> sorted: [82, 95, 105]
//> highest first: [105, 95, 82]
//> Ada and 3 names
//>   Ada has 3 letters
//>   Grace has 5 letters
//>   Alan has 4 letters
//> Grace & Alan / Ada Edsger
//> 4 words: the-quick-brown-fox
//> sum: 27
//> 2 in this row, adding up to 3
//> 2 in this row, adding up to 7
//> 3 in this row, adding up to 18
