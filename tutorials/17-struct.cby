// Tutorial 17: struct
//
// Run it:      cabby 17-struct.cby
// Keywords:    struct
//
// A struct groups values under one name. It is plain data: fields only,
// no methods (for those, see `object` in tutorial 22). Its memory layout
// is exactly C's, so it can be handed to C functions.

struct point {
	int x
	int y
}

struct rect {
	point Corner        // structs can contain structs
	int Width
	int Height
}

// Structs of plain values are copied, just like numbers.
point moved_by point p, int Dx, int Dy {
	p.x += Dx           // changes the copy, not the caller's point
	p.y += Dy
	return p
}

int area const rect &r {
	return r.Width * r.Height
}

int main {
	// Three ways to make one: positional, by field name, or all zero.
	point a = {3, 4}
	point b = {.y = 10, .x = 1}
	point Origin
	println a.x, a.y, b.x, b.y, Origin.x, Origin.y

	// Fields are read and written with a dot.
	a.x = 30
	println "a.x is now", a.x

	// Copy semantics: changing c doesn't affect a.
	point c = a
	c.y = 99
	println a.y, c.y

	point d = moved_by a, 1, 1
	println "a:", a.x, a.y, "d:", d.x, d.y

	// Nested initializers, and a struct value written in an expression.
	rect r = {{0, 0}, 20, 5}
	println "area:", area(r), "corner y:", r.Corner.y
	point e = moved_by point{5, 5}, -5, 0
	println e.x, e.y

	// The size is what C would give: two 4-byte ints.
	println sizeof(point), "bytes per point,", sizeof(rect), "per rect"

	// An array of structs.
	point Path[3] = {{0, 0}, {1, 2}, {3, 5}}
	int Far = 0
	for i in 3 {
		Far += Path[i].y
	}
	println "total climb:", Far
}

// A struct containing a str is no longer plain data: it moves instead of
// copying (tutorial 13), and its str is freed when the struct is dropped.
//
// Try this:
//  - Give point a third field `int z`. Which initializers still compile,
//    and what value does z get?
//  - Write `bool same point p, point q`.

// ---------------------------------------------------------------- output
//> 3 4 1 10 0 0
//> a.x is now 30
//> 4 99
//> a: 30 4 d: 31 5
//> area: 100 corner y: 0
//> 0 5
//> 8 bytes per point, 16 per rect
//> total climb: 7
