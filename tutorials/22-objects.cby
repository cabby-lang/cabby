// Tutorial 22: Objects and methods
//
// Run it:      cabby 22-objects.cby
// Keywords:    object, self, const (methods), static (methods)
//
// An object is a class: fields plus methods (functions that belong to it).
// Unlike a struct, an object can have methods, a destructor (tutorial 23)
// and parents (tutorials 24 and 25). Objects are always moved, never copied.

object counter {
	str Label
	int Count

	// A method. Inside it, the object's fields and other methods can be
	// used by their bare names: `Count` here means this counter's count.
	void bump {
		Count++
	}

	void add int n {
		Count += n
	}

	// A `const` method promises not to change the object. Cabby checks the
	// promise, and lets you call it through a const borrow.
	int value const {
		return Count
	}

	void report const {
		println Label, "=", value         // calling another method
	}

	// `self` is the object itself. You need it when a parameter has the
	// same name as a field...
	void set_label str Label {
		self.Label = Label                // the field, not the parameter
	}

	// ...or to pass the whole object on.
	void show_twice const {
		print_counter self
		print_counter self
	}

	// A `static` method has no object: it's called on the type's name.
	// Handy for "constructors" that build a ready-made object.
	static counter starting_at str Label, int n {
		return counter{.Label = Label, .Count = n}
	}
}

void print_counter const counter &c {
	println "[", c.Label, c.value, "]"
}

int main {
	// Made like a struct: by field name, positionally, or zeroed.
	counter Clicks = {.Label = "clicks"}
	Clicks.bump
	Clicks.bump
	Clicks.add 10
	Clicks.report

	counter Laps = counter.starting_at "laps", 5
	Laps.bump
	Laps.report

	Laps.set_label "circuits"
	Laps.show_twice

	// A method with no parameters is called by its name alone, even inside
	// an expression; value() with parentheses means the same.
	println "total:", Clicks.value + Laps.value

	// Calling a non-const method through a const borrow is an error:
	const counter &View = Clicks
	println View.value
	// View.bump            // error: bump may change the object
}

// Try this:
//  - Uncomment `View.bump` and read the error.
//  - Add a method `void reset` that sets Count back to 0. Should it be
//    const?

// ---------------------------------------------------------------- output
//> clicks = 12
//> laps = 6
//> [ circuits 6 ]
//> [ circuits 6 ]
//> total: 18
//> 12
