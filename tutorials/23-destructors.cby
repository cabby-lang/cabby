// Tutorial 23: Made and dropped
//
// Run it:      cabby 23-destructors.cby
// Topics:      name { }, ~name, when objects are made and dropped, the order,
//              and links: pointing at an object without owning it
//
// A destructor is a method named `~` plus the object's name. It runs
// automatically, exactly once, when the object is dropped (tutorial 13):
// at the end of its owner's block, when its variable is given a new value,
// or when the function it was moved into ends. You never call it yourself.
//
// Typical uses: closing a file, releasing a lock, logging. Here, a "room"
// that announces when it's left.
//
// The opposite, a part named just the object's name (`lamp { }` below),
// runs when an object is made: its parts first, then itself.
//
// A link (`link room Last`) points at an object without owning it, so it
// doesn't keep it: once the object is dropped, the link says so.

object room {
	str Name
	~room {
		println "  leaving", Name
	}
}

object house {
	str Address
	room Kitchen          // fields that are objects are dropped too,
	room Hall             // after the house's own destructor
	~house {
		println "  closing up", Address
	}
}

object lamp {
	bool On
	lamp {
		On = true                  // every lamp starts switched on
		println "  lamp made, on:", On
	}
	~lamp {
		println "  lamp dropped"
	}
}

object desk {
	lamp Light                     // made before the desk itself
	desk {
		println "  desk made"
	}
}

void visit str Where {
	room r = {.Name = Where}       // `Where` is moved into the room here,
	println "  in", r.Name         // so from now on we ask the room
	if r.Name == "attic" {
		println "  too dusty, going back"
		return                     // r is still dropped on the way out
	}
	println "  staying a while"
}

int main {
	println "1. end of a block drops in reverse order"
	if true {
		room a = {.Name = "first"}
		room b = {.Name = "second"}
		println "  both made"
	}

	println "2. early return still drops"
	visit "garden"
	visit "attic"

	println "3. a loop drops each turn's variable at the end of the turn"
	for i in 1 to 2 {
		room r = {.Name = "loop room"}
		println "  turn", i
	}

	println "4. an object's own destructor runs, then its fields are dropped"
	if true {
		house h = {.Address = "1 Main St", .Kitchen = {"kitchen"}, .Hall = {"hall"}}
		println "  house built"
	}

	println "5. a moved object is dropped by its new owner, only once"
	room Keep = {.Name = "kept"}
	room Other = Keep
	println "  moved"

	println "6. made: parts first, then the object"
	if true {
		desk d
		println "  desk in use"
	}

	println "7. a link points at a room without owning it"
	link room Last
	if true {
		room Porch = {"porch"}
		Last = Porch                   // a link to the porch; still Porch's
		println "  the last room was the", Last.Name
	}
	println "  is it still there?", Last.is_set

	println "end of main"
}

// Try this:
//  - Add `break` inside the loop in step 3. Is the room still dropped?
//  - Store a room in an array: `room rooms[2] = {room{"a"}, room{"b"}}`.
//    In what order are they dropped?
//  - In step 7, print `Last.Name` after the block instead. What does the
//    panic say?

