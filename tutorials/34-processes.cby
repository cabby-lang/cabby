// Tutorial 34: Processes
//
// Run it:      cabby 34-processes.cby
// Or compile:  cabby -c 34-processes.cby && ./34-processes
// Library:     use processes
// Topics:      starting a program, sending it lines, reading what it
//              prints, waiting, handlers for its lines and its end
//
// A `process` is another program, started by yours. You can send it lines,
// read the lines it prints, and wait for it to end. It belongs to its
// variable like any other value: when that is dropped, your program waits
// for the process, so none is ever left running by mistake.
//
// Commands are run by /bin/sh, so they are written as in a terminal.

use processes

// Sorts words with the system's own `sort`, by talking to it.
list str sorted const list str &Words {
	process Sorter
	Sorter.start "sort"
	for Word in Words {
		Sorter.send Word
	}
	Sorter.end_input                 // sort only starts once its input ends
	list str Result
	until Sorter.at_end {
		Result.add Sorter.read_line
	}
	return Result
}

// Watches a program, line by line, with two of its own methods as handlers.
object watcher {
	process Job
	int Count

	void run_command const str &Command {
		Job.on_line got_line
		Job.on_end finished
		Job.start Command
		Job.wait                     // the handlers are called meanwhile
	}

	void got_line {
		Count++
		println "line", Count, "says", Job.line
	}

	void finished {
		println "it ended, with exit status", Job.status
	}
}

int main {
	list str Fruit = {"pear", "apple", "fig", "banana"}
	println sorted Fruit

	watcher W
	W.run_command "echo first; echo second; exit 3"

	// A program that takes too long can be stopped.
	process Nap
	Nap.start "sleep 10"
	println "napping:", Nap.is_running
	Nap.stop
	println "napping:", Nap.is_running
}

// Try this:
//  - Run `ls` in your home directory with a watcher, and count its lines.
//  - Start `bc` (a calculator), send it "6 * 7", and read the answer.
//    Send "quit" when you're done, or end its input.

// ---------------------------------------------------------------- output
//> [apple, banana, fig, pear]
//> line 1 says first
//> line 2 says second
//> it ended, with exit status 3
//> napping: true
//> napping: false
