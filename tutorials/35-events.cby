// Tutorial 35: Timers and the event loop
//
// Run it:      cabby 35-events.cby
// Or compile:  cabby -c 35-events.cby && ./35-events
// Library:     use events
// Topics:      timer, every, after, stop, events.run, events.stop, one loop
//              for timers, processes and windows
//
// Handlers are called when something happens. `events.run` is where a
// program waits for those moments: it calls handlers as timers go off (and
// as processes print, chapter 34), and returns when nothing is left to wait
// for. A window's `run` waits in the same loop, so timers keep going while
// a window is open.

use events

// A kettle that warms up on a timer, and says when it boils.
object kettle {
	timer Heat
	int Degrees

	kettle {
		Degrees = 20
		Heat.on_tick warm_up
	}

	void switch_on {
		Heat.every time.milliseconds 100    // ten times a second
	}

	inner void warm_up {
		Degrees += 20
		println "  kettle at", Degrees, "degrees"
		if Degrees >= 100 {
			Heat.stop
			println "  boiled!"
		}
	}
}

// Toast that pops up once, after a while.
object toaster {
	timer Pop

	toaster {
		Pop.on_tick pop_up
	}

	void press {
		Pop.after time.milliseconds 250     // once
	}

	inner void pop_up {
		println "  toast is ready"
	}
}

// Rings until someone gets up: stops the whole loop.
object alarm {
	timer Ring
	int Rings

	alarm {
		Ring.on_tick ring
	}

	void set {
		Ring.every time.milliseconds 40
	}

	inner void ring {
		Rings++
		if Rings == 3 {
			println "  alarm rang 3 times: everyone's up"
			events.stop              // ends events.run now
		}
	}
}

int main {
	println "breakfast:"
	kettle K
	toaster T
	K.switch_on
	T.press
	events.run                       // both at once, until both are done
	println "breakfast is ready"

	println "morning:"
	alarm A
	A.set
	events.run
	println "the alarm is still set:", A.Ring.is_running
}

// Try this:
//  - Add a timer that prints "still waiting" every 70 ms, and stop it when
//    the kettle boils.
//  - Use `events.stop` in the toaster too. What happens to the kettle?

// ---------------------------------------------------------------- output
//> breakfast:
//>   kettle at 40 degrees
//>   kettle at 60 degrees
//>   toast is ready
//>   kettle at 80 degrees
//>   kettle at 100 degrees
//>   boiled!
//> breakfast is ready
//> morning:
//>   alarm rang 3 times: everyone's up
//> the alarm is still set: true
