// Tutorial 41: Downloading
//
// Run it:      cabby 41-downloads.cby
// Or compile:  cabby -c 41-downloads.cby && ./41-downloads
// Library:     use networks
// Topics:      networks.download, networks.download_to, networks.can_reach,
//              networks.status, with json.read
//
// `networks.download` fetches what's at an address on the internet. This
// tutorial uses `file://` addresses, which fetch files on this computer, so
// it works without the internet and gives the same output every time; put
// an `https://` address in instead and the program is the same.

use networks
use json
use files
use directories

// The address of a file in this folder, as a file:// URL.
str here str Name {
	return "file://" + directories.current + "/" + Name
}

int main {
	// Something to download: a little weather "service".
	files.write "forecast.json", "{\"city\": \"Hobart\", \"days\": [{\"day\": \"Friday\", \"high\": 17}, {\"day\": \"Saturday\", \"high\": 21}]}"

	// ---- download straight into JSON
	json Forecast = json.read networks.download here("forecast.json")
	println "Forecast for", Forecast["city"].str
	for Day in Forecast["days"] {
		println " ", Day["day"].str, Day["high"].long, "degrees"
	}

	// ---- check before downloading something that might not be there
	str Missing = here "yesterday.json"
	if networks.can_reach Missing {
		println networks.download Missing
	} else {
		println "No forecast for yesterday (status", networks.status(Missing), "means nothing answered)"
	}

	// ---- save a download as a file
	networks.download_to here("forecast.json"), "copy.json"
	println "Saved", files.size("copy.json"), "bytes"

	files.delete "forecast.json"
	files.delete "copy.json"
	return 0
}

// Try this:
//  - Download a page you know, and count how many times a word appears in
//    it (`.split`, or `.find` in a loop).
//  - Find a free weather service that answers in JSON, and print tomorrow's
//    forecast.

// ---------------------------------------------------------------- output
//> Forecast for Hobart
//>   Friday 17 degrees
//>   Saturday 21 degrees
//> No forecast for yesterday (status 0 means nothing answered)
//> Saved 92 bytes
