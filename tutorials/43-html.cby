// Tutorial 43: HTML
//
// Run it:      cabby 43-html.cby
// Or compile:  cabby -c 43-html.cby && ./43-html
// Library:     use html
// Topics:      html.read, find, find_all, CSS selectors, .text, .attribute,
//              building a page with html.element, .add, .add_text, .pretty
//
// A café's menu, as a web page: the program reads it and works things out
// from it, then makes a page of its own. A real page would come from
// networks.download; this one is written here, so the output is the same
// every time.

use html

str menu_page {
	str Page = "<html><head><title>Corner Café</title></head><body>"
	Page += "<h1>Today's menu</h1>"
	Page += "<ul id='drinks'>"
	Page += "<li class='item' data-price='3.50'>Tea</li>"
	Page += "<li class='item sold-out' data-price='4.20'>Hot chocolate</li>"
	Page += "<li class='item' data-price='4.50'>Flat white</li></ul>"
	Page += "<ul id='food'>"
	Page += "<li class='item' data-price='5.00'>Lemon cake</li>"
	Page += "<li class='item' data-price='9.50'>Toastie <em>(vegetarian)</em></li></ul>"
	Page += "<p>Open 7am &ndash; 3pm. <a href='https://example.com/cafe/map'>Find us</a></p>"
	Page += "</body></html>"
	return Page
}

int main {
	html Menu = html.read menu_page
	println Menu.find("title"), "-", Menu.find("h1")

	// ---- every item, with the price from its data-price attribute
	double Total = 0.0
	int Count = 0
	for Item in Menu.find_all "li.item" {
		double Price = Item.attribute("data-price").to_double
		println " ", Item.text, Price
		Total += Price
		Count++
	}
	println "Average price:", Total / Count

	// ---- selectors pick parts out: by id, class, and what's inside what
	println "Drinks:", Menu.find_all("#drinks > li").length
	println "Sold out:", Menu.find(".sold-out").text
	println "Vegetarian:", Menu.find("li em").parent.text
	println "Map:", Menu.find("a").attribute "href"
	element Breakfast = Menu.find "#breakfast"
	println "Breakfast menu?", !Breakfast.is_missing

	// ---- making a page of our own: what's still available
	element Available = html.element "ul"
	for Item in Menu.find_all "li.item" {
		if !Item.attribute("class").contains("sold-out") {
			element Line = html.element "li"
			Line.add_text Item.text + " - $" + Item.attribute("data-price")
			Available.add Line
		}
	}
	element Heading = html.element "h2"
	Heading.add_text "Food & drink still available"   // the & is written &amp; for you
	element Page = html.element "body"
	Page.add Heading
	Page.add Available
	println Page.pretty
	return 0
}

// Try this:
//  - Print the cheapest item on the menu, and how many
//    are sold out.
//  - Download a page you like, and print every link on it with its text.
//  - Make a page listing your music students (or anything you keep a list
//    of), and open it in a browser.

// ---------------------------------------------------------------- output
//> Corner Café - Today's menu
//>   Tea 3.5
//>   Hot chocolate 4.2
//>   Flat white 4.5
//>   Lemon cake 5.0
//>   Toastie (vegetarian) 9.5
//> Average price: 5.34
//> Drinks: 3
//> Sold out: Hot chocolate
//> Vegetarian: Toastie (vegetarian)
//> Map: https://example.com/cafe/map
//> Breakfast menu? false
//> <body>
//>   <h2>Food &amp; drink still available</h2>
//>   <ul>
//>     <li>Tea - $3.50</li>
//>     <li>Flat white - $4.50</li>
//>     <li>Lemon cake - $5.00</li>
//>     <li>Toastie (vegetarian) - $9.50</li>
//>   </ul>
//> </body>
