// Tutorial 46: Changing a file in place
//
// Run it:      cabby 46-save-game.cby
// Or compile:  cabby -c 46-save-game.cby && ./46-save-game
// Library:     use files (which brings bytes)
// Topics:      a file format of your own, files.open_to_change, .move_to,
//              .read_bytes, .write_bytes, .position, .size, .move_to_end,
//              .find
//
// A game keeps its players in a save file: a small header, then one slot
// of 32 bytes for each player. Because every slot is the same size, the
// program can go straight to any player's slot and change just those
// bytes, without reading and rewriting the whole file: what files much
// too big to read at once (databases, disk images) are made for.

use files

// The save file:
//
//   bytes 0-3   "CSAV": says what kind of file it is
//   bytes 4-5   the format's version (a short), so later versions can
//               still read old files
//   bytes 6-7   how many slots (a short)
//   then the slots, 32 bytes each:
//     0-15    the name, its letters, then 0 bytes to fill the 16
//     16-17   level (a short)
//     18-19   lives (a short)
//     20-23   score (an int)
//     24-31   how far along the map (a double)
//
// Every number is kept smallest byte first, as the plain bytes methods do.

const int HEADER = 8
const int SLOT = 32
const int NAME_SIZE = 16
const int SCORE_AT = 20       // where the score is, inside a slot

// one player's slot, as 32 bytes
bytes slot_bytes const str &Name, int Level, int Lives, int Score, double Along {
	bytes Slot = Name
	if Slot.length > NAME_SIZE {
		Slot = Slot.part 0, NAME_SIZE        // a name too long is cut short
	}
	while Slot.length < NAME_SIZE {
		Slot.add 0
	}
	Slot.add_short Level
	Slot.add_short Lives
	Slot.add_int Score
	Slot.add_double Along
	return Slot
}

// a slot's bytes, as a line to print
str describe const bytes &Slot {
	bytes Name = Slot.part 0, NAME_SIZE
	long End = Name.find bytes.filled(1, 0)  // where the 0 bytes start
	if End >= 0 {
		Name = Name.part 0, End
	}
	str Line = Name.str + ": level " + Slot.short_at(16).text + ", " + Slot.short_at(18).text + " lives, score "
	Line += Slot.int_at(SCORE_AT).text + ", " + Slot.double_at(24).text + " along"
	return Line
}

void show_players const str &Path {
	bytes All = files.read_bytes Path
	if !(All.starts_with "CSAV") {
		println Path, "isn't a save file"
		return
	}
	int Count = All.short_at 6
	println Path, "has", Count, "players and", All.length, "bytes (version", All.short_at(4).text + ")"
	for i in Count {
		println " ", describe(All.part(HEADER + i * SLOT, SLOT))
	}
}

int main {
	// ---- a new save file, written all at once
	bytes Save = "CSAV"
	Save.add_short 1          // version 1
	Save.add_short 3          // 3 slots
	Save.add_bytes slot_bytes("Ada", 4, 3, 1200, 0.75)
	Save.add_bytes slot_bytes("Grace", 2, 5, 640, 0.5)
	Save.add_bytes slot_bytes("Alan", 7, 1, 2950, 0.9)
	files.write_bytes "game.sav", Save
	show_players "game.sav"

	// ---- Grace scores 500 more: change only her score's 4 bytes
	file F = files.open_to_change "game.sav"
	long Where = HEADER + 1 * SLOT + SCORE_AT    // slot 1 (the second), then the score in it
	F.move_to Where
	bytes Old = F.read_bytes 4
	println "\nGrace's score is at byte", Where, "and its bytes are", Old, "=", Old.int_at(0)
	bytes New
	New.add_int Old.int_at(0) + 500
	F.move_to Where                              // reading moved past it: go back
	F.write_bytes New
	println "now", New, "=", New.int_at(0), "(the file is still", F.size, "bytes)"

	// ---- a new player: a slot on the end, and one more in the header
	F.move_to_end
	println "\nthe end is byte", F.position
	F.write_bytes slot_bytes("Katherine Johnson", 9, 2, 5100, 1.0)     // 17 letters: cut to 16
	F.move_to 6
	int Count = F.read_bytes(2).short_at 0
	bytes Header
	Header.add_short Count + 1
	F.move_to 6
	F.write_bytes Header
	println "added one: the file is", F.size, "bytes\n"

	show_players "game.sav"
	println "\nthe file, as a hex dump:"
	println files.read_bytes("game.sav").dump
	return 0
}

// Output:

// Try this:
//  - Give everyone an extra life: for each slot,
//    move to its lives, read the short, and write it back one bigger.
//  - Write a function `remove_player`, which moves the last slot into the
//    removed one's place, then makes the count one smaller. (The file stays
//    the same length, with the old last slot left on the end; write the
//    file again with `files.write_bytes` to make it shorter.)

// ---------------------------------------------------------------- output
//> game.sav has 3 players and 104 bytes (version 1)
//>   Ada: level 4, 3 lives, score 1200, 0.75 along
//>   Grace: level 2, 5 lives, score 640, 0.5 along
//>   Alan: level 7, 1 lives, score 2950, 0.9 along
//>
//> Grace's score is at byte 60 and its bytes are 80 02 00 00 = 640
//> now 74 04 00 00 = 1140 (the file is still 104 bytes)
//>
//> the end is byte 104
//> added one: the file is 136 bytes
//>
//> game.sav has 4 players and 136 bytes (version 1)
//>   Ada: level 4, 3 lives, score 1200, 0.75 along
//>   Grace: level 2, 5 lives, score 1140, 0.5 along
//>   Alan: level 7, 1 lives, score 2950, 0.9 along
//>   Katherine Johnso: level 9, 2 lives, score 5100, 1.0 along
//>
//> the file, as a hex dump:
//> 00000000  43 53 41 56 01 00 04 00  41 64 61 00 00 00 00 00  |CSAV....Ada.....|
//> 00000010  00 00 00 00 00 00 00 00  04 00 03 00 b0 04 00 00  |................|
//> 00000020  00 00 00 00 00 00 e8 3f  47 72 61 63 65 00 00 00  |.......?Grace...|
//> 00000030  00 00 00 00 00 00 00 00  02 00 05 00 74 04 00 00  |............t...|
//> 00000040  00 00 00 00 00 00 e0 3f  41 6c 61 6e 00 00 00 00  |.......?Alan....|
//> 00000050  00 00 00 00 00 00 00 00  07 00 01 00 86 0b 00 00  |................|
//> 00000060  cd cc cc cc cc cc ec 3f  4b 61 74 68 65 72 69 6e  |.......?Katherin|
//> 00000070  65 20 4a 6f 68 6e 73 6f  09 00 02 00 ec 13 00 00  |e Johnso........|
//> 00000080  00 00 00 00 00 00 f0 3f                           |.......?|
