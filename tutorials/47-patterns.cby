// Tutorial 47: Patterns — finding things in text
//
// Run it:      cabby 47-patterns.cby
// Or compile:  cabby -c 47-patterns.cby && ./47-patterns
// Library:     use patterns
// Topics:      patterns.make, matches, find, find_all, parts, replace_all,
//              split, ignoring case, letters in any alphabet
//
// A pattern describes what some text looks like: \d{2}:\d{2} is "two
// digits, a colon, two digits", which is a time. These are regular
// expressions ("regex"), as text editors and other languages have them.
//
// Here, a music teacher's notes for a week: dates, times, students' email
// addresses, all mixed in with the rest. Patterns find them, check them,
// take them apart and tidy them up.
//
// In a Cabby string, \\ is one \, so the pattern \d is written "\\d".

use patterns

str notes {
	str Notes = "2026-11-10 at 16:30: Ada, scales in G. Email ada.l@example.com.\n"
	Notes += "2026-11-12 at 17:00: Grace, the blues in A (guitar). grace@example.org\n"
	Notes += "2026-11-14 at 9:15: Alan, rhythm. Bring the GUITAR tuner!\n"
	return Notes
}

int main {
	str Notes = notes

	// ---- finding: every piece of the text like the pattern
	patterns.pattern Email = patterns.make "[\\w.]+@[\\w.]+\\.\\w+"
	println "emails:", Email.find_all(Notes)

	patterns.pattern Time = patterns.make "\\d{1,2}:\\d{2}"
	println "times:", Time.find_all(Notes)

	// ---- parts: what each ( ) matched
	patterns.pattern Date = patterns.make "(\\d{4})-(\\d{2})-(\\d{2})"
	list str First = Date.parts Notes
	println "the first lesson: day", First[2], "of month", First[1], "in", First[0]

	// ---- replacing: \1, \2 and \3 are the parts, in a new order
	str Australian = Date.replace_all Notes, "\\3/\\2/\\1"
	println Australian.split("\n")[0]

	// ---- checking: is the whole text like it? (a form, say)
	patterns.pattern Clock = patterns.make "([01]?\\d|2[0-3]):[0-5]\\d"
	list str Typed = {"9:15", "16:30", "24:00", "7:5", "noon"}
	for Each in Typed {
		println " ", Each, "is a time:", Clock.matches(Each)
	}

	// ---- big and small letters alike
	patterns.pattern Guitar = patterns.make_ignoring_case "guitar"
	println "guitar comes up", Guitar.find_all(Notes).length, "times"

	// ---- cutting text up: at commas, semicolons, or spaces, however many
	patterns.pattern Gaps = patterns.make "[,;\\s]+"
	println Gaps.split("scales, arpeggios;  chords  ;rhythm")

	// ---- any alphabet: \w is a letter in Greek too
	patterns.pattern Word = patterns.make "\\w+"
	list str Greek = Word.find_all "Χαῖρε, ὦ φίλε!"
	println Greek, Greek.length, "words"
}

// Try this:
//  - Find the students' names: a capital letter, then small ones, before a
//    comma ("[[:upper:]][[:lower:]]+,").
//  - Change every time to the 12-hour clock with replace_all and two
//    patterns: one for the morning, one for the afternoon.
//  - Read a file with files.read, and count the words in it.
//  - Make a pattern that can't be used ("(oops"), and read the panic.

// ---------------------------------------------------------------- output
//> emails: [ada.l@example.com, grace@example.org]
//> times: [16:30, 17:00, 9:15]
//> the first lesson: day 10 of month 11 in 2026
//> 10/11/2026 at 16:30: Ada, scales in G. Email ada.l@example.com.
//>   9:15 is a time: true
//>   16:30 is a time: true
//>   24:00 is a time: false
//>   7:5 is a time: false
//>   noon is a time: false
//> guitar comes up 2 times
//> [scales, arpeggios, chords, rhythm]
//> [Χαῖρε, ὦ, φίλε] 3 words
