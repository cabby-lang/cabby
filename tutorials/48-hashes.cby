// Tutorial 48: Hashes — fingerprints of text and files
//
// Run it:      cabby 48-hashes.cby
// Or compile:  cabby -c 48-hashes.cby && ./48-hashes
// Library:     use hashes (and use files, use directories)
// Topics:      hashes.sha256, sha256_of_file, md5; checking a download
//              against its sum; finding which files in a folder changed
//
// A hash is a fingerprint. The same text, or file, always gives the same
// one, and any change, even one letter, gives a quite different one. So
// two hashes say whether two things are the same, without comparing them
// byte by byte.
//
// Websites that offer big files show each one's SHA-256, to check a
// download against. And a program can keep the hashes of a folder's
// files, to tell later which have changed: that's what backup programs
// and git do. This tutorial does both, with files of its own.

use hashes
use files
use directories

// ---- every file in a folder, with its hash: {"name": "sha-256 ..."}

lookup str str fingerprints const str &Folder {
	lookup str str Sums
	for Name in directories.all_files Folder {
		Sums[Name] = hashes.sha256_of_file Folder + "/" + Name
	}
	return Sums
}

// ---- what's different between then and now

void compare const lookup str str &Then, const lookup str str &Now {
	for Name in Now.keys {
		if !Then.contains Name {
			println "  new:", Name
		} else if Then[Name] != Now[Name] {
			println "  changed:", Name
		}
	}
	for Name in Then.keys {
		if !Now.contains Name {
			println "  gone:", Name
		}
	}
}

int main {
	// ---- the same text, the same hash; one letter different, quite different
	println hashes.sha256("Salve!")
	println hashes.sha256("Salve?")
	println "md5, 32 digits:", hashes.md5("Salve!")

	// ---- checking a "download" against the sum its website shows
	files.write "song.txt", "E4 D4 C4:2 - E4 D4 C4:2\n"
	str Published = "6f0e8b8f0f3cdb5e5a4b8f03bb6e8e5d1f0c09c0b9a3c5c4ad4f2c1c3e7b9a10"
	str Mine = hashes.sha256_of_file "song.txt"
	if Mine == Published {
		println "song.txt arrived whole"
	} else {
		println "song.txt isn't what was published: download it again"
	}
	Published = Mine.copy            // (now pretend it was published right)
	println "and now it matches:", hashes.sha256_of_file("song.txt") == Published

	// ---- which files in a folder have changed
	directories.make "lessons"
	files.write "lessons/ada.txt", "scales in G\n"
	files.write "lessons/grace.txt", "the blues in A\n"
	files.write "lessons/alan.txt", "rhythm\n"
	lookup str str Monday = fingerprints "lessons"
	println Monday.length, "files fingerprinted"

	files.append "lessons/grace.txt", "and a solo\n"
	files.delete "lessons/alan.txt"
	files.write "lessons/linus.txt", "first lesson\n"
	println "since Monday:"
	compare Monday, fingerprints("lessons")

	// (tidying up)
	for Name in directories.all_files "lessons" {
		files.delete "lessons/" + Name
	}
	directories.remove "lessons"
	files.delete "song.txt"
}

// Try this:
//  - Find the SHA-256 of a real download (a Linux ISO's website shows it),
//    and check it with hashes.sha256_of_file.
//  - Save Monday's fingerprints in a file (one "name hash" a line), so a
//    program run on Tuesday can compare against them.
//  - Find files in a folder that are the same as each other: the same
//    hash, under different names.

// ---------------------------------------------------------------- output
//> 61ee6cad977244872566817a3499af9bd18548798437dd11ab239863bcaa705f
//> f5f55d612bea42dac1bc5bee1b903eff58f729564e39836eae07cf8187c57969
//> md5, 32 digits: ff940ba204d233c254bab9de1e0f0618
//> song.txt isn't what was published: download it again
//> and now it matches: true
//> 3 files fingerprinted
//> since Monday:
//>   changed: grace.txt
//>   new: linus.txt
//>   gone: alan.txt
