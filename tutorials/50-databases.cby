// Tutorial 50: Databases — a recipe book in SQLite
//
// Run it:      cabby 50-databases.cby
// Or compile:  cabby -c 50-databases.cby && ./50-databases
// Library:     use databases (and use files)
// Topics:      databases.open, run, run_with and ?s, rows, value, begin
//              and commit, last_id, changes; tables, joins and sums in SQL
//
// A database keeps records in tables, as a spreadsheet does, and answers
// questions about them: "what does each recipe cost?", "what do I need to
// buy?". It's one file, shop.db or recipes.db, with no server to run:
// SQLite, which Firefox, phones and much else keep their data in.
//
// What's asked of it is SQL, the language every database speaks: a few
// words go a long way, and they're in capitals here only to stand out.
// Values go in through ?s, never pasted into the SQL: "Grandma's scones",
// with its ', can't break anything.

use databases
use files

// ---- the tables: what's sold, the recipes, and what each one needs

void make_tables const databases.database &Book {
	Book.run "CREATE TABLE IF NOT EXISTS foods (id INTEGER PRIMARY KEY, name TEXT UNIQUE, price REAL, per TEXT)"
	Book.run "CREATE TABLE IF NOT EXISTS recipes (id INTEGER PRIMARY KEY, name TEXT)"
	Book.run "CREATE TABLE IF NOT EXISTS needs (recipe INTEGER, food INTEGER, amount REAL)"
}

// a food, at a price for an amount of it ("per kg"): its number
long add_food const databases.database &Book, const str &Name, const str &Price, const str &Per {
	Book.run_with "INSERT INTO foods (name, price, per) VALUES (?, ?, ?)", {Name.copy, Price.copy, Per.copy}
	return Book.last_id
}

// a recipe, and how much of each food it needs
void add_recipe const databases.database &Book, const str &Name, const list str &Needs {
	Book.run_with "INSERT INTO recipes (name) VALUES (?)", {Name.copy}
	str Recipe = Book.last_id.text
	for I in Needs.length / 2 {
		list str Which = {Needs[I * 2].copy}
		str Food = Book.value_with "SELECT id FROM foods WHERE name = ?", Which
		Book.run_with "INSERT INTO needs VALUES (?, ?, ?)", {Recipe.copy, Food, Needs[I * 2 + 1].copy}
	}
}

int main {
	if files.exists "recipes.db" {
		files.delete "recipes.db"          // (a fresh start)
	}
	databases.database Book = databases.open "recipes.db"
	make_tables Book

	// ---- putting records in: together, so it's all there or none of it
	Book.begin
	add_food Book, "flour", "1.80", "kg"
	add_food Book, "butter", "11.00", "kg"
	add_food Book, "milk", "1.60", "litre"
	add_food Book, "eggs", "0.70", "egg"
	add_food Book, "sugar", "2.20", "kg"
	add_recipe Book, "Pancakes", {"flour", "0.2", "milk", "0.5", "eggs", "2"}
	add_recipe Book, "Grandma's scones", {"flour", "0.45", "butter", "0.1", "milk", "0.25", "sugar", "0.05"}
	Book.commit
	println Book.value("SELECT count(*) FROM foods"), "foods,", Book.value("SELECT count(*) FROM recipes"), "recipes"

	// ---- a question: what each recipe costs (a join, and a sum)
	str Costs = "SELECT recipes.name AS recipe, round(sum(needs.amount * foods.price), 2) AS cost"
	Costs += " FROM recipes JOIN needs ON needs.recipe = recipes.id JOIN foods ON foods.id = needs.food"
	Costs += " GROUP BY recipes.id ORDER BY cost"
	for Row in Book.rows Costs {
		println " ", Row["recipe"] + ":", "$" + Row["cost"]
	}

	// ---- a shopping list, for one recipe
	str Shopping = "SELECT foods.name, needs.amount, foods.per FROM needs JOIN foods ON foods.id = needs.food"
	Shopping += " JOIN recipes ON recipes.id = needs.recipe WHERE recipes.name = ? ORDER BY foods.name"
	println "for Grandma's scones:"
	list str Which = {"Grandma's scones"}
	for Row in Book.rows_with Shopping, Which {
		println "  -", Row["amount"], Row["per"], "of", Row["name"]
	}

	// ---- changing records: butter's gone up
	Book.run_with "UPDATE foods SET price = price * ? WHERE name = ?", {"1.2", "butter"}
	println Book.changes, "price changed; the scones are now $" + Book.value_with("SELECT round(sum(needs.amount * foods.price), 2) FROM needs JOIN foods ON foods.id = needs.food JOIN recipes ON recipes.id = needs.recipe WHERE recipes.name = ?", {"Grandma's scones"})

	// ---- a mistake, undone: nothing between begin and rollback is kept
	Book.begin
	Book.run "DELETE FROM foods"
	Book.rollback
	println "after a rollback, still", Book.value("SELECT count(*) FROM foods"), "foods"

	files.delete "recipes.db"
}

// Try this:
//  - Keep the database: take out the files.delete lines, run it twice, and
//    see what CREATE TABLE IF NOT EXISTS and UNIQUE do the second time.
//  - Ask for every recipe that needs milk.
//  - Make a shopping list for two recipes at once, adding up what they
//    share (GROUP BY foods.name, and sum).
//  - Open recipes.db with the sqlite3 command, and look around:
//    .tables, then SELECT * FROM foods;

// ---------------------------------------------------------------- output
//> 5 foods, 2 recipes
//>   Grandma's scones: $2.42
//>   Pancakes: $2.56
//> for Grandma's scones:
//>   - 0.1 kg of butter
//>   - 0.45 kg of flour
//>   - 0.25 litre of milk
//>   - 0.05 kg of sugar
//> 1 price changed; the scones are now $2.64
//> after a rollback, still 5 foods
