// Tutorial 56: Menus and shortcuts — text tools
//
// Run it:      cabby 56-menus.cby
// Or compile:  cabby -c 56-menus.cby && ./56-menus
// Library:     use gui (or use tui: change gui to tui)
// Topics:      add_menu, add_item, add_separator, keyboard shortcuts,
//              add_shortcut, graying out an item with set_enabled
//
// A menu bar holds what a program can do without filling its window with
// buttons. Each item in a menu calls a handler, as a button does, and can
// have a keyboard shortcut ("Ctrl+U") that does the same from anywhere in
// the window; the menu shows it beside the item, so people learn them.
//
// This program changes the text in its box: upper or lower case, lines
// sorted or reversed. Undo puts back what was there before the last change,
// so it's grayed out (set_enabled false) until there's something to undo.

use gui

object text_tools : gui.window {
	gui.text_area Text
	gui.label Status
	gui.menu_item Undo
	str Before                          // what Undo puts back

	void build {
		set_title "Text tools"
		set_size 420, 260

		gui.menu File = add_menu "File"
		File.add_item "New", "Ctrl+N", new_text
		File.add_separator
		File.add_item "Quit", "Ctrl+Q", quit

		gui.menu Edit = add_menu "Edit"
		Undo = Edit.add_item "Undo", "Ctrl+Z", undo
		Edit.add_separator
		Edit.add_item "UPPER CASE", "Ctrl+U", upper_case
		Edit.add_item "lower case", "Ctrl+L", lower_case
		Edit.add_separator
		Edit.add_item "Sort lines", "", sort_lines
		Edit.add_item "Reverse lines", "", reverse_lines

		gui.menu Help = add_menu "Help"
		Help.add_item "About", "F1", about

		add_shortcut "F5", count_words      // a shortcut with no menu item

		Text = add_text_area
		Status = add_label "Edit, then try the menus."
		Undo.set_enabled false
	}

	// Every change goes through here, so Undo always has the text before it.
	void change_to const str &New {
		Before = Text.text
		Text.set_text New
		Undo.set_enabled true
		println Text.text.replace("\n", " / ")
	}

	void new_text {
		change_to ""
	}

	void undo {
		Text.set_text Before
		Undo.set_enabled false              // one step back is all it keeps
		println "undone:", Text.text.replace("\n", " / ")
	}

	void upper_case {
		change_to Text.text.upper
	}

	void lower_case {
		change_to Text.text.lower
	}

	void sort_lines {
		list str Lines = Text.text.split "\n"
		Lines.sort
		change_to Lines.join("\n")
	}

	void reverse_lines {
		list str Lines = Text.text.split "\n"
		list str Back
		while Lines.length > 0 {
			Back.add Lines.take_last        // the last line, taken off the end
		}
		change_to Back.join("\n")
	}

	void count_words {
		long Words = 0
		for Line in Text.text.split "\n" {
			for Word in Line.split " " {
				if Word.length > 0 {
					Words++
				}
			}
		}
		Status.set_text Words.text + " words"
		println Status.text
	}

	void about {
		show_message "Text tools: a Cabby tutorial"
		println "about"
	}

	void quit {
		close
	}
}

int main {
	text_tools t
	t.run
}

// (Cabby's tests run it in a virtual display, using its menus and shortcuts:)
// script: write 1 pear apple\nCherry plum; menu Edit > Sort lines; shortcut Ctrl+U; shortcut Ctrl+Z; menu Edit > Reverse lines; shortcut F5; shortcut F1; menu File > Quit
//
// Try this:
//  - Add "Join lines" to the Edit menu, putting all the lines on one.
//  - Keep more than one step of Undo: a list str of what was there before.
//  - Change gui to tui, and use the menus from the keyboard: F10 opens them.

// ---------------------------------------------------------------- output
//> Cherry plum / pear apple
//> CHERRY PLUM / PEAR APPLE
//> undone: Cherry plum / pear apple
//> pear apple / Cherry plum
//> 4 words
//> about
