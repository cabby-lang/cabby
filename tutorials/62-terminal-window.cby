// Tutorial 62: Windows in a terminal — a to-do list
//
// Run it:      cabby 62-terminal-window.cby
// Or compile:  cabby -c 62-terminal-window.cby && ./62-terminal-window
// Library:     use tui
// Topics:      tui.window, the same widgets as gui in a terminal, keys,
//              keeping your own list behind a tui.list
//
// The tui library draws windows in the terminal, with the same objects and
// methods as gui: change `tui` to `gui` everywhere and this program opens a
// desktop window instead. Tab moves between things, Enter presses a button,
// Up and Down pick in the list, and Esc closes the window.

use tui

object todo : tui.window {
	tui.entry Item
	tui.list Shown
	tui.label Count
	list str Things                  // the items; Shown displays them

	void build {
		set_title "To do"
		set_size 400, 240                // 50 by 15 characters
		add_label "New item:"
		tui.row Line = add_row
		Item = Line.add_entry
		tui.button Add = Line.add_button "Add"
		Item.on_enter add_item           // Enter in the box adds it too
		Add.on_click add_item
		Shown = add_list
		tui.row Buttons = add_row
		tui.button Remove = Buttons.add_button "Remove"
		tui.button Clear = Buttons.add_button "Clear all"
		Remove.on_click remove_item
		Clear.on_click ask_clear
		Count = add_label ""
		refresh
	}

	void add_item {
		str Text = Item.text.trim
		if Text.length == 0 {
			return
		}
		Things.add Text
		Item.set_text ""
		refresh
	}

	void remove_item {
		int At = Shown.selected
		if At < 0 {
			show_message "Pick an item in the list first."
			return
		}
		Things.remove_at At
		refresh
	}

	void ask_clear {
		ask "Clear the whole list?", clear_all
	}

	void clear_all {
		Things.clear
		refresh
	}

	// The list on the screen from Things, and the count under it.
	void refresh {
		Shown.clear
		for Thing in Things {
			Shown.add_item Thing
		}
		Count.set_text Things.length.text + " to do"
	}
}

int main {
	todo t
	t.run
	println "left to do:", t.Things
}

// (For Cabby's test suite: what to press in the window.)
// tui-script: type 1 milk; enter 1; type 1 bread; click Add; type 1 eggs; key enter; select 1 bread; click Remove; screen; click Clear all; answer yes; type 1 sleep; enter 1
//
// Try this:
//  - Change `tui` to `gui` everywhere, and run it again.
//  - Add a "Move up" button that swaps the selected item with the one above.
//  - Save the list to a file when the window closes, and load it in build
//    (the files library, tutorial 32).

