// Tutorial 66: Painting — a worker that draws, for a window to show
//
// Run it:      cabby 66-painting.cby
// Or compile:  cabby -c 66-painting.cby && ./66-painting
// Library:     use gui, use threads, use images
// Topics:      images.new, set_pixel_rgb, tell_picture, has_picture and
//              picture; a canvas showing pictures as they come
//
// The Mandelbrot set, worked out by a worker and painted a strip at a
// time. Each pixel is a sum done over and over (up to 200 times), which
// takes a while for the whole picture: on a worker, the window stays
// awake meanwhile, and shows each strip as soon as it's done.
//
// The worker draws each strip on a picture of its own (use images), a
// pixel at a time, and hands it over with tell_picture. A picture is
// moved, not copied, so however big it is, handing it on costs nothing:
// the worker's picture is empty afterwards, and the window's handler
// takes it with `picture`. The window draws each strip onto one picture
// of the whole, and its canvas shows that.

use gui
use threads
use images

const int WIDTH = 360
const int HEIGHT = 240
const int STRIP = 20       // rows in each strip: twelve strips
const int MOST = 200       // times round, at most, for each pixel

// ---- the worker: the Mandelbrot set, a strip at a time

object painter : threads.worker {
	void work {
		for int Top = 0; Top < HEIGHT; Top += STRIP {
			images.picture Strip = images.new WIDTH, STRIP
			for Row in STRIP {
				for Column in WIDTH {
					paint Strip, Column, Row, Top + Row
				}
			}
			tell_picture Strip      // moved to the window: Strip is empty now
		}
	}

	// one pixel: how many times round before it runs off, as a color
	void paint images.picture &Strip, int Column, int Row, int Y {
		double Re = -2.2 + Column * 3.2 / WIDTH
		double Im = -1.2 + Y * 2.4 / HEIGHT
		double X = 0.0
		double Z = 0.0
		int Times = 0
		while Times < MOST and X * X + Z * Z <= 4.0 {
			double Next = X * X - Z * Z + Re
			Z = 2.0 * X * Z + Im
			X = Next
			Times++
		}
		if Times == MOST {
			Strip.set_pixel_rgb Column, Row, 10, 10, 30     // inside: dark
		} else {
			Strip.set_pixel_rgb Column, Row, Times * 9 % 256, Times * 4 % 256, 80 + Times * 2 % 176
		}
	}
}

// ---- the window

object fractal_window : gui.window {
	gui.canvas Canvas
	gui.label Status
	painter Painter
	images.picture Whole
	int Strips

	void build {
		set_title "Mandelbrot"
		Canvas = add_canvas WIDTH, HEIGHT
		Canvas.on_draw draw
		Status = add_label "Painting..."
		Whole = images.new WIDTH, HEIGHT
		Whole.fill_with "black"
		Painter.on_message strip_done
		Painter.on_done all_done
		Painter.start
	}

	// each strip as it comes: onto the whole picture, at its place
	void strip_done {
		if not Painter.has_picture {
			return
		}
		images.picture Strip = Painter.picture
		Whole.draw Strip, 0, Strips * STRIP
		Strips++
		Status.set_text "Painted " + Strips.text + " of " + (HEIGHT / STRIP).text + " strips"
		Canvas.redraw
	}

	void draw {
		Canvas.picture 0, 0, Whole
	}

	void all_done {
		Whole.save "mandelbrot.png"
		Status.set_text "Done: saved as mandelbrot.png"
		println "painted in", Strips, "strips, and saved"
		// (a pixel inside the set, and one outside it, to check)
		println "the middle:", Whole.red(WIDTH * 2 / 3, HEIGHT / 2), Whole.green(WIDTH * 2 / 3, HEIGHT / 2)
		images.picture Back = images.load "mandelbrot.png"
		println "read back:", Back.width, "by", Back.height
	}
}

int main {
	fractal_window W
	W.run
}

// Try this:
//  - Paint it with more workers: give each a part of the rows, and the
//    window puts each strip where its Top says (tell it in a line first).
//  - Zoom in: change Re and Im's ranges to a corner of the set, and MOST
//    to 1000.
//  - Show it while it's being painted a row at a time: tell_picture each
//    row instead of each strip.

// (For Cabby's test suite: "processes" waits until the worker's done.)
// script: processes; close
// leaves: mandelbrot.png

// ---------------------------------------------------------------- output
//> painted in 12 strips, and saved
//> the middle: 10 10
//> read back: 360 by 240
