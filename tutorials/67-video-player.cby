// Tutorial 67: A video player
//
// Run it:      cabby 67-video-player.cby                 (its own test video)
//              cabby 67-video-player.cby lesson.mp4      (any video file)
// Or compile:  cabby -c 67-video-player.cby && ./67-video-player
// Libraries:   use videos, use gui
// Topics:      videos.open, what's in a video (its size, length, codecs),
//              add_video and its controls, play, seek, on_end, picture_at
//
// A video is opened with the videos library, which reads it with FFmpeg:
// MP4, MKV, WebM, MOV and whatever else FFmpeg knows. It's shown in a
// window by giving its source to add_video. The video plays, pauses and
// seeks; the window shows it, and plays its sound.
//
// Click the picture (or press space) to pause it, and again to play it.
// The track under it goes to any place in it; left and right go back and
// on five seconds.

use gui
use videos

object player : gui.window {
	str Path
	videos.video Film
	gui.video Screen

	void build {
		Film = videos.open Path
		str Title = Film.title
		if Title is "" {
			Title = Path.copy
		}
		set_title Title
		set_size 560, 400

		// what's in it
		str About = Film.width.text + " by " + Film.height.text + ", " + seconds(Film.length) + ", "
		About += Film.picture_codec
		if Film.has_sound {
			About += " with " + Film.sound_codec + " sound"
		}
		add_label About

		Screen = add_video Film.source
		Screen.show_controls
		Screen.on_end finished

		gui.row Buttons = add_row
		gui.button Back = Buttons.add_button "Back 10 seconds"
		gui.button Save = Buttons.add_button "Save this picture"
		Back.on_click back
		Save.on_click save_picture

		Film.play
	}

	void back {
		Film.seek Film.position - 10
	}

	// the picture showing now, as a PNG file
	void save_picture {
		double At = Film.position
		images.picture Picture = Film.picture_at At
		Picture.save "frame.png"
		println "saved the picture at", seconds(At), "as frame.png"
	}

	void finished {
		println "the end, after", seconds(Film.position)
	}
}

// "3 seconds", "1.25 seconds", "1 second"
str seconds double Time {
	long Hundredths = (long)(Time * 100 + 0.5)
	str Text = (Hundredths / 100).text
	if Hundredths % 100 != 0 {
		Text += "." + (Hundredths % 100 / 10).text
		if Hundredths % 10 != 0 {
			Text += (Hundredths % 10).text
		}
	}
	if Hundredths == 100 {
		return Text + " second"
	}
	return Text + " seconds"
}

int main int Argc, str Argv[] {
	player P
	P.Path = "videos/colors.mkv"
	if Argc > 1 {
		P.Path = Argv[1].copy
	}
	if !videos.can_open(P.Path) {
		stderr println "can't play", P.Path
		return 1
	}
	P.run
	return 0
}

// Try this:
//  - A button that plays it at the start again: Film.rewind.
//  - Film.set_looping true, for a video that plays round and round.
//  - A slider for its volume: Film.set_volume, from 0 to 100.
//  - Thumbnails: a picture from every 10 seconds of it, with picture_at,
//    saved as "thumb-1.png", "thumb-2.png" ...

