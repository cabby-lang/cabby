// Tutorial 68: Games — catch the apples
//
// Run it:      cabby 68-games.cby
// Or compile:  cabby -c 68-games.cby && ./68-games
// Library:     use game
// Topics:      game.window, set_background, add_rectangle, add_circle,
//              sprites, on_frame, key_hold, key_press, every, random,
//              pause, drawing over the stage
//
// A game is a window with a stage, and sprites on the stage: pictures or
// shapes that move. Nothing loops in the program itself. Instead, the game
// runs in frames, 60 a second, and on_frame's handler is called for each
// one: it moves things a little, and looks at the keys. Timers (every) run
// in frames too, so they wait while the game is paused.
//
// Apples fall from the sky; the left and right arrow keys move the basket
// to catch them. Miss three and the game is over. P pauses it.

use game

const int WIDTH = 480
const int HEIGHT = 360
const int BASKET_SPEED = 6
const int APPLE_SPEED = 3

object apple_catcher : game.window {
	game.sprite Basket
	list game.sprite Apples
	int Caught
	int Missed
	bool Over

	void build {
		set_title "Catch the apples"
		set_size WIDTH, HEIGHT
		set_background "skyblue"
		add_rectangle WIDTH, 30, "forestgreen", WIDTH / 2, HEIGHT - 15     // the grass
		Basket = add_rectangle 70, 20, "saddlebrown", WIDTH / 2, HEIGHT - 40
		on_frame step
		every time.milliseconds(700), drop_apple
		stage.on_draw draw_score
		add_shortcut "P", pause_or_resume     // a shortcut works even while paused
	}

	// ---- every frame: move everything a little

	void step {
		if Over {
			return
		}
		if key_hold("left") && Basket.x > 35 {
			Basket.move -BASKET_SPEED, 0
		}
		if key_hold("right") && Basket.x < WIDTH - 35 {
			Basket.move BASKET_SPEED, 0
		}

		// Each apple falls. One at the basket's height, and over it, is
		// caught; one that reaches the grass is missed. Either way it's
		// taken off the stage and out of the list (so the list isn't moved
		// on past it: the next apple has slid into its place).
		long i = 0
		while i < Apples.length {
			Apples[i].move 0, APPLE_SPEED
			double Across = Apples[i].x - Basket.x
			double Down = Apples[i].y
			if Down >= HEIGHT - 52 && Down <= HEIGHT - 40 && Across > -40 && Across < 40 {
				Caught++
				println "caught one at frame", frame, "-", Caught, "caught"
				Apples[i].remove
				Apples.remove_at i
			} else if Down > HEIGHT - 30 {
				Missed++
				println "missed one at frame", frame, "-", Missed, "missed"
				Apples[i].remove
				Apples.remove_at i
				if Missed == 3 {
					game_over
				}
			} else {
				i++
			}
		}
	}

	void drop_apple {
		if !Over {
			game.sprite Apple = add_circle 10, "red", random(20, WIDTH - 20), -10
			Apples.add Apple
		}
	}

	void pause_or_resume {
		if paused {
			resume
		} else {
			pause
		}
		stage.redraw
	}

	void game_over {
		Over = true
		stop_timers
		println "game over:", Caught, "caught"
	}

	// ---- drawn over the sprites, each time the stage is drawn

	void draw_score {
		stage.set_color "black"
		stage.set_font_size 18
		stage.write 10, 8, "Caught: " + Caught.text + "   Missed: " + Missed.text
		if Over {
			stage.set_font_size 40
			stage.write 130, 140, "Game over"
		} else if paused {
			stage.set_font_size 40
			stage.write 160, 140, "Paused"
		}
	}
}

int main {
	apple_catcher a
	a.run
}

// (Cabby's tests play it, frame by frame:)
// script: frames 150; hold right; frames 26; release right; frames 15; hold left; frames 40; release left; frames 5; hold right; frames 20; release right; frames 20; shortcut P; frames 50; shortcut P; frames 250; close
//
// Try this:
//  - Make the apples fall faster as more are caught.
//  - Drop a golden apple now and then, worth five.
//  - Make the basket a picture: add_sprite "basket.png", X, Y.

// ---------------------------------------------------------------- output
//> caught one at frame 148 - 1 caught
//> caught one at frame 190 - 2 caught
//> caught one at frame 232 - 3 caught
//> caught one at frame 274 - 4 caught
//> missed one at frame 324 - 1 missed
//> missed one at frame 366 - 2 missed
//> missed one at frame 408 - 3 missed
//> game over: 4 caught
