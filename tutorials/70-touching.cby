// Tutorial 70: Sprites touching — space rocks
//
// Run it:      cabby 70-touching.cby
// Or compile:  cabby -c 70-touching.cby && ./70-touching
// Library:     use game, use sound
use sound
// Topics:      touches, set_group, sprites_in, touching, on_stage,
//              move_forward, turn, left/right/top/bottom, sound.play
//
// Games are full of things meeting: a bullet hits a rock, a rock hits the
// ship. `A.touches B` says whether two sprites touch. And a sprite can be
// put in a group ("rock", "bullet"), so that `sprites_in "rock"` gives
// every rock, and `Bullet.touching "rock"` every rock that bullet touches,
// without keeping lists of them.
//
// Left and Right turn the ship, Up moves it forward, and Space fires.
// Rocks break when shot; three hits on the ship and the game is over.
// sound.play (from `use sound`) makes the noises: sound files in sounds/,
// played as they happen, over each other.

use game

const int WIDTH = 520
const int HEIGHT = 400
const int ROCKS = 5

object space_rocks : game.window {
	game.sprite Ship
	int Score
	int Lives
	bool Over

	void build {
		set_title "Space rocks"
		set_size WIDTH, HEIGHT
		set_background "#0b1026"
		Lives = 3
		for i in 40 {
			add_circle 1, "white", random(0, WIDTH), random(0, HEIGHT)    // stars
		}
		Ship = add_sprite "pictures/ship.png", WIDTH / 2, HEIGHT / 2
		for i in ROCKS {
			add_rock
		}
		on_frame step
		stage.on_draw draw_score
	}

	// a rock somewhere along the top, drifting down and sideways
	void add_rock {
		game.sprite Rock = add_circle random(14, 26), "slategray", random(0, WIDTH), -20
		Rock.set_group "rock"
		Rock.set_angle random(150, 210)    // facing down the stage, more or less
	}

	void fire {
		game.sprite Bullet = add_circle 3, "yellow", Ship.x, Ship.y
		Bullet.set_angle Ship.angle
		Bullet.move_forward 16             // from the ship's nose
		Bullet.set_group "bullet"
		sound.play "sounds/laser.wav"
	}

	// ---- every frame

	void step {
		if Over {
			return
		}
		if key_hold "left" {
			Ship.turn -4
		}
		if key_hold "right" {
			Ship.turn 4
		}
		if key_hold "up" {
			Ship.move_forward 3
		}
		if key_press "space" {
			fire
		}
		wrap_ship

		for Bullet in sprites_in "bullet" {
			Bullet.move_forward 8
			for Rock in Bullet.touching "rock" {
				Score += 10
				println "hit! score", Score
				sound.play "sounds/boom.wav"
				Rock.remove
				Bullet.remove
				add_rock
			}
			if !Bullet.on_stage {
				Bullet.remove                  // gone off the edge
			}
		}

		for Rock in sprites_in "rock" {
			Rock.move_forward 2
			if Rock.top > HEIGHT {
				Rock.move_to random(0, WIDTH), -20   // round again from the top
			}
			if Rock.touches Ship {
				Lives--
				println "the ship is hit!", Lives, "left"
				sound.play "sounds/miss.wav"
				Rock.remove
				add_rock
				if Lives == 0 {
					Over = true
					println "game over: score", Score
				}
			}
		}
	}

	// the ship wraps round: off one edge, back on the other
	void wrap_ship {
		if Ship.x < 0 {
			Ship.move WIDTH, 0
		} else if Ship.x > WIDTH {
			Ship.move -WIDTH, 0
		}
		if Ship.y < 0 {
			Ship.move 0, HEIGHT
		} else if Ship.y > HEIGHT {
			Ship.move 0, -HEIGHT
		}
	}

	void draw_score {
		stage.set_color "white"
		stage.set_font_size 16
		stage.write 10, 8, "Score: " + Score.text + "   Lives: " + Lives.text
		if Over {
			stage.set_font_size 40
			stage.write 150, 180, "Game over"
		}
	}
}

int main {
	space_rocks s
	s.run
}

// (Cabby's tests play it:)
// script: frames 30; tap space; frames 20; hold left; frames 20; release left; tap space; frames 30; tap space; frames 200; close
//
// Try this:
//  - Make big rocks break into two small ones when shot.
//  - Give the rocks pictures of their own, and turn them as they go.
//  - Limit the bullets: no more than three on the stage at once
//    (sprites_in("bullet").length).

// ---------------------------------------------------------------- output
//> hit! score 10
//> the ship is hit! 2 left
//> hit! score 20
