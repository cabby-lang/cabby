// Tutorial 87: Cabby Quest, part 11 — a battle in the tall grass
//
// Run it:      cabby 87-quest-battle.cby
// Or compile:  cabby -c 87-quest-battle.cby && ./87-quest-battle
// Library:     use game, use files, use sound, use directories, use json
// Topics:      tall grass, and what's in it; a battle, a turn at a time,
//              as FireRed's are: a menu, moves, health bars that fall,
//              who goes first, and how hard a hit is
//
// Part 10 (tutorial 86) went into the hills. Now there's tall grass in
// them (w in a map), and the hero isn't alone: Ember, a fox, goes with
// them. Now and then, a step into the grass meets something that lives
// there, a field mouse or a hill crow, and Ember and it have a battle.
//
// The screen flashes, and the battle shows: the wild one on its patch of
// ground at the back, Ember at the front, and how each is doing. Each
// turn, Fight picks one of Ember's moves (or Run gets away); the quicker
// of the two goes first. A hit's words show, then its bar falls. The
// first to run out of health has lost.
//
// (Parts 4 to 10 don't know the tall grass: there, it's grass.)
//
// New sections are numbered 82. Chapter 87 of the manual goes through them.

use game
use files
use sound
use directories
use json

// ==== 77.1  Sizes ========================================================

const int TILE = 48                 // each tile's size, in pixels
const int SHOWN_COLUMNS = 13        // how much of the world the stage shows
const int SHOWN_ROWS = 9
const int GROUND = 0                // the layers: the ground, under everything,
const int STANDING = 1              // and what stands on it, lower in front

// ==== 78.1  Walking speed  (changed in 79, 86) ===========================

const int SPEED = 3                 // pixels a frame: a step is 48 / 3 = 16 frames
const int LEG_TIME = 67             // ms for each picture of a step: four to a tile
const int TURN_TIME = 100           // ms: a tap of an arrow shorter than this only turns
const str BLOCKING = "TSH~D#ObCv^<>" // tiles that can't be walked onto (71: a cliff, ledges)

// ==== 79.1  Fading =======================================================

const int FADE_FRAMES = 20          // a third of a second to black, and back

// ==== 79.2  An area's name ===============================================

const int NAME_FRAMES = 150         // how long it shows: two and a half seconds

// ==== 85.1  Being noticed ================================================

const int NOTICE_FRAMES = 40        // the "!" shows this long, then they come over

// ==== 86.1  Over, and under ==============================================

const int BRIDGE = 2                // the layer of a bridge: over who walks under it
const int ON_TOP = 3                // and of the hero, up high, walking over one
const int HOP_HEIGHT = 12           // how high a hop over a ledge goes, in pixels
const int STAIRS = -1               // how high stairs are: either height
const int ON_BRIDGE = -2            // and a bridge: the height the hero was

// ==== 87.1  A battle =====================================================
const int FLASH_FRAMES = 40         // the screen flashes this long, then the battle shows
const int MEETING = 5               // one step in five, in tall grass, meets something

// ==== 78.2  Which way is across ==========================================

// a step that way goes this far across: -1 (left), 1 (right) or 0
int across_of const str &Way {
	if Way == "left" {
		return -1
	} else if Way == "right" {
		return 1
	}
	return 0
}

// ==== 78.3  Which way is down ============================================

// and this far down: -1 (up), 1 (down) or 0
int down_of const str &Way {
	if Way == "up" {
		return -1
	} else if Way == "down" {
		return 1
	}
	return 0
}

// ==== 81.1  The other way ================================================

// the way back: "up" for "down", "left" for "right" ...
str opposite const str &Way {
	if Way == "up" {
		return "down"
	} else if Way == "down" {
		return "up"
	} else if Way == "left" {
		return "right"
	}
	return "left"
}

// ==== 78.4  Someone who walks ============================================

object walker {
	game.sprite Sprite
	str Picture                     // "hero": pictures/hero-down-1.png ...
	int Col                         // the tile it's on
	int Row
	str Facing                      // "down", "up", "left" or "right"
	int Dx                          // the way it's stepping: -1, 0 or 1
	int Dy
	int StepsLeft                   // frames left of this step (0: on a tile)
	int Steps                       // steps taken

	// ==== 78.5  Its pictures =============================================

	// Leg 1 is standing; 2 and 3, one foot forward or the other
	str picture_of int Leg const {
		return "pictures/" + Picture + "-" + Facing + "-" + Leg.text + ".png"
	}

	bool stepping const {
		return StepsLeft > 0
	}

	void face const str &Way {
		Facing = Way.copy
		Sprite.set_picture picture_of(1)
	}

	// ==== 78.6  A step ===================================================

	// to the next tile that way, or (Moves false) a step on the spot
	void step const str &Way, bool Moves {
		Facing = Way.copy
		Dx = 0
		Dy = 0
		if Moves {
			Dx = across_of Way
			Dy = down_of Way
		}
		move_legs
	}

	// ==== 78.7  Its legs =================================================

	// a whole stride to each tile: a foot forward, standing, the other foot
	void move_legs {
		StepsLeft = TILE / SPEED
		Steps++
		Sprite.animate {picture_of(2), picture_of(1), picture_of(3), picture_of(1)}, LEG_TIME
	}

	// ==== 78.8  Each frame of a step  (changed in 86) ====================

	// moves a little: true in the frame the step ends
	bool keep_stepping {
		Sprite.move Dx * SPEED, Dy * SPEED + rise
		StepsLeft--
		if StepsLeft == 0 {
			arrive
		}
		return StepsLeft == 0
	}

	// ==== 78.9  A step's end  (changed in 86) ============================

	void arrive {
		Col += Dx
		Row += Dy
		if Hops {
			Col += Dx                       // (71) a hop goes a tile further
			Row += Dy
			Hops = false
		}
		Sprite.set_picture picture_of(1)   // standing (set_picture stops animate)
	}

	// ==== 81.2  Where it is, or is going =================================

	bool Wanders                    // it walks about on its own

	// on that tile, or stepping onto it
	bool at int C, int R const {
		return (Col == C && Row == R) || (stepping && Col + Dx == C && Row + Dy == R)
	}

	// ==== 86.2  Up high ==================================================

	int Level                       // 0 on the ground, 1 up high
	bool Hops                       // this step is a hop over a ledge

	// ==== 86.3  A hop ====================================================

	// over a ledge: two tiles in one step, twice as long
	void hop const str &Way {
		step Way, true
		Hops = true
		StepsLeft = 2 * TILE / SPEED
	}

	// ==== 86.4  Up, and down again =======================================

	// how far the sprite goes up (less than 0) or down this frame of a hop
	int rise const {
		if !Hops {
			return 0
		}
		int Done = 2 * TILE / SPEED - StepsLeft
		return height(Done) - height(Done + 1)
	}

	// ==== 86.5  How high =================================================

	// part way through a hop, Done frames of it: a half tile's walk up to
	// the lip, then up, and down again over the rest
	int height int Done const {
		int All = 2 * TILE / SPEED
		int Jump = All - All / 4        // frames in the air
		int Off = Done - All / 4        // and how many of them so far
		if Off <= 0 {
			return 0
		}
		return 4 * HOP_HEIGHT * Off * (Jump - Off) / (Jump * Jump)
	}
}

// ==== 79.3  An area next door ============================================

// another area's map, drawn beyond an edge of this one; Col and Row are
// where its top left tile is, counted on this area's map
object neighbour {
	str Area                        // "town"
	str Side                        // the edge it's beyond: "south"
	list str Map
	int Col
	int Row
	bool Corner                     // next door to next door: seen, not walked into

	// ==== 79.4  Where it is ==============================================

	// beyond its edge of Here (this area's map), Along tiles along it
	void place_beside const list str &Here, int Along {
		if Side == "north" || Side == "south" {
			Col = Along
			Row = beyond Side == "south", (int)Here.length, (int)Map.length
		} else {
			Row = Along
			Col = beyond Side == "east", (int)Here[0].length, (int)Map[0].length
		}
	}

	// ==== 79.5  Moved along ==============================================

	// (an area at a corner: placed beside the area next door, then moved
	// with it)
	void move_by int Columns, int Rows {
		Col += Columns
		Row += Rows
	}

	// ==== 79.6  Before, or after =========================================

	// the first row (or column) past the edge: just after Here's last, or
	// far enough before 0 to fit its own (Mine)
	int beyond bool After, int Here, int Mine const {
		if After {
			return Here
		}
		return -Mine
	}

	// ==== 79.7  Its tiles ================================================

	// whether the tile C, R (counted on this area's map) is in it, and what
	// it is
	bool has int C, int R const {
		return R >= Row && R < Row + (int)Map.length && C >= Col && C < Col + (int)Map[R - Row].length
	}

	char tile int C, int R const {
		return Map[R - Row][C - Col]
	}
}

// ==== 78.10  What's happening  (changed in 79, 82, 85) ===================

enum mode {
	PLAYING                         // walking about
	READING                         // words showing: Space goes on
	FADING_OUT                      // going dark, to go somewhere else
	FADING_IN                       // and getting light again, there
	CHOOSING                        // a question showing: the arrow keys, Space
	NOTICED                         // (70) someone has seen the hero, and comes over
}

// ==== 82.1  What the hero has done  (changed in 83) ======================

struct progress {
	lookup str str Answers          // what they answered: "elder name": "Livia"
	str Quest                       // the baker's spoon: "", "asked" or "done"
	list str Items                  // what the hero carries: "spoon"
	list str Taken                  // what's been picked up: "bakery 9,4"
	str Area                        // and where they are (when saved)
	int Col
	int Row
	str Facing

	// ==== 85.2  Who has noticed the hero =================================

	list str Noticed                // "elder": they won't notice again

	// ==== 86.6  How high, when saved =====================================

	int Level                       // so a game saved over a bridge carries on there

	// ==== 87.2  Ember's wounds ===========================================
	int Wounds                      // how hurt Ember is (0: well), from battle to battle
}

// ==== 87.3  A creature ===================================================

struct critter {
	str Name                        // "Ember"
	str Kind                        // its picture: pictures/critter-fox-back.png
	int Level
	int Health                      // how much more it can take
	int Most                        // and how much when it's well
	int Strength                    // how hard it hits
	int Toughness                   // how hard it is to hurt
	int Speed                       // the quicker goes first

	// ==== 87.4  Its moves ================================================

	list str Moves                  // "Pounce"
	list int Powers                 // and how hard each is: 40
}

// ==== 87.5  The hero's fox ===============================================

// Ember, as hurt as the last battle left her
critter fox int Wounds {
	critter Ember = {.Name = "Ember", .Kind = "fox-back", .Level = 5, .Most = 21}
	Ember.Strength = 11
	Ember.Toughness = 9
	Ember.Speed = 12
	Ember.Health = Ember.Most - Wounds
	Ember.Moves = {"Pounce", "Spark"}
	Ember.Powers = {40, 55}
	return Ember
}

// ==== 87.6  A field mouse ================================================

// slower than Ember, so she goes first
critter field_mouse {
	critter Mouse = {.Name = "field mouse", .Kind = "mouse", .Level = 3, .Most = 14}
	Mouse.Strength = 8
	Mouse.Toughness = 8
	Mouse.Speed = 10
	Mouse.Health = Mouse.Most
	Mouse.Moves = {"Nibble", "Scratch"}
	Mouse.Powers = {35, 30}
	return Mouse
}

// ==== 87.7  A hill crow ==================================================

// quicker than Ember, and it hits harder, but it's easier to hurt
critter hill_crow {
	critter Crow = {.Name = "hill crow", .Kind = "crow", .Level = 4, .Most = 15}
	Crow.Strength = 10
	Crow.Toughness = 7
	Crow.Speed = 14
	Crow.Health = Crow.Most
	Crow.Moves = {"Peck", "Gust"}
	Crow.Powers = {35, 40}
	return Crow
}

// ==== 77.2  The world  (changed in 78) ===================================

object world : game.window {
	list str Map                    // the area's tiles, a character each
	list str Things                 // the lines after the map: signs ...
	lookup char str Grounds         // the picture for each kind of ground
	walker Hero

	// ==== 81.3  The people ===============================================

	list walker People              // everyone in the area but the hero

	// ==== 78.11  The words showing =======================================

	mode Mode                       // PLAYING to begin with (it's 0)
	str Message                     // the words being read

	// ==== 80.1  Words a word at a time ===================================

	int Shown                       // how many of the words are showing

	// ==== 82.2  A question ===============================================

	progress Story                  // what the hero has done
	str Question                    // the question showing: "elder name"
	list str Choices                // its answers
	int Choice                      // the one the arrow points at

	// ==== 84.1  Options ==================================================

	int MusicLevel                  // the volumes, from 0 (silent) to 10
	int SoundsLevel
	bool OptionsSet                 // (fields start at 0: set them once)

	// ==== 85.3  Someone coming over ======================================

	int Comer                       // who has noticed the hero, and is coming over
	int NoticeFrame                 // frames since (the "!" shows for the first few)
	lookup str int Sight            // how far each person sees: {"baker": 3}
	bool Leaving                    // someone is walking away (the rival)...
	int Leaver                      // ...this one

	// ==== 87.8  A battle's state =========================================

	bool Fighting                   // a battle is on
	int FlashFrame                  // frames since it began: first, a flash
	critter Ours                    // Ember
	critter Foe                     // and what she's facing
	bool Over                       // won, lost or run from: it ends after the words
	bool Lost

	// ==== 87.9  The bars =================================================

	double FoeShown                 // their health as the bars show it
	double OursShown
	int FoeGoal                     // and where the bars are falling to
	int OursGoal

	// ==== 87.10  What comes next =========================================

	list str Beats                  // what's said next, in turn
	list int Hits                   // after each: who's hit (1 the foe, 2 Ember, 0 no one)
	list int HealthAfter            // and their health then
	int Hit                         // the hit after the words showing (as Hits)
	int HitTo                       // and the health it leaves

	// ==== 79.8  Going somewhere else =====================================

	str Area                        // the area the hero is in: "woods"
	str NextArea                    // and where they're going, when it's dark
	int NextCol
	int NextRow
	int FadeFrame                   // how far through the fade
	list neighbour Joins            // the areas next door

	bool fading const {
		return Mode == FADING_OUT || Mode == FADING_IN
	}

	// ==== 79.9  The name showing =========================================

	str AreaName                    // "Cabby Town", at the top left for a moment
	long NameFrom                   // the frame it appeared in

	// ==== 77.3  Building the world  (changed in 78, 79, 83, 84) ==========

	void build {
		set_title "Cabby Quest"
		set_size SHOWN_COLUMNS * TILE, SHOWN_ROWS * TILE
		set_background "black"
		sort_by_depth STANDING          // the hero, trees and houses
		name_grounds
		show_title
		on_frame step
		stage.on_draw draw_over
	}

	// ==== 79.10  The kinds of ground  (changed in 86, 87) ================

	// outside, then inside a house, and (71) in the hills, (82) tall grass
	void name_grounds {
		Grounds = {
			'~': "water", 'f': "flowers", '=': "path", 'S': "sign",
			'#': "wall", ',': "floor", 'O': "oven", 'b': "table", 'M': "mat",
			'h': "high", 'C': "cliff", 'z': "stairs", 'P': "path", 'v': "ledge-down",
			'^': "ledge-up", '<': "ledge-left", '>': "ledge-right",
			'w': "tall-grass"
		}
	}

	// ==== 77.4  Going to an area  (changed in 78, 79, 81, 83) ============

	void go_to const str &Place, int C, int R {
		clear_area
		Area = Place.copy
		read_area Place
		add_tiles_of Map.copy, 0, 0
		add_joins                       // and (64) the areas next door
		add_things
		Hero = new_walker "hero", C, R, facing_now
		follow Hero.Sprite              // the camera keeps the hero in the middle
	}

	// ==== 83.1  What else is in an area  (changed in 85) =================

	void add_things {
		add_people
		add_rival
		add_items
		add_sights
	}

	// ==== 85.4  The rival ================================================

	// "rival 13,7 left": Rufus, who's there until he's met the hero
	void add_rival {
		str Line = setting "rival"
		if Line != "" && !Story.Noticed.contains("rival") {
			list str Words = Line.split " "
			walker Rufus = new_walker "rival", column_of(Words[0]), row_of(Words[0]), Words[1]
			People.add Rufus
		}
	}

	// ==== 85.5  How far they see =========================================

	// "sees baker 3": the baker sees the hero up to three tiles in front of her
	void add_sights {
		Sight.clear
		for I in Things.length {
			list str Words = Things[I].split " "
			if Words[0] == "sees" {
				Sight[Words[1]] = Words[2].to_int
			}
		}
	}

	// ==== 79.11  Arriving ================================================

	// there, out of the dark
	void start_at const str &Place, int C, int R {
		enter Place, C, R
		Mode = FADING_IN
		FadeFrame = 0
	}

	// ==== 79.12  Entering  (changed in 80, 81, 86) =======================

	// the area built, the hero in it, and its name showing
	void enter const str &Place, int C, int R {
		go_to Place, C, R
		Hero.Level = Story.Level        // (71) as saved: on a bridge, or under it
		settle_level                    // and up high, or not
		show_name
		start_music
		make_room C, R
		println "in the", Area, "at", C, R
	}

	// ==== 79.13  Showing the name ========================================

	// "name Cabby Town" after the map: at the top left, for a moment
	void show_name {
		AreaName = setting "name"
		NameFrom = frame
	}

	// ==== 80.2  The area's music =========================================

	// "music town" after the map: music/town.mid, round and round, after
	// the last area's has faded out (if it's the same, it goes on)
	void start_music {
		str Name = setting "music"
		if Name != "" {
			sound.change_music "music/" + Name + ".mid", 1000
		}
	}

	// ==== 79.14  Clearing the stage  (changed in 81) =====================

	// every sprite off, and the last area's map forgotten
	void clear_area {
		for Old in sprites_in "" {
			Old.remove
		}
		Map.clear
		Things.clear
		Joins.clear
		AreaName = ""
		People.clear
	}

	// ==== 79.15  Facing the same way =====================================

	// a new area, the hero facing as they were ("down" the first time)
	str facing_now const {
		if Hero.Facing == "" {
			return "down"
		}
		return Hero.Facing.copy
	}

	// ==== 78.12  A new walker ============================================

	// on their tile, feet at its bottom, as in FireRed; a tree on the tile
	// below them is lower, so it's in front, and its leaves hide their feet
	walker new_walker const str &Picture, int C, int R, const str &Facing {
		walker Someone
		Someone.Picture = Picture.copy
		Someone.Facing = Facing.copy
		Someone.Col = C
		Someone.Row = R
		Someone.Sprite = add_sprite Someone.picture_of(1), middle_of(C), middle_of(R)
		Someone.Sprite.set_layer STANDING
		return Someone
	}

	// ==== 81.4  The people in an area ====================================

	// (by number: add_person changes the world, which a loop through one
	// of its lists can't let happen)
	void add_people {
		for I in Things.length {
			if Things[I].starts_with "person " {
				add_person Things[I].copy
			}
		}
	}

	// ==== 81.5  Someone ==================================================

	// "person 11,3 elder down wanders": where, who, which way, and whether
	// they walk about
	void add_person const str &Line {
		list str Words = Line.split " "
		walker Someone = new_walker Words[2], column_of(Words[1]), row_of(Words[1]), Words[3]
		Someone.Wanders = Words.length > 4
		People.add Someone
	}

	// ==== 83.2  Things to pick up ========================================

	void add_items {
		for I in Things.length {
			if Things[I].starts_with "item " {
				add_item Things[I].copy
			}
		}
	}

	// ==== 83.3  A thing ==================================================

	// "item 9,4 spoon": pictures/item-spoon.png on tile 9,4 (unless it's
	// been picked up), in a group of its own, to take it away by
	void add_item const str &Line {
		list str Words = Line.split " "
		if item_at(column_of(Words[1]), row_of(Words[1])) != "" {
			str Picture = "pictures/item-" + Words[2] + ".png"
			game.sprite Thing = add_sprite Picture, middle_of(column_of(Words[1])), middle_of(row_of(Words[1]))
			Thing.set_layer STANDING
			Thing.set_group "item " + Words[1]
		}
	}

	// ==== 77.5  Reading an area's map  (changed in 78) ===================

	// quest/woods.txt: notes (//) first, then the map, a line a row; then,
	// after ---, a line for each thing in the area
	void read_area const str &Area {
		bool InMap = true
		for Line in files.lines "quest/" + Area + ".txt" {
			if Line == "---" {
				InMap = false
			} else if !Line.starts_with("//") && Line.trim != "" {
				keep_line Line, InMap
			}
		}
	}

	// ==== 78.13  Keeping a line ==========================================

	void keep_line const str &Line, bool InMap {
		if InMap {
			Map.add Line.copy
		} else {
			Things.add Line.copy
		}
	}

	// ==== 77.6  A sprite for every tile  (changed in 79) =================

	// a map's tiles, its top left one at Left, Top: (64) this area's at 0, 0,
	// and the areas' next door beside it
	void add_tiles_of const list str &Rows, int Left, int Top {
		for R in Rows.length {
			for C in Rows[R].length {
				add_ground Rows[R][C], middle_of(Left + C), middle_of(Top + R)
				add_standing Rows[R][C], middle_of(Left + C), middle_of(Top + R)
			}
		}
	}

	// ==== 79.16  The areas next door =====================================

	// a line for each, after the map; then the world made big enough to
	// show them
	void add_joins {
		for I in Things.length {
			if Things[I].starts_with "join " {
				add_join Things[I].copy
			}
		}
		add_corners
		set_edges
	}

	// ==== 79.17  One area next door ======================================

	// "join south town 0": the town's map, beyond the south edge of Here
	// (this area's map, or an area next door's), its column 0 beside Here's
	neighbour beside const str &Line, const list str &Here const {
		list str Words = Line.split " "
		neighbour Next
		Next.Side = Words[1].copy
		Next.Area = Words[2].copy
		read_map Words[2], Next.Map
		Next.place_beside Here, Words[3].to_int
		return Next
	}

	// ==== 79.18  Joined on ===============================================

	// beyond this area's edge
	void add_join const str &Line {
		neighbour Next = beside Line, Map
		add_tiles_of Next.Map, Next.Col, Next.Row
		Joins.add Next
	}

	// ==== 79.19  Corners =================================================

	// the areas next door's own areas next door: one at a corner is seen
	// from here, before it's walked to
	void add_corners {
		int Count = (int)Joins.length
		for I in Count {
			list str Lines
			read_joins Joins[I].Area, Lines
			for Line in Lines {
				add_corner Line, (int)I
			}
		}
	}

	// ==== 79.20  An area at a corner =====================================

	// "join east grove 0", from the area next door I: beside it, unless it's
	// this area; if it's next door already, it should be in the same place
	void add_corner const str &Line, int I {
		neighbour Corner = beside Line, Joins[I].Map
		Corner.move_by Joins[I].Col, Joins[I].Row
		int Same = join_named Corner.Area
		if Same >= 0 {
			check_place Corner, Same
		} else if Corner.Area != Area {
			keep_corner Corner
		}
	}

	// ==== 79.21  Keeping a corner ========================================

	// seen, but not walked into
	void keep_corner neighbour Corner {
		Corner.Corner = true
		add_tiles_of Corner.Map, Corner.Col, Corner.Row
		Joins.add Corner
	}

	// ==== 79.22  Two ways to a corner ====================================

	// an area reached two ways, from two areas next door: if they don't
	// agree where it is, the maps that join it aren't the same size
	void check_place const neighbour &Corner, int Same const {
		if Joins[Same].Col != Corner.Col || Joins[Same].Row != Corner.Row {
			println "quest:", Corner.Area, "is next door two ways, and they don't agree where it is"
			println "  (make the maps that join it as wide, or as tall, as each other)"
		}
	}

	// ==== 79.23  Next door already =======================================

	// which of Joins that area is (-1: none)
	int join_named const str &Place const {
		for I in Joins.length {
			if Joins[I].Area == Place {
				return (int)I
			}
		}
		return -1
	}

	// ==== 79.24  Just a map ==============================================

	// an area's map, the rows before its ---, into Rows
	void read_map const str &Place, list str &Rows const {
		for Line in files.lines "quest/" + Place + ".txt" {
			if Line == "---" {
				break
			} else if !Line.starts_with("//") && Line.trim != "" {
				Rows.add Line.copy
			}
		}
	}

	// ==== 79.25  Its joins ===============================================

	// an area's join lines, into Lines
	void read_joins const str &Place, list str &Lines const {
		for Line in files.lines "quest/" + Place + ".txt" {
			if Line.starts_with "join " {
				Lines.add Line.copy
			}
		}
	}

	// ==== 79.26  How far the world reaches ===============================

	// past an edge with an area beyond it: half a screen, so the camera
	// goes on following the hero up to the edge (0: no area there)
	int reach_of const str &Side const {
		for Next in Joins {
			if Next.Side == Side && !Next.Corner && (Side == "north" || Side == "south") {
				return SHOWN_ROWS / 2 + 1
			} else if Next.Side == Side && !Next.Corner {
				return SHOWN_COLUMNS / 2 + 1
			}
		}
		return 0
	}

	// ==== 79.27  The world's edges =======================================

	// the map, and as far as the world reaches past each edge
	void set_edges {
		int Left = reach_of "west"
		int Top = reach_of "north"
		int Columns = (int)Map[0].length + Left + reach_of("east")
		int Rows = (int)Map.length + Top + reach_of("south")
		set_world_area -Left * TILE, -Top * TILE, Columns * TILE, Rows * TILE
		add_border -Left, -Top, Columns, Rows
	}

	// ==== 79.28  Trees all round =========================================

	// where the world reaches past this map and the maps next door (by a
	// corner, say), the woods go on
	void add_border int Left, int Top, int Columns, int Rows {
		for R in Rows {
			for C in Columns {
				if !on_map(Left + (int)C, Top + (int)R) && join_at(Left + (int)C, Top + (int)R) < 0 {
					add_tiles_of {"T"}, Left + (int)C, Top + (int)R
				}
			}
		}
	}

	// ==== 77.7  Which ground =============================================

	// grass, unless Grounds says otherwise
	str ground_of char Tile const {
		if Grounds.contains Tile {
			return Grounds[Tile].copy
		}
		return "grass"
	}

	// ==== 77.8  The ground ===============================================

	// water and flowers move a little: two pictures, in turn
	void add_ground char Tile, long X, long Y {
		str Name = ground_of Tile
		str Picture = "pictures/tile-" + Name
		if Name == "water" || Name == "flowers" {
			game.sprite Moving = add_sprite Picture + "-1.png", X, Y
			Moving.animate {Picture + "-1.png", Picture + "-2.png"}, 700
		} else {
			add_sprite Picture + ".png", X, Y
		}
	}

	// ==== 77.9  What stands on the ground  (changed in 86) ===============

	// taller than their tile: placed so their bottom is on it
	void add_standing char Tile, long X, long Y {
		if Tile == 'T' {
			game.sprite Tree = add_sprite "pictures/tall-tree.png", X, Y - TILE / 4
			Tree.set_layer STANDING
		} else if Tile == 'D' {
			game.sprite House = add_sprite "pictures/house.png", X, Y - TILE
			House.set_layer STANDING
		}
		add_over Tile, X, Y             // (71) and a bridge
	}

	// ==== 86.7  A bridge =================================================

	// over the ground, and over whoever walks under it
	void add_over char Tile, long X, long Y {
		if Tile == 'B' || Tile == 'P' {
			game.sprite Bridge = add_sprite "pictures/tile-bridge.png", X, Y
			Bridge.set_layer BRIDGE
		}
	}

	// ==== 77.10  Where a tile is =========================================

	// the middle of a tile, in pixels, from its column (or row)
	long middle_of long Tile const {
		return Tile * TILE + TILE / 2
	}

	// ==== 83.4  Where saved games go =====================================

	// the computer's place for them: ~/.local/share/Cabby Quest on Linux,
	// ~/Library/Application Support/Cabby Quest on a Mac
	str save_path const {
		return directories.save_folder("Cabby Quest") + "/saved.json"
	}

	// ==== 83.5  Saving  (changed in 86) ==================================

	// where the hero is, into Story; then all of Story, as JSON
	void save_game {
		Story.Area = Area.copy
		Story.Col = Hero.Col
		Story.Row = Hero.Row
		Story.Facing = Hero.Facing.copy
		Story.Level = Hero.Level        // (71)
		files.write save_path, json.from(Story).pretty
		effect "menu-choose"
		say "Saved."
	}

	// ==== 83.6  Carrying on ==============================================

	// Story back from the file, and the hero where they were
	void load_game {
		json.read(files.read(save_path)).fill Story
		Hero.Facing = Story.Facing.copy
		start_at Story.Area.copy, Story.Col, Story.Row
	}

	// ==== 84.2  The title screen =========================================

	// nobody in the world (an Area of ""), the woods' music, and a question
	void show_title {
		clear_area
		Area = ""
		first_options
		sound.play_music "music/woods.mid"
		ask "title", "Cabby Quest", title_choices
	}

	// ==== 84.3  What the title offers ====================================

	// Continue only when there's a saved game to carry on from
	list str title_choices const {
		list str Options = {"New game"}
		if files.exists save_path {
			Options.add "Continue"
		}
		Options.add "Options"
		return Options
	}

	// ==== 84.4  A new game ===============================================

	// all that's been done forgotten, and the start, in the woods
	void new_game {
		progress Fresh
		Story = Fresh
		Hero.Facing = "down"
		start_at "woods", 5, 3
	}

	// ==== 78.14  Every frame  (changed in 79, 82, 85) ====================

	// what happens depends on what's happening
	void step {
		if fading {
			fade_step
		} else if Mode == PLAYING {
			play_step
		} else {
			wait_step
		}
	}

	// ==== 85.6  Waiting ==================================================

	// (70) words showing, a question, or someone coming over
	void wait_step {
		if Mode == NOTICED {
			notice_step
		} else {
			read_on
		}
	}

	// ==== 78.15  Walking about  (changed in 81, 85, 87) ==================

	// people walking, and the hero; (82) or, in a battle, only that
	void play_step {
		if Fighting {
			battle_step
			return
		}
		move_people
		walk_away
		hero_step
	}

	// ==== 87.11  The hero, stepping or not ===============================

	// part way through a step, or on a tile
	void hero_step {
		if Hero.stepping {
			keep_walking
		} else {
			walk_or_look
		}
	}

	// ==== 81.6  People walking ===========================================

	// each step they're in, a frame on; and now and then, a new one
	void move_people {
		for I in People.length {
			if People[I].stepping {
				People[I].keep_stepping
			}
		}
		if frame % 75 == 0 {
			wander
		}
	}

	// ==== 81.7  Wandering ================================================

	// a step a random way, for one in three of those who wander
	void wander {
		list str Ways = {"up", "down", "left", "right"}
		for I in People.length {
			if People[I].Wanders && !People[I].stepping && random(1, 3) == 1 {
				walk_person (int)I, Ways[random(0, 3)]
			}
		}
	}

	// ==== 81.8  Where they may go  (changed in 86) =======================

	// anywhere free, but not through a way out, or over the edge (they
	// live here), or (71) up stairs, onto a hill, or under a bridge
	void walk_person int I, const str &Way {
		int C = People[I].Col + across_of(Way)
		int R = People[I].Row + down_of(Way)
		if on_map(C, R) && is_free(C, R) && thing_at("way", C, R) == "" && level_at(C, R) == 0 {
			People[I].step Way, true
		}
	}

	// ==== 78.16  Part way through a step  (changed in 85, 86, 87) ========

	void keep_walking {
		if Hero.keep_stepping {
			arrived
			look_out                    // (70) has anyone noticed the hero?
			settle_level                // (71) up high, or on the ground?
			meet_in_grass               // (82) is anything in the grass?
		}
	}

	// ==== 86.8  Up high, or not ==========================================

	// on high ground, the hero's up high, and drawn over bridges; on the
	// ground, they're down; on stairs or a bridge, as they were
	void settle_level {
		int Here = level_at Hero.Col, Hero.Row
		if Here >= 0 {
			Hero.Level = Here
		}
		Hero.Sprite.set_layer STANDING + (ON_TOP - STANDING) * Hero.Level
	}

	// ==== 87.12  Tall grass ==============================================

	// each step into it: now and then, something's there (a mouse, or one
	// time in three, a crow)
	void meet_in_grass {
		if Mode == PLAYING && ground_at(Hero.Col, Hero.Row) == 'w' && random(1, MEETING) == 1 {
			effect "notice"
			start_battle random(1, 3) == 1
		}
	}

	// ==== 87.13  Something in the grass ==================================

	// the one met; Ember, as she was; and the battle's music
	void start_battle bool Crow {
		Foe = field_mouse
		if Crow {
			Foe = hill_crow
		}
		Ours = fox Story.Wounds
		Fighting = true
		FlashFrame = 0
		sound.play_music "music/battle.mid"
	}

	// ==== 87.14  Each frame of a battle ==================================

	// the flash; a hit landing (its bar then falls); what's said next
	void battle_step {
		if FlashFrame < FLASH_FRAMES {
			flash_step
		} else if Hit != 0 {
			land_hit
		} else if bars_caught_up {
			next_beat
		}
	}

	// ==== 87.15  The flash ===============================================

	// the screen flashes; then the two of them, and what's said
	void flash_step {
		FlashFrame++
		if FlashFrame == FLASH_FRAMES {
			show_health
			Over = false
			Lost = false
			beat "A wild " + Foe.Name + " appeared!", 0, 0
			beat "Go, " + Ours.Name + "!", 0, 0
		}
	}

	// ==== 87.16  Full bars ===============================================

	// to begin with, the bars show what each has
	void show_health {
		FoeShown = Foe.Health
		FoeGoal = Foe.Health
		OursShown = Ours.Health
		OursGoal = Ours.Health
	}

	// ==== 87.17  Saying, in turn =========================================

	// words to say; then Who (1 the foe, 2 Ember, 0 no one) is hit, and
	// left with Health
	void beat const str &Words, int Who, int Health {
		Beats.add Words.copy
		Hits.add Who
		HealthAfter.add Health
	}

	// ==== 87.18  What's said next ========================================

	// the next words, and the hit after them; none left: the turn's over
	void next_beat {
		if Beats.length == 0 {
			turn_over
		} else {
			say Beats[0].copy
			Hit = Hits[0]
			HitTo = HealthAfter[0]
			forget_beat
		}
	}

	// ==== 87.19  Said ====================================================

	void forget_beat {
		Beats.remove_at 0
		Hits.remove_at 0
		HealthAfter.remove_at 0
	}

	// ==== 87.20  A hit landing ===========================================

	// once its words have gone: a thump, and its bar starts to fall
	void land_hit {
		if Hit == 1 {
			FoeGoal = HitTo
		} else {
			OursGoal = HitTo
		}
		Hit = 0
		effect "boom"
	}

	// ==== 87.21  The bars falling ========================================

	// a little further each frame: true once both are where they're going
	bool bars_caught_up {
		FoeShown = toward FoeShown, FoeGoal
		OursShown = toward OursShown, OursGoal
		return FoeShown == FoeGoal && OursShown == OursGoal
	}

	// ==== 87.22  A step toward ===========================================

	// a quarter of a point a frame (health only falls, in a battle)
	double toward double Now, double Goal const {
		if Now > Goal + 0.25 {
			return Now - 0.25
		}
		return Goal
	}

	// ==== 87.23  The turn's end ==========================================

	// over: walking about again; else, what next
	void turn_over {
		if Over {
			end_battle
		} else {
			ask "battle", "What will " + Ours.Name + " do?", {"Fight", "Run"}
		}
	}

	// ==== 87.24  What Ember does =========================================

	// Fight: which move; Run: away, at once; a move: the turn
	void fight_chosen const str &Menu, const str &Answer {
		if Answer == "Fight" {
			ask "moves", "Which move?", Ours.Moves.copy
		} else if Answer == "Run" {
			beat "Got away safely!", 0, 0
			Over = true
		} else if Menu == "moves" {
			take_turn Choice
		}
	}

	// ==== 87.25  A turn ==================================================

	// the quicker one goes first; the other, if it can still go, after
	void take_turn int Move {
		int Theirs = random 0, (int)Foe.Moves.length - 1
		if Ours.Speed >= Foe.Speed {
			ember_goes Move
			foe_goes Theirs
		} else {
			foe_goes Theirs
			ember_goes Move
		}
	}

	// ==== 87.26  Ember's go ==============================================

	void ember_goes int Move {
		if Over {
			return
		}
		Foe.Health = hurt Foe.Health, damage(Ours, Ours.Powers[Move], Foe)
		beat Ours.Name + " used " + Ours.Moves[Move] + "!", 1, Foe.Health
		fainted_if Foe.Health, "The wild " + Foe.Name + " fainted!", false
	}

	// ==== 87.27  The other's go ==========================================

	void foe_goes int Move {
		if Over {
			return
		}
		Ours.Health = hurt Ours.Health, damage(Foe, Foe.Powers[Move], Ours)
		beat "The wild " + Foe.Name + " used " + Foe.Moves[Move] + "!", 2, Ours.Health
		fainted_if Ours.Health, Ours.Name + " is worn out!", true
	}

	// ==== 87.28  How hard a hit is =======================================

	// as FireRed works it out, more or less: by the level, the move's
	// power, and strength against toughness; then from 85% to all of it
	int damage const critter &By, int Power, const critter &Target const {
		int Most = (By.Level * 2 / 5 + 2) * Power * By.Strength / Target.Toughness / 50 + 2
		return Most * random(85, 100) / 100
	}

	// ==== 87.29  Hurt ====================================================

	// health, less a hit, but never below 0
	int hurt int Health, int Damage const {
		if Damage >= Health {
			return 0
		}
		return Health - Damage
	}

	// ==== 87.30  Fainting ================================================

	// out of health: it's over, once the words have shown
	void fainted_if int Health, const str &Words, bool Ember {
		if Health == 0 {
			beat Words, 0, 0
			Over = true
			Lost = Ember
		}
	}

	// ==== 87.31  The battle's end ========================================

	// walking about again, to the area's music; Ember stays as hurt as she
	// is, unless she's worn out: then she rests, and is well again
	void end_battle {
		Fighting = false
		Story.Wounds = Ours.Most - Ours.Health
		if Lost {
			Story.Wounds = 0
			say hero_name + "'s fox curls up for a rest, and is soon well again."
		}
		start_music
		println "the battle is over"
	}

	// ==== 85.7  Looking out for the hero =================================

	// on a tile that makes someone notice; or in front of someone who sees
	void look_out {
		int Who = watcher
		if Who < 0 {
			Who = seen_by
		}
		if Mode == PLAYING && Who >= 0 {
			noticed_by Who
		}
	}

	// ==== 85.8  A tile that's watched ====================================

	// "watch 8,1 elder" on this tile: the elder (-1: nobody, or they've
	// noticed the hero already)
	int watcher const {
		str Name = thing_at "watch", Hero.Col, Hero.Row
		if Name == "" || Story.Noticed.contains(Name) {
			return -1
		}
		return person_named Name
	}

	// ==== 85.9  Someone by name ==========================================

	int person_named const str &Name const {
		for I in People.length {
			if People[I].Picture == Name {
				return (int)I
			}
		}
		return -1
	}

	// ==== 85.10  Who can see the hero ====================================

	// the first who does (-1: nobody)
	int seen_by const {
		for I in People.length {
			int Who = (int)I
			if sees Who {
				return Who
			}
		}
		return -1
	}

	// ==== 85.11  Seeing ==================================================

	// someone who sees, standing still, facing the hero, near enough, with
	// nothing in between; and who hasn't noticed them before
	bool sees int Who const {
		str Name = People[Who].Picture.copy
		if !Sight.contains(Name) || Story.Noticed.contains(Name) || People[Who].stepping {
			return false
		}
		return in_sight People[Who].Col, People[Who].Row, People[Who].Facing, Sight[Name]
	}

	// ==== 85.12  In a line ===============================================

	// the tiles that way from C, R, as far as Far, until something's in the
	// way: is the hero on one?
	bool in_sight int C, int R, const str &Way, int Far const {
		int X = C + across_of(Way)
		int Y = R + down_of(Way)
		while Far > 1 && !Hero.at(X, Y) && is_free(X, Y) {
			X += across_of Way
			Y += down_of Way
			Far--
		}
		return Hero.at X, Y
	}

	// ==== 85.13  Noticed =================================================

	// a "!" over their head, a sound, and the hero stands still
	void noticed_by int Who {
		str Name = People[Who].Picture.copy
		Story.Noticed.add Name.copy
		Comer = Who
		NoticeFrame = 0
		Mode = NOTICED
		effect "notice"
		println "noticed by the", Name
		their_music Who
	}

	// ==== 85.14  Music of their own ======================================

	// the rival's music plays from the moment he sees the hero
	void their_music int Who const {
		if People[Who].Picture == "rival" {
			sound.play_music "music/rival.mid"
		}
	}

	// ==== 85.15  Coming over =============================================

	// the "!" for a moment; then a step at a time toward the hero, and talk
	void notice_step {
		NoticeFrame++
		if NoticeFrame < NOTICE_FRAMES {
			return
		} else if People[Comer].stepping {
			People[Comer].keep_stepping
		} else if !come_closer {
			arrived_to_talk
		}
	}

	// ==== 85.16  A step closer ===========================================

	// (false: they're next to the hero, or can't get any closer)
	bool come_closer {
		str Way = way_toward People[Comer].Col, People[Comer].Row
		if Way != "" {
			People[Comer].step Way, true
		}
		return Way != ""
	}

	// ==== 85.17  Which way to go =========================================

	// from C, R toward the hero: the way that's further first, if it's free
	// ("" when they're next to the hero, or neither way is free)
	str way_toward int C, int R const {
		for Way in ways_toward C, R {
			if Way != "" && !next_to_hero(C, R) && on_map(C + across_of(Way), R + down_of(Way)) && is_free(C + across_of(Way), R + down_of(Way)) {
				return Way.copy
			}
		}
		return ""
	}

	// ==== 85.18  Toward the hero =========================================

	// the way across, and the way down, the one that's further first
	list str ways_toward int C, int R const {
		int Dx = Hero.Col - C
		int Dy = Hero.Row - R
		list str Ways = {way_of(Dx, "left", "right"), way_of(Dy, "up", "down")}
		if Dy * Dy > Dx * Dx {
			Ways.reverse
		}
		return Ways
	}

	// ==== 85.19  A way, from a number ====================================

	// below 0, Less ("left"); above it, More ("right"); 0: ""
	str way_of int D, const str &Less, const str &More const {
		if D < 0 {
			return Less.copy
		} else if D > 0 {
			return More.copy
		}
		return ""
	}

	// ==== 85.20  Next to the hero ========================================

	bool next_to_hero int C, int R const {
		int Dx = Hero.Col - C
		int Dy = Hero.Row - R
		return Dx * Dx + Dy * Dy <= 1
	}

	// ==== 85.21  Face to face ============================================

	// next to the hero (or as near as they can get): the hero turns to them,
	// they turn to the hero, and talk
	void arrived_to_talk {
		str Way = ways_toward(People[Comer].Col, People[Comer].Row)[0].copy
		Hero.face opposite(Way)
		Mode = PLAYING
		talk_to Comer
	}

	// ==== 78.17  On the next tile  (changed in 79, 80) ===================

	// a way out starts here? Or (64) over the edge, into the area next door?
	void arrived {
		str Way = thing_at "way", Hero.Col, Hero.Row
		if !on_map(Hero.Col, Hero.Row) {
			cross_over
		} else if Way != "" {
			door_sound
			leave_by Way
		}
	}

	// ==== 79.29  Over the edge ===========================================

	// into the area next door: it's the area now, with no fade, and the
	// hero on the same tile, counted on its map, so they're where they were
	// on the screen, and the camera doesn't jump
	void cross_over {
		int J = join_at Hero.Col, Hero.Row
		str Place = Joins[J].Area.copy
		int C = Hero.Col - Joins[J].Col
		int R = Hero.Row - Joins[J].Row
		enter Place, C, R
	}

	// ==== 80.3  A door ===================================================

	// a way out through a door (or the mat inside one) sounds like it
	void door_sound {
		char Tile = Map[Hero.Row][Hero.Col]
		if Tile == 'D' || Tile == 'M' {
			effect "door"
		}
	}

	// ==== 79.30  Leaving  (changed in 80) ================================

	// "bakery 6,7": into the bakery, on its tile 6,7, once it's dark
	void leave_by const str &Way {
		list str To = Way.split " "
		NextArea = To[0].copy
		NextCol = column_of To[1]
		NextRow = row_of To[1]
		Mode = FADING_OUT
		FadeFrame = 0
		sound.fade_out_music FADE_FRAMES * 1000 / 60   // (the music fades with it)
	}

	// ==== 79.31  A place's numbers =======================================

	// "8,1": the column, 8, and the row, 1
	int column_of const str &Place const {
		return Place.split(",")[0].to_int
	}

	int row_of const str &Place const {
		return Place.split(",")[1].to_int
	}

	// ==== 79.32  Each frame of a fade ====================================

	// dark: the next area is built; light again: walking on
	void fade_step {
		FadeFrame++
		if FadeFrame < FADE_FRAMES {
			return
		} else if Mode == FADING_OUT {
			start_at NextArea.copy, NextCol, NextRow
		} else {
			Mode = PLAYING
		}
	}

	// ==== 78.18  On a tile: walk, or look  (changed in 83, 84) ===========

	// an arrow key held down starts the next step; Space looks ahead
	void walk_or_look {
		str Way = held_way
		if Way != "" {
			arrow_held Way
		} else if key_press "space" {
			look_ahead
		} else if key_press "escape" {
			open_menu
		}
	}

	// ==== 78.19  Turning, or walking =====================================

	str Turned                      // the arrow key that turned the hero

	// a new way only turns the hero; held a moment longer, they walk. The
	// way they face walks at once.
	void arrow_held const str &Way {
		if Way != Hero.Facing {
			Hero.face Way
			Turned = Way.copy
		} else if Way != Turned || key_press(Way) || key_held_for(Way) >= TURN_TIME {
			walk Way
		}
	}

	// ==== 78.20  The arrow keys ==========================================

	// the way an arrow key held down points ("": none)
	str held_way const {
		list str Ways = {"up", "down", "left", "right"}
		for Way in Ways {
			if key_hold Way {
				return Way.copy
			}
		}
		return ""
	}

	// ==== 78.21  Walking  (changed in 80, 86) ============================

	// a step that way: onto the next tile if it's free (and, 71, at the
	// hero's height), else on the spot; or a hop over a ledge
	void walk const str &Way {
		bool Free = can_go Way
		if hops_over Way {
			hop Way
		} else {
			Hero.step Way, Free
			step_sound Free, Way
		}
	}

	// ==== 86.9  A step's sound ===========================================

	void step_sound bool Free, const str &Way {
		if Free {
			effect "step"
		} else {
			bumped Way
		}
	}

	// ==== 86.10  At the hero's height ====================================

	// the next tile that way: free, and at the hero's height; or stairs, or
	// a bridge (on it from up high, under it from below); or from stairs
	bool can_go const str &Way const {
		int C = Hero.Col + across_of(Way)
		int R = Hero.Row + down_of(Way)
		int To = level_at C, R
		return is_free(C, R) && (To == Hero.Level || To < 0 || level_at(Hero.Col, Hero.Row) == STAIRS)
	}

	// ==== 86.11  The tile at C, R ========================================

	// the tile at C, R: off the map, as if grass
	char ground_at int C, int R const {
		if on_map C, R {
			return Map[R][C]
		}
		return '.'
	}

	// ==== 86.12  How high a tile is ======================================

	// 1 high ground; 0 the ground; STAIRS, from one to the other; ON_BRIDGE,
	// at the height the hero was: over it, or under it
	int level_at int C, int R const {
		char Tile = ground_at C, R
		if Tile == 'z' {
			return STAIRS
		} else if Tile == 'B' || Tile == 'P' {
			return ON_BRIDGE
		}
		return (int)(Tile == 'h')
	}

	// ==== 86.13  A ledge ahead ===========================================

	// facing that way, with a free tile beyond it: the hero hops over it
	bool hops_over const str &Way const {
		int C = Hero.Col + across_of(Way)
		int R = Hero.Row + down_of(Way)
		return Hero.Level == 0 && on_map(C, R) && Map[R][C] == ledge_facing(Way) && is_free(C + across_of(Way), R + down_of(Way))
	}

	// ==== 86.14  Which ledge =============================================

	// the one facing that way: v down, ^ up, < left, > right
	char ledge_facing const str &Way const {
		list str Ways = {"down", "up", "left", "right"}
		str Ledges = "v^<>"
		for I in 4 {
			if Ways[I] == Way {
				return Ledges[I]
			}
		}
		return ' '
	}

	// ==== 86.15  Hopping =================================================

	void hop const str &Way {
		Hero.hop Way
		effect "hop"
		println "hopped", Way, "over a ledge"
	}

	// ==== 78.22  Bumping into something  (changed in 80) =================

	void bumped const str &Way {
		println "bump", Way
		effect "bump"
	}

	// ==== 80.4  Sound effects ============================================

	// sounds/step.wav, sounds/bump.wav ...: played, while the game goes on
	void effect const str &Name const {
		sound.play "sounds/" + Name + ".wav"
	}

	// ==== 78.23  What's in the way  (changed in 79, 81, 83) ==============

	// a tile on the map that isn't a tree, a sign, a house or water, or a
	// door with a way through it; or (64) beyond the edge, a free one in
	// the area next door
	bool is_free int C, int R const {
		if !on_map(C, R) {
			return free_next_door C, R
		} else if Map[R][C] == 'D' {
			return thing_at("way", C, R) != ""
		}
		return !BLOCKING.contains(Map[R][C]) && !someone_at(C, R) && item_at(C, R) == ""
	}

	// ==== 79.33  On the map ==============================================

	// a tile of this area's own map, not beyond its edges
	bool on_map int C, int R const {
		return R >= 0 && R < Map.length && C >= 0 && C < Map[R].length
	}

	// ==== 79.34  Free next door ==========================================

	// beyond the edge: a tile in an area next door that isn't in the way
	// (not one at a corner: it's only next door to next door)
	bool free_next_door int C, int R const {
		int J = join_at C, R
		return J >= 0 && !Joins[J].Corner && !BLOCKING.contains(Joins[J].tile(C, R))
	}

	// ==== 79.35  Which area next door ====================================

	// the one with that tile (-1: none)
	int join_at int C, int R const {
		for I in Joins.length {
			if Joins[I].has C, R {
				return (int)I
			}
		}
		return -1
	}

	// ==== 83.8  A thing to pick up, here =================================

	// the item on that tile ("spoon"), if it hasn't been picked up yet
	str item_at int C, int R const {
		str Place = C.text + "," + R.text
		if Story.Taken.contains Area + " " + Place {
			return ""
		}
		return thing_at "item", C, R
	}

	// ==== 81.9  Someone in the way =======================================

	// the hero, or one of the people, is there (or stepping there)
	bool someone_at int C, int R const {
		return Hero.at(C, R) || person_at(C, R) >= 0
	}

	// ==== 81.10  Who is there ============================================

	// which of the people is there (-1: nobody)
	int person_at int C, int R const {
		for I in People.length {
			if People[I].at C, R {
				return (int)I
			}
		}
		return -1
	}

	// ==== 81.11  Who can be talked to ====================================

	// someone standing on that tile: not someone part way off it (they'd
	// turn to talk a tile away), nor on their way onto it
	int talker_at int C, int R const {
		int Who = person_at C, R
		if Who >= 0 && !People[Who].stepping && People[Who].Col == C && People[Who].Row == R {
			return Who
		}
		return -1
	}

	// ==== 81.12  Making room =============================================

	// someone standing where the hero arrives steps aside (they wandered
	// there, or stood there when the game was saved)
	void make_room int C, int R {
		int Who = person_at C, R
		str Way = free_way_from C, R
		if Who >= 0 && Way != "" {
			People[Who].step Way, true
		}
	}

	// ==== 81.13  A way out of the crowd ==================================

	// the first way from the tile to a free one ("": none)
	str free_way_from int C, int R const {
		list str Ways = {"down", "up", "left", "right"}
		for Way in Ways {
			if is_free C + across_of(Way), R + down_of(Way) {
				return Way.copy
			}
		}
		return ""
	}

	// ==== 78.24  The lines after the map =================================

	// what a line says about a tile: for "sign 3,2 The woods.", asked for
	// ("sign", 3, 2), it's "The woods."; "" if there's no such line
	str thing_at const str &Kind, int C, int R const {
		str Start = Kind + " " + C.text + "," + R.text + " "
		for Line in Things {
			if Line.starts_with Start {
				return Line[Start.length to Line.length - 1]
			}
		}
		return ""
	}

	// ==== 79.36  A line with no place ====================================

	// "music woods" is "woods", asked for "music"; "" if there's none
	str setting const str &Kind const {
		for Line in Things {
			if Line.starts_with Kind + " " {
				return Line[Kind.length + 1 to Line.length - 1]
			}
		}
		return ""
	}

	// ==== 78.25  Looking ahead  (changed in 81, 83) ======================

	// Space: what's on the tile the hero faces (a sign, for now)
	void look_ahead {
		look_at Hero.Col + across_of(Hero.Facing), Hero.Row + down_of(Hero.Facing)
	}

	// ==== 83.9  What's there =============================================

	// someone to talk to, a thing to pick up, or a sign to read
	void look_at int C, int R {
		int Who = talker_at C, R
		if Who >= 0 {
			talk_to Who
		} else if item_at(C, R) != "" {
			pick_up C, R
		} else if thing_at("sign", C, R) != "" {
			say thing_at("sign", C, R)
		}
	}

	// ==== 83.10  Picking up ==============================================

	// carried now, remembered as taken, and off the stage
	void pick_up int C, int R {
		str Name = item_at C, R
		str Place = C.text + "," + R.text
		str Taken = Area + " " + Place
		Story.Items.add Name.copy
		Story.Taken.add Taken
		take_away "item " + Place
		effect "pick-up"
		say "You found " + description_of(Name) + "!"
	}

	// ==== 83.11  Off the stage ===========================================

	void take_away const str &Group {
		for Thing in sprites_in Group {
			Thing.remove
		}
	}

	// ==== 83.12  What a thing is =========================================

	str description_of const str &Name const {
		if Name == "spoon" {
			return "the baker's wooden spoon"
		} else if Name == "bread" {
			return "a loaf of fresh bread"
		}
		return "a " + Name
	}

	// ==== 81.14  Talking to someone  (changed in 82, 85) =================

	// they turn to face the hero, and say what they say
	void talk_to int Who {
		People[Who].face opposite(Hero.Facing)
		if People[Who].Picture == "elder" {
			talk_to_elder
		} else if People[Who].Picture == "rival" {
			talk_to_rival Who
		} else {
			talk_to_baker
		}
	}

	// ==== 85.22  What the rival says =====================================

	// he says what he thinks of the hero, then goes on his way
	void talk_to_rival int Who {
		say "Hey, " + hero_name + "! I'm Rufus. So you're the new one everyone's talking about? One day I'll race you to the coast, and I'll win!"
		Leaving = true
		Leaver = Who
	}

	// ==== 85.23  Walking away ============================================

	// once the words have gone: east, a step at a time, as far as he can
	// go; then he's gone
	void walk_away {
		if !Leaving || People[Leaver].stepping {
			return
		}
		if is_free People[Leaver].Col + 1, People[Leaver].Row {
			People[Leaver].step "right", true
		} else {
			gone Leaver
		}
	}

	// ==== 85.24  Gone ====================================================

	// off down the road to the coast: and the area's own music comes back
	void gone int Who {
		People[Who].Sprite.remove
		People.remove_at Who
		Leaving = false
		start_music
		println "the rival has gone"
	}

	// ==== 78.26  Words, and reading them  (changed in 80) ================

	void say const str &Words {
		Message = Words.copy
		Mode = READING
		Shown = 0
		println "said:", Words
	}

	// ==== 78.27  Reading on  (changed in 80, 82) =========================

	// the words appear; then Space closes the box
	void read_on {
		int Words = (int)Message.split(" ").length
		if Shown < Words {
			show_more Words
		} else if Mode == CHOOSING {
			choose_step
		} else if key_press "space" {
			Mode = PLAYING
		}
	}

	// ==== 80.5  Another word =============================================

	// one every three frames, with a blip; Space shows all of them
	void show_more int Words {
		if key_press "space" {
			Shown = Words
		} else if frame % 3 == 0 {
			Shown++
			effect "blip"
		}
	}

	// ==== 78.28  Drawing the words  (changed in 79, 80, 82, 84, 85, 87) ====

	// over everything (the stage's on_draw): words in a box at the bottom,
	// and the dark of a fade over all of it; (82) a battle, over the world
	void draw_over const {
		draw_name
		draw_notice
		draw_battle
		draw_title                      // (82: it says when)
		if Area != "" && (Mode == READING || Mode == CHOOSING) {
			draw_talk
		}
		draw_fade
	}

	// ==== 87.32  A battle, drawn =========================================

	// the flash, then the two of them, and how they're doing
	void draw_battle const {
		if Fighting && FlashFrame < FLASH_FRAMES {
			draw_flash
		} else if Fighting {
			draw_field
			draw_card Foe, FoeShown, 24, 24, false
			draw_card Ours, OursShown, 340, 214, true
		}
	}

	// ==== 87.33  Flashing ================================================

	// dark, the world, dark, the world..., then dark as the battle comes
	void draw_flash const {
		if FlashFrame / 5 % 2 == 0 || FlashFrame > FLASH_FRAMES - 10 {
			stage.fill_with "#14141c"
		}
	}

	// ==== 87.34  The field ===============================================

	// a pale sky, two patches of ground: the wild one on the far one,
	// Ember (from behind) on the near one
	void draw_field const {
		stage.fill_with "#eef3dc"
		stage.set_color "#b5d68e"
		stage.fill_ellipse 494, 150, 112, 24
		stage.fill_ellipse 160, 306, 140, 30
		stage.image 430, 28, "pictures/critter-" + Foe.Kind + ".png"
		stage.image 96, 182, "pictures/critter-" + Ours.Kind + ".png"
	}

	// ==== 87.35  How one is doing ========================================

	// its name and level, and a bar for its health; and Ember's numbers
	void draw_card const critter &C, double Shown, double Left, double Top, bool Numbers const {
		draw_box_at Left, Top, 260, 70 + 22 * (int)Numbers
		stage.set_font_size 18
		stage.write Left + 16, Top + 10, C.Name
		stage.write Left + 200, Top + 10, "Lv" + C.Level.text
		draw_bar Left + 16, Top + 44, Shown / C.Most
		if Numbers {
			stage.write Left + 156, Top + 62, ((int)(Shown + 0.99)).text + " / " + C.Most.text
		}
	}

	// ==== 87.36  A health bar ============================================

	// HP, and the bar: Part of it full
	void draw_bar double Left, double Top, double Part const {
		stage.set_font_size 14
		stage.write Left, Top - 3, "HP"
		stage.fill_rectangle Left + 30, Top, 198, 12
		stage.set_color bar_color(Part)
		stage.fill_rectangle Left + 32, Top + 2, 194 * Part, 8
		stage.set_color "#2b2b38"
		stage.set_font_size 18
	}

	// ==== 87.37  Its color ===============================================

	// green; yellow under half; red under a fifth
	str bar_color double Part const {
		if Part > 0.5 {
			return "#58c858"
		} else if Part > 0.2 {
			return "#e8c040"
		}
		return "#e05038"
	}

	// ==== 84.5  Drawing the title  (changed in 87) =======================

	// the name of the game, and the answers in the middle; (82) only on the
	// title screen
	void draw_title const {
		if Area != "" {
			return
		}
		stage.set_color "#f5e6b0"
		stage.set_font_size 44
		stage.write (width - stage.text_width("Cabby Quest")) / 2, 90, "Cabby Quest"
		draw_choices_at width / 2 - 100, 190
	}

	// ==== 79.37  The dark ================================================

	// black, see-through to begin with, then less so (or the other way);
	// nothing, unless it's fading
	void draw_fade const {
		double Dark = (double)FadeFrame / FADE_FRAMES
		if Mode == FADING_IN {
			Dark = 1 - Dark
		} else if !fading {
			return
		}
		stage.set_color "rgba(0, 0, 0, " + Dark.text + ")"
		stage.fill_rectangle 0, 0, width, height
	}

	// ==== 85.25  The "!" =================================================

	// over whoever has noticed the hero, for a moment
	void draw_notice const {
		if Mode == NOTICED && NoticeFrame < NOTICE_FRAMES {
			double X = People[Comer].Sprite.x - camera_x
			double Y = People[Comer].Sprite.top - camera_y - 4
			draw_bubble X, Y
		}
	}

	// ==== 85.26  A bubble ================================================

	// a speech bubble, its point at X, Y, with a ! in it
	void draw_bubble double X, double Y const {
		stage.set_color "white"
		stage.fill_rectangle X - 14, Y - 34, 28, 28
		stage.fill_polygon {X - 6, Y - 7, X + 6, Y - 7, X, Y}
		stage.set_color "#2b2b38"
		stage.rectangle X - 14, Y - 34, 28, 28
		stage.set_color "#d03a3a"
		stage.set_font_size 22
		stage.write X - stage.text_width("!") / 2, Y - 32, "!"
	}

	// ==== 79.38  How far in the name is ==================================

	// 0 (out of sight) to 1 (all in): it slides in over 12 frames, and out
	// again at the end
	double name_in const {
		long Near = frame - NameFrom
		if NameFrom + NAME_FRAMES - frame < Near {
			Near = NameFrom + NAME_FRAMES - frame
		}
		if Near > 12 {
			Near = 12
		}
		return (double)Near / 12
	}

	// ==== 79.39  Drawing the name ========================================

	// the area's name, in a box at the top left
	void draw_name const {
		if AreaName != "" && name_in > 0 {
			stage.set_font_size 18
			draw_name_at name_in
		}
	}

	// ==== 79.40  The name's box ==========================================

	// In 0: just past the left edge; 1: all in
	void draw_name_at double In const {
		double Width = stage.text_width(AreaName) + 32
		double X = 12 - (1 - In) * (Width + 12)
		stage.set_color "white"
		stage.fill_rectangle X, 12, Width, 40
		stage.set_color "#2b2b38"
		stage.set_line_width 3
		stage.rectangle X, 12, Width, 40
		stage.write X + 16, 22, AreaName
	}

	// ==== 78.29  Words in a box  (changed in 80, 82) =====================

	// the box as tall as the words need, wrapped to its width
	// (the box is as big as all the words; Shown of them are written)
	void draw_words const str &Words, int Shown const {
		stage.set_font_size 18
		double Height = stage.lines_for(width - 64, Words) * stage.line_height + 32
		draw_box_at 12, height - Height - 12, width - 24, Height
		stage.write_wrapped 32, height - Height + 4, width - 64, first_words(Words, Shown)
	}

	// ==== 82.3  Asking ===================================================

	// words, then answers to choose from; answered (82.6) hears which
	void ask const str &Id, const str &Words, list str Options {
		say Words
		Mode = CHOOSING
		Question = Id.copy
		Choices = Options
		Choice = 0
	}

	// ==== 82.4  Choosing  (changed in 84) ================================

	void choose_step {
		int By = pressed_way "down", "up"
		if key_press "space" {
			chosen
		} else if By != 0 {
			move_choice By
		} else {
			slide_step
		}
	}

	// ==== 84.6  A pair of keys ===========================================

	// 1 if the first key went down, -1 if the second, 0 if neither
	int pressed_way const str &Plus, const str &Minus const {
		if key_press Plus {
			return 1
		} else if key_press Minus {
			return -1
		}
		return 0
	}

	// ==== 82.5  Moving the arrow =========================================

	void move_choice int By {
		int To = Choice + By
		if To >= 0 && To < Choices.length {
			Choice = To
			effect "menu-move"
		}
	}

	// ==== 82.6  Chosen  (changed in 84) ==================================

	void chosen {
		effect "menu-choose"
		Mode = PLAYING
		println "chose:", Choices[Choice]
		if is_menu Question {
			menu_chosen Question.copy, Choices[Choice].copy
		} else {
			answered Question.copy, Choices[Choice].copy
		}
	}

	// ==== 84.7  Menus  (changed in 87) ===================================

	// a menu is a question nobody in the game asks; (82) a battle's too
	bool is_menu const str &Id const {
		return Id == "title" || Id == "menu" || Id == "options" || Id == "battle" || Id == "moves"
	}

	// ==== 84.8  Which menu  (changed in 87) ==============================

	void menu_chosen const str &Menu, const str &Answer {
		if Menu == "title" {
			title_chosen Answer
		} else if Menu == "menu" {
			game_menu_chosen Answer
		} else if Menu == "options" {
			options_chosen Answer
		}
		fight_chosen Menu, Answer       // (82) a battle's
	}

	// ==== 84.9  The title's answers ======================================

	void title_chosen const str &Answer {
		if Answer == "New game" {
			new_game
		} else if Answer == "Continue" {
			load_game
		} else {
			show_options
		}
	}

	// ==== 84.10  The game's menu =========================================

	// Escape, while walking: what the hero carries, and what to do
	void open_menu {
		ask "menu", carrying, {"Save", "Options", "Quit to the title", "Back"}
	}

	// ==== 84.11  What the hero carries ===================================

	str carrying const {
		if Story.Items.length == 0 {
			return "You aren't carrying anything."
		}
		list str Names
		for Item in Story.Items {
			Names.add description_of(Item)
		}
		return "You're carrying " + Names.join(", ") + "."
	}

	// ==== 84.12  The menu's answers ======================================

	// (Back: nothing to do; the walking goes on)
	void game_menu_chosen const str &Answer {
		if Answer == "Save" {
			save_game
		} else if Answer == "Options" {
			show_options
		} else if Answer == "Quit to the title" {
			show_title
		}
	}

	// ==== 84.13  The options =============================================

	// two volumes, and Back
	void show_options {
		list str Volumes = {volume_of("Music", MusicLevel), volume_of("Sounds", SoundsLevel), "Back"}
		ask "options", "Left and right change a volume.", Volumes
	}

	str volume_of const str &Name, int Level const {
		return Name + ": " + (Level * 10).text + "%"
	}

	// ==== 84.14  The volumes =============================================

	// from 0 to 10 each: music, and the sound effects
	void set_volumes int Music, int Sounds {
		if Music < 0 || Music > 10 || Sounds < 0 || Sounds > 10 {
			return
		}
		MusicLevel = Music
		SoundsLevel = Sounds
		sound.set_music_volume MusicLevel / 10.0
		sound.set_effects_volume SoundsLevel / 10.0
	}

	// ==== 84.15  To begin with ===========================================

	// the music a little quieter than the sounds, the first time
	void first_options {
		if !OptionsSet {
			OptionsSet = true
			set_volumes 7, 10
		}
	}

	// ==== 84.16  Left and right ==========================================

	// on a volume, quieter or louder (choose_step, 82.4, comes here)
	void slide_step {
		int By = pressed_way "right", "left"
		if By != 0 && Question == "options" && Choice < 2 {
			slide_volume By
		}
	}

	// ==== 84.17  A volume, changed =======================================

	// the answers say the new volumes; a sound, to hear how loud
	void slide_volume int By {
		if Choice == 0 {
			set_volumes MusicLevel + By, SoundsLevel
		} else {
			set_volumes MusicLevel, SoundsLevel + By
		}
		Choices[0] = volume_of "Music", MusicLevel
		Choices[1] = volume_of "Sounds", SoundsLevel
		effect "menu-move"
	}

	// ==== 84.18  Changing an option ======================================

	// Space on a volume: still choosing; Back goes back
	void options_chosen const str &Answer {
		if Answer == "Back" {
			back_from_options
		} else {
			Mode = CHOOSING
		}
	}

	// ==== 84.19  Back ====================================================

	// to the title, or to the game's menu: wherever the options came from
	void back_from_options {
		if Area == "" {
			show_title
		} else {
			open_menu
		}
	}

	// ==== 82.7  An answer ================================================

	// kept in Story, by its question; and the one asking answers back
	void answered const str &Id, const str &Answer {
		Story.Answers[Id] = Answer.copy
		if Id == "elder name" {
			say "Salve, " + Answer + "! A fine name. The baker looks worried: go and see her."
		} else if Id == "baker spoon" {
			answered_baker Answer
		}
	}

	// ==== 82.8  The elder ================================================

	// he asks the hero's name, once; then he knows it
	void talk_to_elder {
		if Story.Answers.contains "elder name" {
			say "Salve, " + hero_name + "! How is Cabby Town treating you?"
		} else {
			ask "elder name", "Salve, amice! I'm the elder of Cabby Town. What's your name?", {"Marcus", "Livia", "Tiro"}
		}
	}

	// ==== 82.9  The hero's name ==========================================

	// what the hero told the elder they're called ("friend", until then)
	str hero_name const {
		if Story.Answers.contains "elder name" {
			return Story.Answers["elder name"].copy
		}
		return "friend"
	}

	// ==== 82.10  The baker  (changed in 83) ==============================

	// what she says depends on how far the quest has got
	void talk_to_baker {
		if Story.Quest == "done" {
			say "Thank you again, " + hero_name + "! Come back for bread any time."
		} else if Story.Quest == "asked" || Story.Items.contains("spoon") {
			baker_asks_again
		} else {
			ask "baker spoon", "Oh dear, " + hero_name + ". I left my wooden spoon in the bakery. Could you fetch it?", {"Of course!", "Not now."}
		}
	}

	// ==== 83.13  Has the hero found it? ==================================

	void baker_asks_again {
		if Story.Items.contains "spoon" {
			give_spoon
		} else {
			say "Have you found my spoon? It's in the bakery, the house up the path."
		}
	}

	// ==== 83.14  Giving it back ==========================================

	// the spoon goes, the bread comes, and the quest is done (asked or not)
	void give_spoon {
		str Thanks = thanks
		Story.Items.remove_at (int)Story.Items.find("spoon")
		Story.Items.add "bread"
		Story.Quest = "done"
		sound.play_notes "C5 E5 G5 C6", 120
		say Thanks + " Here: a loaf of bread, still warm."
	}

	// ==== 83.15  Thanks ==================================================

	// (found before she asked: she's surprised)
	str thanks const {
		if Story.Quest == "" {
			return "My spoon! How did you know I'd lost it? Thank you, " + hero_name + "!"
		}
		return "My spoon! Thank you, " + hero_name + "!"
	}

	// ==== 82.11  The quest ===============================================

	void answered_baker const str &Answer {
		if Answer == "Of course!" {
			Story.Quest = "asked"
			say "Thank you, " + hero_name + "! The bakery is the house up the path."
		} else {
			say "Oh. Maybe later, then."
		}
	}

	// ==== 80.6  The first few words ======================================

	str first_words const str &Words, int Count const {
		list str All = Words.split " "
		if Count >= All.length {
			return Words.copy
		} else if Count <= 0 {
			return ""
		}
		return All[0 to Count - 1].join " "
	}

	// ==== 78.30  A box  (changed in 82) ==================================

	// white, with a dark edge; the pen is left dark, for the words
	void draw_box_at double Left, double Top, double Width, double Height const {
		stage.set_color "white"
		stage.fill_rectangle Left, Top, Width, Height
		stage.set_color "#2b2b38"
		stage.set_line_width 3
		stage.rectangle Left, Top, Width, Height
	}

	// ==== 82.12  Talk, drawn  (changed in 84, 87) ========================

	// the words, and a question's answers with them; (82) in a battle,
	// at the bottom right, over the end of the words' box
	void draw_talk const {
		draw_words Message, Shown
		if Mode == CHOOSING && Fighting {
			draw_choices_at width - 212, height - 94
		} else if Mode == CHOOSING {
			draw_choices_at width - 212, 12
		}
	}

	// ==== 82.13  The answers' box  (changed in 84) =======================

	// in a box there, an arrow by the one chosen
	void draw_choices_at double Left, double Top const {
		stage.set_font_size 18
		double Line = stage.line_height
		draw_box_at Left, Top, 200, Choices.length * Line + 24
		for I in Choices.length {
			stage.write Left + 40, Top + 12 + I * Line, Choices[I]
		}
		stage.write Left + 16, Top + 12 + Choice * Line, "▶"
	}
}

// ==== 77.11  Starting ====================================================

int main {
	world w
	w.run
}

