// Tutorial 90: A robot from Blender — models and their animations
//
// Run it:      cabby 90-robot.cby
// Or compile:  cabby -c 90-robot.cby && ./90-robot
// Library:     use world
// Topics:      add_model, glTF files (.glb) as Blender exports them;
//              play, play_once, stop_animation, playing; a model's front
//
// A model is made in Blender (or any 3D program), exported as glTF, and
// brought in with add_model. It keeps its colors and pictures, and the
// animations made for it, which are played by name. models/robot.glb is
// a small one: a body with a checked picture, a head, and an arm with a
// shoulder and an elbow, with three animations: "Wave", "Nod" and "Hop".
//
// The up arrow walks it, hopping; left and right turn it; space waves.
//
// From Blender: File > Export > glTF 2.0, as a .glb (one file, its
// pictures inside it). Make the model facing Blender's front (looking at
// you in the front view), its feet at the origin, a metre being a metre.
// Its actions become its animations, by their names.

use world

object robot_walk : world.window {
	world.shape Robot

	void build {
		set_title "A robot from Blender"
		set_size 640, 480
		world.shape Ground = add_plane 40, 40, "olivedrab", 0, 0, 0
		Ground.set_picture "pictures/tile-grass.png"
		Ground.set_picture_size 2
		Robot = add_model "models/robot.glb", 0, 0, 0
		println "It can:", Robot.animations
		follow Robot, 4, 1.5
		on_frame step
	}

	void step {
		if key_hold "left" {
			Robot.turn 3
		}
		if key_hold "right" {
			Robot.turn -3
		}
		if key_hold "up" {
			Robot.move_forward 0.05
			Robot.play "Hop"
		} else if Robot.playing == "Hop" {
			Robot.stop_animation
		}
		if key_press "space" {
			Robot.play_once "Wave"
			println "It waves."
		}
	}
}

int main {
	robot_walk R
	R.run
	println "It walked", (long)(-R.Robot.z + 0.5), "metres"
}

