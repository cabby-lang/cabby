// Tutorial 97: Power, brightness and volume — a status bar
//
// Run it:      cabby 97-power-and-volume.cby
// Or compile:  cabby -c 97-power-and-volume.cby && ./97-power-and-volume
// Library:     use power, use brightness, use volume
// Topics:      power.has_battery, battery_percent, charging, plugged_in,
//              battery_full; brightness.can_set, level; volume.can_set,
//              level, muted (and, in the chapter: set, up, down, mute,
//              unmute)
//
// The three things a laptop's top bar shows: the battery, the screen's
// brightness, and the volume. This program reads them, and prints a line
// as a status bar would. It only reads, so it changes nothing; the chapter
// changes them.
//
// A desktop computer (or a Mac mini) has no battery, and its screen's
// brightness is usually the screen's own to set: each says so, rather than
// making something up.

use power
use brightness
use volume

str battery {
	if !power.has_battery {
		return "on mains power, with no battery"
	}
	str Said = "battery " + power.battery_percent.text + "%"
	if power.battery_full {
		return Said + " (full)"
	}
	if power.charging {
		return Said + " (charging)"
	}
	if power.plugged_in {
		return Said + " (plugged in)"
	}
	return Said
}

str screen {
	if !brightness.can_set {
		return "the screen sets its own brightness"
	}
	return "brightness " + brightness.level.text + "%"
}

str sound {
	if !volume.can_set {
		return "no volume to set here"
	}
	if volume.muted {
		return "volume muted (at " + volume.level.text + "%)"
	}
	return "volume " + volume.level.text + "%"
}

int main {
	println battery + "  |  " + screen + "  |  " + sound
}

// Try this:
//  - Print a bar for each, ten blocks long: "█".repeat(Level / 10) and
//    "░" for the rest.
//  - Warn when the battery is below 20% and not plugged in.
//  - Turn the volume down 10 and back up again (volume.down 10, then
//    volume.up 10), and print it in between.

// ---------------------------------------------------------------- output
// output varies: what one computer said (one with no battery, screen or sound of its own)
//> on mains power, with no battery  |  the screen sets its own brightness  |  no volume to set here
